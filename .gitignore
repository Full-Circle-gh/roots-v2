/.design-tmp/

# Stray redirect/scratch output
/8000

# OS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/
# .claude/ holds two different things and they do not belong on the same side
# of this line. Personal session state (history, local overrides) is cruft like
# the entries above it. `.claude/settings.json` is TEAM config — the permission
# allowlist every session in this repo reads — and a gitignored copy helps only
# the one machine that wrote it, because every session clones the repo fresh.
#
# The glob is `.claude/*` and not `.claude/`: git cannot re-include a file whose
# PARENT DIRECTORY is excluded, so the negation below would silently do nothing
# against `.claude/`. Changed 2026-09-07 with settings.json, and called out in
# that commit rather than slipped in — this file's own history is why that rule
# exists.
.claude/*
!.claude/settings.json
AGENTS.md
.cursor/
.aider*

# Local session/auth state + scrape artifacts — never commit
/data/
/meituan screenshots/
/scripts/_*.json
# Exception: the gzgrocery price list is the only input to
# scripts/import_guanyi_pricing.js, which is the sole writer of the pricing
# table. Tracked deliberately — it is permanent in history from here on.
!/scripts/_guanyi_pricing.json
/.mcp.json

# Logs
*.log

# Local scratch copies pulled from the live server for diffing
_live_*

# Internal ops doc — kept locally, contains server access details
DEPLOY.md

# Customer-migration PII (phones + balances) — transfer out-of-band, never commit
/migration_credits.json
/migration_unmatched.json
/migration_roster.json
/scratch_*
C:/Users/Asher/Downloads/migration_phoneless.json

# Baseline copy of routes/retail.js taken from HEAD, written on demand for the
# --baseline mode of scripts/test_batch_timing.js and test_addon_stock_gate.js.
routes/_baseline_retail.js

# Scratch dirs created by test scripts that build their own fixture database.
.test-scratch-*/

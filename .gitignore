# Secrets — NEVER commit
.env
.env.*
!.env.example
*.key
*.pem
.ossutilconfig

# Dependencies
node_modules/

# Local SQLite + backups
data/*.db
data/*.db-shm
data/*.db-wal
data/*.db.bak.*
data/roots-pre-*.db*
# Per-box runtime state (holder-Chrome launch GUIDs for lib/browser-warmup)
data/chrome-warmup/
# Per-box runtime state (open ops-alert latches for lib/alert-latch)
data/alert-latch/

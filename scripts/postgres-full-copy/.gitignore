# The generated INSERT SQL holds real customer, order and financial data.
# It must never enter git. run.py deletes each file as it loads; this is the
# guard for when a run is interrupted.
sql/
*.sql

# ...except the hand-written Postgres survey, which is an input.
!survey_pg.sql

# Every report the scripts write. Regenerate by re-running the script.
*.log
*.json
!plan.json
!copy_order.json

__pycache__/

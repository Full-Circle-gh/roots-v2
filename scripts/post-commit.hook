#!/bin/sh
# Post-commit hook — GitHub mirror only. Install with:
#   cp scripts/post-commit.hook .git/hooks/post-commit && chmod +x .git/hooks/post-commit
#
# DEPLOYS ARE OWNED BY GITHUB ACTIONS (.github/workflows/deploy.yml): every push
# to main triggers CI to lint the changed files and run the safe installer
# (backup -> pm2 restart -> health probe -> auto-rollback) on the server. This
# hook's only job is to push the commit so that workflow fires. Runs AFTER the
# commit is saved, so a push failure never blocks or undoes the commit.
#
# History: a local deploy (scripts/deploy-changed.sh) used to run here too, but
# it shared the server's __stage__ dir with the CI deploy, lost the race on
# every commit, and printed a false "No such file or directory" while CI
# deployed correctly. Removed 2026-07-17 so CI is the single deploy path. To
# ship WITHOUT GitHub (outage, offline, CI down), run scripts/deploy-changed.sh
# by hand — it re-ships HEAD through the same installer.
root=$(git rev-parse --show-toplevel)
bash "$root/scripts/auto-push.sh"

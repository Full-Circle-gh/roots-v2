{
  "name": "roots-system-v2",
  "version": "2.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "lint": "eslint routes lib middleware scripts server.js database.js public",
    "lint:fix": "eslint --fix routes lib middleware scripts server.js database.js public",
    "verify:fulfilment": "node scripts/verify-fulfilment-types.js",
    "verify:i18n-banners": "node scripts/check-i18n-banners.js",
    "test:address": "node scripts/test_address_pin.js && node scripts/test_address_clients.js",
    "test:batch-timing": "node scripts/test_batch_timing.js",
    "test:customer-search": "node scripts/test_customer_search.js",
    "test:manual-order-fees": "node scripts/test_manual_order_fees.js",
    "test:needs-point": "node scripts/test_needs_point.js && node scripts/test_needs_point_client.js",
    "test:phone": "node scripts/test_recipient_phone.js",
    "test:push-mute": "node scripts/test_push_mute_action.js",
    "test:point-search": "node scripts/test_point_search.js",
    "test:addon-stock": "node scripts/test_addon_stock_gate.js",
    "test:preorder": "node scripts/test_preorder_local.js",
    "test:proxy": "node scripts/test_proxy_failover.js",
    "test:queue-window": "node scripts/test_meituan_queue_window.js",
    "test:split-merge": "node scripts/test_shipments_split_merge.js",
    "test:handle-threading": "node scripts/test_handle_threading_batch1.js && node scripts/test_handle_threading_batch2.js",
    "test:transaction": "node scripts/test_db_transaction.js && node scripts/test_db_transaction_nesting.js",
    "test:tx-conversion": "node scripts/test_tx_conversion_batch1.js && node scripts/test_tx_conversion_batch2.js && node scripts/test_tx_conversion_batch3.js && node scripts/test_tx_conversion_batch4.js"

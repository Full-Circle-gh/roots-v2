    "connect-sqlite3": "^0.9.13",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.17.3",
    "geoip-lite": "^2.0.3",
    "helmet": "^8.1.0",
    "multer": "^1.4.5-lts.1",
    "pg": "8.22.0",
    "playwright": "^1.61.0",
    "sharp": "^0.35.0",
    "uuid": "^9.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "eslint": "^10.4.0",
    "globals": "^17.6.0"

.tabbar {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  display: flex;
  height: calc(98rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 999;
}
.tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding-top: 8rpx;
  transition: transform .12s ease;
}
.tab:active { transform: scale(0.94); }
.icon-wrap { position: relative; width: 48rpx; height: 48rpx; }
.icon { width: 48rpx; height: 48rpx; }
.label {
  font-size: 20rpx;
  letter-spacing: .12em;
  text-transform: uppercase;
  font-weight: 500;
  transition: color .15s ease;
}
.tab--active .label { font-weight: 700; }
.badge {
  position: absolute;
  top: -4rpx;
  right: -10rpx;
  min-width: 26rpx;
  height: 26rpx;
  padding: 0 6rpx;
  border-radius: 13rpx;
  background: #e74c3c;
  color: #fff;
  font-size: 18rpx;
  line-height: 26rpx;
  text-align: center;
  font-weight: 700;
  box-shadow: 0 0 0 2rpx rgba(255,255,255,.6);
}

<!-- Custom tab bar. Reads its visual config from globalData.tabBarStyle which
     app.js refreshes whenever storefront_config changes. Tabs are fixed:
     Home · Shop · Cart · Me (mirrors app.json). -->
<view class="tabbar" style="background:{{backgroundColor}};border-top:1rpx solid {{borderColor}};">
  <view
    wx:for="{{tabs}}"
    wx:key="path"
    class="tab {{selected === index ? 'tab--active' : ''}}"
    data-index="{{index}}"
    data-path="{{item.path}}"
    bindtap="onTap">
    <view class="icon-wrap">
      <image class="icon" src="{{selected === index ? item.iconActive : item.icon}}" mode="aspectFit"/>
      <view wx:if="{{item.badge > 0}}" class="badge">{{item.badge > 99 ? '99+' : item.badge}}</view>
    </view>
    <text class="label" style="color:{{selected === index ? selectedColor : color}};">{{item.label}}</text>
  </view>
</view>

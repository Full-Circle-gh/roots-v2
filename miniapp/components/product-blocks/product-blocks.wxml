<view class="pb-wrap {{tplClass}}">
  <view wx:for="{{resolved}}" wx:key="_k" wx:for-index="bi" class="pb pb-{{item.type}}" style="{{item._style}}">

    <!-- 01 · SPEC STRIP -->
    <block wx:if="{{item.type === 'spec_strip'}}">
      <view class="pb-spec">
        <view wx:for="{{item.cells}}" wx:key="k" wx:for-item="c" class="pb-spec-cell">
          <view wx:if="{{c.k}}" class="pb-spec-k">{{c.k}}</view>
          <view wx:if="{{c.v}}" class="pb-spec-v">{{c.v}}</view>
        </view>
      </view>
    </block>

    <!-- 02 · HERO INTRO -->
    <block wx:elif="{{item.type === 'hero_intro'}}">
      <view class="pb-hero">
        <view wx:if="{{item.kicker}}" class="pb-hero-kicker">{{item.kicker}}</view>
        <view class="pb-hero-body">
          <text wx:for="{{item.bodySegments}}" wx:for-item="seg" wx:key="*this"
                class="{{seg.kind === 'hl' ? 'pb-ink-pull' : ''}}">{{seg.text}}</text>
        </view>
      </view>
    </block>

    <!-- 03 · WHY PEOPLE CHOOSE IT -->
    <block wx:elif="{{item.type === 'why'}}">
      <view class="pb-why">
        <view class="pb-why-head">
          <text class="pb-why-head-l">{{item.head}}</text>
        </view>
        <view wx:for="{{item.rows}}" wx:for-item="r" wx:key="n"
              class="pb-why-row {{r.first ? 'first' : ''}}">
          <text class="pb-why-n">{{r.n}}</text>
          <text class="pb-why-claim">{{r.claim}}</text>
        </view>
      </view>
    </block>

    <!-- 04a · INGREDIENTS · CHIP CLOUD -->
    <block wx:elif="{{item.type === 'ingredients_chips'}}">
      <view class="pb-ing">
        <view class="pb-section-head">
          <text class="pb-section-h3">{{item.headLabel}}</text>
        </view>
        <view class="pb-ing-chips">
          <view wx:for="{{item.items}}" wx:for-item="it" wx:key="name"
                class="pb-chip {{it.lead ? 'pb-chip-lead' : ''}}">
            <text>{{it.name}}</text>
            <text wx:if="{{it.pct}}" class="pb-chip-pct">{{it.pct}}%</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 04b · INGREDIENTS · EDITORIAL LINE -->
    <block wx:elif="{{item.type === 'ingredients_line'}}">
      <view class="pb-ing">
        <view class="pb-section-head">
          <text class="pb-section-h3">{{item.headLabel}}</text>
        </view>
        <view class="pb-ing-line">
          <block wx:for="{{item.items}}" wx:for-item="it" wx:key="name">
            <text wx:if="{{index > 0}}" class="pb-ing-line-sep"></text>
            <text>{{it.name}}</text>
            <text wx:if="{{it.pct}}" class="pb-ing-line-pct"> {{it.pct}}%</text>
          </block>
        </view>
      </view>
    </block>

    <!-- 05 · ALLERGEN CARD -->
    <block wx:elif="{{item.type === 'allergen_card'}}">
      <view class="pb-allergen">
        <view class="pb-allergen-card">
          <view class="pb-allergen-top">
            <view class="pb-allergen-ttl">
              <text class="pb-allergen-warn">!</text>
              <text>{{item.title}}</text>
            </view>
          </view>
          <view class="pb-allergen-row">
            <text class="pb-allergen-lbl">{{item.containsLabel}}</text>
            <view class="pb-allergen-chips">
              <text wx:if="{{item.containsEmpty}}" class="pb-allergen-empty">{{item.emptyText}}</text>
              <block wx:else>
                <text wx:for="{{item.contains}}" wx:for-item="chip" wx:key="*this"
                      class="pb-al-chip pb-al-chip-strong">{{chip}}</text>
              </block>
            </view>
          </view>
          <view wx:if="{{item.mayContain.length}}" class="pb-allergen-row">
            <text class="pb-allergen-lbl">{{item.mayContainLabel}}</text>
            <view class="pb-allergen-chips">
              <text wx:for="{{item.mayContain}}" wx:key="*this"
                    class="pb-al-chip pb-al-chip-soft">{{item}}</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <!-- 06 · HOW TO USE GRID -->
    <block wx:elif="{{item.type === 'how_to_use'}}">
      <view class="pb-how">
        <view class="pb-section-head">
          <text class="pb-section-h3">{{item.head}}</text>
        </view>
        <view class="pb-how-grid {{item.cols === 4 ? 'cols-4' : ''}}">
          <view wx:for="{{item.tiles}}" wx:for-item="t" wx:key="lbl" class="pb-how-tile">
            <text wx:if="{{t.icon}}" class="pb-how-ic">{{t.icon}}</text>
            <text wx:if="{{t.lbl}}" class="pb-how-lbl">{{t.lbl}}</text>
            <text wx:if="{{t.sub}}" class="pb-how-sub">{{t.sub}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 07 · STORAGE BOX -->
    <block wx:elif="{{item.type === 'storage_box'}}">
      <view class="pb-storage">
        <view class="pb-section-head">
          <text class="pb-section-h3">{{item.head}}</text>
        </view>
        <view class="pb-storage-pair">
          <view wx:if="{{item.left}}" class="pb-storage-card {{item.left.alt ? 'alt' : ''}}">
            <text wx:if="{{item.left.icon}}" class="pb-storage-ic">{{item.left.icon}}</text>
            <text wx:if="{{item.left.head}}" class="pb-storage-head">{{item.left.head}}</text>
            <text wx:if="{{item.left.num}}" class="pb-storage-num {{item.left.numLong ? 'long' : ''}}">{{item.left.num}}</text>
            <text wx:if="{{item.left.unit}}" class="pb-storage-unit">{{item.left.unit}}</text>
          </view>
          <view wx:if="{{item.right}}" class="pb-storage-card {{item.right.alt ? 'alt' : ''}}">
            <text wx:if="{{item.right.icon}}" class="pb-storage-ic">{{item.right.icon}}</text>
            <text wx:if="{{item.right.head}}" class="pb-storage-head">{{item.right.head}}</text>
            <text wx:if="{{item.right.num}}" class="pb-storage-num {{item.right.numLong ? 'long' : ''}}">{{item.right.num}}</text>
            <text wx:if="{{item.right.unit}}" class="pb-storage-unit">{{item.right.unit}}</text>
          </view>
        </view>
        <view wx:if="{{item.note}}" class="pb-storage-note">{{item.note}}</view>
      </view>
    </block>

    <!-- 09 · NOTES CALLOUT -->
    <block wx:elif="{{item.type === 'notes_callout'}}">
      <view class="pb-notes">
        <view class="pb-notes-p">{{item.text}}</view>
      </view>
    </block>

    <!-- +1 · BIG STAT CALLOUT -->
    <block wx:elif="{{item.type === 'big_stat'}}">
      <view class="pb-bigstat" style="background: var(--{{item.bg}});">
        <view class="pb-bigstat-num">{{item.stat}}</view>
        <view wx:if="{{item.what}}" class="pb-bigstat-what">{{item.what}}</view>
        <view wx:if="{{item.claim}}" class="pb-bigstat-claim">{{item.claim}}</view>
      </view>
    </block>

    <!-- +3 · CALLOUT BANNER (e.g. Shipped nationwide) -->
    <block wx:elif="{{item.type === 'callout_banner'}}">
      <view class="pb-cbanner">
        <view wx:if="{{item.icon}}" class="pb-cbanner-icon">{{item.icon}}</view>
        <view wx:if="{{item.text}}" class="pb-cbanner-text">{{item.text}}</view>
        <view wx:if="{{item.sub}}" class="pb-cbanner-sub">{{item.sub}}</view>
      </view>
    </block>

    <!-- +2 · PULL QUOTE / ORIGIN NOTE -->
    <block wx:elif="{{item.type === 'pull_quote'}}">
      <view class="pb-pullquote">
        <view class="pb-pullquote-p">"{{item.text}}"</view>
        <view wx:if="{{item.who}}" class="pb-pullquote-who">{{item.who}}</view>
      </view>
    </block>

    <!-- +3 · IMAGE / LIFESTYLE BAND -->
    <block wx:elif="{{item.type === 'image_band'}}">
      <view class="pb-image pb-image-{{item.ratio}}">
        <image class="pb-image-img" src="{{item.url}}" mode="{{item.fill ? 'aspectFill' : 'widthFix'}}" lazy-load/>
        <view wx:if="{{item.caption}}" class="pb-image-cap">{{item.caption}}</view>
      </view>
    </block>

    <!-- +4 · RECIPE STEPS -->
    <block wx:elif="{{item.type === 'recipe_steps'}}">
      <view class="pb-recipe">
        <view class="pb-section-head">
          <text class="pb-section-h3">{{item.head}}</text>
        </view>
        <view wx:for="{{item.steps}}" wx:for-item="s" wx:key="n" class="pb-recipe-step">
          <text class="pb-recipe-n">{{s.n}}</text>
          <view class="pb-recipe-body">
            <view class="pb-recipe-text">{{s.text}}</view>
            <text wx:if="{{s.time}}" class="pb-recipe-time">{{s.time}}</text>
          </view>
        </view>
      </view>
    </block>

    <!-- +5 · GOES WELL WITH -->
    <block wx:elif="{{item.type === 'pairings'}}">
      <view class="pb-pair">
        <view class="pb-section-head">
          <text class="pb-section-h3">{{item.head}}</text>
        </view>
        <scroll-view class="pb-pair-row" scroll-x>
          <view wx:for="{{item.items}}" wx:for-item="p" wx:key="id"
                class="pb-pair-tile" data-id="{{p.id}}" bindtap="onPairTap">
            <image class="pb-pair-img" src="{{p.img}}" mode="aspectFill" lazy-load/>
            <text class="pb-pair-name">{{p.name}}</text>
          </view>
        </scroll-view>
      </view>
    </block>

    <!-- +6 · FAQ ACCORDION -->
    <block wx:elif="{{item.type === 'faq'}}">
      <view class="pb-faq">
        <view class="pb-section-head">
          <text class="pb-section-h3">{{item.head}}</text>
        </view>
        <view wx:for="{{item.items}}" wx:for-item="q" wx:key="q"
              class="pb-faq-item {{q.open ? 'open' : ''}}">
          <view class="pb-faq-q" data-bi="{{bi}}" data-qi="{{index}}" bindtap="onFaqToggle">
            <text class="pb-faq-q-txt">{{q.q}}</text>
            <text class="pb-faq-mark">{{q.open ? '–' : '+'}}</text>
          </view>
          <view wx:if="{{q.open}}" class="pb-faq-a">{{q.a}}</view>
        </view>
      </view>
    </block>

    <!-- +7 · NUTRITION FACTS (attached, inside the design) -->
    <block wx:elif="{{item.type === 'nutrition_facts'}}">
      <view class="pb-nutrition">
        <view class="pb-nut-card">
          <view class="pb-nut-top">
            <text class="pb-nut-ttl">{{item.title}}</text>
            <text wx:if="{{item.basis}}" class="pb-nut-basis">{{item.basis}}</text>
          </view>
          <view wx:for="{{item.rows}}" wx:for-item="nr" wx:key="label" class="pb-nrow {{nr.kind === 'parent' ? 'bold' : ''}} {{nr.kind === 'child' ? 'child' : ''}}">
            <text class="pb-nrow-l">{{nr.label}}</text>
            <text class="pb-nrow-r">{{nr.value}}</text>
          </view>
        </view>
      </view>
    </block>

  </view>
</view>

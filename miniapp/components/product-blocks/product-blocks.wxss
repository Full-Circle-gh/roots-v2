/* ═══════════════════════════════════════════════════════════════════════
   product-blocks — Roots PDP v1 (Editorial direction)
   Ports the design system in /design_handoff_roots_pdp/v1-editorial/.
   All sizes designed at 375px canvas — multiply by 2 for rpx
   (e.g. 14px CSS → 28rpx WXSS).
   ═══════════════════════════════════════════════════════════════════════ */

/* Brand tokens — duplicated here so the component is self-contained.
   Same hex values that /retail-admin uses for its live preview. */
.pb-wrap {
  --oat:      #F2E7DF;
  --oat-deep: #E8D9CB;
  --ink:      #1a1a17;
  --ink-60:   rgba(26, 26, 23, 0.6);
  --ink-30:   rgba(26, 26, 23, 0.3);
  --ink-12:   rgba(26, 26, 23, 0.12);
  --lime:     #CCD900;
  --forest:   #365329;
  --olive:    #6A6E2D;
  --almond:   #C37F4E;
  --corn:     #F2CA6C;
  --berry:    #E96174;
  --carrot:   #FF6B0C;
  --papaya:   #FFAF60;
  --pink:     #F4B8CB;
  --sky:      #B2CFED;
  --lotus:    #EEB8E4;
  --pea:      #7BBD3B;
  --cucumber: #A8D185;
  --avocado:  #73BF83;

  display: block;
  width: 100%;
  background: var(--oat);
  color: var(--ink);
}

/* Each block sits flush against page width and divides with a 2rpx ink
   rule (v1 signature). Negative side margin pulls past the parent body
   padding (the host page uses 44rpx side padding). */
.pb {
  display: block;
  margin: 0 -44rpx;
  padding: 0;
  border-bottom: 2rpx solid var(--ink);
}
.pb:last-child { border-bottom: 0; }

/* ───────── 01 · SPEC STRIP ─────────
   Three meta facts. Equal columns divided by hairline rules. Label is
   small caps Toni; value is Bear Serif. The page's quietest band. */
.pb-spec {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
}
.pb-spec-cell {
  padding: 28rpx 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  border-right: 2rpx solid var(--ink-12);
}
.pb-spec-cell:last-child { border-right: 0; }
.pb-spec-k {
  font-family: var(--f-toni);
  font-size: 19rpx;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ink-60);
}
.pb-spec-v {
  font-family: var(--f-bear);
  font-size: 30rpx;
  line-height: 1.1;
  color: var(--ink);
}

/* ───────── 02 · HERO INTRO ─────────
   Aleo body 30rpx / 1.55. Optional kicker — Bear Serif caps with a
   short lime rule prefix. Optional inline highlight phrase wraps in
   pb-ink-pull → serif uppercase poster treatment inline. */
.pb-hero {
  padding: 64rpx 44rpx 60rpx;
}
.pb-hero-kicker {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
  font-family: var(--f-toni);
  font-size: 22rpx;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--forest);
}
.pb-hero-kicker::before {
  content: "";
  display: inline-block;
  width: 36rpx;
  height: 2rpx;
  background: var(--forest);
}
.pb-hero-body {
  font-family: var(--f-aleo);
  font-size: 30rpx;
  line-height: 1.55;
  color: var(--ink);
  white-space: pre-line;
}
/* Inline ink-pull: serif slab on lime, highlighting one phrase mid-body */
.pb-ink-pull {
  font-family: var(--f-bear);
  font-style: normal;
  font-size: 34rpx;
  line-height: 1;
  letter-spacing: -0.005em;
  background: var(--lime);
  padding: 0.06em 0.18em;
  color: var(--ink);
  box-decoration-break: clone;
  -webkit-box-decoration-break: clone;
}

/* ───────── 03 · WHY PEOPLE CHOOSE IT ─────────
   3–5 numbered single-line claims. League Gothic numeral left rail,
   Toni claim right. Hairline divider; first row gets a solid 2rpx top. */
.pb-why {
  padding: 12rpx 44rpx 44rpx;
}
.pb-why-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 40rpx 0 28rpx;
}
.pb-why-head-l {
  font-family: var(--f-bear);
  font-size: 22rpx;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--olive);
}
.pb-why-head-r {
  font-family: var(--f-toni);
  font-size: 22rpx;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-60);
}
.pb-why-row {
  display: grid;
  grid-template-columns: 72rpx 1fr;
  gap: 28rpx;
  align-items: baseline;
  padding: 28rpx 0;
  border-top: 2rpx solid var(--ink-12);
}
.pb-why-row.first { border-top: 2rpx solid var(--ink); }
.pb-why-n {
  font-family: var(--f-gothic);
  font-size: 68rpx;
  line-height: 0.85;
  color: var(--ink);
}
.pb-why-claim {
  font-family: var(--f-toni);
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 400;
  color: var(--ink);
}

/* ───────── Section heading shared by blocks 4/6/7/8 ─────────
   Bear Serif h3 + small caps Toni tag right. */
.pb-section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 36rpx;
}
.pb-section-h3 {
  font-family: var(--f-bear);
  font-weight: 400;
  font-size: 52rpx;
  line-height: 0.95;
  letter-spacing: -0.005em;
  color: var(--ink);
}
.pb-section-tag {
  font-family: var(--f-toni);
  font-size: 20rpx;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ink-60);
  padding-bottom: 8rpx;
}

/* ───────── 04a · INGREDIENTS · CHIP CLOUD ─────────
   Outlined pills. Optional hero chip (inverted ink fill, serif).
   Optional berry % badge on chips ≥10%. */
.pb-ing {
  padding: 60rpx 44rpx 60rpx;
}
.pb-ing-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: flex-start;
}
.pb-chip {
  display: inline-flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 18rpx 26rpx 16rpx;
  border: 2rpx solid var(--ink);
  border-radius: 999rpx;
  background: transparent;
  font-family: var(--f-toni);
  font-size: 26rpx;
  line-height: 1;
  color: var(--ink);
}
.pb-chip-lead {
  background: var(--ink);
  color: var(--oat);
  font-family: var(--f-bear);
  font-size: 36rpx;
  padding: 22rpx 32rpx 20rpx;
}
.pb-chip-pct {
  font-family: var(--f-gothic);
  font-size: 28rpx;
  letter-spacing: 0.02em;
  color: var(--berry);
}
.pb-chip-lead .pb-chip-pct { color: var(--lime); }

/* ───────── 04b · INGREDIENTS · EDITORIAL LINE ─────────
   Single typographic run. Bear Serif 44rpx / 1.25. Separators are lime
   dots, % callouts are inline League Gothic in berry. */
.pb-ing-line {
  font-family: var(--f-bear);
  font-weight: 400;
  font-size: 44rpx;
  line-height: 1.25;
  letter-spacing: -0.005em;
  color: var(--ink);
}
.pb-ing-line-pct {
  font-family: var(--f-gothic);
  color: var(--berry);
  font-size: 0.85em;
  margin-left: 0.05em;
}
.pb-ing-line-sep {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  background: var(--lime);
  border-radius: 50%;
  margin: 0 0.35em 0.12em;
  vertical-align: middle;
}

/* ───────── 05 · ALLERGEN CARD ─────────
   Outlined card on warm tan tint. Berry square warn-mark + serif title.
   Two segmented chip rows: Contains (berry strong) / May contain (corn soft). */
.pb-allergen {
  padding: 60rpx 44rpx 60rpx;
}
.pb-allergen-card {
  border: 2rpx solid var(--ink);
  background: #FAF1E8;
  padding: 36rpx 32rpx 32rpx;
}
.pb-allergen-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 24rpx;
  margin-bottom: 24rpx;
  border-bottom: 2rpx solid var(--ink);
}
.pb-allergen-ttl {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-family: var(--f-bear);
  font-size: 36rpx;
  line-height: 1;
  color: var(--ink);
}
.pb-allergen-warn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  background: var(--berry);
  color: var(--oat);
  border-radius: 8rpx;
  font-family: var(--f-toni);
  font-size: 26rpx;
  font-weight: 700;
}
.pb-allergen-meta {
  font-family: var(--f-toni);
  font-size: 19rpx;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ink-60);
}
.pb-allergen-row {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  padding: 16rpx 0;
}
.pb-allergen-row + .pb-allergen-row {
  border-top: 2rpx dashed var(--ink-30);
}
.pb-allergen-lbl {
  font-family: var(--f-toni);
  font-size: 20rpx;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink-60);
  flex: 0 0 176rpx;
  line-height: 1.4;
}
.pb-allergen-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
}
.pb-al-chip {
  display: inline-block;
  padding: 10rpx 20rpx 8rpx;
  border-radius: 999rpx;
  font-family: var(--f-toni);
  font-size: 23rpx;
  line-height: 1;
}
.pb-al-chip-strong {
  background: var(--berry);
  color: #fff;
  font-weight: 700;
}
.pb-al-chip-soft {
  background: var(--corn);
  color: var(--ink);
}
.pb-allergen-empty {
  font-family: var(--f-aleo);
  font-style: italic;
  font-size: 26rpx;
  color: var(--ink-60);
}

/* ───────── 06 · HOW TO USE GRID ─────────
   3-col (6 tiles) or 4-col (8 tiles) grid. 2rpx ink-12 gutter — feels
   like a riso plate. Each tile: emoji icon + caps label, optional sub. */
.pb-how {
  padding: 60rpx 44rpx 60rpx;
}
.pb-how-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rpx;
  background: var(--ink-12);
  border: 2rpx solid var(--ink-12);
}
.pb-how-grid.cols-4 {
  grid-template-columns: repeat(4, 1fr);
}
.pb-how-tile {
  background: var(--oat);
  padding: 36rpx 12rpx 32rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: center;
  min-height: 152rpx;
  justify-content: center;
}
.pb-how-ic {
  font-size: 48rpx;
  line-height: 1;
}
.pb-how-lbl {
  font-family: var(--f-toni);
  font-size: 22rpx;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink);
}
.pb-how-sub {
  font-family: var(--f-aleo);
  font-style: italic;
  font-size: 22rpx;
  color: var(--ink-60);
  margin-top: -8rpx;
}

/* ───────── 07 · STORAGE BOX ─────────
   Two paired graphic cards side-by-side. One inverted (ink fill).
   League Gothic huge duration; emoji icon top-right; optional after-
   opening note italic Aleo right-aligned. */
.pb-storage {
  padding: 60rpx 44rpx 60rpx;
}
.pb-storage-pair {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.pb-storage-card {
  border: 2rpx solid var(--ink);
  padding: 32rpx 28rpx 28rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  min-height: 256rpx;
}
.pb-storage-card.alt {
  background: var(--ink);
  color: var(--oat);
}
.pb-storage-ic {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: 36rpx;
  line-height: 1;
}
.pb-storage-head {
  font-family: var(--f-toni);
  font-size: 20rpx;
  letter-spacing: 0.22em;
  text-transform: uppercase;
}
.pb-storage-num {
  font-family: var(--f-gothic);
  font-size: 96rpx;
  line-height: 0.85;
  margin-top: auto;
}
.pb-storage-unit {
  font-family: var(--f-toni);
  font-size: 22rpx;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}
.pb-storage-note {
  margin-top: 24rpx;
  font-family: var(--f-aleo);
  font-style: italic;
  font-size: 24rpx;
  color: var(--ink-60);
  text-align: right;
}

/* ───────── 09 · NOTES CALLOUT ─────────
   Full-width band, no border. Aleo italic dimmed. Olive asterisk
   prefix (never a bullet). Max ~3 lines. */
.pb-notes {
  padding: 48rpx 44rpx 56rpx;
}
.pb-notes-p {
  font-family: var(--f-aleo);
  font-style: italic;
  font-size: 25rpx;
  line-height: 1.55;
  color: var(--ink-60);
  position: relative;
  padding-left: 28rpx;
}
.pb-notes-p::before {
  content: "✱";
  position: absolute;
  left: 0;
  top: 0;
  color: var(--olive);
  font-style: normal;
}

/* ───────── +1 · BIG STAT CALLOUT ─────────
   Full-bleed brand-colour slab. Stat huge in Bear Serif. Caps
   what-label below. Optional italic Aleo sub-line. Decorative dots
   at left/right edges anchor the slab. */
.pb-bigstat {
  background: var(--lime);
  color: var(--ink);
  text-align: center;
  padding: 76rpx 44rpx 80rpx;
  position: relative;
  overflow: hidden;
}
.pb-bigstat-num {
  font-family: var(--f-bear);
  font-weight: 400;
  font-size: 220rpx;
  line-height: 0.85;
  letter-spacing: -0.02em;
  color: var(--ink);
}
.pb-bigstat-what {
  font-family: var(--f-toni);
  font-size: 22rpx;
  letter-spacing: 0.32em;
  text-transform: uppercase;
  margin-top: 20rpx;
  color: var(--ink);
}
.pb-bigstat-claim {
  font-family: var(--f-aleo);
  font-style: italic;
  font-size: 28rpx;
  margin-top: 12rpx;
  color: var(--ink);
}
.pb-bigstat::before,
.pb-bigstat::after {
  content: "·";
  position: absolute;
  font-family: var(--f-bear);
  font-size: 120rpx;
  line-height: 1;
  top: 50%;
  transform: translateY(-50%);
  color: var(--ink);
}
.pb-bigstat::before { left: 28rpx; }
.pb-bigstat::after  { right: 28rpx; }

/* ───────── +2 · PULL QUOTE / ORIGIN NOTE ─────────
   Background oat-deep · no border. Aleo italic with curly quotes.
   Attribution Toni caps. */
.pb-pullquote {
  padding: 48rpx 44rpx 52rpx;
  background: var(--oat-deep);
}
.pb-pullquote-p {
  font-family: var(--f-aleo);
  font-style: italic;
  font-size: 30rpx;
  line-height: 1.5;
  color: var(--ink);
}
.pb-pullquote-who {
  margin-top: 20rpx;
  font-family: var(--f-toni);
  font-size: 20rpx;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ink-60);
}

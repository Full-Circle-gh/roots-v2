/* ═══════════════════════════════════════════════════════════════════════
   product-blocks — Roots PDP v1 (Editorial direction)
   Ports the design system in /design_handoff_roots_pdp/v1-editorial/.
   All sizes designed at 375px canvas — multiply by 2 for rpx
   (e.g. 14px CSS → 28rpx WXSS).
   ═══════════════════════════════════════════════════════════════════════ */

/* Brand tokens — duplicated here so the component is self-contained.
   Same hex values that /retail-admin uses for its live preview. */
.pb-wrap {
  --oat:      #F2E7DF;
  --oat-deep: #E8D9CB;
  --ink:      #1a1a17;
  --ink-60:   rgba(26, 26, 23, 0.6);
  --ink-30:   rgba(26, 26, 23, 0.3);
  --ink-12:   rgba(26, 26, 23, 0.12);
  --lime:     #CCD900;
  --forest:   #365329;
  --olive:    #6A6E2D;
  --almond:   #C37F4E;
  --corn:     #F2CA6C;
  --berry:    #E96174;
  --carrot:   #FF6B0C;
  --papaya:   #FFAF60;
  --pink:     #F4B8CB;
  --sky:      #B2CFED;
  --lotus:    #EEB8E4;
  --pea:      #7BBD3B;
  --cucumber: #A8D185;
  --avocado:  #73BF83;

  display: block;
  width: 100%;
  background: var(--oat);
  color: var(--ink);
}

/* Each block sits flush against page width and divides with a 2rpx ink
   rule (v1 signature). Negative side margin pulls past the parent body
   padding (the host page uses 44rpx side padding). */
.pb {
  display: block;
  margin: 0 -44rpx;
  padding: 0;
  border-bottom: 2rpx solid var(--ink);
}
.pb:last-child { border-bottom: 0; }

/* ───────── 01 · SPEC STRIP ─────────
   Three meta facts. Equal columns divided by hairline rules. Label is
   small caps Toni; value is Bear Serif. The page's quietest band. */
.pb-spec {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
}
.pb-spec-cell {
  padding: 28rpx 28rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  border-right: 2rpx solid var(--ink-12);
}
.pb-spec-cell:last-child { border-right: 0; }
.pb-spec-k {
  font-family: var(--f-toni);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--pa-accent, var(--ink-60));
}
.pb-spec-v {
  font-family: var(--f-bear);
  font-size: calc(30rpx * var(--font-scale));
  line-height: 1.1;
  color: var(--pa-fg, var(--ink));
}

/* ───────── 02 · HERO INTRO ─────────
   Aleo body 30rpx / 1.55. Optional kicker — Bear Serif caps with a
   short lime rule prefix. Optional inline highlight phrase wraps in
   pb-ink-pull → serif uppercase poster treatment inline. */
.pb-hero {
  padding: 64rpx 44rpx 60rpx;
}
.pb-hero-kicker {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
  font-family: var(--f-toni);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--pa-accent, var(--forest));
}
.pb-hero-kicker::before {
  content: "";
  display: inline-block;
  width: 36rpx;
  height: 2rpx;
  background: var(--pa-accent, var(--forest));
}
.pb-hero-body {
  font-family: var(--f-aleo);
  font-size: calc(30rpx * var(--font-scale));
  line-height: 1.55;
  color: var(--pa-fg, var(--ink));
  white-space: pre-line;
}
/* Inline ink-pull: serif slab on lime, highlighting one phrase mid-body */
.pb-ink-pull {
  font-family: var(--f-bear);
  font-style: normal;
  font-size: calc(34rpx * var(--font-scale));
  line-height: 1;
  letter-spacing: -0.005em;
  background: var(--lime);
  padding: 0.06em 0.18em;
  color: var(--ink);
  box-decoration-break: clone;
  -webkit-box-decoration-break: clone;
}

/* ───────── 03 · WHY PEOPLE CHOOSE IT ─────────
   3–5 numbered single-line claims. League Gothic numeral left rail,
   Toni claim right. Hairline divider; first row gets a solid 2rpx top. */
.pb-why {
  padding: 12rpx 44rpx 44rpx;
}
.pb-why-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 40rpx 0 28rpx;
}
.pb-why-head-l {
  font-family: var(--f-bear);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--pa-accent, var(--olive));
}
.pb-why-head-r {
  font-family: var(--f-toni);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--ink-60);
}
.pb-why-row {
  display: grid;
  grid-template-columns: 72rpx 1fr;
  gap: 28rpx;
  align-items: baseline;
  padding: 28rpx 0;
  border-top: 2rpx solid var(--ink-12);
}
.pb-why-row.first { border-top: 2rpx solid var(--ink); }
.pb-why-n {
  font-family: var(--f-gothic);
  font-size: calc(68rpx * var(--font-scale));
  line-height: 0.85;
  color: var(--pa-accent, var(--ink));
}
.pb-why-claim {
  font-family: var(--f-toni);
  font-size: calc(32rpx * var(--font-scale));
  line-height: 1.35;
  font-weight: 400;
  color: var(--pa-fg, var(--ink));
}

/* ───────── Section heading shared by blocks 4/6/7/8 ─────────
   Bear Serif h3 + small caps Toni tag right. */
.pb-section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 36rpx;
}
.pb-section-h3 {
  font-family: var(--f-bear);
  font-weight: 400;
  font-size: calc(52rpx * var(--font-scale));
  line-height: 0.95;
  letter-spacing: -0.005em;
  color: var(--ink);
}
.pb-section-tag {
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ink-60);
  padding-bottom: 8rpx;
}

/* ───────── 04a · INGREDIENTS · CHIP CLOUD ─────────
   Outlined pills. Optional hero chip (inverted ink fill, serif).
   Optional berry % badge on chips ≥10%. */
.pb-ing {
  padding: 60rpx 44rpx 60rpx;
}
.pb-ing-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  align-items: flex-start;
}
.pb-chip {
  display: inline-flex;
  align-items: baseline;
  gap: 12rpx;
  padding: 18rpx 26rpx 16rpx;
  border: 2rpx solid var(--ink);
  border-radius: 999rpx;
  background: transparent;
  font-family: var(--f-toni);
  font-size: calc(26rpx * var(--font-scale));
  line-height: 1;
  color: var(--pa-fg, var(--ink));
}
.pb-chip-lead {
  background: var(--pa-accent, var(--ink));
  color: var(--oat);
  font-family: var(--f-bear);
  font-size: calc(36rpx * var(--font-scale));
  padding: 22rpx 32rpx 20rpx;
}
.pb-chip-pct {
  font-family: var(--f-gothic);
  font-size: calc(28rpx * var(--font-scale));
  letter-spacing: 0.02em;
  color: var(--pa-accent, var(--berry));
}
.pb-chip-lead .pb-chip-pct { color: var(--lime); }

/* ───────── 04b · INGREDIENTS · EDITORIAL LINE ─────────
   Single typographic run. Bear Serif 44rpx / 1.25. Separators are lime
   dots, % callouts are inline League Gothic in berry. */
.pb-ing-line {
  font-family: var(--f-bear);
  font-weight: 400;
  font-size: calc(44rpx * var(--font-scale));
  line-height: 1.25;
  letter-spacing: -0.005em;
  color: var(--pa-fg, var(--ink));
}
.pb-ing-line-pct {
  font-family: var(--f-gothic);
  color: var(--pa-accent, var(--berry));
  font-size: 0.85em;
  margin-left: 0.05em;
}
.pb-ing-line-sep {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  background: var(--pa-accent, var(--lime));
  border-radius: 50%;
  margin: 0 0.35em 0.12em;
  vertical-align: middle;
}

/* ───────── 05 · ALLERGEN CARD ─────────
   Outlined card on warm tan tint. Berry square warn-mark + serif title.
   Two segmented chip rows: Contains (berry strong) / May contain (corn soft). */
.pb-allergen {
  padding: 60rpx 44rpx 60rpx;
}
.pb-allergen-card {
  border: 2rpx solid var(--ink);
  background: #FAF1E8;
  padding: 36rpx 32rpx 32rpx;
}
.pb-allergen-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 24rpx;
  margin-bottom: 24rpx;
  border-bottom: 2rpx solid var(--ink);
}
.pb-allergen-ttl {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-family: var(--f-bear);
  font-size: calc(36rpx * var(--font-scale));
  line-height: 1;
  color: var(--pa-fg, var(--ink));
}
.pb-allergen-warn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  background: var(--pa-accent, var(--berry));
  color: var(--oat);
  border-radius: 8rpx;
  font-family: var(--f-toni);
  font-size: calc(26rpx * var(--font-scale));
  font-weight: 700;
}
.pb-allergen-meta {
  font-family: var(--f-toni);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ink-60);
}
.pb-allergen-row {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
  padding: 16rpx 0;
}
.pb-allergen-row + .pb-allergen-row {
  border-top: 2rpx dashed var(--ink-30);
}
.pb-allergen-lbl {
  font-family: var(--f-toni);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink-60);
  flex: 0 0 176rpx;
  line-height: 1.4;
}
.pb-allergen-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
}
.pb-al-chip {
  display: inline-block;
  padding: 10rpx 20rpx 8rpx;
  border-radius: 999rpx;
  font-family: var(--f-toni);
  font-size: calc(25rpx * var(--font-scale));
  line-height: 1;
}
.pb-al-chip-strong {
  background: var(--berry);
  color: var(--ink);
  font-weight: 700;
}
.pb-al-chip-soft {
  background: var(--corn);
  color: var(--ink);
}
.pb-allergen-empty {
  font-family: var(--f-aleo);
  font-style: italic;
  font-size: calc(26rpx * var(--font-scale));
  color: var(--ink-60);
}

/* ───────── 06 · HOW TO USE GRID ─────────
   3-col (6 tiles) or 4-col (8 tiles) grid. 2rpx ink-12 gutter — feels
   like a riso plate. Each tile: emoji icon + caps label, optional sub. */
.pb-how {
  padding: 60rpx 44rpx 60rpx;
}
.pb-how-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 2rpx;
  background: var(--ink-12);
  border: 2rpx solid var(--ink-12);
}
.pb-how-grid.cols-4 {
  grid-template-columns: repeat(4, 1fr);
}
.pb-how-tile {
  background: var(--oat);
  padding: 36rpx 12rpx 32rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  align-items: center;
  min-height: 152rpx;
  justify-content: center;
}
.pb-how-ic {
  font-size: calc(48rpx * var(--font-scale));
  line-height: 1;
}
.pb-how-lbl {
  font-family: var(--f-toni);
  font-size: calc(24rpx * var(--font-scale));
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--pa-fg, var(--ink));
}
.pb-how-sub {
  font-family: var(--f-aleo);
  font-style: italic;
  font-size: calc(24rpx * var(--font-scale));
  color: var(--ink-60);
  margin-top: -8rpx;
}

/* ───────── 07 · STORAGE BOX ─────────
   Two paired graphic cards side-by-side. One inverted (ink fill).
   League Gothic huge duration; emoji icon top-right; optional after-
   opening note italic Aleo right-aligned. */
.pb-storage {
  padding: 60rpx 44rpx 60rpx;
}
.pb-storage-pair {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}
.pb-storage-card {
  border: 2rpx solid var(--ink);
  padding: 36rpx 30rpx 34rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  min-height: 280rpx;
  /* Grid items default to min-width:auto, which refuses to shrink below the
     widest unbreakable child — that's what let an over-long hero numeral push
     past the card edge and clip. Allow the card to shrink so children wrap. */
  min-width: 0;
  overflow: hidden;
}
.pb-storage-card.alt {
  background: var(--ink);
  color: var(--oat);
}
.pb-storage-ic {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  font-size: calc(36rpx * var(--font-scale));
  line-height: 1;
}
.pb-storage-head {
  font-family: var(--f-toni);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.22em;
  text-transform: uppercase;
}
.pb-storage-num {
  font-family: var(--f-gothic);
  font-size: calc(96rpx * var(--font-scale));
  line-height: 0.95;
  margin-top: auto;
  /* Never clip horizontally — wrap if a value somehow runs long, whatever
     font (brand or wide fallback) ends up rendering it. */
  overflow-wrap: break-word;
  word-break: break-word;
}
/* `.long` = the slot holds a phrase, not a hero numeral ("Cool & dry",
   "Refrigerate"). Drop to a readable display size that wraps inside the card
   instead of overflowing at 96rpx. Set from product-blocks.js (numLong).
   Also swap off League Gothic (a condensed numeral/display face) to Bear
   Serif — the brand body face — so a sentence reads as prose, not as a
   stretched-out numeral. True numeral cards keep --f-gothic. */
.pb-storage-num.long {
  font-family: var(--f-bear);
  font-size: calc(46rpx * var(--font-scale));
  line-height: 1.1;
}
.pb-storage-unit {
  font-family: var(--f-toni);
  font-size: calc(24rpx * var(--font-scale));
  letter-spacing: 0.16em;
  line-height: 1.5;
  text-transform: uppercase;
}
.pb-storage-note {
  margin-top: 24rpx;
  font-family: var(--f-aleo);
  font-style: italic;
  font-size: calc(24rpx * var(--font-scale));
  color: var(--ink-60);
  text-align: right;
}

/* ───────── 09 · NOTES CALLOUT ─────────
   Full-width band, no border. Aleo italic dimmed. Olive asterisk
   prefix (never a bullet). Max ~3 lines. */
.pb-notes {
  padding: 48rpx 44rpx 56rpx;
}
.pb-notes-p {
  font-family: var(--f-aleo);
  font-style: italic;
  font-size: calc(25rpx * var(--font-scale));
  line-height: 1.55;
  color: var(--pa-fg, var(--ink-60));
  position: relative;
  padding-left: 28rpx;
}
.pb-notes-p::before {
  content: "✱";
  position: absolute;
  left: 0;
  top: 0;
  color: var(--pa-accent, var(--olive));
  font-style: normal;
}

/* ───────── +1 · BIG STAT CALLOUT ─────────
   Full-bleed brand-colour slab. Stat huge in Bear Serif. Caps
   what-label below. Optional italic Aleo sub-line. Decorative dots
   at left/right edges anchor the slab. */
.pb-bigstat {
  background: var(--lime);
  color: var(--ink);
  text-align: center;
  padding: 76rpx 44rpx 80rpx;
  position: relative;
  overflow: hidden;
}
.pb-bigstat-num {
  font-family: var(--f-bear);
  font-weight: 400;
  font-size: calc(220rpx * var(--font-scale));
  line-height: 0.85;
  letter-spacing: -0.02em;
  color: var(--ink);
}
.pb-bigstat-what {
  font-family: var(--f-toni);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.32em;
  text-transform: uppercase;
  margin-top: 20rpx;
  color: var(--ink);
}
.pb-bigstat-claim {
  font-family: var(--f-aleo);
  font-style: italic;
  font-size: calc(28rpx * var(--font-scale));
  margin-top: 12rpx;
  color: var(--ink);
}
.pb-bigstat::before,
.pb-bigstat::after {
  content: "·";
  position: absolute;
  font-family: var(--f-bear);
  font-size: calc(120rpx * var(--font-scale));
  line-height: 1;
  top: 50%;
  transform: translateY(-50%);
  color: var(--ink);
}
.pb-bigstat::before { left: 28rpx; }
.pb-bigstat::after  { right: 28rpx; }

/* ───────── +3 · CALLOUT BANNER ─────────
   Full-bleed forest slab, cream Bear-serif headline, Toni caps sub-line.
   Used for the "Shipped nationwide" statement at the top of meal pages. */
.pb-cbanner {
  background: var(--forest);
  color: var(--oat);
  text-align: center;
  padding: 40rpx 44rpx 44rpx;
}
.pb-cbanner-icon {
  font-size: calc(46rpx * var(--font-scale));
  line-height: 1;
  margin-bottom: 10rpx;
}
.pb-cbanner-text {
  font-family: var(--f-bear);
  font-weight: 400;
  font-size: calc(52rpx * var(--font-scale));
  line-height: 1.08;
  letter-spacing: -0.01em;
  color: var(--oat);
}
.pb-cbanner-sub {
  font-family: var(--f-toni);
  font-size: calc(23rpx * var(--font-scale));
  letter-spacing: 0.06em;
  margin-top: 12rpx;
  color: var(--oat);
  opacity: 0.82;
}

/* ───────── +2 · PULL QUOTE / ORIGIN NOTE ─────────
   Background oat-deep · no border. Aleo italic with curly quotes.
   Attribution Toni caps. */
.pb-pullquote {
  padding: 48rpx 44rpx 52rpx;
  background: var(--oat-deep);
}
.pb-pullquote-p {
  font-family: var(--f-aleo);
  font-style: italic;
  font-size: calc(30rpx * var(--font-scale));
  line-height: 1.5;
  color: var(--pa-fg, var(--ink));
}
.pb-pullquote-who {
  margin-top: 20rpx;
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--ink-60);
}

/* ───────── +3 · IMAGE / LIFESTYLE BAND ─────────
   Full-bleed photo to break up the text run. Fixed-ratio variants crop to
   a clean shape; 'natural' keeps the image's own aspect (image set to
   widthFix in the WXML). Optional caption sits below in Aleo italic. */
.pb-image {
  padding: 0;
}
.pb-image-img {
  display: block;
  width: 100%;
}
.pb-image-wide   .pb-image-img { height: 422rpx; }   /* ~16:9 at 750rpx */
.pb-image-square .pb-image-img { height: 750rpx; }   /* 1:1 */
.pb-image-tall   .pb-image-img { height: 938rpx; }   /* ~4:5 */
.pb-image-natural .pb-image-img { height: auto; }
.pb-image-cap {
  padding: 16rpx 44rpx 28rpx;
  font-family: var(--f-aleo);
  font-style: italic;
  font-size: calc(24rpx * var(--font-scale));
  line-height: 1.5;
  color: var(--ink-60);
}

/* ───────── +4 · RECIPE STEPS ─────────
   Numbered method. League Gothic olive numeral rail + Aleo body, with an
   optional lime-tint timing chip. Hairline divider between steps. */
.pb-recipe {
  padding: 60rpx 44rpx 60rpx;
}
.pb-recipe-step {
  display: grid;
  grid-template-columns: 72rpx 1fr;
  gap: 28rpx;
  padding: 28rpx 0;
  border-top: 2rpx solid var(--ink-12);
}
.pb-recipe-step:first-of-type { border-top: 2rpx solid var(--ink); }
.pb-recipe-n {
  font-family: var(--f-gothic);
  font-size: calc(56rpx * var(--font-scale));
  line-height: 0.9;
  color: var(--pa-accent, var(--olive));
}
.pb-recipe-body {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14rpx;
}
.pb-recipe-text {
  font-family: var(--f-aleo);
  font-size: calc(28rpx * var(--font-scale));
  line-height: 1.5;
  color: var(--pa-fg, var(--ink));
}
.pb-recipe-time {
  font-family: var(--f-toni);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--olive);
  background: #E9ECC9;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  line-height: 1;
}

/* ───────── +5 · GOES WELL WITH ─────────
   Horizontal scroll of cross-sell tiles. Photo pulls live from the public
   product-image endpoint; tap navigates to that product page. */
.pb-pair {
  padding: 60rpx 0 60rpx 44rpx;
}
.pb-pair .pb-section-head { padding-right: 44rpx; }
.pb-pair-row {
  white-space: nowrap;
}
.pb-pair-tile {
  display: inline-block;
  width: 200rpx;
  margin-right: 20rpx;
  vertical-align: top;
  white-space: normal;
}
.pb-pair-tile:last-child { margin-right: 44rpx; }
.pb-pair-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  background: var(--ink-12);
  display: block;
}
.pb-pair-name {
  display: block;
  margin-top: 14rpx;
  font-family: var(--f-toni);
  font-size: calc(25rpx * var(--font-scale));
  line-height: 1.3;
  color: var(--pa-fg, var(--ink));
}

/* ───────── +6 · FAQ ACCORDION ─────────
   Tap-to-expand question/answer rows. Toni question + Bear Serif olive
   +/– mark; Aleo answer reveals below. Hairline divider between items. */
.pb-faq {
  padding: 60rpx 44rpx 60rpx;
}
.pb-faq-item {
  border-top: 2rpx solid var(--ink-12);
}
.pb-faq-item:first-of-type { border-top: 2rpx solid var(--ink); }
.pb-faq-q {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx 0;
}
.pb-faq-q-txt {
  font-family: var(--f-toni);
  font-size: calc(27rpx * var(--font-scale));
  line-height: 1.35;
  color: var(--pa-fg, var(--ink));
  flex: 1;
}
.pb-faq-mark {
  font-family: var(--f-bear);
  font-size: calc(44rpx * var(--font-scale));
  line-height: 1;
  color: var(--pa-accent, var(--olive));
  flex: none;
}
.pb-faq-a {
  padding: 0 0 30rpx;
  font-family: var(--f-aleo);
  font-size: calc(27rpx * var(--font-scale));
  line-height: 1.55;
  color: var(--pa-fg, var(--ink-60));
}

/* ═══════════════════════════════════════════════════════════════════════
   TEMPLATE SKIN · quiet_minimal → Style A "無印 Quiet Minimal"
   Restraint, whitespace, hairlines, mono labels, lime as a single accent.
   A re-skin of the shared block markup (renderer untouched → EN/CN intact).
   Scoped to .pb-tpl-quiet_minimal, set on the wrapper from product.wxml's
   template="{{product.page_template}}". Mirrors the product-editor preview.
   (No CSS counters — WXSS support is unreliable; the why-rows keep their
   JS-supplied numbers, section labels rely on whitespace + hairlines.)
   ═══════════════════════════════════════════════════════════════════════ */
.pb-tpl-quiet_minimal { background: #FAF8F3; }

/* blocks — drop heavy ink dividers; whitespace separation. Blocks stay within
   the wrapper (no -44rpx bleed) so the quiet paper bg has no gutter mismatch;
   only the image band bleeds full-width below. */
.pb-tpl-quiet_minimal .pb { margin: 68rpx 0 0 !important; border: none !important; }
.pb-tpl-quiet_minimal .pb:first-child { margin-top: 48rpx !important; }
.pb-tpl-quiet_minimal .pb-spec,
.pb-tpl-quiet_minimal .pb-hero,
.pb-tpl-quiet_minimal .pb-why,
.pb-tpl-quiet_minimal .pb-ing,
.pb-tpl-quiet_minimal .pb-allergen,
.pb-tpl-quiet_minimal .pb-how,
.pb-tpl-quiet_minimal .pb-storage,
.pb-tpl-quiet_minimal .pb-notes,
.pb-tpl-quiet_minimal .pb-recipe,
.pb-tpl-quiet_minimal .pb-faq { padding: 0 16rpx !important; }

/* +7 · NUTRITION FACTS — attached inline in the design stack (mirrors the old
   standalone nut-card panel, scoped to this component). */
.pb-nutrition { margin-top: 16rpx; }
.pb-nut-card { border: 2rpx solid var(--ink); padding: 28rpx 28rpx 18rpx; }
.pb-nut-top { display: flex; justify-content: space-between; align-items: flex-end; padding-bottom: 18rpx; margin-bottom: 8rpx; border-bottom: 4rpx solid var(--ink); }
.pb-nut-ttl { font-family: var(--f-bear); font-size: calc(40rpx * var(--font-scale)); font-weight: 400; line-height: 1; color: var(--ink); }
.pb-nut-basis { font-family: var(--f-aleo); font-style: italic; font-size: calc(22rpx * var(--font-scale)); color: rgba(26,26,23,0.6); text-align: right; line-height: 1.3; }
.pb-nrow { display: flex; justify-content: space-between; align-items: baseline; padding: 16rpx 0; border-bottom: 2rpx solid rgba(26,26,23,0.12); }
.pb-nrow:last-child { border-bottom: 0; }
.pb-nrow-l { font-family: var(--f-toni); font-size: calc(27rpx * var(--font-scale)); letter-spacing: 0.01em; color: var(--ink); }
.pb-nrow-r { font-family: var(--f-gothic); font-size: calc(40rpx * var(--font-scale)); line-height: 1; font-variant-numeric: tabular-nums; color: var(--ink); }
.pb-nrow.bold .pb-nrow-l { font-weight: 700; }
.pb-nrow.child { padding: 10rpx 0 10rpx 44rpx; border-bottom: 2rpx dashed rgba(26,26,23,0.12); }
.pb-nrow.child .pb-nrow-l { font-family: var(--f-aleo); font-style: italic; font-size: calc(25rpx * var(--font-scale)); color: rgba(26,26,23,0.6); position: relative; }
.pb-nrow.child .pb-nrow-l::before { content: "—"; margin-right: 12rpx; color: rgba(26,26,23,0.3); font-style: normal; }
.pb-nrow.child .pb-nrow-r { font-size: calc(32rpx * var(--font-scale)); }

/* shared quiet section label · mono caps + trailing hairline */
.pb-tpl-quiet_minimal .pb-section-head { justify-content: flex-start; align-items: baseline; gap: 20rpx; margin-bottom: 36rpx; }
.pb-tpl-quiet_minimal .pb-section-h3 { font-family: monospace !important; font-weight: 400 !important; font-size: calc(21rpx * var(--font-scale)) !important; line-height: 1.4 !important; letter-spacing: 0.28em; text-transform: uppercase; color: var(--ink-60) !important; }
.pb-tpl-quiet_minimal .pb-section-tag { display: none !important; }
.pb-tpl-quiet_minimal .pb-section-head::after { content: ''; flex: 1; height: 2rpx; background: var(--ink-12); }

/* hero_intro — quiet serif body, italic phrase (no lime marker) */
.pb-tpl-quiet_minimal .pb-hero-kicker { color: var(--olive) !important; }
.pb-tpl-quiet_minimal .pb-hero-kicker::before { background: var(--olive) !important; }
.pb-tpl-quiet_minimal .pb-hero-body { font-size: calc(30rpx * var(--font-scale)) !important; line-height: 1.7 !important; color: var(--pa-fg, rgba(26,26,23,0.82)) !important; }
.pb-tpl-quiet_minimal .pb-ink-pull { background: none !important; padding: 0 !important; font-style: italic !important; font-family: var(--f-bear) !important; font-size: calc(34rpx * var(--font-scale)) !important; color: var(--ink) !important; }

/* spec — quiet label/value hairline rows */
.pb-tpl-quiet_minimal .pb-spec { display: block; }
.pb-tpl-quiet_minimal .pb-spec-cell { flex-direction: row; justify-content: space-between; align-items: baseline; gap: 20rpx; padding: 22rpx 0 !important; border-right: none !important; border-top: 2rpx solid var(--ink-12); }
.pb-tpl-quiet_minimal .pb-spec-cell:first-child { border-top: none; }
.pb-tpl-quiet_minimal .pb-spec-k { font-family: monospace !important; font-size: calc(22rpx * var(--font-scale)) !important; letter-spacing: 0.12em !important; color: var(--ink-60) !important; }
.pb-tpl-quiet_minimal .pb-spec-v { font-family: var(--f-aleo) !important; font-size: calc(28rpx * var(--font-scale)) !important; line-height: 1.3 !important; }

/* why — mono numbers, airy hairlines */
.pb-tpl-quiet_minimal .pb-why-head { padding: 0 0 36rpx !important; }
.pb-tpl-quiet_minimal .pb-why-head-l { font-family: monospace !important; font-size: calc(21rpx * var(--font-scale)) !important; letter-spacing: 0.28em !important; color: var(--ink-60) !important; }
.pb-tpl-quiet_minimal .pb-why-head-r { display: none !important; }
.pb-tpl-quiet_minimal .pb-why-row { grid-template-columns: 48rpx 1fr !important; gap: 32rpx !important; padding: 28rpx 0 !important; border-top: 2rpx solid var(--ink-12) !important; }
.pb-tpl-quiet_minimal .pb-why-row.first { border-top: none !important; }
.pb-tpl-quiet_minimal .pb-why-n { font-family: monospace !important; font-size: calc(22rpx * var(--font-scale)) !important; line-height: 1.5 !important; color: var(--pa-accent, var(--olive)) !important; padding-top: 4rpx; }
.pb-tpl-quiet_minimal .pb-why-claim { font-family: var(--f-aleo) !important; font-weight: 400 !important; font-size: calc(28rpx * var(--font-scale)) !important; line-height: 1.55 !important; }

/* ingredients — quiet serif run, lime slashes, mono % */
.pb-tpl-quiet_minimal .pb-ing-chips { display: block; font-family: var(--f-bear); font-size: calc(38rpx * var(--font-scale)); line-height: 1.5; }
.pb-tpl-quiet_minimal .pb-chip { display: inline !important; border: none !important; border-radius: 0 !important; padding: 0 !important; background: none !important; color: var(--pa-fg, var(--ink)) !important; font-family: var(--f-bear) !important; font-size: calc(38rpx * var(--font-scale)) !important; }
.pb-tpl-quiet_minimal .pb-chip:not(:last-child)::after { content: ' / '; color: var(--pa-accent, var(--lime)); }
.pb-tpl-quiet_minimal .pb-chip-pct { font-family: monospace !important; font-size: calc(24rpx * var(--font-scale)) !important; color: var(--pa-accent, var(--ink-60)) !important; }
.pb-tpl-quiet_minimal .pb-ing-line { font-family: var(--f-bear) !important; font-size: calc(38rpx * var(--font-scale)) !important; line-height: 1.5 !important; }
.pb-tpl-quiet_minimal .pb-ing-line-sep { width: auto; height: auto; background: none; border-radius: 0; margin: 0; vertical-align: baseline; }
.pb-tpl-quiet_minimal .pb-ing-line-sep::before { content: ' / '; color: var(--pa-accent, var(--lime)); }
.pb-tpl-quiet_minimal .pb-ing-line-pct { font-family: monospace !important; font-size: calc(24rpx * var(--font-scale)) !important; color: var(--pa-accent, var(--ink-60)) !important; }

/* how to use — clean two-column hairline list, no boxes/icons */
.pb-tpl-quiet_minimal .pb-how-grid { grid-template-columns: 1fr 1fr !important; gap: 0 48rpx !important; background: none !important; border: none !important; }
.pb-tpl-quiet_minimal .pb-how-grid.cols-4 { grid-template-columns: 1fr 1fr !important; }
.pb-tpl-quiet_minimal .pb-how-tile { background: none !important; text-align: left; align-items: flex-start; justify-content: flex-start; min-height: 0 !important; padding: 26rpx 0 !important; gap: 8rpx !important; border-top: 2rpx solid var(--ink-12); }
.pb-tpl-quiet_minimal .pb-how-ic { display: none !important; }
.pb-tpl-quiet_minimal .pb-how-lbl { font-family: var(--f-aleo) !important; font-size: calc(28rpx * var(--font-scale)) !important; letter-spacing: 0 !important; text-transform: none !important; }
.pb-tpl-quiet_minimal .pb-how-sub { font-family: monospace !important; font-style: normal !important; font-size: calc(21rpx * var(--font-scale)) !important; letter-spacing: 0.04em !important; color: var(--ink-60) !important; margin-top: 0 !important; }

/* storage — inline hairline rows: head … num · unit */
.pb-tpl-quiet_minimal .pb-storage-pair { display: block !important; }
.pb-tpl-quiet_minimal .pb-storage-card { flex-direction: row !important; align-items: baseline; gap: 16rpx; min-height: 0 !important; padding: 24rpx 0 !important; border: none !important; border-top: 2rpx solid var(--ink-12) !important; background: none !important; color: var(--pa-fg, var(--ink)) !important; }
.pb-tpl-quiet_minimal .pb-storage-ic { display: none !important; }
.pb-tpl-quiet_minimal .pb-storage-head { flex: 1; font-family: monospace !important; font-size: calc(22rpx * var(--font-scale)) !important; letter-spacing: 0.1em !important; text-transform: uppercase; color: var(--ink-60) !important; }
.pb-tpl-quiet_minimal .pb-storage-num { font-family: var(--f-aleo) !important; font-size: calc(28rpx * var(--font-scale)) !important; margin-top: 0 !important; text-align: right; }
.pb-tpl-quiet_minimal .pb-storage-unit { font-family: var(--f-aleo) !important; font-size: calc(28rpx * var(--font-scale)) !important; letter-spacing: 0 !important; text-transform: none !important; color: var(--ink-60) !important; }
.pb-tpl-quiet_minimal .pb-storage-unit::before { content: '· '; }
.pb-tpl-quiet_minimal .pb-storage-note { margin-top: 32rpx !important; font-family: var(--f-bear) !important; font-style: italic !important; font-size: calc(26rpx * var(--font-scale)) !important; text-align: left !important; color: var(--ink-60) !important; }

/* allergens — single quiet line, no card/warn/pills */
.pb-tpl-quiet_minimal .pb-allergen-card { border: none !important; background: none !important; padding: 0 !important; }
.pb-tpl-quiet_minimal .pb-allergen-top { justify-content: flex-start; gap: 20rpx; align-items: baseline; padding-bottom: 0 !important; margin-bottom: 28rpx !important; border-bottom: none !important; }
.pb-tpl-quiet_minimal .pb-allergen-warn { display: none !important; }
.pb-tpl-quiet_minimal .pb-allergen-ttl { font-family: monospace !important; font-size: calc(21rpx * var(--font-scale)) !important; letter-spacing: 0.28em !important; text-transform: uppercase; color: var(--ink-60) !important; }
.pb-tpl-quiet_minimal .pb-allergen-meta { display: none !important; }
.pb-tpl-quiet_minimal .pb-allergen-top::after { content: ''; flex: 1; height: 2rpx; background: var(--ink-12); }
.pb-tpl-quiet_minimal .pb-allergen-row { display: block !important; padding: 8rpx 0 !important; border: none !important; font-family: var(--f-aleo); font-size: calc(28rpx * var(--font-scale)); line-height: 1.6; }
.pb-tpl-quiet_minimal .pb-allergen-row + .pb-allergen-row { border-top: none !important; }
.pb-tpl-quiet_minimal .pb-allergen-lbl { display: inline !important; flex: none !important; font-family: var(--f-aleo) !important; font-size: calc(28rpx * var(--font-scale)) !important; letter-spacing: 0 !important; text-transform: none !important; color: var(--pa-fg, var(--ink)) !important; }
.pb-tpl-quiet_minimal .pb-allergen-chips { display: inline !important; }
.pb-tpl-quiet_minimal .pb-al-chip { display: inline !important; padding: 0 !important; border-radius: 0 !important; background: none !important; color: var(--pa-fg, var(--ink-60)) !important; font-family: var(--f-aleo) !important; font-size: calc(28rpx * var(--font-scale)) !important; font-weight: 400 !important; }
.pb-tpl-quiet_minimal .pb-al-chip:not(:last-child)::after { content: ', '; }

/* notes — quiet lime hairline rule, italic serif */
.pb-tpl-quiet_minimal .pb-notes-p { padding-left: 28rpx !important; border-left: 4rpx solid var(--pa-accent, var(--lime)); font-family: var(--f-bear) !important; font-style: italic !important; font-size: calc(28rpx * var(--font-scale)) !important; line-height: 1.5 !important; color: var(--pa-fg, var(--ink)) !important; }
.pb-tpl-quiet_minimal .pb-notes-p::before { display: none !important; }

/* big_stat / pull_quote — softened (no loud slab / huge type) */
.pb-tpl-quiet_minimal .pb-bigstat { background: none !important; padding: 16rpx 16rpx !important; text-align: left; overflow: visible; }
.pb-tpl-quiet_minimal .pb-bigstat::before, .pb-tpl-quiet_minimal .pb-bigstat::after { display: none !important; }
.pb-tpl-quiet_minimal .pb-bigstat-num { font-size: calc(128rpx * var(--font-scale)) !important; }
.pb-tpl-quiet_minimal .pb-bigstat-what { letter-spacing: 0.2em !important; color: var(--ink-60) !important; }
.pb-tpl-quiet_minimal .pb-pullquote { background: none !important; padding: 8rpx 16rpx 8rpx 28rpx !important; border-left: 4rpx solid var(--pa-accent, var(--lime)); }
.pb-tpl-quiet_minimal .pb-pullquote-p { font-family: var(--f-bear) !important; font-style: italic !important; font-size: calc(32rpx * var(--font-scale)) !important; }

/* image band — bleed full-width for the lifestyle break, quiet caption inset */
.pb-tpl-quiet_minimal .pb-image { margin: 0 -44rpx !important; }
.pb-tpl-quiet_minimal .pb-image-cap { padding: 16rpx 60rpx 0 !important; }

/* recipe / faq — quiet olive→mono numerals, lighter weights */
.pb-tpl-quiet_minimal .pb-recipe-step { grid-template-columns: 48rpx 1fr !important; gap: 32rpx !important; border-top: 2rpx solid var(--ink-12) !important; }
.pb-tpl-quiet_minimal .pb-recipe-step:first-of-type { border-top: none !important; }
.pb-tpl-quiet_minimal .pb-recipe-n { font-family: monospace !important; font-size: calc(24rpx * var(--font-scale)) !important; line-height: 1.5 !important; color: var(--pa-accent, var(--olive)) !important; padding-top: 4rpx; }
.pb-tpl-quiet_minimal .pb-faq-item:first-of-type { border-top: none !important; }
.pb-tpl-quiet_minimal .pb-faq-q-txt { font-family: var(--f-aleo) !important; font-size: calc(28rpx * var(--font-scale)) !important; }

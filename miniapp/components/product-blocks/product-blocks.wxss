/* product-blocks — bespoke per-type styling for the block-based product
   page body. The container has no padding of its own; the parent page
   (product.wxss .body) already provides horizontal padding so the slab
   blocks (stat_callout) can bleed full-width when we want them to. */

.pb-wrap {
  display: block;
  width: 100%;
}
.pb {
  display: block;
  margin-top: 48rpx;
}
.pb:first-child { margin-top: 16rpx; }

/* ───────── Hero Intro ─────────
   Big editorial paragraph in serif. Optional lead-in callout sits above,
   styled like a brand-font kicker. Inline highlight spans inside the
   body get an accent color + slight weight bump, drawing the eye to the
   key phrase without breaking the flow. */
.pb-hero-lead {
  display: block;
  font-size: calc(22rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.14em;
  color: var(--olive);
  margin-bottom: 16rpx;
}
.pb-hero-body {
  font-size: calc(30rpx * var(--font-scale));
  line-height: 1.55;
  color: var(--ink);
  /* Preserve manually typed line breaks in the body — same rule as the
     legacy .description, so the editor experience is consistent. */
  white-space: pre-line;
}
.pb-hero-hl {
  color: var(--forest);
  font-weight: 700;
  background: linear-gradient(transparent 60%, rgba(204, 217, 0, 0.55) 60%);
  padding: 0 4rpx;
}

/* ───────── Stat Callout ─────────
   A full-bleed slab. The page body has 44rpx side padding, so we use a
   negative margin to push the slab to the screen edges. The number is
   huge (96rpx → ~46px); the claim is small caps; the sub-line is
   editorial serif. */
.pb-stat-slab {
  margin-left: -44rpx;
  margin-right: -44rpx;
  padding: 52rpx 44rpx;
  background: var(--lime);
  color: var(--ink);
  text-align: center;
}
.pb-stat-num {
  font-size: calc(120rpx * var(--font-scale));
  line-height: 1;
  font-weight: 500;
  letter-spacing: -0.01em;
}
.pb-stat-claim {
  margin-top: 14rpx;
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.16em;
}
.pb-stat-sub {
  margin-top: 14rpx;
  font-size: calc(26rpx * var(--font-scale));
  line-height: 1.45;
  font-style: italic;
}

/* ───────── Allergen Card ─────────
   Bordered card, two segmented sections. CONTAINS gets a strong red-
   border chip; MAY CONTAIN gets a soft tan chip. The ⚠️ + header is the
   first thing the eye lands on. */
.pb-allergen {
  border: 3rpx solid var(--ink);
  background: #FFFCF7;
  padding: 28rpx 28rpx 30rpx;
  box-shadow: 6rpx 6rpx 0 var(--ink);
}
.pb-allergen-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: calc(26rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.14em;
  color: var(--ink);
  margin-bottom: 22rpx;
  padding-bottom: 18rpx;
  border-bottom: 2rpx dashed rgba(26, 26, 23, 0.25);
}
.pb-allergen-emoji {
  font-size: calc(34rpx * var(--font-scale));
  letter-spacing: 0;
}
.pb-allergen-section {
  margin-top: 18rpx;
}
.pb-allergen-section:first-of-type { margin-top: 0; }
.pb-allergen-label {
  font-size: calc(20rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.16em;
  color: var(--olive);
  margin-bottom: 10rpx;
}
.pb-allergen-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.pb-allergen-chip {
  display: inline-block;
  padding: 8rpx 16rpx;
  font-size: calc(22rpx * var(--font-scale));
  font-weight: 600;
  border-radius: 4rpx;
  line-height: 1.3;
}
.pb-allergen-chip-strong {
  background: var(--berry);
  color: #fff;
  border: 2rpx solid var(--berry);
}
.pb-allergen-chip-soft {
  background: var(--oat);
  color: var(--ink);
  border: 2rpx solid rgba(26, 26, 23, 0.18);
}

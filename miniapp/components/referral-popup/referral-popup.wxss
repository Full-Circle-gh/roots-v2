.rp-bg {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(20, 20, 24, .72);
  z-index: 300;
  display: flex; align-items: center; justify-content: center;
  padding: 60rpx 48rpx;
}
.rp-card {
  width: 100%;
  max-width: 640rpx;
  background: var(--oat);
  border-radius: 28rpx;
  overflow: hidden;
  position: relative;
  text-align: center;
  padding: 48rpx 40rpx 40rpx;
  animation: rp-rise 220ms cubic-bezier(.16, 1, .3, 1);
}
@keyframes rp-rise {
  from { opacity: 0; transform: translateY(20rpx) scale(.96); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
.rp-close {
  position: absolute; top: 18rpx; right: 18rpx;
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: rgba(0, 0, 0, .42);
  color: #fff; font-size: calc(36rpx * var(--font-scale)); line-height: 52rpx; text-align: center;
  z-index: 2;
}
.rp-mascot {
  width: 128rpx; height: 128rpx;
  margin: 0 auto 12rpx;
  display: block;
}
.rp-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--ink);
  opacity: .62;
}
.rp-title {
  font-weight: 500;
  font-size: calc(44rpx * var(--font-scale));
  line-height: 1.08;
  color: var(--ink);
  margin-top: 8rpx;
  letter-spacing: -.01em;
}
.rp-sub {
  font-family: var(--f-aleo);
  font-size: calc(24rpx * var(--font-scale));
  line-height: 1.5;
  color: var(--ink);
  opacity: .75;
  margin-top: 12rpx;
}
.rp-bonus {
  display: inline-block;
  margin-top: 20rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--forest);
  color: var(--lime);
  font-family: var(--f-toni);
  font-weight: 600;
  font-size: calc(22rpx * var(--font-scale));
}
.rp-code-row {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  margin-top: 28rpx;
  text-align: left;
}
.rp-code-pill {
  flex: 1;
  min-width: 0;
  background: rgba(0, 0, 0, .06);
  border: 2rpx solid var(--ink);
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.rp-code-lbl {
  display: block;
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: .2em;
  text-transform: uppercase;
  color: var(--ink);
  opacity: .6;
}
.rp-code-val {
  display: block;
  font-family: var(--f-bear);
  font-size: calc(30rpx * var(--font-scale));
  color: var(--ink);
  letter-spacing: -.01em;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.rp-copy {
  flex: 0 0 auto;
  background: var(--ink);
  color: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  font-family: var(--f-gothic);
  font-size: calc(24rpx * var(--font-scale));
  letter-spacing: .1em;
  text-transform: uppercase;
}
.rp-cta {
  width: 100%;
  margin-top: 22rpx;
  background: var(--ink);
  color: var(--lime);
  border-radius: 999rpx;
  padding: 24rpx 0;
  font-family: var(--f-gothic);
  font-size: calc(30rpx * var(--font-scale));
  letter-spacing: .06em;
  text-transform: uppercase;
  line-height: 1.4;
  border: none;
}
.rp-cta::after { border: none; }
.rp-later {
  display: block;
  margin-top: 18rpx;
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  color: var(--ink);
  opacity: .5;
  text-decoration: underline;
}

<!-- Ambient skater-pickle. Nested layers keep the transforms from fighting:
     .mascot    = position/glide        (translate + transition)
     .mascot-face = facing              (scaleX)
     .mascot-bob  = reggae sway         (always-on rotate loop)
     .mascot-img  = breathe / poses     (mood-driven keyframes) -->
<view class="mascot-layer" wx:if="{{show}}">
  <view
    class="mascot"
    style="transform: translate3d({{x}}px, {{-y}}px, 0); transition-duration: {{moveMs}}ms;"
  >
    <view class="mascot-face" style="transform: scaleX({{facing}});">
      <view class="mascot-bob">
        <image class="mascot-img mood-{{mood}}" src="/assets/brand/ip-skater.jpg" mode="widthFix" />
      </view>
    </view>
  </view>
</view>

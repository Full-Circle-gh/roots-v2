<view wx:if="{{mounted}}" class="ls-overlay {{visible ? '' : 'ls-hide'}}">
  <view class="ls-mark">
    <image wx:if="{{logoUrl}}" class="ls-logo" src="{{logoUrl}}" mode="aspectFit"></image>
    <view wx:else class="ls-dots">
      <view class="ls-dot ls-dot--1"></view>
      <view class="ls-dot ls-dot--2"></view>
      <view class="ls-dot ls-dot--3"></view>
    </view>
    <view class="ls-label">{{displayLabel}}</view>
  </view>
</view>

/* Full-screen branded loading state — the tenant's own logo (uploaded in
   /cms → Theme & brand → Loading screen) centred over a plain ground, with
   a small loading label underneath. Falls back to a generic three-dot pulse
   when no logo has been uploaded, so an un-branded tenant still gets a
   proper loading state instead of a blank page. */

.ls-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F2E7DF;
  opacity: 1;
  transition: opacity 260ms ease;
  box-sizing: border-box;
}

/* A custom tab bar (see the `tabbar` property) renders on top of the page as
   its own layer and isn't part of this overlay's box, so centering against
   the full screen height leaves the mark looking low — visually off-centre
   in the space actually free of chrome. This padding shrinks the flex box
   from the bottom by the tab bar's own height (matches --tabbar-clear in
   app.wxss) so the centred content lines up with what the customer sees. */
.ls-has-tabbar {
  padding-bottom: 170rpx;
}

.ls-hide {
  opacity: 0;
  pointer-events: none;
}

.ls-mark {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.ls-logo {
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
}

/* Static logos get a slow breathing pulse so the screen still feels alive.
   An animated GIF already supplies its own motion — layering this on top
   would fight it, so it's applied only to non-GIF uploads (and the
   dot-pulse fallback keeps its own animation regardless). */
.ls-logo-breathe {
  animation: ls-breathe 2.2s ease-in-out infinite;
}

.ls-dots {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 16rpx;
}

.ls-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #365329;
  animation: ls-bounce 1.1s ease-in-out infinite;
}

.ls-dot--2 { animation-delay: .15s; }
.ls-dot--3 { animation-delay: .3s; }

.ls-label {
  /* Tenant's own BODY brand font (--f-aleo) — set globally on `page` in
     app.wxss (base value, or a tenant's own upload via theme.buildThemeVars
     overriding it inline on the page root). Custom-property inheritance
     crosses this component's style isolation boundary same as it does for
     every other themed block in the app, so this always matches whatever
     font the tenant's brand uses for regular text elsewhere — never a font
     hardcoded here. The literal fallback only covers the page root somehow
     not carrying the var at all. */
  font-family: var(--f-aleo, 'Aleo', 'PingFang SC', 'Hiragino Sans GB', -apple-system, sans-serif);
  font-size: 22rpx;
  font-weight: 500;
  color: #6A6E2D;
  letter-spacing: 1rpx;
}

@keyframes ls-bounce {
  0%, 80%, 100% { opacity: .3; transform: scale(.8); }
  40%           { opacity: 1;  transform: scale(1); }
}

@keyframes ls-breathe {
  0%, 100% { opacity: 1; }
  50%      { opacity: .85; }
}

@media (prefers-reduced-motion: reduce) {
  .ls-logo-breathe, .ls-dot { animation: none; }
}

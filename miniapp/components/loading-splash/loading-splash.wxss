/* Full-screen branded loading state — the tenant's own logo (uploaded in
   /cms → Theme & brand → Loading screen) centred over a plain ground, with
   a small loading label underneath. Falls back to a generic three-dot pulse
   when no logo has been uploaded, so an un-branded tenant still gets a
   proper loading state instead of a blank page. */

.ls-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F2E7DF;
  opacity: 1;
  transition: opacity 260ms ease;
}

.ls-hide {
  opacity: 0;
  pointer-events: none;
}

.ls-mark {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.ls-logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  animation: ls-breathe 2.2s ease-in-out infinite;
}

.ls-dots {
  display: flex;
  align-items: center;
  gap: 14rpx;
  height: 16rpx;
}

.ls-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #365329;
  animation: ls-bounce 1.1s ease-in-out infinite;
}

.ls-dot--2 { animation-delay: .15s; }
.ls-dot--3 { animation-delay: .3s; }

.ls-label {
  font-size: 26rpx;
  color: #6A6E2D;
  letter-spacing: 2rpx;
}

@keyframes ls-bounce {
  0%, 80%, 100% { opacity: .3; transform: scale(.8); }
  40%           { opacity: 1;  transform: scale(1); }
}

@keyframes ls-breathe {
  0%, 100% { opacity: 1; }
  50%      { opacity: .85; }
}

@media (prefers-reduced-motion: reduce) {
  .ls-logo, .ls-dot { animation: none; }
}

/* ─── Bundle block ────────────────────────────────────────────────────── */
.bun-blk {
  margin: 0 44rpx;
  padding: 8rpx 0;
}
/* Framed inner card — riso draws an ink border (inline), clean fills + soft
   shadow. Padding/radius come from the energy preset via inline innerCss. */
.bun-inner {
  padding: 32rpx 28rpx;
  margin: 16rpx 0;
}
.bun-kicker {
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--olive);
}
.bun-pills-scroll {
  margin: 20rpx -10rpx 0;
  white-space: nowrap;
}
.bun-pills {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 10rpx;
}
.bun-pill {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border: 2rpx solid;
  border-radius: 999rpx;
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.10em;
  text-transform: uppercase;
  line-height: 1.2;
  background: transparent;
  transition: background 120ms ease, color 120ms ease;
}
.bun-pill.on {
  /* Active styling is driven by inline style (uses block's accent + bg
     vars resolved at render time). This rule just normalises padding. */
}
.bun-pill-star {
  font-size: calc(18rpx * var(--font-scale));
  margin-right: 4rpx;
  color: var(--berry);
}

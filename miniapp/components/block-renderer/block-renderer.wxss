/* ── "Stay in the loop" warm-pop card ────────────────────────────────── */
/* .wc-loop is the outer wrapper; its top padding makes room for the mascot
   that perches over the card's top edge. The visible card is .wc-loop-card. */
.wc-loop {
  position: relative;
  padding-top: 188rpx;
}
.wc-loop-mascot {
  position: absolute;
  right: 20rpx;
  top: 0;
  width: 240rpx;
  height: 204rpx;
  z-index: 3;
  pointer-events: none;
  transform: rotate(3deg);
  filter: drop-shadow(0 6rpx 10rpx rgba(0,0,0,0.18));
}
.wc-loop-card {
  position: relative;
  border: 4rpx solid var(--ink);
  border-radius: 36rpx;
  padding: 40rpx 36rpx 36rpx;
  overflow: hidden;
  box-shadow: 12rpx 14rpx 0 var(--ink);
}
.wc-loop-card.wc-loop-flat {
  box-shadow: none;
}
.wc-loop-card.wc-loop-noframe {
  border: none;
}
.wc-loop-paper {
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  background-image:
    radial-gradient(rgba(0,0,0,.03) 1px, transparent 1.5px),
    radial-gradient(rgba(0,0,0,.022) 1px, transparent 1.5px);
  background-size: 6rpx 6rpx, 14rpx 14rpx;
  background-position: 0 0, 2rpx 4rpx;
}
/* lift content above the paper texture */
.wc-loop-badge,
.wc-loop-title,
.wc-loop-sub,
.wc-loop-props,
.wc-loop-foot { position: relative; z-index: 1; }

.wc-loop-badge {
  display: inline-flex;
  align-items: center;
  align-self: flex-start;
  padding: 8rpx 22rpx;
  border: 3rpx solid var(--ink);
  border-radius: 999rpx;
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.22em;
  text-transform: uppercase;
  line-height: 1;
}
.wc-loop-title {
  margin-top: 22rpx;
  max-width: 62%;
  font-family: var(--f-bear);
  font-size: calc(60rpx * var(--font-scale));
  line-height: 1.0;
  letter-spacing: -0.01em;
}
.wc-loop-sub {
  margin-top: 14rpx;
  max-width: 64%;
  font-family: var(--f-aleo);
  font-size: calc(24rpx * var(--font-scale));
  line-height: 1.45;
  opacity: 0.72;
}
.wc-loop-props {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 28rpx;
}
.wc-loop-chip {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 12rpx 22rpx 12rpx 16rpx;
  border: 3rpx solid var(--ink);
  border-radius: 999rpx;
}
.wc-loop-ico {
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
}
.wc-loop-chip-tx {
  font-family: var(--f-bear);
  font-size: calc(26rpx * var(--font-scale));
  line-height: 1;
  color: var(--ink);
}
.wc-loop-foot {
  display: flex;
  gap: 24rpx;
  margin-top: 34rpx;
  align-items: stretch;
}
.wc-loop-foot-l {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.wc-loop-cta {
  margin: 0;

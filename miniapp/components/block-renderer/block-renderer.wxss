/* Block styles — these match the /storefront preview pixel-for-pixel. */

/* ── Announcement bar ─────────────────────────────────────────────────── */
.announce {
  padding: 20rpx 32rpx;
  font-family: var(--f-toni);
  font-size: calc(24rpx * var(--font-scale));
  font-weight: 600;
  letter-spacing: 0.04em;
  text-align: center;
  overflow: hidden;
}
.announce-linked {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
}
.announce-chev {
  font-size: calc(28rpx * var(--font-scale));
  opacity: 0.75;
  line-height: 1;
}

/* ── Announcement animations ──────────────────────────────────────────── */
/* Marquee — horizontal scroll. Track is 2× the text (padded first copy +
   bare second copy) so translateX(-50%) loops seamlessly. */
.announce.anim-marquee_rtl,
.announce.anim-marquee_ltr { display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.announce .anim-clip { flex: 1; min-width: 0; overflow: hidden; }
.announce .anim-track { display: inline-flex; flex-wrap: nowrap; white-space: nowrap; will-change: transform; }
.announce .anim-track > .announce-text:first-child { padding-right: 96rpx; }
.announce.anim-marquee_rtl .anim-track { animation: a-marquee-rtl var(--anim-dur, 14s) linear infinite; }
.announce.anim-marquee_ltr .anim-track { animation: a-marquee-ltr var(--anim-dur, 14s) linear infinite; }
@keyframes a-marquee-rtl { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@keyframes a-marquee-ltr { from { transform: translateX(-50%); } to { transform: translateX(0); } }

/* Vertical scroll — fixed-height clip with 2 stacked copies. */
.announce.anim-scroll_up,
.announce.anim-scroll_down { padding: 0 32rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.announce .anim-vclip { height: 64rpx; overflow: hidden; }
.announce .anim-vtrack { display: flex; flex-direction: column; align-items: center; line-height: 64rpx; }
.announce.anim-scroll_up .anim-vtrack   { animation: a-scroll-up var(--anim-dur, 14s) linear infinite; }
.announce.anim-scroll_down .anim-vtrack { animation: a-scroll-down var(--anim-dur, 14s) linear infinite; }
@keyframes a-scroll-up   { from { transform: translateY(0); } to { transform: translateY(-50%); } }
@keyframes a-scroll-down { from { transform: translateY(-50%); } to { transform: translateY(0); } }

/* Per-letter — stagger via inline --i */
.announce .letters { display: inline-block; }
.announce .letters .ch { display: inline-block; }
.announce.anim-typewriter .letters .ch {
  opacity: 0;
  animation: a-type-in var(--anim-dur, 6s) infinite;
  animation-delay: calc(var(--i) * var(--step, 0.08s));
}
@keyframes a-type-in { 0%, 100% { opacity: 0; } 8%, 92% { opacity: 1; } }
.announce.anim-fade_in_letters .letters .ch {
  opacity: 0;
  animation: a-fade-in var(--anim-dur, 5s) infinite;
  animation-delay: calc(var(--i) * var(--step, 0.06s));
}
@keyframes a-fade-in { 0%, 100% { opacity: 0; } 25%, 80% { opacity: 1; } }
.announce.anim-wave .letters .ch {
  animation: a-wave var(--anim-dur, 2.2s) ease-in-out infinite;
  animation-delay: calc(var(--i) * var(--step, 0.07s));
}
@keyframes a-wave { 0%, 60%, 100% { transform: translateY(0); } 25% { transform: translateY(-8rpx); } }

/* Flicker — whole-text neon flicker, no per-letter split */
.announce.anim-flicker { animation: a-flicker var(--anim-dur, 2.4s) infinite; }
@keyframes a-flicker {
  0%, 19%, 21%, 23%, 25%, 54%, 56%, 100% { opacity: 1; text-shadow: 0 0 8rpx currentColor; }
  20%, 24%, 55% { opacity: 0.35; text-shadow: none; }
}

/* Speed presets — override --anim-dur (overall) and --step (per-letter delay).
   Per-letter animations want shorter total durations so the cycle doesn't drag. */
.announce.speed-slow   { --anim-dur: 22s; --step: 0.12s; }
.announce.speed-normal { --anim-dur: 14s; --step: 0.08s; }
.announce.speed-fast   { --anim-dur: 8s;  --step: 0.05s; }
.announce.anim-typewriter.speed-slow   { --anim-dur: 9s; }
.announce.anim-typewriter.speed-normal { --anim-dur: 6s; }
.announce.anim-typewriter.speed-fast   { --anim-dur: 3.5s; }
.announce.anim-fade_in_letters.speed-slow   { --anim-dur: 7s; }
.announce.anim-fade_in_letters.speed-normal { --anim-dur: 5s; }
.announce.anim-fade_in_letters.speed-fast   { --anim-dur: 3s; }
.announce.anim-wave.speed-slow   { --anim-dur: 3.4s; }
.announce.anim-wave.speed-normal { --anim-dur: 2.2s; }
.announce.anim-wave.speed-fast   { --anim-dur: 1.3s; }
.announce.anim-flicker.speed-slow   { --anim-dur: 3.6s; }
.announce.anim-flicker.speed-normal { --anim-dur: 2.4s; }
.announce.anim-flicker.speed-fast   { --anim-dur: 1.4s; }

/* ── Hero banner ──────────────────────────────────────────────────────── */
.hero {
  position: relative;
  width: 100%;
  background: linear-gradient(135deg, #c4c4c4, #a8a8a8);
  overflow: hidden;
}
.hero .hero-img { width: 100%; height: 100%; display: block; }
.hero .hero-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  min-height: 400rpx;
  color: rgba(0, 0, 0, 0.3);
  font-size: calc(24rpx * var(--font-scale));
}
.hero .cta-stack {
  position: absolute;
  bottom: 56rpx;
  left: 44rpx;
  right: 44rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.cta-btn {
  padding: 28rpx 0;
  text-align: center;
  font-family: var(--f-toni);
  font-size: calc(24rpx * var(--font-scale));
  font-weight: 600;
  letter-spacing: 0.16em;
  border-radius: 999rpx;
  text-transform: uppercase;
}
.cta-btn.cta-primary {
  background: var(--ink);
  color: var(--oat);
}
.cta-btn.cta-secondary {
  background: rgba(255, 255, 255, 0.92);
  color: var(--ink);
  border: 3rpx solid var(--ink);
}
.cta-btn.cta-link {
  background: transparent;
  color: var(--ink);
  text-decoration: underline;
  padding: 12rpx 0;
  border-radius: 0;
}

/* Hero: split view (image left, copy panel right) */
.hero-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 480rpx;
  height: auto !important;
  aspect-ratio: auto !important;
  position: relative;
}
.hero-split .split-img {
  position: relative;
  overflow: hidden;
  background: #ddd;
}
.hero-split .split-img .hero-img { width: 100%; height: 100%; }
.hero-split .split-img .hero-placeholder {
  display: flex; align-items: center; justify-content: center;
  width: 100%; height: 100%;
  color: rgba(0, 0, 0, 0.3);
  font-family: var(--f-sans);
  font-size: calc(22rpx * var(--font-scale));
}
.hero-split .split-panel {
  padding: 36rpx 32rpx;
  display: flex; flex-direction: column; justify-content: center;
  gap: 12rpx;
}
.hero-split .split-panel .headline {
  font-family: var(--f-bear);
  font-weight: 500;
  font-size: calc(42rpx * var(--font-scale));
  line-height: 1.1;
}
.hero-split .split-panel .subtitle {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  opacity: 0.8;
  line-height: 1.4;
}
.hero-split .split-panel .cta-stack {
  position: static;
  padding: 0;
  margin-top: 16rpx;
  display: flex; flex-direction: column; gap: 12rpx;
}
.hero-split .split-panel .cta-btn {
  padding: 20rpx 28rpx;
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.14em;
  border-radius: 999rpx;
  text-align: center;
}

/* ── Category tabs ────────────────────────────────────────────────────── */
.cattabs { padding: 36rpx 44rpx; }
.cattabs .head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}
.cattabs .kicker {
  font-family: var(--f-toni);
  font-size: calc(18rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.14em;
  color: var(--olive);
}
.cattabs .ttl {
  font-family: var(--f-bear);
  font-size: calc(44rpx * var(--font-scale));
  font-weight: 500;
  line-height: 1.05;
  margin-top: 8rpx;
}
.cattabs .more {
  font-family: var(--f-toni);
  font-size: calc(18rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--olive);
  text-decoration: underline;
}
.cattabs .grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}
.cattabs .tile {
  height: 192rpx;
  padding: 24rpx;
  position: relative;
  overflow: hidden;
  border-radius: 4rpx;
}
.cattabs .tile .num {
  font-family: var(--f-toni);
  font-size: calc(18rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.1em;
  opacity: 0.85;
}
.cattabs .tile .name {
  font-family: var(--f-bear);
  font-size: calc(34rpx * var(--font-scale));
  font-weight: 500;
  line-height: 1;
  position: absolute;
  bottom: 24rpx;
  left: 24rpx;
  right: 24rpx;
}
.cattabs .empty {
  color: rgba(0, 0, 0, 0.3);
  text-align: center;
  padding: 40rpx 0;
  font-size: calc(24rpx * var(--font-scale));
}
/* Icons view — circle + label per category */
.cattabs .icons-grid { display: grid; gap: 28rpx 12rpx; }
.cattabs .icons-grid.icons-cols-3 { grid-template-columns: repeat(3, 1fr); }
.cattabs .icons-grid.icons-cols-4 { grid-template-columns: repeat(4, 1fr); }
.cattabs .icons-grid.icons-cols-5 { grid-template-columns: repeat(5, 1fr); }
.cattabs .icon-tile {
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
}
.cattabs .icon-circle {
  width: 112rpx; height: 112rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--f-bear);
  font-size: calc(44rpx * var(--font-scale));
  font-weight: 700;
}
.cattabs .icon-name {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  text-align: center;
  line-height: 1.2;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* Scroll view — single horizontal row, drag left/right */
.cattabs .scroll-rail { white-space: nowrap; }
.cattabs .scroll-tile {
  display: inline-flex; flex-direction: column; align-items: center; gap: 12rpx;
  width: 140rpx;
  margin-right: 24rpx;
  vertical-align: top;
}
.cattabs .scroll-tile:last-child { margin-right: 0; }
.cattabs .scroll-tile .icon-name { width: 140rpx; }

/* ── Featured item ────────────────────────────────────────────────────── */
/* Three layouts (driven by CMS `view`):
   • card    — square image on top, kicker / name / price stacked below
   • split   — image left, copy right (legacy default)
   • banner  — wide image with copy floated bottom-left on top of it
   Card surface (`background:{...}` inline) + text colour come from
   `card_bg_color` / `card_fg_color`; the outer block bg comes from
   `bg_color` (transparent by default). */
.featured { padding: 36rpx 44rpx; }
.featured .card {
  padding: 36rpx;
  border-radius: 4rpx;
  overflow: hidden;
}
.featured .img { background: rgba(0,0,0,.15); overflow: hidden; border-radius: 4rpx; }
.featured .img-full { width: 100%; height: 100%; }
.featured .meta { min-width: 0; }
.featured .kicker {
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.14em;
  /* Card-fg via inline style; fall back to lime if unspecified */
}
.featured .name {
  font-family: var(--f-bear);
  font-size: calc(40rpx * var(--font-scale));
  font-weight: 500;
  line-height: 1.05;
  margin-top: 8rpx;
}
.featured .price {
  font-family: var(--f-gothic);
  font-size: calc(36rpx * var(--font-scale));
  font-weight: 600;
  letter-spacing: 0.04em;
}
.featured .price.is-flash { color: #FF8FA1; }
.featured .price-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 12rpx;
}
.featured .price-was {
  font-family: var(--f-aleo);
  font-size: calc(24rpx * var(--font-scale));
  text-decoration: line-through;
}
.featured .empty {
  color: rgba(0, 0, 0, 0.3);
  text-align: center;
  padding: 40rpx 0;
  font-size: calc(24rpx * var(--font-scale));
}

/* CARD view — image on top, copy below. */
.featured-view-card .card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.featured-view-card .img { width: 100%; height: 420rpx; }
.featured-view-card .meta { width: 100%; }

/* SPLIT view (legacy default) — image left, copy right. */
.featured-view-split .card {
  display: flex;
  gap: 32rpx;
  align-items: center;
}
.featured-view-split .img {
  width: 168rpx;
  height: 208rpx;
  flex-shrink: 0;
}
.featured-view-split .meta { flex: 1; }

/* BANNER view — wide image with copy floated bottom-left as an overlay. */
.featured-view-banner .card {
  position: relative;
  padding: 0;
  min-height: 360rpx;
}
.featured-view-banner .img {
  width: 100%;
  height: 360rpx;
  border-radius: 4rpx;
}
.featured-view-banner .meta {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 28rpx;
  padding: 18rpx 22rpx;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 4rpx;
  backdrop-filter: blur(8rpx);
}

/* ── Product grid ─────────────────────────────────────────────────────── */
.grid-block { padding: 36rpx 44rpx; }
.grid-block .head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}
.grid-block .kicker {
  font-family: var(--f-toni);
  font-size: calc(18rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.14em;
  color: var(--olive);
}
.grid-block .ttl {
  font-family: var(--f-bear);
  font-size: calc(44rpx * var(--font-scale));
  font-weight: 500;
  line-height: 1.05;
  margin-top: 8rpx;
}
.grid-block .more {
  font-family: var(--f-toni);
  font-size: calc(18rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--olive);
  text-decoration: underline;
}
.grid-block .grid { display: grid; gap: 24rpx; }
.grid-block .cols-1 { grid-template-columns: 1fr; }
.grid-block .cols-2 { grid-template-columns: 1fr 1fr; }
.grid-block .cols-3 { grid-template-columns: 1fr 1fr 1fr; }
.grid-block .card .img {
  width: 100%;
  aspect-ratio: 4 / 5;
  background: #ddd;
  overflow: hidden;
  border-radius: 4rpx;
}
.grid-block .card .img-full { width: 100%; height: 100%; }
.grid-block .card .name {
  font-family: var(--f-bear);
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 500;
  margin-top: 16rpx;
  line-height: 1.15;
}
.grid-block .card .price {
  font-family: var(--f-gothic);
  font-size: calc(26rpx * var(--font-scale));
  font-weight: 600;
  color: var(--olive);
  letter-spacing: 0.04em;
}
.grid-block .card .price.is-flash { color: #E96174; }
.grid-block .card .price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 4rpx;
}
.grid-block .card .price-was {
  font-family: var(--f-aleo);
  font-size: calc(20rpx * var(--font-scale));
  color: rgba(0, 0, 0, 0.4);
  text-decoration: line-through;
}
.grid-block .card .img { position: relative; }
.grid-block .card .grid-flash-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  background: #E96174;
  color: #fff;
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.12em;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

/* Rank badges — "NO. 01" style chip in the top-left of the product image.
   Tier 1 is the eye-catching lime so #1 reads as the headline of the
   block; 2/3 use warm brand colours; 4+ fall back to ink so the medal
   positions stay dominant. Applies to grid + scroll + list views. */
.grid-block .card .rank-badge,
.grid-block .rail-card .rank-badge,
.grid-block .list-row .rank-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.14em;
  padding: 6rpx 14rpx;
  border-radius: 4rpx;
  text-transform: uppercase;
  z-index: 2;
}
/* Gold / silver / bronze gradients lean into the medal metaphor — the
   eye reads "top 3" before reading the number. The hard offset shadow
   on #1 lifts it off the photo like a sticker. */
.rank-1 {
  background: linear-gradient(135deg, #FFE066 0%, #FFC72C 45%, #B8860B 100%);
  color: #1a1a17;
  box-shadow: 3rpx 3rpx 0 rgba(0, 0, 0, 0.85);
  border: 1rpx solid rgba(184, 134, 11, 0.6);
}
.rank-2 {
  background: linear-gradient(135deg, #F4F4F4 0%, #C8C8C8 50%, #8C8C8C 100%);
  color: #1a1a17;
  box-shadow: 2rpx 2rpx 0 rgba(0, 0, 0, 0.5);
  border: 1rpx solid rgba(120, 120, 120, 0.55);
}
.rank-3 {
  background: linear-gradient(135deg, #E1A878 0%, #C57F4E 50%, #8A4B22 100%);
  color: #fff;
  box-shadow: 2rpx 2rpx 0 rgba(0, 0, 0, 0.5);
  border: 1rpx solid rgba(138, 75, 34, 0.6);
}
.rank-n {
  background: #1a1a17;
  color: #F2E7DF;
}
/* List view's rank badge sits over a smaller square image — shrink it a
   touch so it doesn't crowd the thumbnail. */
.grid-block .list-row .rank-badge {
  font-size: calc(16rpx * var(--font-scale));
  padding: 4rpx 10rpx;
  letter-spacing: 0.1em;
}

/* Social proof — "420 SOLD" sits below the price on top-selling cards.
   Quiet styling so the rank badge + price stay primary; the number is
   the value here, not the typography. */
.grid-block .card .sold-caption,
.grid-block .rail-card .sold-caption,
.grid-block .list-row .sold-caption {
  margin-top: 6rpx;
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.12em;
  color: var(--olive);
  text-transform: uppercase;
}

/* Make the #1 product card itself feel a bit more premium with a hair-
   thin gold rule along the bottom of the image. Subtle — the badge is
   doing the heavy lifting visually. */
.grid-block .rank-card-1 .img {
  box-shadow: inset 0 -3rpx 0 #FFC72C;
}
.grid-block .empty {
  color: rgba(0, 0, 0, 0.3);
  text-align: center;
  padding: 40rpx 0;
  font-size: calc(24rpx * var(--font-scale));
}
/* Scroll view — horizontal rail of cards. Each card fixed-width so the
   rail doesn't squish further-down items as it grows. */
.grid-block .scroll-rail { white-space: nowrap; }
.grid-block .rail-card {
  display: inline-block;
  vertical-align: top;
  width: 260rpx;
  margin-right: 20rpx;
  white-space: normal;
}
.grid-block .rail-card .img {
  width: 100%; aspect-ratio: 4 / 5;
  background: #ddd; overflow: hidden; border-radius: 4rpx;
  position: relative;
}
.grid-block .rail-card .img .img-full { width: 100%; height: 100%; }
.grid-block .rail-card .name {
  font-family: var(--f-bear);
  font-size: calc(26rpx * var(--font-scale));
  font-weight: 500;
  margin-top: 14rpx;
  line-height: 1.15;
}
.grid-block .rail-card .price {
  font-family: var(--f-gothic);
  font-size: calc(24rpx * var(--font-scale));
  font-weight: 600;
  color: var(--olive);
  letter-spacing: 0.04em;
}
.grid-block .rail-card .price.is-flash { color: #E96174; }
.grid-block .rail-card .price-row {
  display: flex; align-items: baseline; gap: 12rpx; margin-top: 4rpx;
}
.grid-block .rail-card .price-was {
  font-family: var(--f-aleo);
  font-size: calc(20rpx * var(--font-scale));
  color: rgba(0, 0, 0, 0.4);
  text-decoration: line-through;
}

/* List view — single column, image left, tagline + price on the right */
.grid-block .list-rows { display: flex; flex-direction: column; gap: 32rpx; }
.grid-block .list-row { display: flex; gap: 24rpx; align-items: flex-start; }
.grid-block .list-row .img {
  flex: 0 0 200rpx; width: 200rpx; aspect-ratio: 1;
  background: #ddd; overflow: hidden; border-radius: 8rpx;
  position: relative;
}
.grid-block .list-row .img .img-full { width: 100%; height: 100%; }
.grid-block .list-row .meta { flex: 1; min-width: 0; }
.grid-block .list-row .name {
  font-family: var(--f-bear);
  font-size: calc(30rpx * var(--font-scale));
  font-weight: 500;
  line-height: 1.15;
}
.grid-block .list-row .tagline {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  color: rgba(0, 0, 0, 0.55);
  margin-top: 6rpx;
  line-height: 1.35;
}
.grid-block .list-row .price {
  font-family: var(--f-gothic);
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 600;
  color: var(--olive);
}
.grid-block .list-row .price.is-flash { color: #E96174; }
.grid-block .list-row .price-row {
  display: flex; align-items: baseline; gap: 12rpx; margin-top: 12rpx;
}
.grid-block .list-row .price-was {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  color: rgba(0, 0, 0, 0.4);
  text-decoration: line-through;
}

/* ── Sticker collage ──────────────────────────────────────────────────── */
.stickers {
  padding: 44rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  justify-content: center;
  align-items: center;
  min-height: 160rpx;
}
.sticker {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  color: var(--ink);
  font-family: var(--f-toni);
  font-size: calc(24rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  box-shadow: 4rpx 4rpx 0 rgba(0, 0, 0, 0.85);
  white-space: nowrap;
}

/* ── Progress dots ────────────────────────────────────────────────────── */
.dots {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx;
}
.dots .dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 999rpx;
  background: transparent;
  border: 3rpx solid rgba(0, 0, 0, 0.35);
  transition: all 0.15s ease;
}
.dots .dot.active {
  width: 48rpx;
  border-color: transparent;
}

/* ── Countdown timer (flash-sale / 秒杀) ─────────────────────────────── */
.countdown {
  padding: 40rpx 44rpx 44rpx;
  text-align: center;
}
.cd-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.18em;
  opacity: 0.75;
  text-transform: uppercase;
}
.cd-title {
  font-family: var(--f-bear);
  font-weight: 500;
  font-size: calc(36rpx * var(--font-scale));
  line-height: 1.15;
  margin-top: 8rpx;
}
.cd-clock {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 24rpx;
}
.cd-cell {
  min-width: 96rpx;
  padding: 16rpx 8rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 12rpx;
}
.cd-num {
  font-family: var(--f-gothic);
  font-weight: 700;
  font-size: calc(44rpx * var(--font-scale));
  letter-spacing: 0.04em;
  line-height: 1;
}
.cd-lbl {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.14em;
  margin-top: 8rpx;
  opacity: 0.7;
}
.cd-sep {
  font-family: var(--f-gothic);
  font-weight: 700;
  font-size: calc(44rpx * var(--font-scale));
  line-height: 1;
  padding-top: 16rpx;
  opacity: 0.55;
}
.cd-cta {
  display: inline-block;
  margin-top: 28rpx;
  padding: 18rpx 44rpx;
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.16em;
  background: rgba(255, 255, 255, 0.92);
  color: #1a1a17;
  border-radius: 999rpx;
}
.cd-ended {
  margin-top: 32rpx;
  font-family: var(--f-aleo);
  font-size: calc(26rpx * var(--font-scale));
  opacity: 0.8;
}

/* ── Flash sale strip (秒杀) ──────────────────────────────────────────── */
.flash-strip {
  padding: 32rpx 36rpx 36rpx;
}
.fs-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 28rpx;
}
.fs-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.18em;
  opacity: 0.85;
  text-transform: uppercase;
}
.fs-title {
  font-family: var(--f-bear);
  font-weight: 500;
  font-size: calc(40rpx * var(--font-scale));
  line-height: 1.0;
  padding-top: 4rpx;
  margin-top: 4rpx;
}
.fs-clock {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.fs-clock-lbl {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.14em;
  opacity: 0.8;
}
.fs-clock-cells {
  display: inline-flex;
  align-items: center;
}
.fs-ct-num {
  display: inline-block;
  background: rgba(0, 0, 0, 0.35);
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  font-family: var(--f-gothic);
  font-weight: 700;
  font-size: calc(28rpx * var(--font-scale));
  letter-spacing: 0.04em;
  min-width: 52rpx;
  text-align: center;
}
.fs-ct-sep {
  padding: 0 6rpx;
  font-family: var(--f-gothic);
  font-weight: 700;
  font-size: calc(28rpx * var(--font-scale));
  opacity: 0.65;
}
.fs-cards {
  margin-top: 28rpx;
  white-space: nowrap;
  width: 100%;
}
.fs-card {
  display: inline-block;
  vertical-align: top;
  width: 260rpx;
  margin-right: 20rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #1a1a17;
  border-radius: 12rpx;
  overflow: hidden;
  white-space: normal;
}
.fs-card-img {
  position: relative;
  width: 100%;
  height: 260rpx;
  background: #eee;
  overflow: hidden;
}
.fs-card-img .img-full {
  width: 100%;
  height: 100%;
}
.fs-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: #1a1a17;
  color: #CCD900;
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.04em;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.fs-card-meta {
  padding: 16rpx 20rpx 20rpx;
}
.fs-card-name {
  font-family: var(--f-bear);
  font-weight: 500;
  font-size: calc(24rpx * var(--font-scale));
  line-height: 1.2;
  height: 60rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.fs-card-prices {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}
.fs-price-now {
  font-family: var(--f-gothic);
  font-weight: 700;
  font-size: calc(30rpx * var(--font-scale));
  letter-spacing: 0.03em;
  color: #E96174;
}
.fs-price-was {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  color: rgba(0, 0, 0, 0.4);
  text-decoration: line-through;
}
.fs-meter {
  margin-top: 12rpx;
  height: 8rpx;
  background: rgba(0, 0, 0, 0.08);
  border-radius: 999rpx;
  overflow: hidden;
}
.fs-meter-bar {
  height: 100%;
  background: #E96174;
  border-radius: inherit;
  transition: width 0.3s ease;
}
.fs-meter-lbl {
  margin-top: 8rpx;
  font-family: var(--f-toni);
  font-weight: 500;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.06em;
  color: rgba(0, 0, 0, 0.55);
}
.fs-empty {
  margin-top: 24rpx;
  padding: 36rpx 0;
  text-align: center;
  font-family: var(--f-aleo);
  font-size: calc(24rpx * var(--font-scale));
  opacity: 0.85;
}

/* ── Flash sale: hero / banner views ─────────────────────────────────── */
.flash-hero {
  padding: 48rpx 44rpx 56rpx;
  text-align: center;
}
.flash-banner { padding-bottom: 48rpx; }
.fh-kicker {
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.18em;
  opacity: 0.85;
  text-transform: uppercase;
}
.fh-title {
  font-family: var(--f-bear); font-weight: 500;
  font-size: calc(44rpx * var(--font-scale));
  line-height: 1.0;
  padding-top: 4rpx;
  margin-top: 6rpx;
}
.fh-ends {
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.18em;
  opacity: 0.7;
  margin-top: 28rpx;
}
.fh-clock {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 16rpx;
}
.fh-cell {
  min-width: 104rpx;
  padding: 20rpx 8rpx;
  background: rgba(0, 0, 0, 0.35);
  border-radius: 12rpx;
}
.fh-num {
  font-family: var(--f-gothic); font-weight: 700;
  font-size: calc(52rpx * var(--font-scale));
  letter-spacing: 0.04em;
  line-height: 1;
}
.fh-lbl {
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.14em;
  margin-top: 8rpx;
  opacity: 0.75;
}
.fh-sep {
  font-family: var(--f-gothic); font-weight: 700;
  font-size: calc(52rpx * var(--font-scale));
  line-height: 1;
  padding-top: 20rpx;
  opacity: 0.55;
}
.fh-cta {
  display: inline-block;
  margin-top: 32rpx;
  padding: 20rpx 48rpx;
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.16em;
  background: rgba(255, 255, 255, 0.92);
  color: #1a1a17;
  border-radius: 999rpx;
}
.fh-cards { margin-top: 36rpx; text-align: left; }

/* ── Coupon block ─────────────────────────────────────────────────────── */
.coupon-blk {
  margin: 28rpx 36rpx;
  padding: 32rpx 36rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  position: relative;
  overflow: hidden;
}
.coupon-blk::before, .coupon-blk::after {
  content: '';
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #F2E7DF;
}
.coupon-blk::before { left: -14rpx; }
.coupon-blk::after  { right: -14rpx; }
.cp-disc {
  flex: 0 0 auto;
  min-width: 140rpx;
  text-align: center;
  padding-right: 28rpx;
  border-right: 1rpx dashed currentColor;
}
.cp-big {
  font-family: var(--f-gothic);
  font-weight: 700;
  font-size: calc(56rpx * var(--font-scale));
  letter-spacing: 0.04em;
  line-height: 1;
}
.cp-body { flex: 1; min-width: 0; }
.cp-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.14em;
  opacity: 0.8;
}
.cp-title {
  font-family: var(--f-bear);
  font-weight: 500;
  font-size: calc(30rpx * var(--font-scale));
  line-height: 1.15;
  margin-top: 6rpx;
}
.cp-sub {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  margin-top: 8rpx;
  opacity: 0.8;
}
.cp-code {
  margin-top: 14rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 16rpx;
  border: 1rpx dashed currentColor;
  border-radius: 6rpx;
}
.cp-code-label {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.14em;
  opacity: 0.65;
}
.cp-code-val {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.1em;
}
.cp-code-copy {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.12em;
  opacity: 0.6;
}
.cp-cta {
  flex: 0 0 auto;
  align-self: stretch;
  display: inline-flex;
  align-items: center;
  padding: 0 24rpx;
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.14em;
  background: rgba(255, 255, 255, 0.92);
  color: #1a1a17;
  border-radius: 8rpx;
}

/* ── Points widget ────────────────────────────────────────────────────── */
.points-blk {
  padding: 40rpx 36rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
}
.pt-star {
  flex: 0 0 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}
.pt-star-glyph {
  font-family: var(--f-gothic);
  font-weight: 700;
  font-size: calc(56rpx * var(--font-scale));
  line-height: 1;
}
.pt-body { flex: 1; min-width: 0; }
.pt-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.14em;
  opacity: 0.85;
}
.pt-title {
  font-family: var(--f-bear);
  font-weight: 500;
  font-size: calc(32rpx * var(--font-scale));
  line-height: 1.15;
  margin-top: 4rpx;
}
.pt-sub {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  margin-top: 8rpx;
  opacity: 0.85;
}
.pt-cta {
  flex: 0 0 auto;
  padding: 14rpx 28rpx;
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.14em;
  background: rgba(255, 255, 255, 0.92);
  color: #1a1a17;
  border-radius: 999rpx;
}

/* ── Review card / carousel ───────────────────────────────────────────── */
.review-blk {
  padding: 44rpx 44rpx 40rpx;
}
.rv-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.18em;
  opacity: 0.75;
  text-align: center;
  margin-bottom: 16rpx;
}
.rv-item { text-align: center; }
.rv-stars {
  display: flex;
  justify-content: center;
  gap: 4rpx;
}
.rv-star {
  font-size: calc(32rpx * var(--font-scale));
  letter-spacing: 0.04em;
}
.rv-star.on  { color: #F2CA6C; }
.rv-star.off { color: rgba(0, 0, 0, 0.15); }
.rv-quote {
  font-family: var(--f-bear);
  font-weight: 500;
  font-size: calc(30rpx * var(--font-scale));
  line-height: 1.4;
  margin-top: 20rpx;
}
.rv-byline {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.rv-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-family: var(--f-bear);
  font-weight: 700;
  font-size: calc(28rpx * var(--font-scale));
  color: rgba(0, 0, 0, 0.5);
}
.rv-avatar-img { width: 100%; height: 100%; }
.rv-byline-text {
  font-family: var(--f-aleo);
  text-align: left;
}
.rv-name {
  font-weight: 700;
  font-size: calc(24rpx * var(--font-scale));
}
.rv-sub {
  opacity: 0.65;
  font-size: calc(20rpx * var(--font-scale));
  margin-top: 4rpx;
  letter-spacing: 0.04em;
}
/* Carousel — uses <swiper>, which sizes its own height. Give the
   swiper itself a min-height so short reviews don't collapse. */
.review-carousel .rv-swiper {
  width: 100%;
  min-height: 360rpx;
  height: 360rpx;
}

/* ── Store info ───────────────────────────────────────────────────────── */
.store-blk {
  margin: 28rpx 36rpx;
  padding: 36rpx 36rpx 40rpx;
  border-radius: 12rpx;
}
.st-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.14em;
  opacity: 0.8;
}
.st-title {
  font-family: var(--f-bear);
  font-weight: 500;
  font-size: calc(34rpx * var(--font-scale));
  line-height: 1.15;
  margin-top: 10rpx;
}
.st-row {
  margin-top: 18rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.st-icon {
  font-size: calc(24rpx * var(--font-scale));
  line-height: 1.4;
  opacity: 0.85;
}
.st-val {
  flex: 1;
  font-family: var(--f-aleo);
  font-size: calc(24rpx * var(--font-scale));
  line-height: 1.4;
}
.st-phone {
  text-decoration: underline;
}
.st-cta {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 28rpx;
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.14em;
  background: rgba(255, 255, 255, 0.92);
  color: #1a1a17;
  border-radius: 8rpx;
}
.st-cards { display: flex; flex-direction: column; }
.st-card + .st-card {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
}
.st-status {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
}
.st-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.25);
}
.st-status-lbl { font-weight: 600; }
.st-hours { opacity: 0.7; }
.st-eta {
  margin-top: 6rpx;
  font-family: var(--f-aleo);
  font-size: calc(20rpx * var(--font-scale));
  opacity: 0.8;
}

/* ── Voting block — 4 views (teaser/peek/inline/past_result) ───────────── */

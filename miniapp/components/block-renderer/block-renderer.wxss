.bun-title {
  font-family: var(--f-bear);
  font-size: calc(48rpx * var(--font-scale));
  /* f-bear glyphs + CJK fill the full em box; line-height 1 clips the top
     of 囤 etc. */
  line-height: 1.12;
  padding-top: 8rpx;
  margin-top: 8rpx;
}
.bun-sub {
  font-family: var(--f-aleo);
  font-size: calc(24rpx * var(--font-scale));
  color: var(--olive);
  margin-top: 10rpx;
}
.bun-empty {
  margin-top: 16rpx;
  padding: 22rpx;
  border: 2rpx dashed var(--ink);
  font-family: var(--f-toni);
  font-size: calc(22rpx * var(--font-scale));
  color: var(--olive);
  text-align: center;
}
.bun-cards {
  margin: 22rpx -10rpx 0;
  white-space: nowrap;
}
.bun-card-row {
  display: inline-flex;
  align-items: flex-start;          /* top-align so images line up evenly */
  gap: 14rpx;
  padding: 0 10rpx;
}
.bun-card {
  width: 180rpx;
  flex-shrink: 0;
  white-space: normal;
}
.bun-card-img {
  width: 180rpx; aspect-ratio: 1 / 1;
  background: rgba(0,0,0,0.08);
  border: 2rpx solid var(--ink);
  overflow: hidden;
}
.bun-card-img .img-full { width: 100%; height: 100%; display: block; }
.bun-card-name {
  margin-top: 10rpx;
  font-family: var(--f-bear);
  font-size: calc(22rpx * var(--font-scale));
  line-height: 1.2;
  min-height: 2.4em;                /* reserve 2 lines so short names keep row aligned */
  overflow: hidden;

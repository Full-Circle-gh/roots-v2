/* ── Order tracker ───────────────────────────────────────────────────── */
.ot-wrap { padding: 0 44rpx; }
.ot-card {
  background: #fff;
  border: 3rpx solid var(--ink, #1a1a17);
  border-radius: 12rpx;
  padding: 28rpx 28rpx 24rpx;
}
.ot-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.ot-title {
  font-family: var(--f-bear);
  font-size: calc(30rpx * var(--font-scale));
  font-weight: 600;
}
.ot-status {
  flex: 0 0 auto;
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--oat, #F2E7DF);
  background: var(--forest, #365329);
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}
.ot-status.unpaid { background: #E96174; color: #fff; }
.ot-body { display: flex; align-items: center; gap: 20rpx; margin-top: 22rpx; }
.ot-thumb {
  flex: 0 0 96rpx; width: 96rpx; height: 96rpx;
  border-radius: 14rpx; background: #eee; overflow: hidden;
}
.ot-info { flex: 1; min-width: 0; }
.ot-no {
  font-family: var(--f-gothic);
  font-size: calc(26rpx * var(--font-scale));
  font-weight: 600;
}
.ot-sub {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  color: rgba(0, 0, 0, 0.55);
  margin-top: 4rpx;
}
.ot-cta {
  flex: 0 0 auto;
  color: #fff;
  font-family: var(--f-gothic);
  font-size: calc(24rpx * var(--font-scale));
  font-weight: 700;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}
/* Icon-node tracker. Colour encodes progress: done/current nodes get a
   candy fill (set inline from step.candy) + charcoal ring + charcoal glyph;
   upcoming nodes stay grey. The connector bar leading into a filled node
   turns brand-green, so the fill runs from the first node up to the current
   one. The current node also gets a pulsing green ring. */
.ot-track {
  display: flex; justify-content: space-between;
  margin-top: 26rpx; padding-top: 26rpx;
  border-top: 2rpx solid rgba(0, 0, 0, 0.08);
}
.ot-node {
  flex: 1; position: relative;
  display: flex; flex-direction: column; align-items: center; gap: 14rpx;
}
.ot-bar {
  position: absolute; top: 43rpx; left: -50%; width: 100%; height: 6rpx;
  background: #D3D1C7; border-radius: 999rpx; z-index: 0;
}
.ot-bar.on { background: var(--forest, #365329); }
.ot-circle {
  position: relative; z-index: 1;
  width: 92rpx; height: 92rpx; border-radius: 999rpx;
  background: #D3D1C7; border: 2rpx solid #9A988E;
  display: flex; align-items: center; justify-content: center;
}
.ot-node.filled .ot-circle { border-color: var(--ink, #1a1a17); }
.ot-ic { width: 46rpx; height: 46rpx; opacity: 0.38; }
.ot-node.filled .ot-ic { opacity: 1; }
/* Pulsing tea-green ring on the current node only. */
.ot-node.current .ot-circle::after {
  content: ''; position: absolute;
  top: -10rpx; left: -10rpx; right: -10rpx; bottom: -10rpx;
  border-radius: 999rpx; border: 4rpx solid var(--forest, #365329);
  animation: ot-pulse 1.6s ease-out infinite;
}
@keyframes ot-pulse {
  0%   { transform: scale(0.92); opacity: 0.9; }
  70%  { transform: scale(1.12); opacity: 0; }
  100% { transform: scale(1.12); opacity: 0; }
}
.ot-node-label {
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
  color: #9A988E;
}
.ot-node.filled .ot-node-label { color: var(--ink, #1a1a17); }


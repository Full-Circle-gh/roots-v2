}
.voting-blk .vb-cta {
  margin-top: 22rpx;
  display: inline-block;
  padding: 16rpx 28rpx;
  background: var(--ink); color: #fff;
  font-family: var(--f-gothic); font-weight: 700;
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.12em;
  border-radius: 999rpx;
  text-transform: uppercase;
}
.voting-blk .vb-cta-pill {
  margin-top: 0;
  flex-shrink: 0;
  padding: 18rpx 28rpx;
}
.voting-blk .vb-stub {
  font-family: var(--f-aleo); font-style: italic;
  font-size: calc(22rpx * var(--font-scale));
  color: var(--olive); text-align: center;
  padding: 20rpx 0;
}

/* Inline view — A/B/C/D options + cast button */
.voting-blk .vb-opts {
  margin-top: 22rpx;
  display: flex; flex-direction: column; gap: 12rpx;
}
.voting-blk .vb-opt {
  position: relative;
  border: 3rpx solid rgba(0, 0, 0, 0.4);
  padding: 18rpx 22rpx;
  overflow: hidden;
  border-radius: 4rpx;
}
.voting-blk .vb-opt.on,
.voting-blk .vb-opt.opt-results { border-color: var(--ink); }
.voting-blk .vb-opt-fill {
  position: absolute; left: 0; top: 0; bottom: 0;
  background: rgba(204, 217, 0, 0.25);
  transition: width 0.4s ease;
  z-index: 0;
}
.voting-blk .vb-opt-fill.fill-mine { background: var(--lime); }
.voting-blk .vb-opt-row {
  position: relative; z-index: 1;
  display: flex; align-items: center; gap: 20rpx;
}
.voting-blk .vb-opt-letter {
  width: 50rpx; height: 50rpx; border-radius: 50%;
  border: 3rpx solid var(--ink);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--f-gothic); font-weight: 700;
  font-size: calc(24rpx * var(--font-scale));
  flex-shrink: 0;
}
.voting-blk .vb-opt-letter.on {
  background: var(--ink); color: var(--lime);
}
.voting-blk .vb-opt-label {
  flex: 1; min-width: 0;
  font-family: var(--f-bear); font-weight: 500;
  font-size: calc(28rpx * var(--font-scale));
  line-height: 1;
}
.voting-blk .vb-opt-tick {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  border: 3rpx solid var(--ink);
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--f-bear); font-size: calc(22rpx * var(--font-scale));
}
.voting-blk .vb-opt-tick.on {
  background: var(--lime);
}
.voting-blk .vb-opt-pct {
  text-align: right; flex-shrink: 0;
}
.voting-blk .vb-opt-pct-num {
  font-family: var(--f-gothic); font-weight: 700;
  font-size: calc(30rpx * var(--font-scale)); line-height: 1;
}
.voting-blk .vb-opt-pct-lbl {
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(14rpx * var(--font-scale));
  letter-spacing: 0.1em; opacity: 0.7;
  margin-top: 4rpx;
}
.voting-blk .vb-voted {
  margin-top: 22rpx;
  display: flex; align-items: center; gap: 14rpx;
  padding: 18rpx 22rpx;
  border: 3rpx solid var(--ink);
}
.voting-blk .vb-voted-dot {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: var(--ink);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--f-bear); font-size: calc(22rpx * var(--font-scale));
  flex-shrink: 0;
}
.voting-blk .vb-voted-text {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
}
.voting-blk.voting-inline .vb-cta {
  display: block;
  width: 100%; box-sizing: border-box;
  text-align: center;
  margin-top: 22rpx;
  background: rgba(0, 0, 0, 0.08);
  color: var(--olive);
  border-radius: 0;
}
.voting-blk.voting-inline .vb-cta.on {
  background: var(--ink);
  color: var(--lime);
}
.voting-blk .vb-foot {
  margin-top: 14rpx;
  text-align: center;
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.15em; opacity: 0.6;
}

/* Past-result view — winner card */
.voting-blk .vb-winner {
  margin-top: 16rpx;
  display: flex; align-items: center; gap: 16rpx;
}
.voting-blk .vb-winner-label {
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.16em;
  color: var(--olive);
}
.voting-blk .vb-winner-name {
  font-family: var(--f-bear); font-weight: 500;
  font-size: calc(26rpx * var(--font-scale));
  padding: 6rpx 16rpx;
  border: 3rpx solid var(--ink);
  border-radius: 4rpx;
}
.voting-blk .vb-winner-meta {
  margin-left: auto;
  font-family: var(--f-aleo);
  font-size: calc(20rpx * var(--font-scale));
  color: var(--olive);
}

/* ─── Affiliate block ─────────────────────────────────────────── */
.aff-blk {
  margin: 28rpx 36rpx;
  padding: 32rpx 32rpx 28rpx;
  border: 3rpx solid var(--ink);
  border-radius: 8rpx;
}
.aff-head { margin-bottom: 22rpx; }
.aff-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.22em;
  opacity: 0.7;
}
.aff-title {
  font-family: var(--f-bear);
  font-weight: 500;
  font-size: calc(40rpx * var(--font-scale));
  line-height: 1.0;
  padding-top: 4rpx;
  margin-top: 6rpx;
  letter-spacing: -0.01em;
  margin-top: 6rpx;
}
.aff-sub {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  line-height: 1.4;
  margin-top: 12rpx;
  opacity: 0.85;
}
.aff-code-row {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
}
.aff-code-pill {
  flex: 1;
  background: rgba(0,0,0,0.08);
  border: 2rpx solid var(--ink);
  padding: 14rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}
.aff-code-lbl {
  display: block;
  font-family: var(--f-toni);
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.22em;
  opacity: 0.7;
}
.aff-code-val {
  display: block;
  font-family: var(--f-bear);
  font-size: calc(34rpx * var(--font-scale));
  line-height: 1;
  letter-spacing: -0.01em;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.aff-copy {
  background: var(--ink);
  color: #fff;
  padding: 0 24rpx;
  font-family: var(--f-gothic);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.12em;
  display: flex;
  align-items: center;
  text-transform: uppercase;
}
.aff-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
}
.aff-share {
  flex: 0 0 auto;
  background: #1AAD19;
  color: #fff;
  font-family: var(--f-gothic);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.12em;
  padding: 12rpx 26rpx;
  border: 2rpx solid var(--ink);
  border-radius: 0;
  line-height: 1.4;
  text-transform: uppercase;
}
.aff-share::after { border: none; }
.aff-stats {
  flex: 1;
  font-family: var(--f-toni);
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.08em;
  opacity: 0.7;
  text-align: right;
}
.aff-signin {
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.12em;
  padding: 16rpx 20rpx;
  background: rgba(0,0,0,0.08);
  border: 2rpx dashed var(--ink);
  text-align: center;
}
.aff-disabled {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  padding: 18rpx 20rpx;
  border: 2rpx dashed var(--ink);
  text-align: center;
  opacity: 0.7;
}

/* ─── Affiliate · STRIP view (compact horizontal) ─── */
.aff-strip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
}
.aff-strip-left { flex: 1; min-width: 0; }
.aff-strip-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.22em;
  opacity: 0.7;
}
.aff-strip-code-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 4rpx;
  min-width: 0;
}
.aff-strip-code {
  font-family: var(--f-bear);
  font-size: calc(30rpx * var(--font-scale));
  line-height: 1;
  letter-spacing: -0.01em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.aff-strip-stats {
  font-family: var(--f-toni);
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.08em;
  opacity: 0.6;
  white-space: nowrap;
}
.aff-strip-copy,
.aff-strip-share,
.aff-strip-cta {
  flex: 0 0 auto;
  background: var(--ink);
  color: #fff;
  padding: 12rpx 18rpx;
  font-family: var(--f-gothic);
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.1em;
  border: none;
  border-radius: 0;
  line-height: 1.2;
  text-transform: uppercase;
}
.aff-strip-share { background: #1AAD19; }
.aff-strip-share::after { border: none; }
.aff-strip-disabled {
  font-family: var(--f-toni);
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.08em;
  opacity: 0.6;
}

/* ─── Affiliate · STAT view (big earned-¥ hero) ─── */
.aff-stat {
  text-align: center;
  padding: 40rpx 32rpx 32rpx;
}
.aff-stat-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.28em;
  opacity: 0.75;
}
.aff-stat-num {
  font-family: var(--f-bear);
  font-size: calc(120rpx * var(--font-scale));
  line-height: 0.95;
  letter-spacing: -0.02em;
  margin-top: 12rpx;
}
.aff-stat-sub {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  line-height: 1.4;
  margin-top: 8rpx;
  opacity: 0.8;
}
.aff-stat-code-pill {
  display: inline-block;
  margin-top: 24rpx;
  background: rgba(255,255,255,0.12);
  border: 2rpx dashed currentColor;
  padding: 12rpx 22rpx;
  font-family: var(--f-bear);
  font-size: calc(30rpx * var(--font-scale));
  letter-spacing: 0.02em;
  line-height: 1;
}
.aff-stat-actions {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 22rpx;
}
.aff-stat-copy,
.aff-stat-share,
.aff-stat-cta {
  background: currentColor;
  padding: 14rpx 24rpx;
  font-family: var(--f-gothic);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.12em;
  text-transform: uppercase;
  border: none;
  border-radius: 0;
  line-height: 1.3;
}
/* For stat-view we paint the button text in the card's bg colour so it
   reads as inverse-on-currentColor without needing extra wiring. */
.aff-stat-copy { color: #1a1a17; opacity: .92; }
.aff-stat-share {
  background: #1AAD19;
  color: #fff;
}
.aff-stat-share::after { border: none; }
.aff-stat-cta {
  display: inline-block;
  margin-top: 20rpx;
  color: #1a1a17;
}
.aff-stat-disabled {
  margin-top: 16rpx;
  font-family: var(--f-aleo);
  opacity: 0.7;
}

/* ─── Affiliate · RECEIPT view (paper / dashed-edges) ─── */
.aff-receipt {
  margin: 28rpx 60rpx;
  padding: 28rpx 28rpx 32rpx;
  border: 2rpx dashed var(--ink);
  border-radius: 0;
  position: relative;
  box-shadow: 8rpx 8rpx 0 var(--ink);
}
.aff-receipt-stub {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.3em;
  text-align: center;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid var(--ink);
  opacity: 0.75;
}
.aff-receipt-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.22em;
  margin-top: 18rpx;
  opacity: 0.7;
}
.aff-receipt-title {
  font-family: var(--f-bear);
  font-size: calc(34rpx * var(--font-scale));
  line-height: 1.05;
  letter-spacing: -0.01em;
  margin-top: 4rpx;
}
.aff-receipt-sep {
  font-family: var(--f-gothic);
  font-size: calc(20rpx * var(--font-scale));
  text-align: center;
  margin: 16rpx 0;
  opacity: 0.55;
  letter-spacing: 0.06em;
  white-space: nowrap;
  overflow: hidden;
}
.aff-receipt-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin: 6rpx 0;
}
.aff-receipt-row-muted { opacity: 0.7; }
.aff-receipt-lbl {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.22em;
  opacity: 0.75;
}
.aff-receipt-val {
  font-family: var(--f-bear);
  font-size: calc(26rpx * var(--font-scale));
  line-height: 1.1;
  letter-spacing: -0.01em;
  text-align: right;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 60%;
}
.aff-receipt-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}
.aff-receipt-copy,
.aff-receipt-share {
  flex: 1;
  background: var(--ink);
  color: #fff;
  padding: 14rpx 0;
  text-align: center;
  font-family: var(--f-gothic);
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.12em;
  border: none;
  border-radius: 0;
  line-height: 1.3;
  text-transform: uppercase;
}
.aff-receipt-share { background: #1AAD19; }
.aff-receipt-share::after { border: none; }
.aff-receipt-signin,
.aff-receipt-disabled {
  font-family: var(--f-aleo);
  font-size: calc(20rpx * var(--font-scale));
  text-align: center;
  padding: 12rpx 0;
  opacity: 0.7;
}

/* ─── Greeting block ──────────────────────────────────────────────────── */
.greet-blk {
  margin: 24rpx 44rpx;
  padding: 32rpx 36rpx 28rpx;
  border: 3rpx solid var(--ink);
  position: relative;
}
.gr-kicker {
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--olive);
}
.gr-headline {
  font-family: var(--f-bear);
  font-size: calc(64rpx * var(--font-scale));
  /* Tight leading (1.0) keeps multi-line EN like "Good afternoon, /
     mimi." from looking airy. padding-top absorbs the few rpx CN
     glyphs overflow upward so the kicker doesn't get bitten into. */
  line-height: 1.0;
  padding-top: 6rpx;
  margin-top: 10rpx;
}
.gr-points {
  margin-top: 14rpx;
  font-family: var(--f-gothic);
  font-size: calc(28rpx * var(--font-scale));
  letter-spacing: 0.06em;
}
.gr-cta {
  margin-top: 14rpx;
  font-family: var(--f-toni);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.16em;
  text-decoration: underline;
  text-transform: uppercase;
}

/* Notif strip — flush full-bleed row at the top of the greeting card. Sits
   against the card's inner edges using negative margins that exactly cancel
   each variant's padding (and the 3rpx border on the default/card variant).
   Default background = berry; replaced by an inline style when the operator
   sets theme.notif_color in the Mini App Backend. */
.gr-notif-strip {
  display: flex;
  align-items: center;
  gap: 12rpx;
  /* Default (card) variant: card padding 32rpx 36rpx 28rpx + 3rpx border —
     pull the strip up and out to overlap the border so it reads as the
     card's top edge, not a sticker placed inside it. */
  margin: -35rpx -39rpx 24rpx;
  padding: 16rpx 36rpx;
  background: var(--berry);
  color: #fff;
}
.gr-notif-icon {
  font-size: calc(28rpx * var(--font-scale));
  line-height: 1;
  flex-shrink: 0;
}
.gr-notif-icon.fresh {
  /* Subtle 2s breathing pulse for newly-arrived unreads (within last 6h).
     Draws the eye without being obnoxious. */
  animation: gr-notif-pulse 2s ease-in-out infinite;
}
@keyframes gr-notif-pulse {
  0%,100% { transform: scale(1);    opacity: 1;   }
  50%     { transform: scale(1.22); opacity: 0.85;}
}
.gr-notif-text {
  flex: 1;
  min-width: 0;
  font-family: var(--f-toni);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.04em;
  line-height: 1.2;
  /* One-line ellipsis so a long broadcast title (when N=1 we surface it
     directly) collapses to "Title that is too lon…" instead of wrapping
     and pushing the arrow off the strip. */
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.gr-notif-arrow {
  font-family: var(--f-bear);
  font-size: calc(26rpx * var(--font-scale));
  line-height: 1;
  flex-shrink: 0;
}
/* Banner = borderless, padded 44rpx all round → no border to overlap. */
.greet-blk-banner .gr-notif-strip { margin: -44rpx -44rpx 28rpx; padding: 18rpx 44rpx; }
/* Split = borderless, padded 28rpx 44rpx. */
.greet-blk-split  .gr-notif-strip { margin: -28rpx -44rpx 22rpx; padding: 16rpx 44rpx; }
/* Inline = padded 22rpx 28rpx, with the same 3rpx border as default. */
.greet-blk-inline .gr-notif-strip { margin: -25rpx -31rpx 16rpx; padding: 12rpx 28rpx; }

/* Greeting — view variants */
.gr-headline-sm { font-size: calc(38rpx * var(--font-scale)); line-height: 1.05; padding-top: 4rpx; margin-top: 8rpx; }
.gr-headline-lg { font-size: calc(88rpx * var(--font-scale)); line-height: 1.0; padding-top: 8rpx; }

/* Banner = full-bleed colour band: drop the side inset so the field
   stretches edge-to-edge. Inner copy keeps its own horizontal padding. */
.greet-blk-banner { border: 0; margin-left: 0; margin-right: 0; padding: 44rpx 44rpx 38rpx; }
.greet-blk-banner .gr-kicker { opacity: 0.6; }

.greet-blk-inline { padding: 22rpx 28rpx; }
.gr-inline-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.gr-inline-copy { flex: 1; min-width: 0; }
.gr-pts-pill {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border: 2rpx solid currentColor;
  border-radius: 999rpx;
  font-family: var(--f-gothic);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.04em;
}

/* Split, like Banner, is a full-width greeting band — drop the side inset
   so the coloured field reaches both edges; copy keeps a 44rpx gutter. */
.greet-blk-split { margin-left: 0; margin-right: 0; padding: 28rpx 44rpx; }
.gr-split-row {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
}
.gr-split-left { flex: 1; min-width: 0; }
.gr-split-wallet {
  flex-shrink: 0;
  min-width: 160rpx;
  padding: 18rpx 22rpx;
  border: 3rpx solid currentColor;
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.gr-wallet-num {
  font-family: var(--f-bear);
  font-size: calc(56rpx * var(--font-scale));
  line-height: 1;
}
.gr-wallet-lbl {
  margin-top: 8rpx;
  font-family: var(--f-gothic);
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.06em;
  opacity: 0.85;
  text-align: center;
}


/* ─── Kitchen status block ────────────────────────────────────────────── */
.kit-blk {
  margin: 24rpx 44rpx;
  padding: 28rpx 30rpx;
  border: 3rpx solid var(--ink);
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.kit-left { flex: 1; min-width: 0; }
.kit-kicker {
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--olive);
}
.kit-title {
  font-family: var(--f-bear);
  font-size: calc(40rpx * var(--font-scale));
  line-height: 1.0;
  padding-top: 4rpx;
  margin-top: 6rpx;
}
.kit-status {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  font-family: var(--f-aleo);
  font-size: calc(24rpx * var(--font-scale));
}
.kit-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  margin-right: 10rpx;
  box-shadow: 0 0 0 6rpx rgba(0,0,0,0.06);
}
.kit-status-label { font-weight: 500; }

/* Block styles — these match the /storefront preview pixel-for-pixel. */

/* ── Announcement bar ─────────────────────────────────────────────────── */
.announce {
  padding: 20rpx 32rpx;
  font-family: var(--f-toni);
  font-size: calc(24rpx * var(--font-scale));
  font-weight: 600;
  letter-spacing: 0.04em;
  text-align: center;
  overflow: hidden;
}
.announce-linked {
  display: flex; align-items: center; justify-content: center; gap: 12rpx;
}
.announce-chev {
  font-size: calc(28rpx * var(--font-scale));
  opacity: 0.75;
  line-height: 1;
}

/* ── Announcement animations ──────────────────────────────────────────── */
/* Marquee — horizontal scroll. Track is 2× the text (padded first copy +
   bare second copy) so translateX(-50%) loops seamlessly. */
.announce.anim-marquee_rtl,
.announce.anim-marquee_ltr { display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.announce .anim-clip { flex: 1; min-width: 0; overflow: hidden; }
.announce .anim-track { display: inline-flex; flex-wrap: nowrap; white-space: nowrap; will-change: transform; }
.announce .anim-track > .announce-text:first-child { padding-right: 96rpx; }
.announce.anim-marquee_rtl .anim-track { animation: a-marquee-rtl var(--anim-dur, 14s) linear infinite; }
.announce.anim-marquee_ltr .anim-track { animation: a-marquee-ltr var(--anim-dur, 14s) linear infinite; }
@keyframes a-marquee-rtl { from { transform: translateX(0); } to { transform: translateX(-50%); } }
@keyframes a-marquee-ltr { from { transform: translateX(-50%); } to { transform: translateX(0); } }

/* Vertical scroll — fixed-height clip with 2 stacked copies. */
.announce.anim-scroll_up,
.announce.anim-scroll_down { padding: 0 32rpx; display: flex; align-items: center; justify-content: center; gap: 12rpx; }
.announce .anim-vclip { height: 64rpx; overflow: hidden; }
.announce .anim-vtrack { display: flex; flex-direction: column; align-items: center; line-height: 64rpx; }
.announce.anim-scroll_up .anim-vtrack   { animation: a-scroll-up var(--anim-dur, 14s) linear infinite; }
.announce.anim-scroll_down .anim-vtrack { animation: a-scroll-down var(--anim-dur, 14s) linear infinite; }
@keyframes a-scroll-up   { from { transform: translateY(0); } to { transform: translateY(-50%); } }
@keyframes a-scroll-down { from { transform: translateY(-50%); } to { transform: translateY(0); } }

/* Per-letter — stagger via inline --i */
.announce .letters { display: inline-block; }
.announce .letters .ch { display: inline-block; }
.announce.anim-typewriter .letters .ch {
  opacity: 0;
  animation: a-type-in var(--anim-dur, 6s) infinite;
  animation-delay: calc(var(--i) * var(--step, 0.08s));
}
@keyframes a-type-in { 0%, 100% { opacity: 0; } 8%, 92% { opacity: 1; } }
.announce.anim-fade_in_letters .letters .ch {
  opacity: 0;
  animation: a-fade-in var(--anim-dur, 5s) infinite;
  animation-delay: calc(var(--i) * var(--step, 0.06s));
}
@keyframes a-fade-in { 0%, 100% { opacity: 0; } 25%, 80% { opacity: 1; } }
.announce.anim-wave .letters .ch {
  animation: a-wave var(--anim-dur, 2.2s) ease-in-out infinite;
  animation-delay: calc(var(--i) * var(--step, 0.07s));
}
@keyframes a-wave { 0%, 60%, 100% { transform: translateY(0); } 25% { transform: translateY(-8rpx); } }

/* Flicker — whole-text neon flicker, no per-letter split */
.announce.anim-flicker { animation: a-flicker var(--anim-dur, 2.4s) infinite; }
@keyframes a-flicker {
  0%, 19%, 21%, 23%, 25%, 54%, 56%, 100% { opacity: 1; text-shadow: 0 0 8rpx currentColor; }
  20%, 24%, 55% { opacity: 0.35; text-shadow: none; }
}

/* Speed presets — override --anim-dur (overall) and --step (per-letter delay).
   Per-letter animations want shorter total durations so the cycle doesn't drag. */
.announce.speed-slow   { --anim-dur: 22s; --step: 0.12s; }
.announce.speed-normal { --anim-dur: 14s; --step: 0.08s; }
.announce.speed-fast   { --anim-dur: 8s;  --step: 0.05s; }
.announce.anim-typewriter.speed-slow   { --anim-dur: 9s; }
.announce.anim-typewriter.speed-normal { --anim-dur: 6s; }
.announce.anim-typewriter.speed-fast   { --anim-dur: 3.5s; }
.announce.anim-fade_in_letters.speed-slow   { --anim-dur: 7s; }
.announce.anim-fade_in_letters.speed-normal { --anim-dur: 5s; }
.announce.anim-fade_in_letters.speed-fast   { --anim-dur: 3s; }
.announce.anim-wave.speed-slow   { --anim-dur: 3.4s; }
.announce.anim-wave.speed-normal { --anim-dur: 2.2s; }
.announce.anim-wave.speed-fast   { --anim-dur: 1.3s; }
.announce.anim-flicker.speed-slow   { --anim-dur: 3.6s; }
.announce.anim-flicker.speed-normal { --anim-dur: 2.4s; }
.announce.anim-flicker.speed-fast   { --anim-dur: 1.4s; }

/* ── Hero banner ──────────────────────────────────────────────────────── */
.hero {
  position: relative;
  width: 100%;
  background: linear-gradient(135deg, #c4c4c4, #a8a8a8);
  overflow: hidden;
}
.hero .hero-img { width: 100%; height: 100%; display: block; }
.hero .hero-video { width: 100%; height: 100%; display: block; }
.hero .hero-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  min-height: 400rpx;
  color: rgba(0, 0, 0, 0.3);
  font-size: calc(24rpx * var(--font-scale));
}
.hero .cta-stack {
  position: absolute;
  bottom: 56rpx;
  left: 44rpx;
  right: 44rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.cta-btn {
  padding: 28rpx 0;
  text-align: center;
  font-family: var(--f-toni);
  font-size: calc(24rpx * var(--font-scale));
  font-weight: 600;
  letter-spacing: 0.16em;
  border-radius: 999rpx;
  text-transform: uppercase;
}
.cta-btn.cta-primary {
  background: var(--ink);
  color: var(--oat);
}
.cta-btn.cta-secondary {
  background: rgba(255, 255, 255, 0.92);
  color: var(--ink);
  border: 3rpx solid var(--ink);
}
.cta-btn.cta-link {
  background: transparent;
  color: var(--ink);
  text-decoration: underline;
  padding: 12rpx 0;
  border-radius: 0;
}

/* Hero: split view (image left, copy panel right) */
.hero-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  min-height: 480rpx;
  height: auto !important;
  aspect-ratio: auto !important;
  position: relative;
}
.hero-split .split-img {
  position: relative;
  overflow: hidden;
  background: #ddd;
}
.hero-split .split-img .hero-img,
.hero-split .split-img .hero-video { width: 100%; height: 100%; display: block; }
.hero-split .split-img .hero-placeholder {
  display: flex; align-items: center; justify-content: center;
  width: 100%; height: 100%;
  color: rgba(0, 0, 0, 0.3);
  font-family: var(--f-sans);
  font-size: calc(22rpx * var(--font-scale));
}
.hero-split .split-panel {
  padding: 36rpx 32rpx;
  display: flex; flex-direction: column; justify-content: center;
  gap: 12rpx;
}
.hero-split .split-panel .headline {
  font-family: var(--f-bear);
  font-weight: 500;
  font-size: calc(42rpx * var(--font-scale));
  line-height: 1.1;
}
.hero-split .split-panel .subtitle {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  opacity: 0.8;
  line-height: 1.4;
}
.hero-split .split-panel .cta-stack {
  position: static;
  padding: 0;
  margin-top: 16rpx;
  display: flex; flex-direction: column; gap: 12rpx;
}
.hero-split .split-panel .cta-btn {
  padding: 20rpx 28rpx;
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.14em;
  border-radius: 999rpx;
  text-align: center;
}

/* ── Category tabs ────────────────────────────────────────────────────── */
.cattabs {
  padding: 0 44rpx;
  /* Per-element colour defaults — overridden by inline custom properties the
     renderer sets from the inspector's colour pickers. */
  --cat-text: #1a1a17;
  --cat-accent: #6A6E2D;
  --cat-keyline: #1a1a17;
  --cat-shadow: #1a1a17;
  --cat-surface: #F2E7DF;
  --cat-radius: 4rpx;
}
.cattabs.corner-sharp  { --cat-radius: 0rpx; }
.cattabs.corner-subtle { --cat-radius: 12rpx; }
.cattabs.corner-bold   { --cat-radius: 28rpx; }
.cattabs .head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}
.cattabs .kicker {
  font-family: var(--f-toni);
  font-size: calc(18rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.14em;
  color: var(--cat-accent);
}
.cattabs .ttl {
  font-family: var(--f-bear);
  font-size: calc(44rpx * var(--font-scale));
  font-weight: 500;
  line-height: 1.05;
  margin-top: 8rpx;
  color: var(--cat-text);
}
.cattabs .more {
  font-family: var(--f-toni);
  font-size: calc(18rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--cat-accent);
  text-decoration: underline;
}
.cattabs .grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}
.cattabs .tile {
  height: 192rpx;
  padding: 24rpx;
  position: relative;
  overflow: hidden;
  border-radius: var(--cat-radius);
}
.cattabs .tile .num {
  font-family: var(--f-toni);
  font-size: calc(18rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.1em;
  opacity: 0.85;
}
.cattabs .tile .name {
  font-family: var(--f-bear);
  font-size: calc(34rpx * var(--font-scale));
  font-weight: 500;
  line-height: 1;
  position: absolute;
  bottom: 24rpx;
  left: 24rpx;
  right: 24rpx;
}
/* ════ A · Index directory ════ numbered rows, colour dot, bilingual name,
   category-coloured count pill, chevron. */
.cattabs.cat-index .idx-list { display: flex; flex-direction: column; }
.cattabs.cat-index .idx-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 4rpx;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.08);
}
.cattabs.cat-index .idx-row:last-child { border-bottom: 0; }
.cattabs.cat-index .idx-num {
  font-family: var(--f-gothic);
  font-size: calc(26rpx * var(--font-scale));
  color: var(--cat-accent);
  width: 40rpx;
  flex: 0 0 auto;
}
.cattabs.cat-index .idx-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: var(--cat-radius);
  flex: 0 0 auto;
}
.cattabs.cat-index .idx-name { flex: 1 1 auto; min-width: 0; }
.cattabs.cat-index .idx-name .en {
  font-family: var(--f-bear);
  font-size: calc(32rpx * var(--font-scale));
  font-weight: 500;
  line-height: 1.05;
  color: var(--cat-text);
}
.cattabs.cat-index .idx-name .cn {
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  color: var(--cat-accent);
  margin-top: 2rpx;
}
.cattabs.cat-index .idx-count {
  font-family: var(--f-gothic);
  font-size: calc(22rpx * var(--font-scale));
  min-width: 52rpx;
  text-align: center;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  flex: 0 0 auto;
}
.cattabs.cat-index .idx-chev {
  color: var(--cat-accent);
  font-size: calc(36rpx * var(--font-scale));
  opacity: 0.6;
  flex: 0 0 auto;
}
/* ════ B · Bento mosaic ════ image tiles, first a wide hero, scrim caption,
   "NN · count" badge. Colour-fill fallback when no product photo. */
.cattabs.cat-bento .bento-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}
.cattabs.cat-bento .bento-tile {
  position: relative;
  min-height: 220rpx;
  padding: 20rpx;
  overflow: hidden;
  border-radius: var(--cat-radius);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.cattabs.cat-bento .bento-tile.hero {
  grid-column: 1 / -1;
  min-height: 300rpx;
}
.cattabs.cat-bento .bento-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
.cattabs.cat-bento .bento-tile::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to top, rgba(0, 0, 0, 0.55), rgba(0, 0, 0, 0) 60%);
}
.cattabs.cat-bento .bento-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  z-index: 2;
  font-family: var(--f-toni);
  font-size: calc(18rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.06em;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}
.cattabs.cat-bento .bento-cap { position: relative; z-index: 2; }
.cattabs.cat-bento .bento-cap.on-img { color: #fff; }
.cattabs.cat-bento .bento-cap .en {
  font-family: var(--f-bear);
  font-size: calc(36rpx * var(--font-scale));
  font-weight: 500;
  line-height: 1;
}
.cattabs.cat-bento .bento-cap .cn {
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  opacity: 0.9;
  margin-top: 4rpx;
}
/* ════ C · Sticker chips ════ coloured pills, ink keyline + hard shadow,
   bilingual name, dark count badge. Wrapping varying-width flow. */
.cattabs.cat-sticker .chip-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.cattabs.cat-sticker .chip-pill {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 20rpx 14rpx 28rpx;
  border-radius: 999rpx;
  border: 4rpx solid var(--cat-keyline);
  box-shadow: 6rpx 6rpx 0 var(--cat-shadow);
}
.cattabs.cat-sticker .chip-pill .en {
  font-family: var(--f-bear);
  font-size: calc(30rpx * var(--font-scale));
  font-weight: 500;
  line-height: 1;
}
.cattabs.cat-sticker .chip-pill .cn {
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  opacity: 0.85;
}
.cattabs.cat-sticker .chip-count {
  font-family: var(--f-gothic);
  font-size: calc(22rpx * var(--font-scale));
  min-width: 40rpx;
  text-align: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: var(--cat-text);
  color: var(--cat-surface);
}
.cattabs .empty {
  color: rgba(0, 0, 0, 0.3);
  text-align: center;
  padding: 40rpx 0;
  font-size: calc(24rpx * var(--font-scale));
}
/* Icons view — circle + label per category */
.cattabs .icons-grid { display: grid; gap: 28rpx 12rpx; }
.cattabs .icons-grid.icons-cols-3 { grid-template-columns: repeat(3, 1fr); }
.cattabs .icons-grid.icons-cols-4 { grid-template-columns: repeat(4, 1fr); }
.cattabs .icons-grid.icons-cols-5 { grid-template-columns: repeat(5, 1fr); }
.cattabs .icon-tile {
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
}
.cattabs .icon-circle {
  width: 112rpx; height: 112rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--f-bear);
  font-size: calc(44rpx * var(--font-scale));
  font-weight: 700;
}
.cattabs .icon-name {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  color: var(--cat-text);
  text-align: center;
  line-height: 1.2;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* Scroll view — single horizontal row, drag left/right */
.cattabs .scroll-rail { white-space: nowrap; }
.cattabs .scroll-tile {
  display: inline-flex; flex-direction: column; align-items: center; gap: 12rpx;
  width: 140rpx;
  margin-right: 24rpx;
  vertical-align: top;
}
.cattabs .scroll-tile:last-child { margin-right: 0; }
.cattabs .scroll-tile .icon-name { width: 140rpx; }

/* ── Featured item ────────────────────────────────────────────────────── */
/* Three layouts (driven by CMS `view`):
   • card    — square image on top, kicker / name / price stacked below
   • split   — image left, copy right (legacy default)
   • banner  — wide image with copy floated bottom-left on top of it
   Card surface (`background:{...}` inline) + text colour come from
   `card_bg_color` / `card_fg_color`; the outer block bg comes from
   `bg_color` (transparent by default). */
.featured { padding: 0 44rpx; }
.featured .card {
  padding: 36rpx;
  border-radius: 4rpx;
  overflow: hidden;
}
.featured .img { background: rgba(0,0,0,.15); overflow: hidden; border-radius: 4rpx; }
.featured .img-full { width: 100%; height: 100%; }
.featured .meta { min-width: 0; }
.featured .kicker {
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.14em;
  /* Card-fg via inline style; fall back to lime if unspecified */
}
.featured .name {
  font-family: var(--f-bear);
  font-size: calc(40rpx * var(--font-scale));
  font-weight: 500;
  line-height: 1.05;
  margin-top: 8rpx;
}
.featured .price {
  font-family: var(--f-gothic);
  font-size: calc(36rpx * var(--font-scale));
  font-weight: 600;
  letter-spacing: 0.04em;
}
.featured .price.is-flash { color: #FF8FA1; }
.featured .price-row {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  margin-top: 12rpx;
}
.featured .price-was {
  font-family: var(--f-aleo);
  font-size: calc(24rpx * var(--font-scale));
  text-decoration: line-through;
}
.featured .empty {
  color: rgba(0, 0, 0, 0.3);
  text-align: center;
  padding: 40rpx 0;
  font-size: calc(24rpx * var(--font-scale));
}

/* CARD view — image on top, copy below. */
.featured-view-card .card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.featured-view-card .img { width: 100%; height: 420rpx; }
.featured-view-card .meta { width: 100%; }

/* SPLIT view (legacy default) — image left, copy right. */
.featured-view-split .card {
  display: flex;
  gap: 32rpx;
  align-items: center;
}
.featured-view-split .img {
  width: 168rpx;
  height: 208rpx;
  flex-shrink: 0;
}
.featured-view-split .meta { flex: 1; }

/* BANNER view — wide image with copy floated bottom-left as an overlay. */
.featured-view-banner .card {
  position: relative;
  padding: 0;
  min-height: 360rpx;
}
.featured-view-banner .img {
  width: 100%;
  height: 360rpx;
  border-radius: 4rpx;
}
.featured-view-banner .meta {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: 28rpx;
  padding: 18rpx 22rpx;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 4rpx;
  backdrop-filter: blur(8rpx);
}

/* ── Product grid ─────────────────────────────────────────────────────── */
.grid-block { padding: 0 44rpx; }
.grid-block .head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 24rpx;
}
.grid-block .kicker {
  font-family: var(--f-toni);
  font-size: calc(18rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.14em;
  color: var(--olive);
}
.grid-block .ttl {
  font-family: var(--f-bear);
  font-size: calc(44rpx * var(--font-scale));
  font-weight: 500;
  line-height: 1.05;
  margin-top: 8rpx;
}
.grid-block .more {
  font-family: var(--f-toni);
  font-size: calc(18rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.1em;
  color: var(--olive);
  text-decoration: underline;
}
.grid-block .grid { display: grid; gap: 24rpx; }
.grid-block .cols-1 { grid-template-columns: 1fr; }
.grid-block .cols-2 { grid-template-columns: 1fr 1fr; }
.grid-block .cols-3 { grid-template-columns: 1fr 1fr 1fr; }
.grid-block .card .img {
  width: 100%;
  aspect-ratio: 4 / 5;
  background: #ddd;
  overflow: hidden;
  border-radius: 4rpx;
}
.grid-block .card .img-full { width: 100%; height: 100%; }
.grid-block .card .name {
  font-family: var(--f-bear);
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 500;
  margin-top: 16rpx;
  line-height: 1.15;
}
.grid-block .card .price {
  font-family: var(--f-gothic);
  font-size: calc(26rpx * var(--font-scale));
  font-weight: 600;
  color: var(--olive);
  letter-spacing: 0.04em;
}
.grid-block .card .price.is-flash { color: #E96174; }
.grid-block .card .price-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 4rpx;
}
.grid-block .card .price-was {
  font-family: var(--f-aleo);
  font-size: calc(20rpx * var(--font-scale));
  color: rgba(0, 0, 0, 0.4);
  text-decoration: line-through;
}
.grid-block .card .img { position: relative; }
.grid-block .card .grid-flash-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  background: #E96174;
  color: #fff;
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.12em;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

/* Rank badges — "NO. 01" style chip in the top-left of the product image.
   Tier 1 is the eye-catching lime so #1 reads as the headline of the
   block; 2/3 use warm brand colours; 4+ fall back to ink so the medal
   positions stay dominant. Applies to grid + scroll + list views. */
.grid-block .card .rank-badge,
.grid-block .rail-card .rank-badge,
.grid-block .list-row .rank-badge {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.14em;
  padding: 6rpx 14rpx;
  border-radius: 4rpx;
  text-transform: uppercase;
  z-index: 2;
}
/* Flat brand colours keep the "top 3" hierarchy without the off-brand
   metallic gloss: gold/stone/almond read as medals, and the crisp solid
   ink offset (the brand's sticker shadow) lifts them off the photo. #4+
   fall back to ink so the medal positions stay dominant. */
.rank-1 {
  background: var(--corn, #F2CA6C);
  color: var(--ink, #1a1a17);
  box-shadow: 3rpx 3rpx 0 var(--ink, #1a1a17);
}
.rank-2 {
  background: #D3D1C7;
  color: var(--ink, #1a1a17);
  box-shadow: 3rpx 3rpx 0 var(--ink, #1a1a17);
}
.rank-3 {
  background: var(--almond, #C37F4E);
  color: var(--oat, #F2E7DF);
  box-shadow: 3rpx 3rpx 0 var(--ink, #1a1a17);
}
.rank-n {
  background: var(--ink, #1a1a17);
  color: var(--oat, #F2E7DF);
}
/* List view's rank badge sits over a smaller square image — shrink it a
   touch so it doesn't crowd the thumbnail. */
.grid-block .list-row .rank-badge {
  font-size: calc(16rpx * var(--font-scale));
  padding: 4rpx 10rpx;
  letter-spacing: 0.1em;
}

/* Social proof — "420 SOLD" sits below the price on top-selling cards.
   Quiet styling so the rank badge + price stay primary; the number is
   the value here, not the typography. */
.grid-block .card .sold-caption,
.grid-block .rail-card .sold-caption,
.grid-block .list-row .sold-caption {
  margin-top: 6rpx;
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.12em;
  color: var(--olive);
  text-transform: uppercase;
}

/* Make the #1 product card itself feel a bit more premium with a hair-
   thin gold rule along the bottom of the image. Subtle — the badge is
   doing the heavy lifting visually. */
.grid-block .rank-card-1 .img {
  box-shadow: inset 0 -3rpx 0 var(--corn, #F2CA6C);
}
.grid-block .empty {
  color: rgba(0, 0, 0, 0.3);
  text-align: center;
  padding: 40rpx 0;
  font-size: calc(24rpx * var(--font-scale));
}
/* Scroll view — horizontal rail of cards. Each card fixed-width so the
   rail doesn't squish further-down items as it grows. */
.grid-block .scroll-rail { white-space: nowrap; }
.grid-block .rail-card {
  display: inline-block;
  vertical-align: top;
  width: 260rpx;
  margin-right: 20rpx;
  white-space: normal;
}
.grid-block .rail-card .img {
  width: 100%; aspect-ratio: 4 / 5;
  background: #ddd; overflow: hidden; border-radius: 4rpx;
  position: relative;
}
.grid-block .rail-card .img .img-full { width: 100%; height: 100%; }
.grid-block .rail-card .name {
  font-family: var(--f-bear);
  font-size: calc(26rpx * var(--font-scale));
  font-weight: 500;
  margin-top: 14rpx;
  line-height: 1.15;
}
.grid-block .rail-card .price {
  font-family: var(--f-gothic);
  font-size: calc(24rpx * var(--font-scale));
  font-weight: 600;
  color: var(--olive);
  letter-spacing: 0.04em;
}
.grid-block .rail-card .price.is-flash { color: #E96174; }
.grid-block .rail-card .price-row {
  display: flex; align-items: baseline; gap: 12rpx; margin-top: 4rpx;
}
.grid-block .rail-card .price-was {
  font-family: var(--f-aleo);
  font-size: calc(20rpx * var(--font-scale));
  color: rgba(0, 0, 0, 0.4);
  text-decoration: line-through;
}

/* List view — single column, image left, tagline + price on the right */
.grid-block .list-rows { display: flex; flex-direction: column; gap: 32rpx; }
.grid-block .list-row { display: flex; gap: 24rpx; align-items: flex-start; }
.grid-block .list-row .img {
  flex: 0 0 200rpx; width: 200rpx; aspect-ratio: 1;
  background: #ddd; overflow: hidden; border-radius: 8rpx;
  position: relative;
}
.grid-block .list-row .img .img-full { width: 100%; height: 100%; }
.grid-block .list-row .meta { flex: 1; min-width: 0; }
.grid-block .list-row .name {
  font-family: var(--f-bear);
  font-size: calc(30rpx * var(--font-scale));
  font-weight: 500;
  line-height: 1.15;
}
.grid-block .list-row .tagline {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  color: rgba(0, 0, 0, 0.55);
  margin-top: 6rpx;
  line-height: 1.35;
}
.grid-block .list-row .price {
  font-family: var(--f-gothic);
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 600;
  color: var(--olive);
}
.grid-block .list-row .price.is-flash { color: #E96174; }
.grid-block .list-row .price-row {
  display: flex; align-items: baseline; gap: 12rpx; margin-top: 12rpx;
}
.grid-block .list-row .price-was {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  color: rgba(0, 0, 0, 0.4);
  text-decoration: line-through;
}

/* ── Order tracker ───────────────────────────────────────────────────── */
/* Colour + energy controls ride on .ot-wrap as --ot-* CSS vars so every
   layout (classic / truck / banner) inherits them. */
.ot-wrap { padding: 0 44rpx; }
/* "N more orders in progress →" link beneath the card. Quiet by design — a
   text link, not a second button, so the tracker stays a single focal card. */
.ot-more {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-family: var(--f-toni);
  font-size: calc(22rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.04em;
  padding: 18rpx 22rpx;
  border-radius: 999rpx;
  border: 3rpx solid var(--ot-accent, var(--forest, #365329));
  color: var(--ot-accent, var(--forest, #365329));
  background: transparent;
}
.ot-more:active { opacity: 0.7; }
.ot-card {
  background: var(--ot-card-bg, #fff);
  border: var(--ot-card-border, 3rpx solid var(--ink, #1a1a17));
  border-radius: 12rpx;
  padding: 28rpx 28rpx 24rpx;
}
.ot-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.ot-title {
  font-family: var(--f-bear);
  font-size: calc(30rpx * var(--font-scale));
  font-weight: 600;
}
.ot-status {
  flex: 0 0 auto;
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ot-cta-text, var(--oat, #F2E7DF));
  background: var(--ot-accent, var(--forest, #365329));
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}
.ot-status.unpaid { background: #E96174; color: #fff; }
/* Refund tag — flags a partial / in-progress refund so a refunded order
   never reads as a plain Paid order. Sits inline in classic's head and
   stacked under the headline in truck/banner. */
.ot-refund-tag {
  align-self: flex-start;
  margin-top: 8rpx;
  font-family: var(--f-toni);
  font-size: calc(18rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: #fff;
  background: #E96174;
  padding: 5rpx 16rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}
.ot-head .ot-refund-tag { margin-top: 0; }
.ot-body { display: flex; align-items: center; gap: 20rpx; margin-top: 22rpx; }
/* Stacked product thumbnails (shared across all three layouts). */
.ot-thumbs { display: flex; flex: none; }
.ot-th {
  width: 88rpx; height: 88rpx; border-radius: 18rpx;
  background: #e3ddcf; border: 4rpx solid var(--ot-card-bg, #fff);
  margin-left: -24rpx; box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.15);
  overflow: hidden; position: relative;
}
.ot-th:first-child { margin-left: 0; }
.ot-th-img { width: 100%; height: 100%; }
.ot-info { flex: 1; min-width: 0; }
.ot-no, .ot-count {
  font-family: var(--f-gothic);
  font-size: calc(26rpx * var(--font-scale));
  font-weight: 600;
}
.ot-sub, .ot-eta {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  color: rgba(0, 0, 0, 0.55);
  margin-top: 4rpx;
}
.ot-cta {
  flex: 0 0 auto;
  color: var(--ot-cta-text, #fff);
  background: var(--ot-accent, var(--forest, #365329));
  font-family: var(--f-gothic);
  font-size: calc(24rpx * var(--font-scale));
  font-weight: 700;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}
/* A · Icon-node tracker. Colour encodes progress: done/current nodes get a
   candy fill (set inline from step.candy) + charcoal ring + charcoal glyph;
   upcoming nodes stay grey. The connector bar leading into a filled node
   turns the accent colour, so the fill runs from the first node up to the
   current one. The current node also gets a pulsing accent ring. */
.ot-track {
  display: flex; justify-content: space-between;
  margin-top: 26rpx; padding-top: 26rpx;
  border-top: 2rpx solid rgba(0, 0, 0, 0.08);
}
.ot-node {
  flex: 1; position: relative;
  display: flex; flex-direction: column; align-items: center; gap: 14rpx;
}
.ot-bar {
  position: absolute; top: 43rpx; left: -50%; width: 100%; height: 6rpx;
  background: var(--ot-rail, #D3D1C7); border-radius: 999rpx; z-index: 0;
}
.ot-bar.on { background: var(--ot-accent, var(--forest, #365329)); }
.ot-circle {
  position: relative; z-index: 1;
  width: 92rpx; height: 92rpx; border-radius: 999rpx;
  background: var(--ot-rail, #D3D1C7); border: 2rpx solid #9A988E;
  display: flex; align-items: center; justify-content: center;
}
.ot-node.filled .ot-circle { border-color: var(--ink, #1a1a17); }
.ot-ic { width: 46rpx; height: 46rpx; opacity: 0.38; }
.ot-node.filled .ot-ic { opacity: 1; }
/* Pulsing accent ring on the current node only. */
.ot-node.current .ot-circle::after {
  content: ''; position: absolute;
  top: -10rpx; left: -10rpx; right: -10rpx; bottom: -10rpx;
  border-radius: 999rpx; border: 4rpx solid var(--ot-accent, var(--forest, #365329));
  animation: ot-pulse 1.6s ease-out infinite;
}
@keyframes ot-pulse {
  0%   { transform: scale(0.92); opacity: 0.9; }
  70%  { transform: scale(1.12); opacity: 0; }
  100% { transform: scale(1.12); opacity: 0; }
}
.ot-node-label {
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
  color: #9A988E;
}
.ot-node.filled .ot-node-label { color: var(--ink, #1a1a17); }

/* B · Track & truck — status headline + rounded rail with a truck riding the
   current milestone. */
.ot-truck .ot-tk-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; }
.ot-tk-headtext { flex: 1; min-width: 0; }
.ot-kicker {
  font-family: var(--f-toni);
  font-size: calc(18rpx * var(--font-scale));
  font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase;
  color: #6A6E2D;
}
.ot-bighead {
  font-family: var(--f-bear);
  font-size: calc(44rpx * var(--ot-h, 1) * var(--font-scale));
  font-weight: 600; line-height: 1; margin-top: 10rpx;
  color: var(--ink, #1a1a17);
}
.ot-tk-sub {
  font-family: var(--f-aleo);
  font-size: calc(24rpx * var(--font-scale));
  color: #6A6E2D; margin-top: 8rpx;
}
.ot-tk-sub .b { color: var(--ink, #1a1a17); font-weight: 700; }
.ot-rail { position: relative; height: 84rpx; margin: 44rpx 8rpx 8rpx; }
.ot-rail-base {
  position: absolute; top: 50%; left: 0; right: 0; height: 16rpx;
  transform: translateY(-50%); border-radius: 18rpx;
  background: var(--ot-rail, #D3D1C7);
}
.ot-rail-fill {
  position: absolute; top: 50%; left: 0; height: 16rpx;
  transform: translateY(-50%); border-radius: 18rpx;
  background: var(--ot-accent, var(--forest, #365329));
}
.ot-rail-dot {
  position: absolute; top: 50%; width: 28rpx; height: 28rpx; border-radius: 999rpx;
  transform: translate(-50%, -50%); border: 4rpx solid var(--ot-card-bg, #fff);
}
.ot-truck-marker {
  position: absolute; top: 50%; transform: translate(-50%, -50%);
  width: 80rpx; height: 80rpx; border-radius: 999rpx;
  background: var(--ot-marker, #F4B8CB); border: 4rpx solid var(--ink, #1a1a17);
  display: flex; align-items: center; justify-content: center;
  box-shadow: 0 0 0 8rpx var(--ot-card-bg, #fff); z-index: 2;
}
.ot-mk-ic { width: 44rpx; height: 44rpx; }
.ot-tk-labels { display: flex; justify-content: space-between; margin-top: 20rpx; }
.ot-tl { flex: 1; }
.ot-tl-en {
  font-family: var(--f-gothic);
  font-size: calc(22rpx * var(--font-scale));
  font-weight: 700; letter-spacing: 0.05em; color: #9A988E;
}
.ot-tl.on .ot-tl-en { color: var(--ink, #1a1a17); }
.ot-tl.current .ot-tl-en { color: var(--ot-accent, var(--forest, #365329)); }
.ot-tk-cta {
  margin-top: 32rpx; text-align: center; border-radius: 24rpx; padding: 24rpx 0;
  font-family: var(--f-gothic); font-size: calc(28rpx * var(--font-scale));
  font-weight: 700; letter-spacing: 0.06em;
  color: var(--ot-cta-text, #fff); background: var(--ot-accent, var(--forest, #365329));
}

/* C · Status banner — accent header band + chunky 4-segment progress + a
   raised ticket button. */
.ot-banner {
  border-radius: var(--ot-radius, 32rpx); overflow: hidden;
  border: var(--ot-bw, 4rpx) solid var(--ink, #1a1a17);
}
.ot-bn-head {
  display: flex; align-items: center; gap: 22rpx; padding: 26rpx 30rpx;
  background: var(--ot-accent, var(--forest, #365329)); color: var(--ot-cta-text, #fff);
}
.ot-bn-marker {
  width: 84rpx; height: 84rpx; border-radius: 999rpx; flex: none;
  background: var(--ot-marker, #F4B8CB);
  display: flex; align-items: center; justify-content: center;
}
.ot-bn-headtext { flex: 1; min-width: 0; }
.ot-bn-kicker {
  font-family: var(--f-toni);
  font-size: calc(18rpx * var(--font-scale));
  font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--ot-bright, #CCD900);
}
.ot-bn-eta {
  font-family: var(--f-bear);
  font-size: calc(38rpx * var(--ot-h, 1) * var(--font-scale));
  font-weight: 600; line-height: 1; margin-top: 6rpx;
}
.ot-bn-body { background: var(--ot-card-bg, #FFFCF7); padding: 26rpx 30rpx 30rpx; }
.ot-bn-row { display: flex; align-items: center; gap: 22rpx; }
.ot-segs { display: flex; gap: 10rpx; margin-top: 30rpx; }
.ot-seg { flex: 1; text-align: center; }
.ot-seg-bar { height: 14rpx; border-radius: 18rpx; background: var(--ot-rail, #D3D1C7); }
.ot-seg.done .ot-seg-bar { background: var(--ot-bright, #CCD900); }
.ot-seg.current .ot-seg-bar { background: var(--ot-marker, #F4B8CB); border: 3rpx solid var(--ink, #1a1a17); }
.ot-seg-lbl { display: flex; align-items: center; justify-content: center; gap: 8rpx; margin-top: 14rpx; }
.ot-seg-ic { width: 28rpx; height: 28rpx; opacity: 0.38; }
.ot-seg.on .ot-seg-ic { opacity: 1; }
.ot-seg-lbl text {
  font-family: var(--f-gothic);
  font-size: calc(20rpx * var(--font-scale));
  font-weight: 700; letter-spacing: 0.03em; color: #9A988E;
}
.ot-seg.on .ot-seg-lbl text { color: var(--ink, #1a1a17); }
.ot-bn-cta {
  margin-top: 30rpx; text-align: center; border-radius: 24rpx; padding: 22rpx 0;
  font-family: var(--f-gothic); font-size: calc(28rpx * var(--font-scale));
  font-weight: 700; letter-spacing: 0.06em;
  color: var(--ink, #1a1a17); background: var(--ot-bright, #CCD900);
  border: 3rpx solid var(--ink, #1a1a17); box-shadow: 0 6rpx 0 var(--ink, #1a1a17);
}

/* ── Countdown timer (flash-sale / 秒杀) ─────────────────────────────── */
.countdown {
  padding: 40rpx 44rpx 44rpx;
  text-align: center;
}
.cd-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.18em;
  opacity: 0.75;
  text-transform: uppercase;
}
.cd-title {
  font-family: var(--f-bear);
  font-weight: 500;
  font-size: calc(36rpx * var(--font-scale));
  line-height: 1.15;
  margin-top: 8rpx;
}
.cd-clock {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 24rpx;
}
.cd-cell {
  min-width: 96rpx;
  padding: 16rpx 8rpx;
  background: rgba(255, 255, 255, 0.12);
  border-radius: 12rpx;
}
.cd-num {
  font-family: var(--f-gothic);
  font-weight: 700;
  font-size: calc(44rpx * var(--font-scale));
  letter-spacing: 0.04em;
  line-height: 1;
}
.cd-lbl {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.14em;
  margin-top: 8rpx;
  opacity: 0.7;
}
.cd-sep {
  font-family: var(--f-gothic);
  font-weight: 700;
  font-size: calc(44rpx * var(--font-scale));
  line-height: 1;
  padding-top: 16rpx;
  opacity: 0.55;
}
.cd-cta {
  display: inline-block;
  margin-top: 28rpx;
  padding: 18rpx 44rpx;
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.16em;
  background: rgba(255, 255, 255, 0.92);
  color: #1a1a17;
  border-radius: 999rpx;
}
.cd-ended {
  margin-top: 32rpx;
  font-family: var(--f-aleo);
  font-size: calc(26rpx * var(--font-scale));
  opacity: 0.8;
}

/* ── Flash sale strip (秒杀) ──────────────────────────────────────────── */
.flash-strip {
  padding: 32rpx 36rpx 36rpx;
}
.fs-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 28rpx;
}
.fs-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.18em;
  opacity: 0.85;
  text-transform: uppercase;
}
.fs-title {
  font-family: var(--f-bear);
  font-weight: 500;
  font-size: calc(40rpx * var(--font-scale));
  line-height: 1.0;
  padding-top: 4rpx;
  margin-top: 4rpx;
}
.fs-clock {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.fs-clock-lbl {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.14em;
  opacity: 0.8;
}
.fs-clock-cells {
  display: inline-flex;
  align-items: center;
}
.fs-ct-num {
  display: inline-block;
  background: rgba(0, 0, 0, 0.35);
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
  font-family: var(--f-gothic);
  font-weight: 700;
  font-size: calc(28rpx * var(--font-scale));
  letter-spacing: 0.04em;
  min-width: 52rpx;
  text-align: center;
}
.fs-ct-sep {
  padding: 0 6rpx;
  font-family: var(--f-gothic);
  font-weight: 700;
  font-size: calc(28rpx * var(--font-scale));
  opacity: 0.65;
}
.fs-cards {
  margin-top: 28rpx;
  white-space: nowrap;
  width: 100%;
}
.fs-card {
  display: inline-block;
  vertical-align: top;
  width: 260rpx;
  margin-right: 20rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #1a1a17;
  border-radius: 12rpx;
  overflow: hidden;
  white-space: normal;
}
.fs-card-img {
  position: relative;
  width: 100%;
  height: 260rpx;
  background: #eee;
  overflow: hidden;
}
.fs-card-img .img-full {
  width: 100%;
  height: 100%;
}
.fs-badge {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: #1a1a17;
  color: #CCD900;
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.04em;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.fs-card-meta {
  padding: 16rpx 20rpx 20rpx;
}
.fs-card-name {
  font-family: var(--f-bear);
  font-weight: 500;
  font-size: calc(24rpx * var(--font-scale));
  line-height: 1.2;
  height: 60rpx;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.fs-card-prices {
  margin-top: 12rpx;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}
.fs-price-now {
  font-family: var(--f-gothic);
  font-weight: 700;
  font-size: calc(30rpx * var(--font-scale));
  letter-spacing: 0.03em;
  color: #E96174;
}
.fs-price-was {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  color: rgba(0, 0, 0, 0.4);
  text-decoration: line-through;
}
.fs-meter {
  margin-top: 12rpx;
  height: 8rpx;
  background: rgba(0, 0, 0, 0.08);
  border-radius: 999rpx;
  overflow: hidden;
}
.fs-meter-bar {
  height: 100%;
  background: #E96174;
  border-radius: inherit;
  transition: width 0.3s ease;
}
.fs-meter-lbl {
  margin-top: 8rpx;
  font-family: var(--f-toni);
  font-weight: 500;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.06em;
  color: rgba(0, 0, 0, 0.55);
}
.fs-empty {
  margin-top: 24rpx;
  padding: 36rpx 0;
  text-align: center;
  font-family: var(--f-aleo);
  font-size: calc(24rpx * var(--font-scale));
  opacity: 0.85;
}

/* ── Flash sale: hero / banner views ─────────────────────────────────── */
.flash-hero {
  padding: 48rpx 44rpx 56rpx;
  text-align: center;
}
.flash-banner { padding-bottom: 48rpx; }
.fh-kicker {
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.18em;
  opacity: 0.85;
  text-transform: uppercase;
}
.fh-title {
  font-family: var(--f-bear); font-weight: 500;
  font-size: calc(44rpx * var(--font-scale));
  line-height: 1.0;
  padding-top: 4rpx;
  margin-top: 6rpx;
}
.fh-ends {
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.18em;
  opacity: 0.7;
  margin-top: 28rpx;
}
.fh-clock {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 16rpx;
}
.fh-cell {
  min-width: 104rpx;
  padding: 20rpx 8rpx;
  background: rgba(0, 0, 0, 0.35);
  border-radius: 12rpx;
}
.fh-num {
  font-family: var(--f-gothic); font-weight: 700;
  font-size: calc(52rpx * var(--font-scale));
  letter-spacing: 0.04em;
  line-height: 1;
}
.fh-lbl {
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.14em;
  margin-top: 8rpx;
  opacity: 0.75;
}
.fh-sep {
  font-family: var(--f-gothic); font-weight: 700;
  font-size: calc(52rpx * var(--font-scale));
  line-height: 1;
  padding-top: 20rpx;
  opacity: 0.55;
}
.fh-cta {
  display: inline-block;
  margin-top: 32rpx;
  padding: 20rpx 48rpx;
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.16em;
  background: rgba(255, 255, 255, 0.92);
  color: #1a1a17;
  border-radius: 999rpx;
}
.fh-cards { margin-top: 36rpx; text-align: left; }

/* ── Flash sale · design directions (Classic / Editorial / Urgency) ───────
   Ported from the CMS editor. Each coloured element rides on a CSS var that
   block-renderer.js sets per-block (styleVars), so the inspector can recolour
   every piece independently. --fs-head/-radius/-border come from Energy. */
.fsd-wrap {
  position: relative;
  overflow: hidden;
  font-family: var(--f-aleo);
  --fs-head: 1; --fs-radius: 32rpx; --fs-border: 3rpx;
  --fs-panel: #FBF1F1; --fs-tile: #C24E61;
  --fs-accent: var(--lime, #CCD900); --fs-fill: var(--forest, #365329);
  --fs-price: var(--berry, #E96174); --fs-ink: var(--ink, #1a1a17);
}
.fsd-wrap.corner-subtle { border-radius: 28rpx; }
.fsd-wrap.corner-bold   { border-radius: 44rpx; }
.fsd-zig {
  position: absolute; top: 0; left: 0; right: 0;
  height: 28rpx; background: var(--fs-panel);
  z-index: 3; pointer-events: none;
}
.fsd-body { padding: 44rpx 0; color: var(--fs-ink); }

/* live-pulse — only attached when the Urgency tweak is "Frantic" */
@keyframes fsPulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.035); } }
@keyframes fsDot   { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: .35; transform: scale(1.5); } }
.fsd-wrap .fs-pulse     { animation: fsPulse 1s ease-in-out infinite; }
.fsd-wrap .fs-pulse-dot { animation: fsDot .9s ease-in-out infinite; }

/* shared kicker CN accent */
.fsd-kicker .cn { font-family: var(--f-yuan); font-weight: 700; letter-spacing: .12em; }

/* shared product card — badge variants: corner / stamp / ribbon */
.fsd-cards { white-space: nowrap; width: 100%; padding: 0 32rpx 8rpx; box-sizing: border-box; }
.fsd-card {
  display: inline-block; vertical-align: top;
  width: 300rpx; margin-right: 24rpx;
  background: #FFFCF7; color: var(--ink, #1a1a17);
  border-radius: var(--fs-radius); overflow: hidden; white-space: normal;
}
.fsd-img { position: relative; width: 100%; height: 300rpx; overflow: hidden; background: #eee; }
.fsd-img image { width: 100%; height: 100%; }
.fsd-badge-corner { position: absolute; top: 20rpx; left: 20rpx; background: var(--fs-ink); color: var(--fs-accent); padding: 6rpx 16rpx; border-radius: 14rpx; font-family: var(--f-gothic); font-size: calc(30rpx * var(--font-scale)); letter-spacing: .03em; }
.fsd-badge-stamp  { position: absolute; top: 16rpx; right: 16rpx; background: var(--fs-accent); color: var(--fs-ink); border: var(--fs-border) solid var(--fs-ink); box-shadow: 4rpx 4rpx 0 var(--fs-ink); transform: rotate(7deg); padding: 10rpx 16rpx; font-family: var(--f-gothic); font-size: calc(32rpx * var(--font-scale)); letter-spacing: .03em; line-height: 1; }
.fsd-badge-ribbon { position: absolute; top: 28rpx; left: -56rpx; width: 220rpx; transform: rotate(-45deg); background: var(--fs-accent); color: var(--fs-ink); text-align: center; font-family: var(--f-gothic); font-size: calc(26rpx * var(--font-scale)); letter-spacing: .06em; padding: 6rpx 0; }
.fsd-meta { padding: 24rpx 26rpx 28rpx; }
.fsd-name { font-family: var(--f-bear); font-size: calc(31rpx * var(--font-scale)); line-height: 1.05; }
.fsd-cn { font-family: var(--f-yuan); font-weight: 500; font-size: calc(21rpx * var(--font-scale)); color: #6A6E2D; margin-top: 4rpx; }
.fsd-prices { display: flex; align-items: baseline; gap: 14rpx; margin-top: 16rpx; }
.fsd-now { font-family: var(--f-gothic); font-size: calc(44rpx * var(--font-scale)); color: var(--fs-price); letter-spacing: .02em; }
.fsd-was { font-family: var(--f-aleo); font-size: calc(24rpx * var(--font-scale)); color: #6A6E2D; text-decoration: line-through; }
.fsd-meter { margin-top: 18rpx; height: 8rpx; border-radius: 18rpx; background: rgba(0,0,0,.12); position: relative; overflow: hidden; }
.fsd-meter .fsd-meter-bar { position: absolute; top: 0; bottom: 0; left: 0; background: var(--fs-fill); border-radius: 18rpx; }
.fsd-sold { font-family: var(--f-toni); font-size: calc(18rpx * var(--font-scale)); letter-spacing: .12em; color: #6A6E2D; margin-top: 10rpx; }

/* A · Classic — centred, cream tiles with ":" separators, cream CTA pill */
.fsd-classic .fsd-head { text-align: center; padding: 0 48rpx; }
.fsd-classic .fsd-kicker { font-family: var(--f-toni); font-size: calc(24rpx * var(--font-scale)); letter-spacing: .34em; }
.fsd-classic .fsd-title { font-family: var(--f-bear); font-size: calc(62rpx * var(--fs-head) * var(--font-scale)); line-height: 1; margin-top: 16rpx; }
.fsd-classic .fsd-ends { text-align: center; margin-top: 40rpx; }
.fsd-classic .fsd-ends-lbl { font-family: var(--f-toni); font-size: calc(20rpx * var(--font-scale)); letter-spacing: .28em; color: rgba(26,26,23,.7); }
.fsd-classic .fsd-clock { display: flex; justify-content: center; align-items: center; gap: 12rpx; margin-top: 20rpx; }
.fsd-classic .fsd-tile { background: var(--fs-tile); border-radius: 28rpx; width: 132rpx; padding: 22rpx 0 16rpx; text-align: center; }
.fsd-classic .fsd-tile-num { font-family: var(--f-bear); font-size: calc(68rpx * var(--fs-head) * var(--font-scale)); line-height: 1; color: #FFFCF7; }
.fsd-classic .fsd-tile-lbl { font-family: var(--f-toni); font-size: calc(16rpx * var(--font-scale)); letter-spacing: .18em; color: rgba(255,255,255,.7); margin-top: 8rpx; }
.fsd-classic .fsd-colon { font-family: var(--f-bear); font-size: calc(48rpx * var(--font-scale)); color: rgba(26,26,23,.5); }
.fsd-classic .fsd-cta-wrap { display: flex; justify-content: center; margin: 44rpx 0; }
.fsd-classic .fsd-cta { background: var(--fs-panel); color: var(--ink, #1a1a17); border-radius: 999rpx; padding: 28rpx 80rpx; font-family: var(--f-gothic); font-size: calc(36rpx * var(--font-scale)); letter-spacing: .1em; }

/* B · Editorial — left headline, horizontal cream ticker, accent CTA */
.fsd-editorial .fsd-head { padding: 0 40rpx; }
.fsd-editorial .fsd-kicker { font-family: var(--f-toni); font-size: calc(22rpx * var(--font-scale)); letter-spacing: .3em; }
.fsd-editorial .fsd-title { font-family: var(--f-bear); font-size: calc(68rpx * var(--fs-head) * var(--font-scale)); line-height: .95; margin-top: 12rpx; max-width: 600rpx; }
.fsd-editorial .fsd-ticker { display: flex; align-items: stretch; background: var(--fs-panel); border-radius: var(--fs-radius); margin-top: 32rpx; overflow: hidden; }
.fsd-editorial .fsd-seg { flex: 1; text-align: center; padding: 20rpx 0 16rpx; }
.fsd-editorial .fsd-seg-num { font-family: var(--f-gothic); font-size: calc(60rpx * var(--fs-head) * var(--font-scale)); line-height: 1; color: var(--ink, #1a1a17); letter-spacing: .02em; }
.fsd-editorial .fsd-seg-lbl { font-family: var(--f-toni); font-size: calc(16rpx * var(--font-scale)); letter-spacing: .16em; color: #6A6E2D; margin-top: 4rpx; }
.fsd-editorial .fsd-seg-div { width: 2rpx; background: rgba(0,0,0,.12); margin: 20rpx 0; }
.fsd-editorial .fsd-cta-row { display: flex; align-items: center; gap: 24rpx; margin-top: 32rpx; padding: 0 40rpx; }
.fsd-editorial .fsd-cta { background: var(--fs-accent); color: var(--ink, #1a1a17); border: var(--fs-border) solid var(--fs-ink); border-radius: 999rpx; padding: 24rpx 52rpx; font-family: var(--f-gothic); font-size: calc(34rpx * var(--font-scale)); letter-spacing: .08em; box-shadow: 0 6rpx 0 var(--fs-ink); }
.fsd-editorial .fsd-off { font-family: var(--f-aleo); font-size: calc(24rpx * var(--font-scale)); color: rgba(26,26,23,.75); line-height: 1.3; }
.fsd-editorial .fsd-off .cn { font-family: var(--f-yuan); font-weight: 500; font-size: calc(21rpx * var(--font-scale)); }
.fsd-editorial .fsd-cards { margin-top: 40rpx; }

/* C · Urgency — LIVE tag, accent tiles popping on the band, ink CTA */
.fsd-urgency .fsd-head { text-align: center; padding: 0 48rpx; }
.fsd-urgency .fsd-live { display: inline-flex; align-items: center; gap: 14rpx; background: var(--fs-ink); color: var(--fs-accent); border-radius: 999rpx; padding: 8rpx 24rpx; }
.fsd-urgency .fsd-live-dot { width: 14rpx; height: 14rpx; border-radius: 18rpx; background: var(--fs-accent); }
.fsd-urgency .fsd-live-lbl { font-family: var(--f-toni); font-size: calc(20rpx * var(--font-scale)); letter-spacing: .24em; }
.fsd-urgency .fsd-title { font-family: var(--f-bear); font-size: calc(66rpx * var(--fs-head) * var(--font-scale)); line-height: .98; margin-top: 24rpx; }
.fsd-urgency .fsd-sub { font-family: var(--f-yuan); font-weight: 700; font-size: calc(26rpx * var(--font-scale)); color: var(--ink, #1a1a17); margin-top: 12rpx; opacity: .85; }
.fsd-urgency .fsd-clock { display: flex; justify-content: center; gap: 14rpx; margin-top: 36rpx; padding: 0 32rpx; }
.fsd-urgency .fsd-tile { flex: 1; max-width: 160rpx; background: var(--fs-accent); border: var(--fs-border) solid var(--fs-ink); border-radius: 24rpx; padding: 20rpx 0 14rpx; text-align: center; box-shadow: 0 8rpx 0 var(--fs-ink); }
.fsd-urgency .fsd-tile-num { font-family: var(--f-bear); font-size: calc(64rpx * var(--fs-head) * var(--font-scale)); line-height: 1; color: var(--ink, #1a1a17); }
.fsd-urgency .fsd-tile-lbl { font-family: var(--f-toni); font-size: calc(16rpx * var(--font-scale)); letter-spacing: .16em; color: var(--fs-fill); margin-top: 6rpx; }
.fsd-urgency .fsd-cta-wrap { display: flex; justify-content: center; margin: 40rpx 0 44rpx; }
.fsd-urgency .fsd-cta { background: var(--fs-ink); color: var(--fs-accent); border-radius: 999rpx; padding: 28rpx 88rpx; font-family: var(--f-gothic); font-size: calc(36rpx * var(--font-scale)); letter-spacing: .1em; }

/* ── Coupon block ─────────────────────────────────────────────────────── */
.coupon-blk {
  margin: 0 36rpx;
  padding: 32rpx 36rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  position: relative;
  overflow: hidden;
}
.coupon-blk::before, .coupon-blk::after {
  content: '';
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #F2E7DF;
}
.coupon-blk::before { left: -14rpx; }
.coupon-blk::after  { right: -14rpx; }
.cp-disc {
  flex: 0 0 auto;
  min-width: 140rpx;
  text-align: center;
  padding-right: 28rpx;
  border-right: 1rpx dashed currentColor;
}
.cp-big {
  font-family: var(--f-gothic);
  font-weight: 700;
  font-size: calc(56rpx * var(--font-scale));
  letter-spacing: 0.04em;
  line-height: 1;
}
.cp-body { flex: 1; min-width: 0; }
.cp-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.14em;
  opacity: 0.8;
}
.cp-title {
  font-family: var(--f-bear);
  font-weight: 500;
  font-size: calc(30rpx * var(--font-scale));
  line-height: 1.15;
  margin-top: 6rpx;
}
.cp-sub {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  margin-top: 8rpx;
  opacity: 0.8;
}
.cp-code {
  margin-top: 14rpx;
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 6rpx 16rpx;
  border: 1rpx dashed currentColor;
  border-radius: 6rpx;
}
.cp-code-label {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.14em;
  opacity: 0.65;
}
.cp-code-val {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.1em;
}
.cp-code-copy {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.12em;
  opacity: 0.6;
}
.cp-cta {
  flex: 0 0 auto;
  align-self: center;
  display: inline-flex;
  align-items: center;
  padding: 18rpx 24rpx;
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.14em;
  background: rgba(255, 255, 255, 0.92);
  color: #1a1a17;
  border-radius: 8rpx;
}

/* ── Points widget ────────────────────────────────────────────────────── */
.points-blk {
  padding: 40rpx 36rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
}
.pt-star {
  flex: 0 0 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}
.pt-star-glyph {
  font-family: var(--f-gothic);
  font-weight: 700;
  font-size: calc(56rpx * var(--font-scale));
  line-height: 1;
}
.pt-body { flex: 1; min-width: 0; }
.pt-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.14em;
  opacity: 0.85;
}
.pt-title {
  font-family: var(--f-bear);
  font-weight: 500;
  font-size: calc(32rpx * var(--font-scale));
  line-height: 1.15;
  margin-top: 4rpx;
}
.pt-sub {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  margin-top: 8rpx;
  opacity: 0.85;
}
.pt-cta {
  flex: 0 0 auto;
  padding: 14rpx 28rpx;
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.14em;
  background: rgba(255, 255, 255, 0.92);
  color: #1a1a17;
  border-radius: 999rpx;
}

/* ── Top up (tier row) ────────────────────────────────────────────────── */
.topup-blk { padding: 40rpx 36rpx; }
.tu-head { margin-bottom: 26rpx; }
.tu-kicker {
  font-family: var(--f-gothic);
  font-weight: 700;
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.12em;
  color: var(--olive);
}
.tu-title {
  font-family: var(--f-bear);
  font-weight: 700;
  font-size: calc(40rpx * var(--font-scale));
  line-height: 1.08;
  margin-top: 8rpx;
}
.tu-hl {
  background: var(--lime);
  color: var(--ink);
  padding: 0 10rpx;
  border-radius: 6rpx;
}
.tu-row { display: flex; gap: 16rpx; }
.tu-card {
  flex: 1;
  min-width: 0;
  position: relative;
  border: 3rpx solid var(--ink);
  border-radius: 20rpx;
  padding: 20rpx 18rpx 22rpx;
}
.tu-card--cream { background: #FBF7EF; }
.tu-card--amber { background: var(--papaya); }
.tu-card--ink   { background: var(--ink); color: #fff; }
.tu-best {
  position: absolute;
  top: -18rpx;
  right: 16rpx;
  transform: rotate(3deg);
  font-family: var(--f-gothic);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.05em;
  background: var(--berry);
  color: #fff;
  padding: 7rpx 16rpx;
  border-radius: 8rpx;
}
.tu-num {
  font-family: var(--f-gothic);
  font-weight: 700;
  font-size: calc(19rpx * var(--font-scale));
  letter-spacing: 0.04em;
  color: var(--olive);
}
.tu-card--ink .tu-num { color: var(--lime); }
.tu-amt {
  font-family: var(--f-gothic);
  font-weight: 700;
  font-size: calc(52rpx * var(--font-scale));
  line-height: 1;
  margin: 10rpx 0 16rpx;
}
.tu-pts {
  display: inline-block;
  font-family: var(--f-gothic);
  font-weight: 700;
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.04em;
  background: var(--ink);
  color: var(--lime);
  padding: 7rpx 16rpx;
  border-radius: 8rpx;
}
.tu-card--ink .tu-pts { background: var(--lime); color: var(--ink); }
.tu-foot {
  font-family: var(--f-gothic);
  font-weight: 700;
  font-size: calc(17rpx * var(--font-scale));
  letter-spacing: 0.02em;
  color: var(--olive);
  margin-top: 16rpx;
}
.tu-card--ink .tu-foot { color: rgba(255, 255, 255, 0.6); }

/* ── Review card / carousel ───────────────────────────────────────────── */
.review-blk {
  /* Always paints a bg (defaults to oat-milk = page colour, so it's normally
     invisible). Needs vertical padding so a contrasting bg — e.g. white — gives
     the testimonial breathing room instead of cropping it at the top/bottom. */
  padding: 40rpx 44rpx;
}
.rv-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.18em;
  opacity: 0.75;
  text-align: center;
  margin-bottom: 16rpx;
}
.rv-item { text-align: center; }
.rv-stars {
  display: flex;
  justify-content: center;
  gap: 4rpx;
}
.rv-star {
  font-size: calc(32rpx * var(--font-scale));
  letter-spacing: 0.04em;
}
.rv-star.on  { color: #F2CA6C; }
.rv-star.off { color: rgba(0, 0, 0, 0.15); }
.rv-quote {
  font-family: var(--f-bear);
  font-weight: 500;
  font-size: calc(30rpx * var(--font-scale));
  line-height: 1.4;
  margin-top: 20rpx;
  white-space: pre-line;  /* honor the author's manual line breaks (\n) */
}
.rv-byline {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}
.rv-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-family: var(--f-bear);
  font-weight: 700;
  font-size: calc(28rpx * var(--font-scale));
  color: rgba(0, 0, 0, 0.5);
}
.rv-avatar-img { width: 100%; height: 100%; }
.rv-byline-text {
  font-family: var(--f-aleo);
  text-align: left;
}
.rv-name {
  font-weight: 700;
  font-size: calc(24rpx * var(--font-scale));
}
.rv-sub {
  opacity: 0.65;
  font-size: calc(20rpx * var(--font-scale));
  margin-top: 4rpx;
  letter-spacing: 0.04em;
}
/* Carousel — <swiper> can't auto-size, so its height is set inline from a
   per-block measurement (reviewSwiperH, see measureReviewSwiper) to fit the
   tallest review. The 360rpx here is just the floor before measurement. */
.review-carousel .rv-swiper {
  width: 100%;
  min-height: 360rpx;
}

/* ── Review — Editorial / Riso pop / Spotlight (inset-card layouts) ───────
   The card fill / border / accent / avatar-circle ride on inline --rv-*
   custom props (set only when the author overrides them); brand defaults
   live here. Mirrors public/cms.html + public/storefront.html. */
.review-blk .rv-card { box-sizing: border-box; position: relative; }
.rv-mono {
  width: 80rpx; height: 80rpx; border-radius: 50%;
  background: var(--rv-circle, #7BBD3B); border: 4rpx solid #1a1a17; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--f-bear); font-weight: 700;
  font-size: calc(38rpx * var(--font-scale)); color: #1a1a17;
}
.rv-mono-img { width: 100%; height: 100%; border-radius: 50%; }
.rv-person { display: flex; align-items: center; gap: 22rpx; }
.rv-person-text { text-align: left; }
.rv-person-text .rv-name {
  font-family: var(--f-gothic); font-size: calc(34rpx * var(--font-scale));
  font-weight: 400; letter-spacing: 0.04em; line-height: 1;
}
.rv-role {
  font-family: var(--f-aleo); font-size: calc(22rpx * var(--font-scale));
  opacity: 0.7; margin-top: 6rpx;
}
.rv-stars-left { justify-content: flex-start; }
.rv-quote-left { text-align: left; }

/* A · Editorial — calm centered card, hairline border */
.review-editorial .rv-card {
  background: var(--rv-card, #FFFCF7);
  border: 3rpx solid var(--rv-border, #365329);
  border-radius: 32rpx; padding: 44rpx 40rpx 36rpx; text-align: center;
  box-shadow: 0 24rpx 52rpx -36rpx rgba(54, 83, 41, 0.6);
}
.ed-kicker {
  display: flex; align-items: center; justify-content: center; gap: 18rpx;
  color: var(--rv-accent, #6A6E2D);
}
.ed-tick { width: 32rpx; height: 3rpx; background: currentColor; }
.ed-klabel {
  font-family: var(--f-toni); font-size: calc(18rpx * var(--font-scale)); letter-spacing: 0.28em;
}
.rv-divider { height: 2rpx; background: rgba(0, 0, 0, 0.12); margin: 32rpx 0 28rpx; }
.review-editorial .rv-person { justify-content: center; }

/* B · Riso pop — ink border + offset shadow, sticker badge + verified stamp */
.review-riso .rv-card {
  background: var(--rv-card, #FFFCF7);
  border: 4rpx solid var(--rv-border, #1a1a17);
  border-radius: 20rpx; padding: 44rpx 36rpx 32rpx; margin-top: 20rpx;
  box-shadow: 8rpx 10rpx 0 #1a1a17;
}
.riso-badge {
  position: absolute; top: -24rpx; left: 36rpx; z-index: 4;
  background: var(--rv-accent, #CCD900); border: 3rpx solid #1a1a17;
  box-shadow: 4rpx 4rpx 0 #1a1a17; transform: rotate(-4deg);
  padding: 8rpx 16rpx; display: flex; gap: 2rpx;
}
.riso-badge-star { font-size: calc(22rpx * var(--font-scale)); color: #1a1a17; line-height: 1; }
.riso-stamp {
  position: absolute; top: 28rpx; right: 24rpx;
  border: 4rpx solid var(--rv-accent, #E96174); color: var(--rv-accent, #E96174);
  transform: rotate(7deg); padding: 4rpx 14rpx; text-align: center; line-height: 1.05;
  font-family: var(--f-gothic); font-size: calc(22rpx * var(--font-scale)); letter-spacing: 0.08em;
}
.riso-stamp-cn {
  display: block; font-family: var(--f-toni);
  font-size: calc(12rpx * var(--font-scale)); letter-spacing: 0.14em; margin-top: 2rpx;
}
.riso-kicker {
  font-family: var(--f-toni); font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.24em; color: #6A6E2D;
}
.review-riso .rv-quote { margin-top: 20rpx; }
.review-riso .rv-person { margin-top: 32rpx; }
.rv-mono-sticker {
  border-radius: 8rpx; transform: rotate(-3deg);
  box-shadow: 4rpx 4rpx 0 #1a1a17; background: #fff; padding: 4rpx;
}
.rv-mono-inner {
  display: flex; width: 100%; height: 100%; align-items: center; justify-content: center;
  background: var(--rv-circle, #7BBD3B); font-family: var(--f-bear); font-weight: 700;
  font-size: calc(36rpx * var(--font-scale));
}

/* C · Spotlight — header band + dark hero card + thumbnail rail */
.spot-head {
  display: flex; align-items: flex-end; justify-content: space-between; margin-bottom: 28rpx;
}
.spot-kicker {
  font-family: var(--f-toni); font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.24em; color: #6A6E2D;
}
.spot-title {
  font-family: var(--f-bear); font-weight: 700; font-size: calc(44rpx * var(--font-scale));
  line-height: 0.98; margin-top: 8rpx;
}
.spot-nav { display: flex; gap: 12rpx; }
.spot-arrow {
  width: 60rpx; height: 60rpx; border-radius: 50%; border: 3rpx solid #1a1a17;
  display: flex; align-items: center; justify-content: center;
  background: #FFFCF7; font-size: 32rpx; color: #1a1a17;
}
.spot-arrow.next { background: var(--rv-accent, #CCD900); }
.spot-stage { position: relative; }
.spot-peek {
  position: absolute; top: 20rpx; right: -16rpx; bottom: 20rpx; width: 48rpx;
  background: #FFFCF7; border: 3rpx solid #1a1a17; border-radius: 24rpx; opacity: 0.5;
}
.review-spotlight .rv-card {
  background: var(--rv-card, #365329); color: var(--rv-cardfg, #FFFCF7);
  border-radius: 32rpx; padding: 36rpx 36rpx 32rpx;
  box-shadow: 0 24rpx 52rpx -36rpx rgba(54, 83, 41, 0.6);
}
.spot-top { display: flex; align-items: center; justify-content: space-between; }
.spot-count {
  font-family: var(--f-gothic); font-size: calc(26rpx * var(--font-scale));
  letter-spacing: 0.08em; color: var(--rv-accent, #CCD900);
}
.review-spotlight .rv-quote { text-align: left; margin-top: 24rpx; }
.review-spotlight .rv-person { margin-top: 28rpx; }
.review-spotlight .rv-role { opacity: 0.82; }
.spot-rail { display: flex; gap: 14rpx; margin-top: 24rpx; }
.spot-thumb {
  width: 64rpx; height: 64rpx; border-radius: 50%; border: 3rpx solid #1a1a17;
  background: var(--rv-circle, #7BBD3B); box-sizing: border-box;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--f-bear); font-weight: 700; font-size: calc(30rpx * var(--font-scale));
  color: #1a1a17; opacity: 0.5;
}
.spot-thumb.on { opacity: 1; box-shadow: 0 0 0 4rpx #F2E7DF, 0 0 0 7rpx #1a1a17; }

/* ── Store info ───────────────────────────────────────────────────────── */
.store-blk {
  margin: 0 36rpx;
  padding: 36rpx 36rpx 40rpx;
  border-radius: 12rpx;
}
.st-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.14em;
  opacity: 0.8;
}
.st-title {
  font-family: var(--f-bear);
  font-weight: 500;
  font-size: calc(34rpx * var(--font-scale));
  line-height: 1.15;
  margin-top: 10rpx;
}
.st-row {
  margin-top: 18rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}
.st-icon {
  font-size: calc(24rpx * var(--font-scale));
  line-height: 1.4;
  opacity: 0.85;
}
.st-val {
  flex: 1;
  font-family: var(--f-aleo);
  font-size: calc(24rpx * var(--font-scale));
  line-height: 1.4;
}
.st-phone {
  text-decoration: underline;
}
.st-cta {
  display: inline-block;
  margin-top: 24rpx;
  padding: 14rpx 28rpx;
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.14em;
  background: rgba(255, 255, 255, 0.92);
  color: #1a1a17;
  border-radius: 8rpx;
}
.st-cards { display: flex; flex-direction: column; }
.st-card + .st-card {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
}
.st-status {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
}
.st-dot {
  width: 14rpx; height: 14rpx; border-radius: 50%;
  box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.25);
}
.st-status-lbl { font-weight: 600; }
.st-hours { opacity: 0.7; }
.st-eta {
  margin-top: 6rpx;
  font-family: var(--f-aleo);
  font-size: calc(20rpx * var(--font-scale));
  opacity: 0.8;
}

/* ── Voting block — 4 views (teaser/peek/inline/past_result) ───────────── */
.voting-blk {
  margin: 0 36rpx;
  padding: 32rpx;
  border-radius: 8rpx;
  position: relative;
}
.voting-blk .voting-row {
  display: flex; align-items: center; gap: 24rpx;
}
.voting-blk.voting-teaser .voting-row { padding: 4rpx 0; }
.voting-blk .vb-body { flex: 1; min-width: 0; }

.voting-blk .vb-kicker {
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.18em; opacity: 0.8;
}
.voting-blk .vb-title {
  font-family: var(--f-bear); font-weight: 500;
  font-size: calc(34rpx * var(--font-scale));
  line-height: 1.15; margin-top: 10rpx;
}
.voting-blk .vb-q {
  font-family: var(--f-bear); font-weight: 500;
  font-size: calc(32rpx * var(--font-scale));
  line-height: 1.12;
  margin-top: 8rpx;
}
.voting-blk .vb-sub {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  line-height: 1.4; margin-top: 10rpx; opacity: 0.85;
}
.voting-blk .vb-meta {
  margin-top: 12rpx;
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.16em;
  opacity: 0.7;
}
.voting-blk .vb-status-row {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 10rpx;
}
.voting-blk .vb-status-pill {
  display: inline-block;
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.12em;
  color: var(--berry);
}
.voting-blk .vb-status-pill.closed { color: var(--olive); }
.voting-blk .vb-cat {
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.12em; opacity: 0.7;
}
.voting-blk .vb-cta {
  margin-top: 22rpx;
  display: inline-block;
  padding: 16rpx 28rpx;
  background: var(--ink); color: #fff;
  font-family: var(--f-gothic); font-weight: 700;
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.12em;
  border-radius: 999rpx;
  text-transform: uppercase;
}
.voting-blk .vb-cta-pill {
  margin-top: 0;
  flex-shrink: 0;
  padding: 18rpx 28rpx;
}
.voting-blk .vb-stub {
  font-family: var(--f-aleo); font-style: italic;
  font-size: calc(22rpx * var(--font-scale));
  color: var(--olive); text-align: center;
  padding: 20rpx 0;
}

/* Inline view — A/B/C/D options + cast button */
.voting-blk .vb-opts {
  margin-top: 22rpx;
  display: flex; flex-direction: column; gap: 12rpx;
}
.voting-blk .vb-opt {
  position: relative;
  border: 3rpx solid rgba(0, 0, 0, 0.4);
  padding: 18rpx 22rpx;
  overflow: hidden;
  border-radius: 4rpx;
}
.voting-blk .vb-opt.on,
.voting-blk .vb-opt.opt-results { border-color: var(--ink); }
.voting-blk .vb-opt-fill {
  position: absolute; left: 0; top: 0; bottom: 0;
  background: rgba(204, 217, 0, 0.25);
  transition: width 0.4s ease;
  z-index: 0;
}
.voting-blk .vb-opt-fill.fill-mine { background: var(--lime); }
.voting-blk .vb-opt-row {
  position: relative; z-index: 1;
  display: flex; align-items: center; gap: 20rpx;
}
.voting-blk .vb-opt-letter {
  width: 50rpx; height: 50rpx; border-radius: 50%;
  border: 3rpx solid var(--ink);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--f-gothic); font-weight: 700;
  font-size: calc(24rpx * var(--font-scale));
  flex-shrink: 0;
}
.voting-blk .vb-opt-letter.on {
  background: var(--ink); color: var(--lime);
}
.voting-blk .vb-opt-label {
  flex: 1; min-width: 0;
  font-family: var(--f-bear); font-weight: 500;
  font-size: calc(28rpx * var(--font-scale));
  line-height: 1;
}
.voting-blk .vb-opt-tick {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  border: 3rpx solid var(--ink);
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--f-bear); font-size: calc(22rpx * var(--font-scale));
}
.voting-blk .vb-opt-tick.on {
  background: var(--lime);
}
.voting-blk .vb-opt-pct {
  text-align: right; flex-shrink: 0;
}
.voting-blk .vb-opt-pct-num {
  font-family: var(--f-gothic); font-weight: 700;
  font-size: calc(30rpx * var(--font-scale)); line-height: 1;
}
.voting-blk .vb-opt-pct-lbl {
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(14rpx * var(--font-scale));
  letter-spacing: 0.1em; opacity: 0.7;
  margin-top: 4rpx;
}
.voting-blk .vb-voted {
  margin-top: 22rpx;
  display: flex; align-items: center; gap: 14rpx;
  padding: 18rpx 22rpx;
  border: 3rpx solid var(--ink);
}
.voting-blk .vb-voted-dot {
  width: 36rpx; height: 36rpx; border-radius: 50%;
  background: var(--ink);
  display: flex; align-items: center; justify-content: center;
  font-family: var(--f-bear); font-size: calc(22rpx * var(--font-scale));
  flex-shrink: 0;
}
.voting-blk .vb-voted-text {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
}
.voting-blk.voting-inline .vb-cta {
  display: block;
  width: 100%; box-sizing: border-box;
  text-align: center;
  margin-top: 22rpx;
  background: rgba(0, 0, 0, 0.08);
  color: var(--olive);
  border-radius: 0;
}
.voting-blk.voting-inline .vb-cta.on {
  background: var(--ink);
  color: var(--lime);
}
.voting-blk .vb-foot {
  margin-top: 14rpx;
  text-align: center;
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.15em; opacity: 0.6;
}

/* Past-result view — winner card */
.voting-blk .vb-winner {
  margin-top: 16rpx;
  display: flex; align-items: center; gap: 16rpx;
}
.voting-blk .vb-winner-label {
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.16em;
  color: var(--olive);
}
.voting-blk .vb-winner-name {
  font-family: var(--f-bear); font-weight: 500;
  font-size: calc(26rpx * var(--font-scale));
  padding: 6rpx 16rpx;
  border: 3rpx solid var(--ink);
  border-radius: 4rpx;
}
.voting-blk .vb-winner-meta {
  margin-left: auto;
  font-family: var(--f-aleo);
  font-size: calc(20rpx * var(--font-scale));
  color: var(--olive);
}

/* ─── Affiliate block ─────────────────────────────────────────── */
.aff-blk {
  margin: 0 36rpx;
  padding: 32rpx 32rpx 28rpx;
  border-radius: 8rpx;
}
.aff-head { margin-bottom: 22rpx; }
.aff-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.22em;
  opacity: 0.7;
}
.aff-title {
  font-family: var(--f-bear);
  font-weight: 500;
  font-size: calc(40rpx * var(--font-scale));
  line-height: 1.0;
  padding-top: 4rpx;
  margin-top: 6rpx;
  letter-spacing: -0.01em;
  margin-top: 6rpx;
}
.aff-sub {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  line-height: 1.4;
  margin-top: 12rpx;
  opacity: 0.85;
}
.aff-code-row {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
}
.aff-code-pill {
  flex: 1;
  background: rgba(0,0,0,0.08);
  border: 2rpx solid var(--ink);
  padding: 14rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}
.aff-code-lbl {
  display: block;
  font-family: var(--f-toni);
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.22em;
  opacity: 0.7;
}
.aff-code-val {
  display: block;
  font-family: var(--f-bear);
  font-size: calc(34rpx * var(--font-scale));
  line-height: 1;
  letter-spacing: -0.01em;
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.aff-copy {
  background: var(--ink);
  color: #fff;
  padding: 0 24rpx;
  font-family: var(--f-gothic);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.12em;
  display: flex;
  align-items: center;
  text-transform: uppercase;
}
.aff-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
}
.aff-share {
  flex: 0 0 auto;
  background: #1AAD19;
  color: #fff;
  font-family: var(--f-gothic);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.12em;
  padding: 12rpx 26rpx;
  border: 2rpx solid var(--ink);
  border-radius: 0;
  line-height: 1.4;
  text-transform: uppercase;
}
.aff-share::after { border: none; }
.aff-stats {
  flex: 1;
  font-family: var(--f-toni);
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.08em;
  opacity: 0.7;
  text-align: right;
}
.aff-signin {
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.12em;
  padding: 16rpx 20rpx;
  background: rgba(0,0,0,0.08);
  border: 2rpx dashed var(--ink);
  text-align: center;
}
.aff-disabled {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  padding: 18rpx 20rpx;
  border: 2rpx dashed var(--ink);
  text-align: center;
  opacity: 0.7;
}

/* ─── Affiliate · STRIP view (compact horizontal) ─── */
.aff-strip {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
}
.aff-strip-left { flex: 1; min-width: 0; }
.aff-strip-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.22em;
  opacity: 0.7;
}
.aff-strip-code-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  margin-top: 4rpx;
  min-width: 0;
}
.aff-strip-code {
  font-family: var(--f-bear);
  font-size: calc(30rpx * var(--font-scale));
  line-height: 1;
  letter-spacing: -0.01em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.aff-strip-stats {
  font-family: var(--f-toni);
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.08em;
  opacity: 0.6;
  white-space: nowrap;
}
.aff-strip-copy,
.aff-strip-share,
.aff-strip-cta {
  flex: 0 0 auto;
  background: var(--ink);
  color: #fff;
  padding: 12rpx 18rpx;
  font-family: var(--f-gothic);
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.1em;
  border: none;
  border-radius: 0;
  line-height: 1.2;
  text-transform: uppercase;
}
.aff-strip-share { background: #1AAD19; }
.aff-strip-share::after { border: none; }
.aff-strip-disabled {
  font-family: var(--f-toni);
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.08em;
  opacity: 0.6;
}

/* ─── Affiliate · STAT view (big earned-¥ hero) ─── */
.aff-stat {
  text-align: center;
  padding: 40rpx 32rpx 32rpx;
}
.aff-stat-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.28em;
  opacity: 0.75;
}
.aff-stat-num {
  font-family: var(--f-bear);
  font-size: calc(120rpx * var(--font-scale));
  line-height: 0.95;
  letter-spacing: -0.02em;
  margin-top: 12rpx;
}
.aff-stat-sub {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  line-height: 1.4;
  margin-top: 8rpx;
  opacity: 0.8;
}
.aff-stat-code-pill {
  display: inline-block;
  margin-top: 24rpx;
  background: rgba(255,255,255,0.12);
  border: 2rpx dashed currentColor;
  padding: 12rpx 22rpx;
  font-family: var(--f-bear);
  font-size: calc(30rpx * var(--font-scale));
  letter-spacing: 0.02em;
  line-height: 1;
}
.aff-stat-actions {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-top: 22rpx;
}
.aff-stat-copy,
.aff-stat-share,
.aff-stat-cta {
  background: currentColor;
  padding: 14rpx 24rpx;
  font-family: var(--f-gothic);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.12em;
  text-transform: uppercase;
  border: none;
  border-radius: 0;
  line-height: 1.3;
}
/* For stat-view we paint the button text in the card's bg colour so it
   reads as inverse-on-currentColor without needing extra wiring. */
.aff-stat-copy { color: #1a1a17; opacity: .92; }
.aff-stat-share {
  background: #1AAD19;
  color: #fff;
}
.aff-stat-share::after { border: none; }
.aff-stat-cta {
  display: inline-block;
  margin-top: 20rpx;
  color: #1a1a17;
}
.aff-stat-disabled {
  margin-top: 16rpx;
  font-family: var(--f-aleo);
  opacity: 0.7;
}

/* ─── Affiliate · RECEIPT view (paper / dashed-edges) ─── */
.aff-receipt {
  margin: 28rpx 60rpx;
  padding: 28rpx 28rpx 32rpx;
  border: 2rpx dashed var(--ink);
  border-radius: 0;
  position: relative;
  box-shadow: 8rpx 8rpx 0 var(--ink);
}
.aff-receipt-stub {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.3em;
  text-align: center;
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid var(--ink);
  opacity: 0.75;
}
.aff-receipt-kicker {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.22em;
  margin-top: 18rpx;
  opacity: 0.7;
}
.aff-receipt-title {
  font-family: var(--f-bear);
  font-size: calc(34rpx * var(--font-scale));
  line-height: 1.05;
  letter-spacing: -0.01em;
  margin-top: 4rpx;
}
.aff-receipt-sep {
  font-family: var(--f-gothic);
  font-size: calc(20rpx * var(--font-scale));
  text-align: center;
  margin: 16rpx 0;
  opacity: 0.55;
  letter-spacing: 0.06em;
  white-space: nowrap;
  overflow: hidden;
}
.aff-receipt-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
  margin: 6rpx 0;
}
.aff-receipt-row-muted { opacity: 0.7; }
.aff-receipt-lbl {
  font-family: var(--f-toni);
  font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.22em;
  opacity: 0.75;
}
.aff-receipt-val {
  font-family: var(--f-bear);
  font-size: calc(26rpx * var(--font-scale));
  line-height: 1.1;
  letter-spacing: -0.01em;
  text-align: right;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 60%;
}
.aff-receipt-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
}
.aff-receipt-copy,
.aff-receipt-share {
  flex: 1;
  background: var(--ink);
  color: #fff;
  padding: 14rpx 0;
  text-align: center;
  font-family: var(--f-gothic);
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.12em;
  border: none;
  border-radius: 0;
  line-height: 1.3;
  text-transform: uppercase;
}
.aff-receipt-share { background: #1AAD19; }
.aff-receipt-share::after { border: none; }
.aff-receipt-signin,
.aff-receipt-disabled {
  font-family: var(--f-aleo);
  font-size: calc(20rpx * var(--font-scale));
  text-align: center;
  padding: 12rpx 0;
  opacity: 0.7;
}

/* ─── Greeting block ──────────────────────────────────────────────────── */
.greet-blk {
  margin: 0 44rpx;
  padding: 32rpx 36rpx 28rpx;
  border: 0;
  position: relative;
}
.gr-kicker {
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--olive);
}
.gr-headline {
  font-family: var(--f-bear);
  font-size: calc(64rpx * var(--font-scale));
  /* Tight leading (1.0) keeps multi-line EN like "Good afternoon, /
     mimi." from looking airy. padding-top absorbs the few rpx CN
     glyphs overflow upward so the kicker doesn't get bitten into. */
  line-height: 1.0;
  padding-top: 6rpx;
  margin-top: 10rpx;
}
.gr-points {
  margin-top: 14rpx;
  font-family: var(--f-gothic);
  font-size: calc(28rpx * var(--font-scale));
  letter-spacing: 0.06em;
}
.gr-cta {
  margin-top: 14rpx;
  font-family: var(--f-toni);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.16em;
  text-decoration: underline;
  text-transform: uppercase;
}

/* ── Notification bar (standalone block) ─────────────────────────────────
   Unread-updates strip. Renders only when notifUnread>0. The operator sets
   background / text / button colours per block (inline styles); the view
   variant picks the silhouette. .nbar (outer) stays layout-neutral so the
   block collapses to nothing when there's no unread row. */
.nbar-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 36rpx;
}
.nbar-icon {
  font-size: calc(28rpx * var(--font-scale));
  line-height: 1;
  flex-shrink: 0;
}
.nbar-icon.fresh {
  /* Subtle 2s breathing pulse for newly-arrived unreads (within last 6h). */
  animation: nbar-pulse 2s ease-in-out infinite;
}
@keyframes nbar-pulse {
  0%,100% { transform: scale(1);    opacity: 1;   }
  50%     { transform: scale(1.22); opacity: 0.85;}
}
.nbar-text {
  flex: 1;
  min-width: 0;
  font-family: var(--f-toni);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.04em;
  line-height: 1.2;
  /* One-line ellipsis so a long broadcast title collapses gracefully. */
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.nbar-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  border-radius: 999rpx;
  font-family: var(--f-bear);
  font-size: calc(24rpx * var(--font-scale));
  line-height: 1;
  /* When no button colour is set the chip is transparent and the arrow
     simply inherits the row's text colour. */
  background: transparent;
}
/* view: bar (default) — slim full-width strip, square edges. */
.nbar-bar .nbar-row { border-radius: 0; }
/* view: card — rounded inset card with a side gutter. */
.nbar-card { padding: 0 22rpx; }
.nbar-card .nbar-row { border-radius: 24rpx; padding: 22rpx 32rpx; }
/* view: pill — compact, centred, fully-rounded; text not stretched. */
.nbar-pill { padding: 0 22rpx; display: flex; justify-content: center; }
.nbar-pill .nbar-row {
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
  display: inline-flex;
  max-width: 100%;
}
.nbar-pill .nbar-text { flex: 0 1 auto; }
/* view: banner — taller, generous padding, larger icon + text. */
.nbar-banner .nbar-row { padding: 30rpx 40rpx; gap: 18rpx; }
.nbar-banner .nbar-icon { font-size: calc(40rpx * var(--font-scale)); }
.nbar-banner .nbar-text { font-size: calc(26rpx * var(--font-scale)); }
.nbar-banner .nbar-btn { width: 52rpx; height: 52rpx; font-size: calc(30rpx * var(--font-scale)); }

/* Greeting — view variants */
.gr-headline-sm { font-size: calc(38rpx * var(--font-scale)); line-height: 1.05; padding-top: 4rpx; margin-top: 8rpx; }
.gr-headline-lg { font-size: calc(88rpx * var(--font-scale)); line-height: 1.0; padding-top: 8rpx; }

/* Banner = full-bleed colour band: drop the side inset so the field
   stretches edge-to-edge. Inner copy keeps its own horizontal padding. */
.greet-blk-banner { border: 0; margin: 0; padding: 44rpx 44rpx 38rpx; }
.greet-blk-banner .gr-kicker { opacity: 0.6; }

.greet-blk-inline { padding: 22rpx 28rpx; }
.gr-inline-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.gr-inline-copy { flex: 1; min-width: 0; }
.gr-pts-pill {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border: 2rpx solid currentColor;
  border-radius: 999rpx;
  font-family: var(--f-gothic);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.04em;
}

/* Split, like Banner, is a full-width greeting band — drop the side inset
   so the coloured field reaches both edges; copy keeps a 44rpx gutter.
   border:0 so it doesn't inherit the base .greet-blk black outline, which
   (with margin:0) painted a stray black rule across the screen. */
.greet-blk-split { border: 0; margin: 0; padding: 28rpx 44rpx; }
.gr-split-row {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
}
.gr-split-left { flex: 1; min-width: 0; }
.gr-split-wallet {
  flex-shrink: 0;
  min-width: 160rpx;
  padding: 18rpx 22rpx;
  border: 3rpx solid currentColor;
  border-radius: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.gr-wallet-num {
  font-family: var(--f-bear);
  font-size: calc(56rpx * var(--font-scale));
  line-height: 1;
}
.gr-wallet-lbl {
  margin-top: 8rpx;
  font-family: var(--f-gothic);
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.06em;
  opacity: 0.85;
  text-align: center;
}

/* ═══ Welcome-back design directions (classic / wallet / coin) ════════════
   Full-bleed mood band + time-based greeting + points/wallet. Every colour
   rides on a --gr-* var the renderer sets inline (band/accent/kicker/badge/
   ink), so the inspector can recolour each piece; energy drives --gr-head
   (type scale), --gr-border, --gr-radius and --gr-coin (coin depth). */
.greet-blk-classic, .greet-blk-wallet, .greet-blk-coin {
  margin: 0;
  padding: 56rpx 44rpx;
  border: 0;
  position: relative;
  overflow: hidden;
}
.greet-blk-classic .grd-kicker,
.greet-blk-wallet .grd-kicker,
.greet-blk-coin .grd-kicker {
  font-family: var(--f-toni);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.3em;
  text-transform: uppercase;
  color: var(--gr-kicker);
}
.greet-blk-classic .grd-top,
.greet-blk-coin .grd-top { display: flex; align-items: center; gap: 14rpx; }

/* Classic — greeting left, accent-outlined points card right */
.greet-blk-classic .grd-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 32rpx; }
.greet-blk-classic .grd-col { flex: 1; min-width: 0; }
.greet-blk-classic .grd-head {
  font-family: var(--f-bear);
  font-size: calc(66rpx * var(--gr-head) * var(--font-scale));
  line-height: 0.98; color: var(--gr-ink); margin-top: 20rpx;
}
.greet-blk-classic .grd-name-br { display: block; }
.greet-blk-classic .grd-cn { font-family: var(--f-yuan); font-weight: 700; font-size: calc(26rpx * var(--font-scale)); color: var(--gr-kicker); margin-top: 12rpx; }
.greet-blk-classic .grd-link { display: inline-flex; align-items: center; margin-top: 32rpx; padding-bottom: 6rpx; border-bottom: var(--gr-border) solid var(--gr-ink); }
.greet-blk-classic .grd-link-lbl { font-family: var(--f-gothic); font-size: calc(32rpx * var(--font-scale)); letter-spacing: 0.08em; color: var(--gr-ink); }
.greet-blk-classic .grd-link-ar { font-family: var(--f-gothic); font-size: calc(32rpx * var(--font-scale)); color: var(--gr-ink); }
.greet-blk-classic .grd-pts-card {
  flex-shrink: 0; width: 176rpx; box-sizing: border-box;
  border: var(--gr-border) solid var(--gr-accent); border-radius: var(--gr-radius);
  padding: 28rpx 0; text-align: center;
}
.greet-blk-classic .grd-pts-num { font-family: var(--f-bear); font-size: calc(88rpx * var(--gr-head) * var(--font-scale)); line-height: 1; color: var(--gr-accent); }
.greet-blk-classic .grd-pts-unit { font-family: var(--f-gothic); font-size: calc(26rpx * var(--font-scale)); letter-spacing: 0.06em; color: var(--gr-accent); margin-top: 12rpx; }

/* Wallet — greeting on top, split wallet/points bar below */
.greet-blk-wallet .grd-top { display: flex; align-items: center; gap: 16rpx; }
.greet-blk-wallet .grd-head { font-family: var(--f-bear); font-size: calc(64rpx * var(--gr-head) * var(--font-scale)); line-height: 1; color: var(--gr-ink); margin-top: 20rpx; }
.greet-blk-wallet .grd-bar { display: flex; align-items: stretch; border: var(--gr-border) solid var(--gr-accent); border-radius: var(--gr-radius); margin-top: 36rpx; overflow: hidden; }
.greet-blk-wallet .grd-seg { flex: 1; padding: 24rpx 32rpx; }
.greet-blk-wallet .grd-seg-lbl { font-family: var(--f-toni); font-size: calc(18rpx * var(--font-scale)); letter-spacing: 0.2em; text-transform: uppercase; color: var(--gr-kicker); }
.greet-blk-wallet .grd-seg-val { font-family: var(--f-bear); font-size: calc(48rpx * var(--gr-head) * var(--font-scale)); line-height: 1; color: var(--gr-accent); margin-top: 8rpx; }
.greet-blk-wallet .grd-seg-pts { display: flex; align-items: baseline; gap: 12rpx; margin-top: 8rpx; }
.greet-blk-wallet .grd-seg-num { font-family: var(--f-bear); font-size: calc(48rpx * var(--gr-head) * var(--font-scale)); line-height: 1; color: var(--gr-accent); }
.greet-blk-wallet .grd-seg-unit { font-family: var(--f-gothic); font-size: calc(24rpx * var(--font-scale)); letter-spacing: 0.05em; color: var(--gr-kicker); }
.greet-blk-wallet .grd-bar-div { width: 4rpx; background: var(--gr-accent); opacity: 0.5; margin: 20rpx 0; }
.greet-blk-wallet .grd-bar-arrow { background: var(--gr-accent); color: var(--gr-ink); display: flex; align-items: center; padding: 0 32rpx; font-family: var(--f-gothic); font-size: calc(40rpx * var(--font-scale)); }

/* Coin — name in accent, points coin + pill CTA */
.greet-blk-coin .grd-halftone { position: absolute; top: 0; right: 0; width: 300rpx; height: 300rpx; opacity: var(--gr-halftone); pointer-events: none; background-image: radial-gradient(var(--gr-ink) 3rpx, transparent 3.4rpx); background-size: 20rpx 20rpx; }
.greet-blk-coin .grd-row { position: relative; display: flex; align-items: flex-start; justify-content: space-between; gap: 32rpx; }
.greet-blk-coin .grd-col { flex: 1; min-width: 0; }
.greet-blk-coin .grd-top-accent { color: var(--gr-accent); }
.greet-blk-coin .grd-top-accent .grd-kicker { color: var(--gr-accent); }
.greet-blk-coin .grd-head { font-family: var(--f-bear); font-size: calc(66rpx * var(--gr-head) * var(--font-scale)); line-height: 0.98; color: var(--gr-ink); margin-top: 20rpx; }
.greet-blk-coin .grd-name { display: block; color: var(--gr-accent); }
.greet-blk-coin .grd-pill { display: inline-flex; align-items: center; margin-top: 32rpx; background: var(--gr-accent); color: var(--gr-ink); border-radius: 999rpx; padding: 18rpx 32rpx; }
.greet-blk-coin .grd-pill-lbl { font-family: var(--f-gothic); font-size: calc(30rpx * var(--font-scale)); letter-spacing: 0.06em; color: var(--gr-ink); }
.greet-blk-coin .grd-coin-wrap { flex-shrink: 0; text-align: center; }
.greet-blk-coin .grd-coin { position: relative; width: 164rpx; height: 164rpx; border-radius: 999rpx; background: var(--gr-accent); border: 4rpx solid var(--gr-ink); display: flex; align-items: center; justify-content: center; box-shadow: var(--gr-coin); }
.greet-blk-coin .grd-coin-num { font-family: var(--f-bear); font-size: calc(80rpx * var(--gr-head) * var(--font-scale)); line-height: 1; color: var(--gr-ink); }
.greet-blk-coin .grd-coin-star { position: absolute; top: -16rpx; right: -12rpx; background: var(--gr-badge); border: 3rpx solid var(--gr-ink); color: var(--gr-ink); font-size: calc(22rpx * var(--font-scale)); width: 44rpx; height: 44rpx; border-radius: 999rpx; display: flex; align-items: center; justify-content: center; }
.greet-blk-coin .grd-coin-unit { font-family: var(--f-gothic); font-size: calc(26rpx * var(--font-scale)); letter-spacing: 0.05em; color: var(--gr-accent); margin-top: 16rpx; }


/* ─── Kitchen status block ────────────────────────────────────────────── */
.kit-blk {
  margin: 24rpx 44rpx;
  padding: 28rpx 30rpx;
  border: 3rpx solid var(--ink);
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.kit-left { flex: 1; min-width: 0; }
.kit-kicker {
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--olive);
}
.kit-title {
  font-family: var(--f-bear);
  font-size: calc(40rpx * var(--font-scale));
  line-height: 1.0;
  padding-top: 4rpx;
  margin-top: 6rpx;
}
.kit-status {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  font-family: var(--f-aleo);
  font-size: calc(24rpx * var(--font-scale));
}
.kit-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 999rpx;
  margin-right: 10rpx;
  box-shadow: 0 0 0 6rpx rgba(0,0,0,0.06);
}
.kit-status-label { font-weight: 500; }
.kit-hours { color: var(--olive); }
.kit-eta {
  margin-top: 6rpx;
  font-family: var(--f-gothic);
  font-size: calc(26rpx * var(--font-scale));
  letter-spacing: 0.06em;
}
.kit-address {
  margin-top: 6rpx;
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));

  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.04em;
}
.bun-plus {
  font-family: var(--f-bear);
  font-size: calc(42rpx * var(--font-scale));
  color: var(--olive);
  flex-shrink: 0;
}
.bun-foot {
  margin-top: 22rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.bun-price-block {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.bun-was {
  font-family: var(--f-aleo);
  font-size: calc(20rpx * var(--font-scale));
  color: var(--olive);
  text-decoration: line-through;
}
.bun-price {
  font-family: var(--f-bear);
  font-size: calc(44rpx * var(--font-scale));
  line-height: 1;
}
.bun-savings {
  margin-top: 4rpx;

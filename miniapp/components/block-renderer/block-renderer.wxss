/* ── Per-block chrome: optional outline frame + full-bleed width ──────────
   Both opt-in via the inspector; absent → .blk-outer is a layout-neutral
   passthrough so every existing block renders exactly as before. */
.blk-outer.framed {
  margin: 16rpx 24rpx;
  border: 3rpx solid;            /* border-color set inline from brand token */
  border-radius: 28rpx;
  padding: 18rpx 0;              /* vertical breathing room inside the frame */
  overflow: hidden;             /* clip the block's own bg to rounded corners */
}
/* Corner radius drives the frame's rounding (subtle = 28rpx default). */
.blk-outer.framed.corner-sharp { border-radius: 0; }
.blk-outer.framed.corner-bold  { border-radius: 40rpx; }
/* Self-bg blocks fill the frame edge-to-edge — drop the inner padding so the
   colored panel meets the border instead of leaking the page color. */
.blk-outer.framed.fill { padding: 0; }
/* Full-bleed: drop the per-block side gutter so the block (and any bg/image)
   reaches both screen edges. Targets each branch's single root <view>. */
.blk-outer.bleed > view {
  padding-left: 0 !important;
  padding-right: 0 !important;
}
/* Framed + bleed → a full-width banded frame (top/bottom rule, square). */
.blk-outer.framed.bleed {
  margin: 16rpx 0;
  border-radius: 0;
}
/* Self-styled cards (bundle, poll, referral, store, WeCom) carry their own
   bg + side MARGIN — not the .framed system — so the generic bleed rule
   above (which only zeros padding) can't reach their gutter. Drop the side
   margin and square the corners so the panel reads as an edge-to-edge band;
   restore the inner padding (zeroed by the generic rule) so content keeps its
   breathing room against the border. */
.blk-outer.bleed > .bun-blk,
.blk-outer.bleed > .voting-blk,
.blk-outer.bleed > .aff-blk,
.blk-outer.bleed > .store-blk,
.blk-outer.bleed > .coupon-blk,
.blk-outer.bleed > .greet-blk,
.blk-outer.bleed > .wc-blk {
  margin-left: 0;
  margin-right: 0;
  border-radius: 0 !important;   /* edge-to-edge band stays square, even if corner=bold */
}
.blk-outer.bleed > .bun-blk    { padding-left: 30rpx !important; padding-right: 30rpx !important; }
/* Review always spans full width (bg, no side margin), so "full width" is a
   no-op — keep its content inset rather than letting text hit the edges. */
.blk-outer.bleed > .review-blk { padding-left: 44rpx !important; padding-right: 44rpx !important; }
.blk-outer.bleed > .voting-blk { padding-left: 32rpx !important; padding-right: 32rpx !important; }
.blk-outer.bleed > .aff-blk    { padding-left: 32rpx !important; padding-right: 32rpx !important; }
.blk-outer.bleed > .store-blk  { padding-left: 36rpx !important; padding-right: 36rpx !important; }
.blk-outer.bleed > .coupon-blk { padding-left: 36rpx !important; padding-right: 36rpx !important; }
.blk-outer.bleed > .greet-blk  { padding-left: 36rpx !important; padding-right: 36rpx !important; }
/* .wc-blk keeps its margin-only gutter; its padding lives on the inner
   .wc-card, so the generic rule never touches it — nothing to restore. */

/* lift the new styles' content above the paper texture */
.wc-lc-title,
.wc-lc-main .wc-loop-proof,
.wc-lp-title,
.wc-lp-foot,
.wc-lm-body { position: relative; z-index: 1; }

/* ── Coupon ticket (D) ── */
.wc-loop-coupon { padding-top: 150rpx; }
.wc-lc-ticket {

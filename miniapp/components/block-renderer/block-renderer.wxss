}
.kit-title {
  font-family: var(--f-bear);
  font-size: calc(40rpx * var(--font-scale));
  line-height: 1.0;
  padding-top: 4rpx;
  margin-top: 6rpx;
}
.kit-status {
  display: flex;
  align-items: center;

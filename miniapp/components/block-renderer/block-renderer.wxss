/* ── 2026-05-20 cross-cutting enhancements ────────────────────────────────
   Shared classes used across multiple blocks: corner-radius presets,
   entrance animations, hero-banner scrim, spacer divider, countdown
   urgency pulse, featured sale badge. */

/* Corner radius presets — `corner-{sharp|subtle|bold}` on a block's outer
   class. Each block's existing border-radius wins via more specific
   selectors; these are global overrides for the wrapper card surfaces. */
.featured.corner-sharp .card,
.grid-block.corner-sharp .card,
.fav-blk.corner-sharp .fav-card,
.bun-blk.corner-sharp,
.recipe-blk.corner-sharp .recipe-img,
.recipe-blk.corner-sharp,
.ot-card.corner-sharp,
.countdown.corner-sharp { border-radius: 0 !important; }
.featured.corner-bold .card,
.grid-block.corner-bold .card,
.fav-blk.corner-bold .fav-card,
.bun-blk.corner-bold,
.recipe-blk.corner-bold .recipe-img,
.recipe-blk.corner-bold,
.ot-card.corner-bold,
.countdown.corner-bold { border-radius: 28rpx !important; }
/* Self-framed blocks (poll, referral, store, coupon, greeting, WeCom) don't
   carry the corner class on their own element, so reach them via the
   .blk-outer corner class. Subtle keeps each block's native radius. */
.blk-outer.corner-sharp > .voting-blk,
.blk-outer.corner-sharp > .aff-blk,
.blk-outer.corner-sharp > .store-blk,
.blk-outer.corner-sharp > .coupon-blk,
.blk-outer.corner-sharp > .greet-blk,
.blk-outer.corner-sharp > .wc-blk { border-radius: 0 !important; }
.blk-outer.corner-bold > .voting-blk,
.blk-outer.corner-bold > .aff-blk,
.blk-outer.corner-bold > .store-blk,
.blk-outer.corner-bold > .coupon-blk,
.blk-outer.corner-bold > .greet-blk,
.blk-outer.corner-bold > .wc-blk { border-radius: 28rpx !important; }
/* corner-subtle = legacy default, no override. */

/* Entrance animations — keep them subtle. The class is applied on the
   block root from JS via the `entrance_anim` CMS field. */
@keyframes blk-fade-in    { from { opacity: 0; } to { opacity: 1; } }
@keyframes blk-slide-up   { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: translateY(0); } }
.hero.enter-fade,
.featured.enter-fade,
.bun-blk.enter-fade        { animation: blk-fade-in   .4s ease-out both; }
.hero.enter-slide_up,
.featured.enter-slide_up,
.bun-blk.enter-slide_up    { animation: blk-slide-up .45s ease-out both; }
/* `enter-none` is the legacy instant render. */

/* Hero scrim — dims the bottom half of the image so floating CTAs read
   on busy photography. Strength controlled by .scrim-{light|medium|dark}.
   `scrim-none` simply omits the .hero-scrim element from the markup. */
.hero .hero-scrim {
  position: absolute; left: 0; right: 0; bottom: 0; height: 50%;
  pointer-events: none;
  z-index: 1;
}
.hero.scrim-light  .hero-scrim { background: linear-gradient(to top, rgba(0,0,0,.30), transparent); }
.hero.scrim-medium .hero-scrim { background: linear-gradient(to top, rgba(0,0,0,.50), transparent); }
.hero.scrim-dark   .hero-scrim { background: linear-gradient(to top, rgba(0,0,0,.72), transparent); }
.hero .cta-stack { z-index: 2; }

/* Featured-item SALE ribbon — top-right corner of the card image. */
.featured .img { position: relative; }
.featured .feat-badge {
  position: absolute; top: 14rpx; right: 14rpx;
  padding: 6rpx 16rpx;
  background: var(--berry, #E96174);
  color: #fff;
  font-family: var(--f-toni);
  font-size: calc(18rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: .12em;
  border-radius: 999rpx;
  z-index: 2;
}

/* Spacer divider — line / dashes / dots. Reuses `--divider-color` set
   inline by the renderer from the brand-color picker. */
.spacer-blk { display: flex; align-items: center; justify-content: center; }
.spacer-blk .spacer-divider { width: 50%; }
.spacer-blk.divider-line   .spacer-divider { height: 2rpx; }
.spacer-blk.divider-dashes .spacer-divider { height: 0; border-top-width: 3rpx; border-top-style: dashed; }
.spacer-blk.divider-dots   .spacer-divider { height: 0; border-top-width: 4rpx; border-top-style: dotted; }

/* Countdown urgency — pulse the clock cells when remaining time crosses
   the configured threshold. Mirrors the CMS preview. */
@keyframes cd-pulse {
  0%, 100% { transform: scale(1);    opacity: 1;   }
  50%      { transform: scale(1.06); opacity: .85; }
}
.countdown.urgent .cd-cell { animation: cd-pulse .9s ease-in-out infinite; }
.countdown.urgent .cd-cell:nth-child(2) { animation-delay: .12s; }
.countdown.urgent .cd-cell:nth-child(4) { animation-delay: .24s; }
.countdown.urgent .cd-cell:nth-child(6) { animation-delay: .36s; }

/* Product-grid density — gap between cards. The existing `.grid` selector
   picks up these density-prefixed overrides. */
.grid-block.density-compact  .grid { gap: 6rpx; }
.grid-block.density-normal   .grid { gap: 12rpx; }
.grid-block.density-spacious .grid { gap: 28rpx; }

/* ── Leaderboard block — Roots Club ranking strip on Home ───────────────── */
/* Video banner — autoplaying muted loop clip */
.video-blk {
  width: 100%;
  overflow: hidden;
  background: #000;
}
.video-el {
  width: 100%;
  height: 100%;
  display: block;
}
/* Full-screen splash — covers the whole device (onboarding intro video) */
.video-blk.video-fs {
  position: fixed;
  left: 0;
  top: 0;
  width: 100vw;
  height: 100vh;
  margin: 0;
  z-index: 1;
}

.lb-blk {
  margin: 16rpx 24rpx;
  padding: 32rpx 36rpx 28rpx;
  border-radius: 28rpx;
}
.lb-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}
.lb-head-main { min-width: 0; flex: 1; }
.lb-kicker {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  margin-bottom: 6rpx;
}
.lb-ttl {
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.15;
}
.lb-sub {
  font-size: 24rpx;
  opacity: .7;
  margin-top: 6rpx;
}
.lb-period {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-transform: uppercase;
  opacity: .55;
  padding-top: 6rpx;
}
.lb-list { display: flex; flex-direction: column; }
.lb-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 0;
  border-bottom: 2rpx solid rgba(26, 26, 23, .08);
}
.lb-row:last-child { border-bottom: none; }
.lb-medal { font-size: 32rpx; line-height: 1; width: 44rpx; text-align: center; }
.lb-rank {
  width: 44rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  opacity: .55;
}
.lb-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.lb-value {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 800;
}
.lb-footer {
  margin-top: 18rpx;
  font-size: 22rpx;
  opacity: .65;
  line-height: 1.4;
}
.lb-cta {
  margin-top: 18rpx;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

/* ── Per-block chrome: optional outline frame + full-bleed width ──────────
   Both opt-in via the inspector; absent → .blk-outer is a layout-neutral
   passthrough so every existing block renders exactly as before. */
.blk-outer.framed {
  margin: 16rpx 24rpx;
  border: 3rpx solid;            /* border-color set inline from brand token */
  border-radius: 28rpx;
  padding: 18rpx 0;              /* vertical breathing room inside the frame */
  overflow: hidden;             /* clip the block's own bg to rounded corners */
}
/* Corner radius drives the frame's rounding (subtle = 28rpx default). */
.blk-outer.framed.corner-sharp { border-radius: 0; }
.blk-outer.framed.corner-bold  { border-radius: 40rpx; }
/* Self-bg blocks fill the frame edge-to-edge — drop the inner padding so the
   colored panel meets the border instead of leaking the page color. */
.blk-outer.framed.fill { padding: 0; }
/* Full-bleed: drop the per-block side gutter so the block (and any bg/image)
   reaches both screen edges. Targets each branch's single root <view>. */
.blk-outer.bleed > view {
  padding-left: 0 !important;
  padding-right: 0 !important;
}
/* Framed + bleed → a full-width banded frame (top/bottom rule, square). */
.blk-outer.framed.bleed {
  margin: 16rpx 0;
  border-radius: 0;
}
/* Self-styled cards (bundle, poll, referral, store, WeCom) carry their own
   bg + side MARGIN — not the .framed system — so the generic bleed rule
   above (which only zeros padding) can't reach their gutter. Drop the side
   margin and square the corners so the panel reads as an edge-to-edge band;
   restore the inner padding (zeroed by the generic rule) so content keeps its
   breathing room against the border. */
.blk-outer.bleed > .bun-blk,
.blk-outer.bleed > .voting-blk,
.blk-outer.bleed > .aff-blk,
.blk-outer.bleed > .store-blk,
.blk-outer.bleed > .coupon-blk,
.blk-outer.bleed > .greet-blk,
.blk-outer.bleed > .wc-blk {
  margin-left: 0;
  margin-right: 0;
  border-radius: 0 !important;   /* edge-to-edge band stays square, even if corner=bold */
}
.blk-outer.bleed > .bun-blk    { padding-left: 30rpx !important; padding-right: 30rpx !important; }
/* Review always spans full width (bg, no side margin), so "full width" is a
   no-op — keep its content inset rather than letting text hit the edges. */
.blk-outer.bleed > .review-blk { padding-left: 44rpx !important; padding-right: 44rpx !important; }
.blk-outer.bleed > .voting-blk { padding-left: 32rpx !important; padding-right: 32rpx !important; }
.blk-outer.bleed > .aff-blk    { padding-left: 32rpx !important; padding-right: 32rpx !important; }
.blk-outer.bleed > .store-blk  { padding-left: 36rpx !important; padding-right: 36rpx !important; }
.blk-outer.bleed > .coupon-blk { padding-left: 36rpx !important; padding-right: 36rpx !important; }
.blk-outer.bleed > .greet-blk  { padding-left: 36rpx !important; padding-right: 36rpx !important; }
/* .wc-blk keeps its margin-only gutter; its padding lives on the inner
   .wc-card, so the generic rule never touches it — nothing to restore. */

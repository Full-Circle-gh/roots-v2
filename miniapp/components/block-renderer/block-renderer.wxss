.voting-blk .vb-kicker {
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.18em; opacity: 0.8;
}
.voting-blk .vb-title {
  font-family: var(--f-bear); font-weight: 500;
  font-size: calc(34rpx * var(--font-scale));
  line-height: 1.15; margin-top: 10rpx;
}
.voting-blk .vb-q {
  font-family: var(--f-bear); font-weight: 500;
  font-size: calc(32rpx * var(--font-scale));
  line-height: 1.12;
  margin-top: 8rpx;
}
.voting-blk .vb-sub {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  line-height: 1.4; margin-top: 10rpx; opacity: 0.85;
}
.voting-blk .vb-meta {
  margin-top: 12rpx;
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.16em;
  opacity: 0.7;
}
.voting-blk .vb-status-row {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 10rpx;
}
.voting-blk .vb-status-pill {
  display: inline-block;
  font-family: var(--f-toni); font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));

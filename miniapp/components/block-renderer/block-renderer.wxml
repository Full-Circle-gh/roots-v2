      <view wx:if="{{s.ctaLabel && s.ctaTarget}}" class="st-cta" style="background:{{storeBtnBg}};color:{{storeBtnFg}}" data-target="{{s.ctaTarget}}" bindtap="onStoreCtaTap">{{s.ctaLabel}}</view>

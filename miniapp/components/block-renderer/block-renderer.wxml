<!-- ─── Affiliate · STRIP view (one-line compact) ─── -->
<view wx:elif="{{type === 'affiliate_block' && affiliateCard && affiliateCard.view === 'strip'}}" class="aff-blk aff-strip" style="background:{{bg}};color:{{fg}}" bindtap="onAffiliateTap">
  <view class="aff-strip-left">
    <view wx:if="{{affiliateCard.kicker}}" class="aff-strip-kicker">{{affiliateCard.kicker}}</view>
    <view class="aff-strip-code-row">
      <text class="aff-strip-code">{{affiliateCard.code || affiliateCard.codePlaceholder}}</text>
      <view wx:if="{{affiliateCard.statsLabel}}" class="aff-strip-stats">· {{affiliateCard.statsLabel}}</view>
    </view>
  </view>
  <view wx:if="{{!affiliateCard.enabled}}" class="aff-strip-disabled">{{affiliateCard.disabledMsg}}</view>
  <block wx:elif="{{affiliateCard.code}}">
    <view class="aff-strip-copy" style="background:{{affiliateCard.accent}}" catchtap="onAffiliateCopyTap">{{affiliateCard.copyLabel}}</view>
    <button class="aff-strip-share" open-type="share" catchtap="noop">{{affiliateCard.shareLabel}}</button>
  </block>
  <view wx:else class="aff-strip-cta">{{affiliateCard.ctaLabel}} →</view>
</view>

<!-- ─── Affiliate · STAT view (big earned-¥ hero) ─── -->
<view wx:elif="{{type === 'affiliate_block' && affiliateCard && affiliateCard.view === 'stat'}}" class="aff-blk aff-stat" style="background:{{bg}};color:{{fg}}" bindtap="onAffiliateTap">
  <view wx:if="{{affiliateCard.kicker}}" class="aff-stat-kicker">{{affiliateCard.kicker}}</view>
  <view class="aff-stat-num">{{affiliateCard.statHeadline}}</view>
  <view class="aff-stat-sub">{{affiliateCard.statSubline}}</view>
  <view wx:if="{{!affiliateCard.enabled}}" class="aff-stat-disabled">{{affiliateCard.disabledMsg}}</view>
  <block wx:elif="{{affiliateCard.code}}">
    <view class="aff-stat-code-pill">{{affiliateCard.code}}</view>
    <view class="aff-stat-actions">
      <view class="aff-stat-copy" catchtap="onAffiliateCopyTap">{{affiliateCard.copyLabel}}</view>
      <button class="aff-stat-share" open-type="share" catchtap="noop">{{affiliateCard.shareLabel}} →</button>
    </view>
  </block>
  <view wx:else class="aff-stat-cta">{{affiliateCard.statCta}}</view>
</view>

<!-- ─── Affiliate · RECEIPT view (paper / dashed-edges aesthetic) ─── -->
<view wx:elif="{{type === 'affiliate_block' && affiliateCard && affiliateCard.view === 'receipt'}}" class="aff-blk aff-receipt" style="background:{{bg}};color:{{fg}}" bindtap="onAffiliateTap">
  <view class="aff-receipt-stub">{{affiliateCard.receiptStub}}</view>
  <view wx:if="{{affiliateCard.kicker}}" class="aff-receipt-kicker">{{affiliateCard.kicker}}</view>
  <view wx:if="{{affiliateCard.title}}" class="aff-receipt-title">{{affiliateCard.title}}</view>
  <view class="aff-receipt-sep">- - - - - - - - - - - - - - - - - -</view>
  <view wx:if="{{!affiliateCard.enabled}}" class="aff-receipt-disabled">{{affiliateCard.disabledMsg}}</view>
  <block wx:elif="{{affiliateCard.code}}">
    <view class="aff-receipt-row">
      <text class="aff-receipt-lbl">{{affiliateCard.codeLabel}}</text>
      <text class="aff-receipt-val">{{affiliateCard.code}}</text>
    </view>
    <view wx:if="{{affiliateCard.statsLabel}}" class="aff-receipt-row aff-receipt-row-muted">
      <text class="aff-receipt-lbl">STATS</text>
      <text class="aff-receipt-val">{{affiliateCard.statsLabel}}</text>
    </view>
    <view class="aff-receipt-sep">- - - - - - - - - - - - - - - - - -</view>
    <view class="aff-receipt-actions">
      <view class="aff-receipt-copy" style="background:{{affiliateCard.accent}}" catchtap="onAffiliateCopyTap">{{affiliateCard.copyLabel}}</view>
      <button class="aff-receipt-share" open-type="share" catchtap="noop">{{affiliateCard.shareLabel}} →</button>
    </view>
  </block>
  <view wx:else class="aff-receipt-signin">{{affiliateCard.signinHint}}</view>
</view>

<view wx:elif="{{type === 'store_info' && stores && stores.length}}" class="store-blk" style="background:{{bg}};color:{{fg}}">
  <view wx:if="{{storeKicker}}" class="st-kicker">{{storeKicker}}</view>
  <view class="st-cards">
    <view wx:for="{{stores}}" wx:key="key" wx:for-item="s" class="st-card">
      <view wx:if="{{s.name}}" class="st-title">{{s.name}}</view>
      <view wx:if="{{s.hasStatus}}" class="st-status">
        <view class="st-dot" style="background:{{s.statusColor}}"></view>
        <text class="st-status-lbl">{{s.statusLabel}}</text>
        <text wx:if="{{s.hours}}" class="st-hours"> · {{s.hours}}</text>
      </view>
      <view wx:elif="{{s.hours}}" class="st-row">
        <text class="st-icon">🕒</text>
        <text class="st-val">{{s.hours}}</text>
      </view>
      <view wx:if="{{s.etaLabel}}" class="st-eta">{{s.etaLabel}}</view>
      <view wx:if="{{s.address}}" class="st-row">
        <text class="st-icon">📍</text>
        <text class="st-val">{{s.address}}</text>
      </view>
      <view wx:if="{{s.phone}}" class="st-row" data-phone="{{s.phone}}" bindtap="onStorePhoneTap">
        <text class="st-icon">📞</text>
        <text class="st-val st-phone">{{s.phone}}</text>
      </view>
      <view wx:if="{{s.ctaLabel && s.ctaTarget}}" class="st-cta" style="background:{{storeBtnBg}};color:{{storeBtnFg}}" data-target="{{s.ctaTarget}}" bindtap="onStoreCtaTap">{{s.ctaLabel}}</view>
    </view>
  </view>
</view>

<view wx:elif="{{type === 'greeting' && greeting}}" class="greet-blk greet-blk-{{greeting.view}} {{greeting.bandStyle ? 'enter-' + greeting.enter : ''}}" style="{{greeting.bandStyle ? greeting.bandStyle : 'background:' + bg + ';color:' + fg}}" bindtap="onGreetingCtaTap">
  <!-- Unread notifications now live in the standalone notification_bar block,
       not pinned to the greeting card. -->

  <!-- Classic: editorial greeting left, accent-bordered points card right -->
  <view wx:if="{{greeting.view === 'classic'}}" class="grd-row">
    <view class="grd-col">
      <view wx:if="{{greeting.kicker}}" class="grd-kicker">{{greeting.kicker}}</view>
      <view class="grd-head">{{greeting.greetWord}}{{greeting.firstName ? ',' : '.'}}<text wx:if="{{greeting.firstName}}" class="grd-name-br"> {{greeting.firstName}}.</text></view>
      <view wx:if="{{greeting.cnLine}}" class="grd-cn">{{greeting.cnLine}}{{greeting.firstName ? ',' + greeting.firstName : ''}}</view>
      <view wx:if="{{greeting.ctaLabel}}" class="grd-link"><text class="grd-link-lbl">{{greeting.ctaLabel}}</text><text class="grd-link-ar"> →</text></view>
    </view>
    <view wx:if="{{greeting.pointsNum}}" class="grd-pts-card">
      <view class="grd-pts-num">{{greeting.pointsNum}}</view>
      <view class="grd-pts-unit">{{greeting.ptsUnitCny}}</view>
    </view>
  </view>

  <!-- Wallet: top kicker, big greeting, accent-bordered wallet/points strip -->
  <view wx:elif="{{greeting.view === 'wallet'}}">
    <view wx:if="{{greeting.kicker}}" class="grd-top"><text class="grd-kicker">{{greeting.kicker}}</text></view>
    <view class="grd-head">{{greeting.greetWord}}<text wx:if="{{greeting.firstName}}">, {{greeting.firstName}}</text>.</view>
    <view wx:if="{{greeting.pointsNum}}" class="grd-bar">
      <view class="grd-seg">
        <view class="grd-seg-lbl">{{greeting.walletLabel}}</view>
        <view class="grd-seg-val">{{greeting.walletValue}}</view>
      </view>
      <view class="grd-bar-div"></view>
      <view class="grd-seg">
        <view class="grd-seg-lbl">{{greeting.ptsUnit}}</view>
        <view class="grd-seg-pts"><text class="grd-seg-num">{{greeting.pointsNum}}</text><text class="grd-seg-unit"> {{greeting.ptsUnitCny}}</text></view>
      </view>
      <view class="grd-bar-arrow">→</view>
    </view>
  </view>

  <!-- Coin: playful greeting with halftone, accent coin with star -->
  <view wx:elif="{{greeting.view === 'coin'}}" class="grd-row grd-coin-row">
    <view class="grd-halftone"></view>
    <view class="grd-col">
      <view wx:if="{{greeting.kicker}}" class="grd-top grd-top-accent"><text class="grd-kicker">{{greeting.kicker}}</text></view>
      <view class="grd-head">{{greeting.greetWord}}{{greeting.firstName ? ',' : '.'}}<text wx:if="{{greeting.firstName}}" class="grd-name"> {{greeting.firstName}}.</text></view>
      <view wx:if="{{greeting.ctaLabel}}" class="grd-pill"><text class="grd-pill-lbl">{{greeting.ctaLabel}} →</text></view>
    </view>
    <view wx:if="{{greeting.pointsNum}}" class="grd-coin-wrap">
      <view class="grd-coin"><text class="grd-coin-num">{{greeting.pointsNum}}</text><text class="grd-coin-star">★</text></view>
      <view class="grd-coin-unit">{{greeting.ptsUnitCny}}</view>
    </view>
  </view>

  <!-- Split: greeting + CTA on left, big points wallet on right -->
  <view wx:elif="{{greeting.view === 'split'}}" class="gr-split-row">
    <view class="gr-split-left">
      <view wx:if="{{greeting.kicker}}" class="gr-kicker">{{greeting.kicker}}</view>
      <view class="gr-headline">{{greeting.headline}}</view>
      <view wx:if="{{greeting.ctaLabel}}" class="gr-cta">{{greeting.ctaLabel}} →</view>
    </view>
    <view wx:if="{{greeting.pointsNum}}" class="gr-split-wallet" style="color:{{greeting.accent}};border-color:{{greeting.accent}}">
      <view class="gr-wallet-num">{{greeting.pointsNum}}</view>
      <view class="gr-wallet-lbl">{{greeting.pointsCnyLabel}}</view>
    </view>
  </view>
  <!-- Inline: one-row, kicker + greeting on left, points pill on right -->
  <view wx:elif="{{greeting.view === 'inline'}}" class="gr-inline-row">
    <view class="gr-inline-copy">
      <view wx:if="{{greeting.kicker}}" class="gr-kicker">{{greeting.kicker}}</view>
      <view class="gr-headline gr-headline-sm">{{greeting.headline}}</view>
    </view>
    <view wx:if="{{greeting.pointsLabel}}" class="gr-pts-pill" style="color:{{greeting.accent}};border-color:{{greeting.accent}}">★ {{greeting.pointsLabel}}</view>
  </view>
  <!-- Banner: borderless, oversized greeting on coloured field -->
  <view wx:elif="{{greeting.view === 'banner'}}">
    <view wx:if="{{greeting.kicker}}" class="gr-kicker">{{greeting.kicker}}</view>
    <view class="gr-headline gr-headline-lg">{{greeting.headline}}</view>
    <view wx:if="{{greeting.pointsLabel}}" class="gr-points" style="color:{{greeting.accent}}">★ {{greeting.pointsLabel}}</view>
    <view wx:if="{{greeting.ctaLabel}}" class="gr-cta">{{greeting.ctaLabel}} →</view>
  </view>
  <!-- Card (default): bordered editorial card -->
  <view wx:else>
    <view wx:if="{{greeting.kicker}}" class="gr-kicker">{{greeting.kicker}}</view>
    <view class="gr-headline">{{greeting.headline}}</view>
    <view wx:if="{{greeting.pointsLabel}}" class="gr-points" style="color:{{greeting.accent}}">★ {{greeting.pointsLabel}}</view>
    <view wx:if="{{greeting.ctaLabel}}" class="gr-cta">{{greeting.ctaLabel}} →</view>
  </view>
</view>

<view wx:elif="{{type === 'kitchen_status' && kitchenCard}}" class="kit-blk" style="background:{{bg}};color:{{fg}}" bindtap="onKitchenCtaTap">
  <view class="kit-left">
    <view wx:if="{{kitchenCard.kicker}}" class="kit-kicker">{{kitchenCard.kicker}}</view>
    <view class="kit-title">{{kitchenCard.title}}</view>
    <view class="kit-status">
      <view class="kit-dot" style="background:{{kitchenCard.statusColor}}"></view>
      <text class="kit-status-label">{{kitchenCard.statusLabel}}</text>
      <text wx:if="{{kitchenCard.hoursLabel}}" class="kit-hours"> · {{kitchenCard.hoursLabel}}</text>
    </view>
    <view wx:if="{{kitchenCard.etaLabel}}" class="kit-eta">{{kitchenCard.etaLabel}}</view>
    <view wx:if="{{kitchenCard.address}}" class="kit-address">{{kitchenCard.address}}</view>
  </view>
  <view wx:if="{{kitchenCard.ctaLabel}}" class="kit-cta">{{kitchenCard.ctaLabel}} →</view>
</view>

<view wx:elif="{{type === 'recipe_story' && recipe}}" class="recipe-blk recipe-{{recipe.imageView}} corner-{{recipeCorner}}" style="background:{{bg}};color:{{fg}}">
  <view class="rcp-img">
    <image wx:if="{{recipe.imageUrl}}" src="{{recipe.imageUrl}}" mode="aspectFill" class="img-full"/>
    <view wx:else class="rcp-img-placeholder">No image</view>
  </view>
  <view class="rcp-body">
    <view wx:if="{{recipe.kicker}}" class="rcp-kicker">{{recipe.kicker}}</view>
    <view wx:if="{{recipe.headline}}" class="rcp-headline">{{recipe.headline}}</view>
    <view wx:if="{{recipe.byline || recipe.readTime}}" class="rcp-meta">
      <text wx:if="{{recipe.byline}}">{{recipe.byline}}</text>
      <text wx:if="{{recipe.byline && recipe.readTime}}"> · </text>
      <text wx:if="{{recipe.readTime}}">{{recipe.readTime}}</text>
    </view>
    <view wx:for="{{recipe.paragraphs}}" wx:key="*this" class="rcp-para">{{item}}</view>
    <view wx:if="{{recipe.linkedProduct}}" class="rcp-card" data-id="{{recipe.linkedProduct.id}}" bindtap="onProductTap">
      <view class="rcp-card-img">
        <image wx:if="{{recipe.linkedProduct.image}}" src="{{recipe.linkedProduct.image}}" mode="aspectFill" class="img-full"/>
      </view>
      <view class="rcp-card-meta">
        <view class="rcp-card-name">{{recipe.linkedProduct.name}}</view>
        <view wx:if="{{recipe.linkedProduct.tagline}}" class="rcp-card-tag">{{recipe.linkedProduct.tagline}}</view>
        <view wx:if="{{recipe.linkedProduct.price}}" class="rcp-card-price">{{recipe.linkedProduct.price}} →</view>
      </view>
    </view>
    <view wx:if="{{recipe.ctaLabel}}" class="rcp-cta" style="background:{{recipe.btnBg}};color:{{recipe.btnFg}}" bindtap="onRecipeCtaTap">{{recipe.ctaLabel}} →</view>
  </view>
</view>

<view wx:elif="{{type === 'bundle' && bundle && bundle.active}}" class="bun-blk bun-style-{{bundle.style}} {{bundle.riso ? 'finish-riso' : 'finish-clean'}} corner-{{bundleCorner}} enter-{{bundleEnter}}" style="background:{{bg}};color:{{fg}}">
  <view class="bun-inner" style="{{bundle.innerCss}}">

  <!-- Variant pills — tap to swap which bundle shows below. Hidden when
       there's only one variant so legacy single-bundle blocks look the same.
       Defined once; reused by every style via a wxml template. -->
  <template name="bun-pills">
    <scroll-view wx:if="{{showPills}}" class="bun-pills-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="bun-pills">
        <block wx:for="{{variants}}" wx:key="id" wx:for-item="v" wx:for-index="i">
          <view
            class="bun-pill {{i === activeIndex ? 'on' : ''}}"
            data-idx="{{i}}"
            bindtap="onBundleVariantTap"
            style="{{i === activeIndex ? 'background:' + toggleOn + ';color:' + toggleOnText + ';border-color:' + toggleOn + ';' : 'border-color:' + text + ';color:' + text + ';'}}">
            <text wx:if="{{v.recommended}}" class="bun-pill-star" style="color:{{save}}">★ </text>{{v.label}}
          </view>
        </block>
      </view>
    </scroll-view>
  </template>

  <!-- ── B · Receipt tally ─────────────────────────────────────────── -->
  <block wx:if="{{bundle.style === 'receipt'}}">
    <view class="bun-rhead">
      <view wx:if="{{bundle.kicker}}" class="bun-kicker">{{bundle.kicker}}</view>
      <view wx:if="{{bundle.active.title}}" class="bun-title" style="font-size:{{bundle.titleSize}}">{{bundle.active.title}}</view>
    </view>
    <template is="bun-pills" data="{{bundle}}"/>
    <view wx:if="{{bundle.active.empty}}" class="bun-empty">{{bundle.emptyText}}</view>
    <block wx:else>
      <view class="bun-rows">
        <view wx:for="{{bundle.active.rows}}" wx:key="id" class="bun-rrow" style="border-top:{{item.borderTop}}" data-id="{{item.id}}" bindtap="onProductTap">
          <view class="bun-rimg">
            <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="img-full"/>
          </view>
          <view class="bun-rmid">
            <view class="bun-rname">{{item.name}}</view>
            <view wx:if="{{item.cn}}" class="bun-rcn">{{item.cn}}</view>
          </view>
          <view class="bun-rprice">{{item.price}}</view>
        </view>
      </view>
      <view class="bun-tally">
        <view class="bun-trow"><text>{{bundle.itemsTotalLabel}}</text><text class="bun-strike">{{bundle.active.sumLabel}}</text></view>
        <view class="bun-trow bun-trow-big"><text>{{bundle.bundlePriceLabel}}</text><text class="bun-tprice" style="color:{{bundle.price}};font-size:{{bundle.tallyPriceSize}}">{{bundle.active.priceLabel}}</text></view>
        <view wx:if="{{bundle.active.savingsLabel}}" class="bun-tchip-row"><text class="bun-tchip" style="background:{{bundle.save}};color:{{bundle.saveText}}">{{bundle.active.savingsLabel}}</text></view>
        <view class="bun-cta bun-cta-full" style="background:{{bundle.cta}};color:{{bundle.ctaText}}" bindtap="onBundleAddTap">{{bundle.active.addLabel}}</view>
      </view>
    </block>
  </block>

  <!-- ── C · Sticker hero ──────────────────────────────────────────── -->
  <block wx:elif="{{bundle.style === 'sticker'}}">
    <view class="bun-sticker" style="background:{{bundle.sticker}};color:{{bundle.stickerText}};border:{{bundle.elBorder}};box-shadow:{{bundle.elShadow}};transform:{{bundle.riso ? 'rotate(-3deg)' : 'none'}}">{{bundle.stickerLabel}}</view>
    <view wx:if="{{bundle.active.title}}" class="bun-title" style="font-size:{{bundle.titleSize}}">{{bundle.active.title}}</view>
    <template is="bun-pills" data="{{bundle}}"/>
    <view wx:if="{{bundle.active.empty}}" class="bun-empty">{{bundle.emptyText}}</view>
    <block wx:else>
      <view class="bun-tubs">
        <view wx:for="{{bundle.active.tubs}}" wx:key="id" class="bun-tub" style="{{item.style}}" data-id="{{item.id}}" bindtap="onProductTap">
          <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="img-full"/>
        </view>
        <view wx:if="{{bundle.active.stampAmt}}" class="bun-stamp" style="background:{{bundle.save}};color:{{bundle.saveText}};border:{{bundle.elBorder}};box-shadow:{{bundle.elShadow}};transform:{{bundle.riso ? 'rotate(8deg)' : 'none'}}">
          <text class="bun-stamp-k">SAVE</text><text class="bun-stamp-n">{{bundle.active.stampAmt}}</text>
        </view>
      </view>
      <view wx:if="{{bundle.active.moreText}}" class="bun-more" style="color:{{bundle.cta}}">{{bundle.active.moreText}}</view>
      <view class="bun-foot">
        <view class="bun-price-block">
          <view wx:if="{{bundle.active.savingsLabel}}" class="bun-was">{{bundle.active.sumLabel}}</view>
          <view class="bun-price" style="color:{{bundle.price}};font-size:{{bundle.stickerPriceSize}}">{{bundle.active.priceLabel}}</view>
        </view>
        <view class="bun-tap">{{bundle.tapText}}</view>
      </view>
      <view class="bun-cta bun-cta-full" style="background:{{bundle.cta}};color:{{bundle.ctaText}}" bindtap="onBundleAddTap">{{bundle.active.addLabel}}</view>
    </block>
  </block>

  <!-- ── A · Classic refined ───────────────────────────────────────── -->
  <block wx:else>
    <view wx:if="{{bundle.kicker}}" class="bun-kicker">{{bundle.kicker}}</view>
    <template is="bun-pills" data="{{bundle}}"/>
    <view wx:if="{{bundle.active.title}}" class="bun-title" style="font-size:{{bundle.titleSize}}">{{bundle.active.title}}</view>
    <view wx:if="{{bundle.active.subtitle}}" class="bun-sub">{{bundle.active.subtitle}}</view>

    <view wx:if="{{bundle.active.empty}}" class="bun-empty">{{bundle.emptyText}}</view>

    <scroll-view wx:else class="bun-cards" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="bun-card-row">
        <block wx:for="{{bundle.active.cards}}" wx:key="id">
          <view class="bun-card" data-id="{{item.id}}" bindtap="onProductTap">
            <view class="bun-card-img" style="{{bundle.riso ? '' : 'border-color:transparent'}}">
              <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="img-full"/>
            </view>
            <view class="bun-card-name">{{item.name}}</view>
            <view wx:if="{{item.price}}" class="bun-card-price">{{item.price}}</view>
          </view>
          <view wx:if="{{index < bundle.active.cardCount - 1}}" class="bun-plus">+</view>
        </block>
      </view>
    </scroll-view>

    <view wx:if="{{!bundle.active.empty}}" class="bun-foot">
      <view class="bun-price-block">
        <view wx:if="{{bundle.active.savingsLabel}}" class="bun-was">{{bundle.active.sumLabel}}</view>
        <view class="bun-price" style="color:{{bundle.price}};font-size:{{bundle.priceSize}}">{{bundle.active.priceLabel}}</view>
        <view wx:if="{{bundle.active.savingsLabel}}" class="bun-savings" style="color:{{bundle.save}}">{{bundle.active.savingsLabel}}</view>
      </view>
      <view class="bun-cta" style="background:{{bundle.cta}};color:{{bundle.ctaText}}" bindtap="onBundleAddTap">{{bundle.active.addLabel}}</view>
    </view>
  </block>

  </view>
</view>

<!-- "Add us on 企业微信" block. Tap the button → opens the mini-app's bound
     WeCom CSR chat (needs WeCom CSR bound in MP backend → 设置 → 客服).
     Long-press the 联系我 QR → adds employee as WeCom contact. Either half
     is optional. Card stacks vertically; strip is compact horizontal. -->
<!-- Card view — "Stay in the loop" warm-pop redesign. Cream card with an
     ink keyline, a mascot perched on the top edge, an ADD US badge, four
     value-prop chips, then a footer that pairs the CTA + social proof on the
     left with the 联系我 QR on the right. bg/fg/accent stay operator-editable. -->
<view wx:elif="{{type === 'wecom_contact' && wecom && wecom.view === 'card' && wecom.cardStyle === 'warm'}}" class="wc-blk wc-loop">
  <image wx:if="{{wecom.showMascot}}" class="wc-loop-mascot" src="{{wecom.mascot}}" mode="aspectFit"/>
  <view class="wc-loop-card {{wecom.showShadow ? '' : 'wc-loop-flat'}} {{wecom.showBorder ? '' : 'wc-loop-noframe'}}" style="background:{{bg}};color:{{fg}}">
    <view wx:if="{{wecom.showTexture}}" class="wc-loop-paper"></view>

    <view wx:if="{{wecom.kicker}}" class="wc-loop-badge" style="background:{{wecom.accent}};color:{{wecom.btnFg}}">{{wecom.kicker}}</view>

    <view wx:if="{{wecom.title}}" class="wc-loop-title">{{wecom.title}}</view>
    <view wx:if="{{wecom.subtitle}}" class="wc-loop-sub">{{wecom.subtitle}}</view>

    <view class="wc-loop-props">
      <view wx:for="{{wecom.props}}" wx:key="k" class="wc-loop-chip" style="background:{{item.bg}}">
        <image class="wc-loop-ico" src="{{item.icon}}" mode="aspectFit"/>
        <text class="wc-loop-chip-tx">{{item.label}}</text>
      </view>
    </view>

    <view class="wc-loop-foot">
      <view class="wc-loop-foot-l">
        <!-- Three button modes (priority order). Button precedence is
             WeCom-chat-first so the CTA lands the customer in the company's
             微信客服 (NOT the OA's 公众号客服):
             1. kfUrl set      → wx.openCustomerServiceChat; falls back to the
                                 QR preview if the chat can't open.
             2. qrUrl set only → previews the 联系我 QR full-screen so a
                                 long-press triggers 识别图中二维码 → 添加朋友.
             3. neither        → open-type="contact" (bound 客服). -->
        <button wx:if="{{wecom.showButton && wecom.kfUrl}}" class="wc-loop-cta"
                bindtap="onWecomChatTap" style="color:{{wecom.accent}}">
          <text>{{wecom.buttonLabel}}</text><text class="wc-loop-cta-ar">→</text>
        </button>
        <button wx:elif="{{wecom.showButton && wecom.qrUrl}}" class="wc-loop-cta"
                bindtap="onWecomCtaTap" style="color:{{wecom.accent}}">
          <text>{{wecom.buttonLabel}}</text><text class="wc-loop-cta-ar">→</text>
        </button>
        <button wx:elif="{{wecom.showButton}}" class="wc-loop-cta" open-type="contact"
                session-from="wecom_contact_block" bindcontact="onWecomContactError"
                style="color:{{wecom.accent}}">
          <text>{{wecom.buttonLabel}}</text><text class="wc-loop-cta-ar">→</text>
        </button>

        <view wx:if="{{wecom.showProof}}" class="wc-loop-proof">
          <view class="wc-loop-faces">
            <view class="wc-loop-face wc-face-0"><image class="wc-loop-face-ic" src="/assets/icons/loop/member.svg"/></view>
            <view class="wc-loop-face wc-face-1"><image class="wc-loop-face-ic" src="/assets/icons/loop/member.svg"/></view>
            <view class="wc-loop-face wc-face-2"><image class="wc-loop-face-ic" src="/assets/icons/loop/member.svg"/></view>
            <view class="wc-loop-face wc-face-3"><image class="wc-loop-face-ic" src="/assets/icons/loop/member.svg"/></view>
          </view>
          <text class="wc-loop-proof-tx">{{wecom.proofPre}}<text class="wc-loop-proof-n">{{wecom.proofCount}}</text>{{wecom.proofPost}}</text>
        </view>
      </view>

      <view wx:if="{{wecom.showQr && wecom.qrUrl}}" class="wc-loop-qr">
        <view class="wc-loop-qr-frame">
          <image src="{{wecom.qrUrl}}" mode="aspectFit" class="wc-loop-qr-img" show-menu-by-longpress="{{true}}" bindtap="onWecomQrTap"/>
        </view>
        <text wx:if="{{wecom.agentName}}" class="wc-loop-qr-name">{{wecom.agentName}}</text>
        <text class="wc-loop-qr-hint">{{wecom.hint}}</text>
      </view>
    </view>
  </view>
</view>

<!-- Coupon ticket (D) — main stub + dashed perforation + accent QR stub. -->
<view wx:elif="{{type === 'wecom_contact' && wecom && wecom.view === 'card' && wecom.cardStyle === 'coupon'}}" class="wc-blk wc-loop wc-loop-coupon">
  <image wx:if="{{wecom.showMascot}}" class="wc-loop-mascot" src="{{wecom.mascot}}" mode="aspectFit"/>
  <view class="wc-lc-ticket {{wecom.showShadow ? '' : 'wc-loop-flat'}} {{wecom.showBorder ? '' : 'wc-loop-noframe'}}">
    <view class="wc-lc-main" style="background:{{bg}};color:{{fg}}">
      <view wx:if="{{wecom.showTexture}}" class="wc-loop-paper"></view>
      <view wx:if="{{wecom.kicker}}" class="wc-loop-badge" style="background:{{wecom.accent}};color:{{wecom.btnFg}}">{{wecom.kicker}}</view>
      <view wx:if="{{wecom.title}}" class="wc-lc-title">{{wecom.title}}</view>
      <view class="wc-loop-props wc-loop-pills">
        <view wx:for="{{wecom.props}}" wx:key="k" class="wc-loop-pill"><text>{{item.label}}</text></view>
      </view>
      <template is="wcProof" data="{{w: wecom}}"/>
    </view>
    <view class="wc-lc-perf"></view>
    <view class="wc-lc-stub" style="{{wecom.stubStyle}}">
      <view wx:if="{{wecom.showQr && wecom.qrUrl}}" class="wc-loop-qr-frame">
        <image src="{{wecom.qrUrl}}" mode="aspectFit" class="wc-loop-qr-img" show-menu-by-longpress="{{true}}" bindtap="onWecomQrTap"/>
      </view>
      <template is="wcCta" data="{{w: wecom, cls: 'wc-lc-cta', sty: wecom.couponCtaStyle}}"/>
      <text class="wc-lc-hint">{{wecom.hint}}</text>
    </view>
  </view>
</view>

<!-- Poster (E/F) — big headline, outlined pills, CTA beside the QR. -->
<view wx:elif="{{type === 'wecom_contact' && wecom && wecom.view === 'card' && wecom.cardStyle === 'poster'}}" class="wc-blk wc-loop wc-loop-poster">
  <image wx:if="{{wecom.showMascot}}" class="wc-loop-mascot" src="{{wecom.mascot}}" mode="aspectFit"/>
  <view class="wc-loop-card wc-lp-card {{wecom.showShadow ? '' : 'wc-loop-flat'}} {{wecom.showBorder ? '' : 'wc-loop-noframe'}}" style="background:{{bg}};color:{{fg}}">
    <view wx:if="{{wecom.showTexture}}" class="wc-loop-paper"></view>
    <view wx:if="{{wecom.kicker}}" class="wc-loop-badge" style="background:{{wecom.accent}};color:{{wecom.btnFg}}">{{wecom.kicker}}</view>
    <view wx:if="{{wecom.title}}" class="wc-lp-title">{{wecom.title}}</view>
    <view wx:if="{{wecom.subtitle}}" class="wc-loop-sub">{{wecom.subtitle}}</view>
    <view class="wc-loop-props wc-loop-pills">
      <view wx:for="{{wecom.props}}" wx:key="k" class="wc-loop-pill"><text>{{item.label}}</text></view>
    </view>
    <view class="wc-lp-foot">
      <view class="wc-lp-foot-l">
        <template is="wcCta" data="{{w: wecom, cls: 'wc-lp-cta', sty: wecom.fillCtaStyle}}"/>
        <template is="wcProof" data="{{w: wecom}}"/>
      </view>
      <view wx:if="{{wecom.showQr && wecom.qrUrl}}" class="wc-lp-qr">
        <view class="wc-loop-qr-frame">
          <image src="{{wecom.qrUrl}}" mode="aspectFit" class="wc-loop-qr-img" show-menu-by-longpress="{{true}}" bindtap="onWecomQrTap"/>
        </view>
        <text class="wc-lc-hint">{{wecom.hint}}</text>
      </view>
    </view>
  </view>
</view>

<!-- Compact mini — wide-short zigzag ticket, one-line props, QR on the right. -->
<view wx:elif="{{type === 'wecom_contact' && wecom && wecom.view === 'card' && wecom.cardStyle === 'compact'}}" class="wc-blk wc-loop wc-loop-compact">
  <view class="wc-lm-card {{wecom.showShadow ? '' : 'wc-loop-flat'}}" style="background:{{bg}};color:{{fg}};clip-path:{{wecom.zigClip}};-webkit-clip-path:{{wecom.zigClip}}">
    <view wx:if="{{wecom.showTexture}}" class="wc-loop-paper"></view>
    <view class="wc-lm-body">
      <view class="wc-lm-l">
        <view wx:if="{{wecom.kicker}}" class="wc-lm-kicker" style="color:{{wecom.accent}}">{{wecom.kicker}}</view>
        <view wx:if="{{wecom.title}}" class="wc-lm-title">{{wecom.title}}</view>
        <view class="wc-lm-sub">{{wecom.subtitle || wecom.oneLineProps}}</view>
        <template is="wcCta" data="{{w: wecom, cls: 'wc-lm-cta', sty: wecom.fillCtaStyle}}"/>
      </view>
      <view wx:if="{{wecom.showQr && wecom.qrUrl}}" class="wc-lm-qr">
        <view class="wc-loop-qr-frame">
          <image src="{{wecom.qrUrl}}" mode="aspectFit" class="wc-loop-qr-img" show-menu-by-longpress="{{true}}" bindtap="onWecomQrTap"/>
        </view>
        <text class="wc-lm-hint">{{wecom.hint}}</text>
      </view>
    </view>
  </view>
</view>

<view wx:elif="{{type === 'wecom_contact' && wecom && wecom.view === 'strip'}}" class="wc-blk wc-strip" style="background:{{bg}};color:{{fg}}">
  <view class="wc-strip-body">
    <view wx:if="{{wecom.kicker}}" class="wc-kicker">{{wecom.kicker}}</view>
    <view wx:if="{{wecom.title}}" class="wc-strip-title">{{wecom.title}}</view>
    <view wx:if="{{wecom.subtitle}}" class="wc-strip-sub">{{wecom.subtitle}}</view>
    <!-- See card-view notes for the three-mode branching rationale. -->
    <button wx:if="{{wecom.showButton && wecom.kfUrl}}" class="wc-cta wc-cta-strip"
            bindtap="onWecomChatTap" style="background:{{wecom.accent}};color:{{wecom.btnFg}}">{{wecom.buttonLabel}}</button>
    <button wx:elif="{{wecom.showButton && wecom.qrUrl}}" class="wc-cta wc-cta-strip"
            bindtap="onWecomCtaTap" style="background:{{wecom.accent}};color:{{wecom.btnFg}}">{{wecom.buttonLabel}}</button>
    <button wx:elif="{{wecom.showButton}}" class="wc-cta wc-cta-strip" open-type="contact"
            session-from="wecom_contact_block" bindcontact="onWecomContactError"
            style="background:{{wecom.accent}};color:{{wecom.btnFg}}">{{wecom.buttonLabel}}</button>
  </view>
  <view wx:if="{{wecom.showQr && wecom.qrUrl}}" class="wc-strip-qr">
    <image src="{{wecom.qrUrl}}" mode="aspectFit" class="wc-qr-sm" show-menu-by-longpress="{{true}}" bindtap="onWecomQrTap"/>
    <view class="wc-hint wc-hint-sm">{{wecom.hint}}</view>
  </view>
</view>

<view wx:elif="{{type === 'countdown_timer'}}" class="countdown corner-{{countdownCorner}} {{countdownUrgent ? 'urgent' : ''}}" style="background:{{bg}};color:{{fg}}">
  <view wx:if="{{countdown.kicker}}" class="cd-kicker">{{countdown.kicker}}</view>
  <view wx:if="{{countdown.title}}" class="cd-title">{{countdown.title}}</view>
  <view wx:if="{{!countdown.isEnded}}" class="cd-clock">
    <block wx:for="{{countdown.cells}}" wx:key="lbl">
      <view class="cd-cell">
        <view class="cd-num">{{item.num}}</view>
        <view class="cd-lbl">{{item.lbl}}</view>
      </view>
      <view wx:if="{{index < countdown.cells.length - 1}}" class="cd-sep">:</view>
    </block>
  </view>
  <view wx:if="{{!countdown.isEnded && countdown.ctaLabel}}" class="cd-cta" style="background:{{countdown.btnBg}};color:{{countdown.btnFg}}" bindtap="onCountdownCtaTap">
    {{countdown.ctaLabel}}
  </view>
  <view wx:if="{{countdown.isEnded}}" class="cd-ended">{{countdown.ended}}</view>
</view>

<view wx:elif="{{type === 'leaderboard' && leaderboardCard && !leaderboardHidden}}" class="lb-blk" style="background:{{bg}};color:{{fg}}" bindtap="onLeaderboardTap">
  <view class="lb-head">
    <view class="lb-head-main">
      <view wx:if="{{leaderboardCard.kicker}}" class="lb-kicker" style="color:{{leaderboardAccent}}">{{leaderboardCard.kicker}}</view>
      <view class="lb-ttl">{{leaderboardCard.title}}</view>
      <view wx:if="{{leaderboardCard.subhead}}" class="lb-sub">{{leaderboardCard.subhead}}</view>
    </view>
    <view class="lb-period">{{leaderboardCard.periodLabel}}</view>
  </view>
  <view class="lb-list">
    <view wx:for="{{leaderboardCard.rows}}" wx:key="rank" class="lb-row">
      <text wx:if="{{item.medal}}" class="lb-medal">{{item.medal}}</text>
      <text wx:else class="lb-rank">{{item.rankText}}</text>
      <text class="lb-name">{{item.name}}</text>
      <text wx:if="{{item.value}}" class="lb-value" style="color:{{leaderboardAccent}}">{{item.value}}</text>
    </view>
  </view>
  <view wx:if="{{leaderboardCard.footer}}" class="lb-footer">{{leaderboardCard.footer}}</view>
  <view class="lb-cta" style="color:{{leaderboardAccent}}">{{leaderboardCard.ctaLabel}} ›</view>
</view>

<!-- Video banner: autoplaying muted loop, no controls -->
<view wx:elif="{{type === 'video_banner' && videoUrl}}" class="video-blk {{videoFullscreen ? 'video-fs' : ''}}" style="{{videoFullscreen ? '' : 'height:' + (videoHeight * 2) + 'rpx'}}" bindtap="onVideoTap">
  <video class="video-el"
         src="{{videoUrl}}"
         poster="{{videoPoster}}"
         autoplay="{{true}}"
         loop="{{true}}"
         muted="{{true}}"
         controls="{{false}}"
         show-center-play-btn="{{false}}"
         show-play-btn="{{false}}"
         show-fullscreen-btn="{{false}}"
         show-progress="{{false}}"
         enable-progress-gesture="{{false}}"
         object-fit="cover"
         vslide-gesture="{{false}}"/>
</view>

</view><!-- /.blk-outer -->

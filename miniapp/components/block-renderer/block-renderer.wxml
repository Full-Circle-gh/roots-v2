<view wx:elif="{{type === 'bundle' && bundle && bundle.active}}" class="bun-blk corner-{{bundleCorner}} enter-{{bundleEnter}}" style="background:{{bg}};color:{{fg}}">
  <view wx:if="{{bundle.kicker}}" class="bun-kicker">{{bundle.kicker}}</view>

  <!-- Variant pills — tap to swap which bundle shows below. Hidden when
       there's only one variant so legacy single-bundle blocks look the same. -->
  <scroll-view wx:if="{{bundle.showPills}}" class="bun-pills-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="bun-pills">
      <block wx:for="{{bundle.variants}}" wx:key="id" wx:for-item="v" wx:for-index="i">
        <view
          class="bun-pill {{i === bundle.activeIndex ? 'on' : ''}}"
          data-idx="{{i}}"
          bindtap="onBundleVariantTap"
          style="{{i === bundle.activeIndex ? 'background:' + accent + ';color:' + bg + ';border-color:' + accent + ';' : 'border-color:' + fg + ';'}}">
          <text wx:if="{{v.recommended}}" class="bun-pill-star">★ </text>{{v.label}}
        </view>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{bundle.active.title}}" class="bun-title">{{bundle.active.title}}</view>
  <view wx:if="{{bundle.active.subtitle}}" class="bun-sub">{{bundle.active.subtitle}}</view>

  <view wx:if="{{bundle.active.empty}}" class="bun-empty">{{bundle.emptyText}}</view>

  <scroll-view wx:else class="bun-cards" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="bun-card-row">
      <block wx:for="{{bundle.active.cards}}" wx:key="id">
        <view class="bun-card" data-id="{{item.id}}" bindtap="onProductTap">
          <view class="bun-card-img">
            <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="img-full"/>
          </view>
          <view class="bun-card-name">{{item.name}}</view>
          <view wx:if="{{item.price}}" class="bun-card-price">{{item.price}}</view>
        </view>
        <view wx:if="{{index < bundle.active.cardCount - 1}}" class="bun-plus">+</view>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{!bundle.active.empty}}" class="bun-foot">
    <view class="bun-price-block">
      <view wx:if="{{bundle.active.savingsLabel}}" class="bun-was">{{bundle.active.sumLabel}}</view>
      <view class="bun-price">{{bundle.active.priceLabel}}</view>
      <view wx:if="{{bundle.active.savingsLabel}}" class="bun-savings">{{bundle.active.savingsLabel}}</view>
    </view>
    <view class="bun-cta" style="background:{{accent}};color:{{bundleBtnFg}}" bindtap="onBundleAddTap">{{bundle.active.addLabel}}</view>
  </view>
</view>

<!-- "Add us on 企业微信" block. Tap the button → opens the mini-app's bound
     WeCom CSR chat (needs WeCom CSR bound in MP backend → 设置 → 客服).
     Long-press the 联系我 QR → adds employee as WeCom contact. Either half
     is optional. Card stacks vertically; strip is compact horizontal. -->
<view wx:elif="{{type === 'wecom_contact' && wecom && wecom.view === 'card'}}" class="wc-blk wc-card" style="background:{{bg}};color:{{fg}}">
  <view wx:if="{{wecom.kicker}}" class="wc-kicker">{{wecom.kicker}}</view>
  <view wx:if="{{wecom.title}}" class="wc-title">{{wecom.title}}</view>
  <view wx:if="{{wecom.subtitle}}" class="wc-sub">{{wecom.subtitle}}</view>
  <!-- Three button modes (priority order):
       1. qrUrl set      → tap previews the QR full-screen; user long-presses
                           to trigger WeChat's "识别图中二维码" → 添加朋友
                           flow. Only sanctioned add-WeChat-friend path.
       2. kfUrl set      → tap opens WeCom (企业微信) 微信客服 chat via
                           wx.openCustomerServiceChat. Routes directly to
                           the company's WeCom CSR, not the OA's CSR.
       3. neither        → falls back to open-type="contact" (whichever
                           客服 is bound in 小程序管理后台). -->
  <button wx:if="{{wecom.showButton && wecom.qrUrl}}" class="wc-cta"
          bindtap="onWecomCtaTap" style="background:{{wecom.accent}};color:{{wecom.btnFg}}">{{wecom.buttonLabel}}</button>
  <button wx:elif="{{wecom.showButton && wecom.kfUrl}}" class="wc-cta"
          bindtap="onWecomChatTap" style="background:{{wecom.accent}};color:{{wecom.btnFg}}">{{wecom.buttonLabel}}</button>
  <button wx:elif="{{wecom.showButton}}" class="wc-cta" open-type="contact"
          session-from="wecom_contact_block" bindcontact="onWecomContactError"
          style="background:{{wecom.accent}};color:{{wecom.btnFg}}">{{wecom.buttonLabel}}</button>
  <view wx:if="{{wecom.showQr && wecom.qrUrl}}" class="wc-qr-wrap">
    <image src="{{wecom.qrUrl}}" mode="aspectFit" class="wc-qr" show-menu-by-longpress="{{true}}" bindtap="onWecomQrTap"/>
    <view wx:if="{{wecom.agentName}}" class="wc-name">{{wecom.agentName}}</view>
    <view class="wc-hint">{{wecom.hint}}</view>
  </view>
</view>

<view wx:elif="{{type === 'wecom_contact' && wecom && wecom.view === 'strip'}}" class="wc-blk wc-strip" style="background:{{bg}};color:{{fg}}">
  <view class="wc-strip-body">
    <view wx:if="{{wecom.kicker}}" class="wc-kicker">{{wecom.kicker}}</view>
    <view wx:if="{{wecom.title}}" class="wc-strip-title">{{wecom.title}}</view>
    <view wx:if="{{wecom.subtitle}}" class="wc-strip-sub">{{wecom.subtitle}}</view>
    <!-- See card-view notes for the three-mode branching rationale. -->
    <button wx:if="{{wecom.showButton && wecom.qrUrl}}" class="wc-cta wc-cta-strip"
            bindtap="onWecomCtaTap" style="background:{{wecom.accent}};color:{{wecom.btnFg}}">{{wecom.buttonLabel}}</button>
    <button wx:elif="{{wecom.showButton && wecom.kfUrl}}" class="wc-cta wc-cta-strip"
            bindtap="onWecomChatTap" style="background:{{wecom.accent}};color:{{wecom.btnFg}}">{{wecom.buttonLabel}}</button>
    <button wx:elif="{{wecom.showButton}}" class="wc-cta wc-cta-strip" open-type="contact"
            session-from="wecom_contact_block" bindcontact="onWecomContactError"
            style="background:{{wecom.accent}};color:{{wecom.btnFg}}">{{wecom.buttonLabel}}</button>
  </view>
  <view wx:if="{{wecom.showQr && wecom.qrUrl}}" class="wc-strip-qr">
    <image src="{{wecom.qrUrl}}" mode="aspectFit" class="wc-qr-sm" show-menu-by-longpress="{{true}}" bindtap="onWecomQrTap"/>
    <view class="wc-hint wc-hint-sm">{{wecom.hint}}</view>
  </view>
</view>

<view wx:elif="{{type === 'countdown_timer'}}" class="countdown corner-{{countdownCorner}} {{countdownUrgent ? 'urgent' : ''}}" style="background:{{bg}};color:{{fg}}">
  <view wx:if="{{countdown.kicker}}" class="cd-kicker">{{countdown.kicker}}</view>
  <view wx:if="{{countdown.title}}" class="cd-title">{{countdown.title}}</view>
  <view wx:if="{{!countdown.isEnded}}" class="cd-clock">
    <block wx:for="{{countdown.cells}}" wx:key="lbl">
      <view class="cd-cell">
        <view class="cd-num">{{item.num}}</view>
        <view class="cd-lbl">{{item.lbl}}</view>
      </view>
      <view wx:if="{{index < countdown.cells.length - 1}}" class="cd-sep">:</view>
    </block>
  </view>
  <view wx:if="{{!countdown.isEnded && countdown.ctaLabel}}" class="cd-cta" style="background:{{countdown.btnBg}};color:{{countdown.btnFg}}" bindtap="onCountdownCtaTap">
    {{countdown.ctaLabel}}
  </view>
  <view wx:if="{{countdown.isEnded}}" class="cd-ended">{{countdown.ended}}</view>
</view>

<view wx:elif="{{type === 'leaderboard' && leaderboardCard && !leaderboardHidden}}" class="lb-blk" style="background:{{bg}};color:{{fg}}" bindtap="onLeaderboardTap">
  <view class="lb-head">
    <view class="lb-head-main">
      <view wx:if="{{leaderboardCard.kicker}}" class="lb-kicker" style="color:{{leaderboardAccent}}">{{leaderboardCard.kicker}}</view>
      <view class="lb-ttl">{{leaderboardCard.title}}</view>
      <view wx:if="{{leaderboardCard.subhead}}" class="lb-sub">{{leaderboardCard.subhead}}</view>
    </view>
    <view class="lb-period">{{leaderboardCard.periodLabel}}</view>
  </view>
  <view class="lb-list">
    <view wx:for="{{leaderboardCard.rows}}" wx:key="rank" class="lb-row">
      <text wx:if="{{item.medal}}" class="lb-medal">{{item.medal}}</text>
      <text wx:else class="lb-rank">{{item.rankText}}</text>
      <text class="lb-name">{{item.name}}</text>
      <text wx:if="{{item.value}}" class="lb-value" style="color:{{leaderboardAccent}}">{{item.value}}</text>
    </view>
  </view>
  <view wx:if="{{leaderboardCard.footer}}" class="lb-footer">{{leaderboardCard.footer}}</view>
  <view class="lb-cta" style="color:{{leaderboardAccent}}">{{leaderboardCard.ctaLabel}} ›</view>
</view>

<!-- Video banner: autoplaying muted loop, no controls -->
<view wx:elif="{{type === 'video_banner' && videoUrl}}" class="video-blk {{videoFullscreen ? 'video-fs' : ''}}" style="{{videoFullscreen ? '' : 'height:' + (videoHeight * 2) + 'rpx'}}" bindtap="onVideoTap">
  <video class="video-el"
         src="{{videoUrl}}"
         poster="{{videoPoster}}"
         autoplay="{{true}}"
         loop="{{true}}"
         muted="{{true}}"
         controls="{{false}}"
         show-center-play-btn="{{false}}"
         show-play-btn="{{false}}"
         show-fullscreen-btn="{{false}}"
         show-progress="{{false}}"
         enable-progress-gesture="{{false}}"
         object-fit="cover"
         vslide-gesture="{{false}}"/>
</view>

</view><!-- /.blk-outer -->

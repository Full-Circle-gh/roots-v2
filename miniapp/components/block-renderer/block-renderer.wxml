<!-- Switch on block.type and render the appropriate sub-template.
     All data normalisation happens in JS; the template stays declarative.
     Everything is wrapped in .blk-outer so a block can opt into a brand-
     colored outline frame and/or edge-to-edge full-bleed width. -->
<view class="blk-outer {{frameOn ? 'framed' : ''}} {{fullBleed ? 'bleed' : ''}} {{blockFill ? 'fill' : ''}} corner-{{blockCorner}}" style="{{frameOn ? 'border-color:' + frameColor : ''}}">

<!-- Shared button trio (kfUrl → chat · qrUrl → QR preview · else bound 客服)
     and social-proof row, reused across the coupon / poster / compact styles.
     `cls` + `sty` let each style colour the CTA differently.
     Defined here (outside the wx:if/wx:elif dispatch chain) so they don't
     break the chain — a template sitting between elif branches orphans them. -->
<template name="wcCta">
  <button wx:if="{{w.showButton && w.kfUrl}}" class="{{cls}}" bindtap="onWecomChatTap" style="{{sty}}"><text>{{w.buttonLabel}}</text><text class="wc-loop-cta-ar">→</text></button>
  <button wx:elif="{{w.showButton && w.qrUrl}}" class="{{cls}}" bindtap="onWecomCtaTap" style="{{sty}}"><text>{{w.buttonLabel}}</text><text class="wc-loop-cta-ar">→</text></button>
  <button wx:elif="{{w.showButton}}" class="{{cls}}" open-type="contact" session-from="wecom_contact_block" bindcontact="onWecomContactError" style="{{sty}}"><text>{{w.buttonLabel}}</text><text class="wc-loop-cta-ar">→</text></button>
</template>
<template name="wcProof">
  <view wx:if="{{w.showProof}}" class="wc-loop-proof">
    <view class="wc-loop-faces">
      <view class="wc-loop-face wc-face-0"><image class="wc-loop-face-ic" src="/assets/icons/loop/member.svg"/></view>
      <view class="wc-loop-face wc-face-1"><image class="wc-loop-face-ic" src="/assets/icons/loop/member.svg"/></view>
      <view class="wc-loop-face wc-face-2"><image class="wc-loop-face-ic" src="/assets/icons/loop/member.svg"/></view>
      <view class="wc-loop-face wc-face-3"><image class="wc-loop-face-ic" src="/assets/icons/loop/member.svg"/></view>
    </view>
    <text class="wc-loop-proof-tx">{{w.proofPre}}<text class="wc-loop-proof-n">{{w.proofCount}}</text>{{w.proofPost}}</text>
  </view>
</template>
<!-- Flash-sale design card (classic/editorial/urgency). `c` = card data,
     `badge` = corner | stamp | ribbon. Shares the component's tap handler. -->
<template name="fsdCard">
  <view class="fsd-card" data-id="{{c.id}}" bindtap="onFlashCardTap">
    <view class="fsd-img">
      <image wx:if="{{c.image}}" src="{{c.image}}" mode="aspectFill" class="img-full"/>
      <view wx:if="{{c.badge}}" class="fsd-badge-{{badge}}">{{c.badge}}</view>
    </view>
    <view class="fsd-meta">
      <view class="fsd-name">{{c.name}}</view>
      <view wx:if="{{c.sub}}" class="fsd-cn">{{c.sub}}</view>
      <view class="fsd-prices">
        <text class="fsd-now">{{c.priceNow}}</text>
        <text wx:if="{{c.priceWas}}" class="fsd-was">{{c.priceWas}}</text>
      </view>
      <view wx:if="{{c.meterPct !== null}}" class="fsd-meter"><view class="fsd-meter-bar" style="width:{{c.meterPct}}%"></view></view>
      <view class="fsd-sold">{{c.soldLbl}}</view>
    </view>
  </view>
</template>

<view wx:if="{{type === 'announcement_bar'}}" class="announce anim-{{anim}} speed-{{speed}} {{announceLink ? 'announce-linked' : ''}}" style="background:{{bg}};color:{{fg}}" bindtap="onAnnounceTap">
  <!-- Marquee: clipped wrapper around a duplicated track for seamless loop -->
  <view wx:if="{{anim === 'marquee_rtl' || anim === 'marquee_ltr'}}" class="anim-clip">
    <view class="anim-track">
      <text class="announce-text">{{label}}</text>
      <text class="announce-text">{{label}}</text>
    </view>
  </view>
  <!-- Vertical scroll: fixed-height clip with stacked duplicates -->
  <view wx:elif="{{anim === 'scroll_up' || anim === 'scroll_down'}}" class="anim-vclip">
    <view class="anim-vtrack">
      <text class="announce-text">{{label}}</text>
      <text class="announce-text">{{label}}</text>
    </view>
  </view>
  <!-- Per-letter: each char on its own with --i for staggered delay -->
  <view wx:elif="{{anim === 'typewriter' || anim === 'wave' || anim === 'fade_in_letters'}}" class="letters">
    <text wx:for="{{chars}}" wx:key="index" class="ch" style="--i:{{index}}">{{item}}</text>
  </view>
  <!-- static, flicker — plain text -->
  <text wx:else class="announce-text">{{label}}</text>
  <text wx:if="{{announceLink}}" class="announce-chev">›</text>
</view>

<!-- Hero: full view (current — image fills, CTAs float) -->
<view wx:elif="{{type === 'hero_banner' && heroView !== 'split'}}" class="hero hero-full scrim-{{heroScrim}} enter-{{heroEnter}}" style="{{heroFit === 'contain' ? (aspectRatio ? 'aspect-ratio:' + aspectRatio + ';height:auto' : 'height:' + (placeholderH * 2) + 'rpx') : 'aspect-ratio:' + fillAspect + ';height:auto'}}">
  <video wx:if="{{heroVideo}}" class="hero-video" src="{{heroVideo}}" poster="{{imageUrl}}"
         autoplay="{{true}}" loop="{{true}}" muted="{{true}}" controls="{{false}}"
         show-center-play-btn="{{false}}" show-play-btn="{{false}}" show-fullscreen-btn="{{false}}"
         show-progress="{{false}}" enable-progress-gesture="{{false}}" object-fit="{{heroFit === 'contain' ? 'contain' : heroFit === 'stretch' ? 'fill' : 'cover'}}" vslide-gesture="{{false}}"/>
  <image wx:elif="{{imageUrl}}" src="{{imageUrl}}" mode="{{heroImgMode}}" class="hero-img"/>
  <view wx:else class="hero-placeholder">No image</view>
  <view wx:if="{{(heroVideo || imageUrl) && ctas.length && heroScrim !== 'none'}}" class="hero-scrim"></view>
  <view wx:if="{{(heroVideo || imageUrl) && ctas.length}}" class="cta-stack">
    <button wx:for="{{ctas}}" wx:key="index" class="cta-btn cta-{{item.style}}"
            style="background:{{item.btnBg}};color:{{item.btnFg}}"
            data-idx="{{index}}" bindtap="onCtaTap">
      {{item.label}}
    </button>
  </view>
</view>

<!-- Hero: split view (image left, copy panel right) -->
<view wx:elif="{{type === 'hero_banner' && heroView === 'split'}}" class="hero hero-split">
  <view class="split-img">
    <video wx:if="{{heroVideo}}" class="hero-video" src="{{heroVideo}}" poster="{{imageUrl}}"
           autoplay="{{true}}" loop="{{true}}" muted="{{true}}" controls="{{false}}"
           show-center-play-btn="{{false}}" show-play-btn="{{false}}" show-fullscreen-btn="{{false}}"
           show-progress="{{false}}" enable-progress-gesture="{{false}}" object-fit="cover" vslide-gesture="{{false}}"/>
    <image wx:elif="{{imageUrl}}" src="{{imageUrl}}" mode="aspectFill" class="hero-img"/>
    <view wx:else class="hero-placeholder">No image</view>
  </view>
  <view class="split-panel" style="background:{{heroPanelBg}};color:{{heroPanelFg}}">
    <view wx:if="{{heroHeadline}}" class="headline">{{heroHeadline}}</view>
    <view wx:if="{{heroSubtitle}}" class="subtitle">{{heroSubtitle}}</view>
    <view wx:if="{{ctas.length}}" class="cta-stack">
      <button wx:for="{{ctas}}" wx:key="index" class="cta-btn cta-{{item.style}}"
              style="background:{{item.btnBg}};color:{{item.btnFg}}"
              data-idx="{{index}}" bindtap="onCtaTap">
        {{item.label}}
      </button>
    </view>
  </view>
</view>

<view wx:elif="{{type === 'category_tabs'}}"
      class="cattabs cattabs-{{catView}} cat-{{catStyle}} corner-{{catCorner}} enter-{{catEnter}}"
      style="{{catBg ? 'background:' + catBg + ';' : ''}}--cat-text:{{catText}};--cat-accent:{{catAccent}};--cat-keyline:{{catKeyline}};--cat-shadow:{{catShadow}};--cat-surface:{{catSurface}}">
  <view class="head">
    <view>
      <view class="kicker">{{kicker}}</view>
      <view class="ttl">{{title}}</view>
    </view>
    <view class="more" data-target="{{seeAllTarget}}" bindtap="onSeeAllTap">{{seeAll}}</view>
  </view>
  <!-- A · Index directory — numbered rows, colour dot, bilingual name,
       category-coloured count pill, chevron. -->
  <view wx:if="{{tiles.length && catStyle === 'index'}}" class="idx-list">
    <view wx:for="{{tiles}}" wx:key="id" class="idx-row"
          data-id="{{item.id}}" bindtap="onCategoryTap">
      <view class="idx-num">{{item.num}}</view>
      <view class="idx-dot" style="background:{{item.bg}}"></view>
      <view class="idx-name">
        <view class="en">{{item.name}}</view>
      </view>
      <view class="idx-count" style="background:{{item.bg}};color:{{item.fg}}">{{item.count}}</view>
      <view class="idx-chev">›</view>
    </view>
  </view>
  <!-- B · Bento mosaic — image tiles (first a wide hero), scrim caption,
       "NN · count" badge. Colour-fill fallback when no product photo. -->
  <view wx:elif="{{tiles.length && catStyle === 'bento'}}" class="bento-grid">
    <view wx:for="{{tiles}}" wx:key="id" class="bento-tile {{index === 0 ? 'hero' : ''}}"
          style="{{item.cover ? '' : 'background:' + item.bg + ';color:' + item.fg}}"
          data-id="{{item.id}}" bindtap="onCategoryTap">
      <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" class="bento-img"/>
      <view wx:if="{{bentoBadge}}" class="bento-badge" style="background:{{item.bg}};color:{{item.fg}}">{{item.num}} · {{item.count}}</view>
      <view class="bento-cap {{item.cover ? 'on-img' : ''}}">
        <view class="en">{{item.name}}</view>
      </view>
    </view>
  </view>
  <!-- C · Sticker chips — coloured pills, ink keyline + hard shadow, dark
       count badge. Wraps to a varying-width flow. -->
  <view wx:elif="{{tiles.length && catStyle === 'sticker'}}" class="chip-wrap">
    <view wx:for="{{tiles}}" wx:key="id" class="chip-pill"
          style="background:{{item.bg}};color:{{item.fg}}"
          data-id="{{item.id}}" bindtap="onCategoryTap">
      <text class="en">{{item.name}}</text>
      <text class="chip-count">{{item.count}}</text>
    </view>
  </view>
  <!-- Classic · Tiles view (category colour fills the tile) -->
  <view wx:elif="{{tiles.length && catView === 'tiles'}}" class="grid">
    <view wx:for="{{tiles}}" wx:key="id" class="tile"
          style="background:{{item.bg}};color:{{item.fg}}"
          data-id="{{item.id}}" bindtap="onCategoryTap">
      <view class="num">{{item.num}} · {{catWord}}</view>
      <view class="name">{{item.name}}</view>
    </view>
  </view>
  <!-- Classic · Icons view -->
  <view wx:elif="{{tiles.length && catView === 'icons'}}" class="icons-grid icons-cols-{{catCols}}">
    <view wx:for="{{tiles}}" wx:key="id" class="icon-tile"
          data-id="{{item.id}}" bindtap="onCategoryTap">
      <view class="icon-circle" style="background:{{item.bg}};color:{{item.fg}}">{{item.letter}}</view>
      <view class="icon-name">{{item.name}}</view>
    </view>
  </view>
  <!-- Classic · Scroll view — single horizontal row, drag left/right -->
  <scroll-view wx:elif="{{tiles.length && catView === 'scroll'}}" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" class="scroll-rail">
    <view wx:for="{{tiles}}" wx:key="id" class="scroll-tile"
          data-id="{{item.id}}" bindtap="onCategoryTap">
      <view class="icon-circle" style="background:{{item.bg}};color:{{item.fg}}">{{item.letter}}</view>
      <view class="icon-name">{{item.name}}</view>
    </view>
  </scroll-view>
  <view wx:else class="empty">No categories yet.</view>
</view>

<view wx:elif="{{type === 'featured_item'}}" class="featured featured-view-{{featuredView}} corner-{{featuredCorner}} enter-{{featuredEnter}}" style="background:{{featuredBg}}">
  <view wx:if="{{featuredProduct}}" class="card" data-id="{{featuredProduct.id}}" bindtap="onProductTap" style="background:{{featuredCardBg}};color:{{featuredCardFg}}">
    <view class="img">
      <image wx:if="{{featuredProduct.image}}" src="{{featuredProduct.image}}" mode="aspectFill" class="img-full"/>
      <view wx:if="{{featuredShowSale}}" class="feat-badge">{{featuredSaleLabel}}</view>
    </view>
    <view class="meta">
      <view class="kicker" style="color:{{featuredCardFg}}">{{featuredKicker}}</view>
      <view class="name">{{featuredProduct.name}}</view>
      <view wx:if="{{featuredPriceMode !== 'hide_price'}}" class="price-row">
        <text wx:if="{{featuredPriceMode === 'both' && featuredProduct.priceWas}}" class="price-was" style="color:{{featuredCardFg}};opacity:.55">{{featuredProduct.priceWas}}</text>
        <text class="price {{featuredProduct.isFlash ? 'is-flash' : ''}}">{{price}}</text>
      </view>
    </view>
  </view>
  <view wx:else class="empty">No featured product</view>
</view>

<view wx:elif="{{type === 'product_grid'}}" class="grid-block grid-view-{{gridView}} corner-{{gridCorner}} density-{{gridDensity}}" style="{{gridBg ? 'background:' + gridBg + ';padding-top:32rpx;padding-bottom:32rpx' : ''}}">
  <view class="head">
    <view>
      <view class="kicker">{{kicker}}</view>
      <view class="ttl">{{title}}</view>
    </view>
    <view class="more" data-target="{{seeAllTarget}}" bindtap="onSeeAllTap">{{seeAll}}</view>
  </view>
  <!-- Grid view (default) -->
  <view wx:if="{{gridView !== 'scroll' && gridView !== 'list'}}" class="grid cols-{{cols}}">
    <view wx:for="{{gridProducts}}" wx:key="id" class="card {{item.rank ? 'has-rank rank-card-' + item.rank : ''}}"
          data-id="{{item.id}}" bindtap="onProductTap">
      <view class="img">
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="img-full"/>
        <view wx:if="{{item.rank}}" class="rank-badge {{item.rankClass}}">{{item.rankLabel}}</view>
        <view wx:elif="{{item.isFlash}}" class="grid-flash-badge" style="{{gridSaleColor ? 'background:' + gridSaleColor + ';color:' + gridSaleFg : ''}}">{{lang === 'cn' ? '秒杀' : 'FLASH'}}</view>
      </view>
      <view class="name">{{item.name}}</view>
      <view class="price-row">
        <text wx:if="{{item.priceWas}}" class="price-was">{{item.priceWas}}</text>
        <text class="price {{item.priceWas ? 'is-flash' : ''}}" style="{{item.priceWas && gridSaleColor ? 'color:' + gridSaleColor : ''}}">{{item.price}}</text>
      </view>
      <view wx:if="{{item.soldCaption}}" class="sold-caption" style="{{gridSaleColor ? 'color:' + gridSaleColor : ''}}">{{item.soldCaption}}</view>
    </view>
    <view wx:if="{{!gridProducts.length}}" class="empty">No products yet</view>
  </view>
  <!-- Scroll view — horizontal rail -->
  <scroll-view wx:if="{{gridView === 'scroll'}}" class="scroll-rail" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view wx:for="{{gridProducts}}" wx:key="id" class="rail-card {{item.rank ? 'has-rank rank-card-' + item.rank : ''}}"
          data-id="{{item.id}}" bindtap="onProductTap">
      <view class="img">
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="img-full"/>
        <view wx:if="{{item.rank}}" class="rank-badge {{item.rankClass}}">{{item.rankLabel}}</view>
        <view wx:elif="{{item.isFlash}}" class="grid-flash-badge" style="{{gridSaleColor ? 'background:' + gridSaleColor + ';color:' + gridSaleFg : ''}}">{{lang === 'cn' ? '秒杀' : 'FLASH'}}</view>
      </view>
      <view class="name">{{item.name}}</view>
      <view class="price-row">
        <text wx:if="{{item.priceWas}}" class="price-was">{{item.priceWas}}</text>
        <text class="price {{item.priceWas ? 'is-flash' : ''}}" style="{{item.priceWas && gridSaleColor ? 'color:' + gridSaleColor : ''}}">{{item.price}}</text>
      </view>
      <view wx:if="{{item.soldCaption}}" class="sold-caption" style="{{gridSaleColor ? 'color:' + gridSaleColor : ''}}">{{item.soldCaption}}</view>
    </view>
    <view wx:if="{{!gridProducts.length}}" class="empty">No products yet</view>
  </scroll-view>
  <!-- List view — single column with bigger images + tagline -->
  <view wx:if="{{gridView === 'list'}}" class="list-rows">
    <view wx:for="{{gridProducts}}" wx:key="id" class="list-row {{item.rank ? 'has-rank rank-card-' + item.rank : ''}}"
          data-id="{{item.id}}" bindtap="onProductTap">
      <view class="img">
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="img-full"/>
        <view wx:if="{{item.rank}}" class="rank-badge {{item.rankClass}}">{{item.rankLabel}}</view>
        <view wx:elif="{{item.isFlash}}" class="grid-flash-badge" style="{{gridSaleColor ? 'background:' + gridSaleColor + ';color:' + gridSaleFg : ''}}">{{lang === 'cn' ? '秒杀' : 'FLASH'}}</view>
      </view>
      <view class="meta">
        <view class="name">{{item.name}}</view>
        <view wx:if="{{item.tagline}}" class="tagline">{{item.tagline}}</view>
        <view class="price-row">
          <text wx:if="{{item.priceWas}}" class="price-was">{{item.priceWas}}</text>
          <text class="price {{item.priceWas ? 'is-flash' : ''}}" style="{{item.priceWas && gridSaleColor ? 'color:' + gridSaleColor : ''}}">{{item.price}}</text>
        </view>
        <view wx:if="{{item.soldCaption}}" class="sold-caption" style="{{gridSaleColor ? 'color:' + gridSaleColor : ''}}">{{item.soldCaption}}</view>
      </view>
    </view>
    <view wx:if="{{!gridProducts.length}}" class="empty">No products yet</view>
  </view>
</view>

<view wx:elif="{{type === 'spacer'}}" class="spacer-blk divider-{{dividerStyle}}" style="height:{{height * 2}}rpx">
  <view wx:if="{{dividerStyle !== 'none'}}" class="spacer-divider" style="border-color:{{dividerColor}};background:{{dividerStyle === 'line' ? dividerColor : 'transparent'}}"></view>
</view>

<!-- Order tracker — only renders when the customer has a live order. Three
     layouts (classic / truck / banner) mirror the Mini App Editor; colour +
     energy controls ride on the wrapper as CSS vars. -->
<view wx:elif="{{type === 'order_tracker'}}" class="ot-wrap" style="{{orderTracker.vars}}">
  <!-- A · Classic — ringed icon stepper -->
  <view wx:if="{{orderTracker && orderTracker.style === 'classic'}}" class="ot-card corner-{{orderTrackerCorner}}" bindtap="onOrderTrackerTap">
    <view class="ot-head">
      <view class="ot-title">{{orderTracker.title}}</view>
      <view class="ot-status {{orderTracker.isUnpaid ? 'unpaid' : ''}}">{{orderTracker.statusLabel}}</view>
      <view wx:if="{{orderTracker.refundTag}}" class="ot-refund-tag">{{orderTracker.refundTag}}</view>
    </view>
    <view class="ot-body">
      <view class="ot-thumbs">
        <view wx:for="{{orderTracker.thumbs}}" wx:key="index" class="ot-th">
          <image wx:if="{{item}}" src="{{item}}" mode="aspectFill" class="ot-th-img"/>
        </view>
      </view>
      <view class="ot-info">
        <view class="ot-no">{{orderTracker.orderNo}}</view>
        <view wx:if="{{orderTracker.countLabel}}" class="ot-sub">{{orderTracker.countLabel}}<text wx:if="{{orderTracker.total}}"> · {{orderTracker.total}}</text></view>
        <view wx:if="{{orderTracker.eta}}" class="ot-sub">{{orderTracker.eta}}</view>
      </view>
      <view class="ot-cta">{{orderTracker.ctaLabel}}</view>
    </view>
    <view wx:if="{{!orderTracker.isUnpaid}}" class="ot-track">
      <view wx:for="{{orderTracker.steps}}" wx:key="label" class="ot-node {{item.filled ? 'filled' : 'upcoming'}} {{item.current ? 'current' : ''}}" style="--ot-candy:{{item.candy}}">
        <view wx:if="{{index > 0}}" class="ot-bar {{item.filled ? 'on' : ''}}"></view>
        <view class="ot-circle" style="{{item.filled ? 'background:' + item.candy : ''}}">
          <image class="ot-ic" src="{{item.icon}}" mode="aspectFit"/>
        </view>
        <view class="ot-node-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- B · Track & truck — status headline + rail with a riding truck -->
  <view wx:elif="{{orderTracker && orderTracker.style === 'truck'}}" class="ot-card ot-truck corner-{{orderTrackerCorner}}" bindtap="onOrderTrackerTap">
    <view class="ot-tk-top">
      <view class="ot-tk-headtext">
        <view class="ot-kicker">{{orderTracker.kicker}}</view>
        <view class="ot-bighead">{{orderTracker.bighead}}</view>
        <view wx:if="{{orderTracker.refundTag}}" class="ot-refund-tag">{{orderTracker.refundTag}}</view>
        <view class="ot-tk-sub">{{orderTracker.countLabel}}<text wx:if="{{orderTracker.eta}}"> · </text><text wx:if="{{orderTracker.eta}}" class="b">{{orderTracker.eta}}</text></view>
      </view>
      <view class="ot-thumbs">
        <view wx:for="{{orderTracker.thumbs}}" wx:key="index" class="ot-th">
          <image wx:if="{{item}}" src="{{item}}" mode="aspectFill" class="ot-th-img"/>
        </view>
      </view>
    </view>
    <view class="ot-rail">
      <view class="ot-rail-base"></view>
      <view class="ot-rail-fill" style="width:{{orderTracker.pct}}"></view>
      <block wx:for="{{orderTracker.dots}}" wx:key="left">
        <view wx:if="{{item.show}}" class="ot-rail-dot" style="left:{{item.left}};background:{{item.color}}"></view>
      </block>
      <view class="ot-truck-marker" style="left:{{orderTracker.pct}}">
        <image class="ot-mk-ic" src="{{orderTracker.markerIcon}}" mode="aspectFit"/>
      </view>
    </view>
    <view class="ot-tk-labels">
      <view wx:for="{{orderTracker.tkLabels}}" wx:key="label" class="ot-tl {{item.on ? 'on' : ''}} {{item.current ? 'current' : ''}}" style="text-align:{{item.align}}">
        <view class="ot-tl-en">{{item.label}}</view>
      </view>
    </view>
    <view class="ot-tk-cta">{{orderTracker.ctaArrow}}</view>
  </view>

  <!-- C · Status banner — accent header band + 4-segment bar + ticket button -->
  <view wx:elif="{{orderTracker && orderTracker.style === 'banner'}}" class="ot-banner corner-{{orderTrackerCorner}}" bindtap="onOrderTrackerTap">
    <view class="ot-bn-head">
      <view class="ot-bn-marker">
        <image class="ot-mk-ic" src="{{orderTracker.markerIcon}}" mode="aspectFit"/>
      </view>
      <view class="ot-bn-headtext">
        <view class="ot-bn-kicker">{{orderTracker.kicker}}</view>
        <view class="ot-bn-eta">{{orderTracker.bighead}}</view>
        <view wx:if="{{orderTracker.refundTag}}" class="ot-refund-tag">{{orderTracker.refundTag}}</view>
      </view>
    </view>
    <view class="ot-bn-body">
      <view class="ot-bn-row">
        <view class="ot-thumbs">
          <view wx:for="{{orderTracker.thumbs}}" wx:key="index" class="ot-th">
            <image wx:if="{{item}}" src="{{item}}" mode="aspectFill" class="ot-th-img"/>
          </view>
        </view>
        <view class="ot-info">
          <view wx:if="{{orderTracker.countLabel}}" class="ot-count">{{orderTracker.countLabel}}</view>
          <view wx:if="{{orderTracker.orderNo}}" class="ot-eta">{{orderTracker.orderNo}}</view>
        </view>
      </view>
      <view class="ot-segs">
        <view wx:for="{{orderTracker.segs}}" wx:key="label" class="ot-seg {{item.on ? 'on' : ''}} {{item.done ? 'done' : ''}} {{item.current ? 'current' : ''}}">
          <view class="ot-seg-bar"></view>
          <view class="ot-seg-lbl">
            <image class="ot-seg-ic" src="{{item.icon}}" mode="aspectFit"/>
            <text>{{item.label}}</text>
          </view>
        </view>
      </view>
      <view class="ot-bn-cta">{{orderTracker.ctaArrow}}</view>
    </view>
  </view>

  <!-- More-orders link — shown only when the customer has >1 order in flight -->
  <view wx:if="{{orderTracker && orderTracker.moreLabel}}" class="ot-more" catchtap="onOrderTrackerMore">{{orderTracker.moreLabel}}</view>
</view>

<!-- Notification bar — standalone unread strip; only renders when notifUnread>0.
     view variants: bar (slim full-width) / card (rounded inset) / pill
     (compact centred) / banner (tall, big icon). All colours operator-set. -->
<view wx:elif="{{type === 'notification_bar'}}" class="nbar nbar-{{nbarView}}">
  <view wx:if="{{nbarCount > 0}}" class="nbar-row" style="background:{{nbarBg}};color:{{nbarFg}}" catchtap="onNotifTap">
    <text class="nbar-icon {{nbarFresh ? 'fresh' : ''}}">{{nbarHasBroadcast ? '📣' : '🔔'}}</text>
    <text class="nbar-text">{{nbarText}}</text>
    <view class="nbar-btn" style="{{nbarBtnBg ? 'background:' + nbarBtnBg + ';color:' + nbarBtnFg : ''}}">→</view>
  </view>
</view>

<!-- Flash sale: strip view (default — compact header + side clock + cards) -->
<view wx:elif="{{type === 'flash_sale_strip' && !flashHidden && flashStrip && flashView === 'strip'}}" class="flash-strip" style="background:{{bg}};color:{{fg}}">
  <view class="fs-head">
    <view class="fs-head-l">
      <view wx:if="{{flashStrip.kicker}}" class="fs-kicker">{{flashStrip.kicker}}</view>
      <view wx:if="{{flashStrip.title}}" class="fs-title">{{flashStrip.title}}</view>
    </view>
    <view wx:if="{{flashStrip.countdown}}" class="fs-clock">
      <view class="fs-clock-lbl">{{flashStrip.endsLabel}}</view>
      <view class="fs-clock-cells">
        <text class="fs-ct-num">{{flashStrip.countdown.d}}</text>
        <text class="fs-ct-sep">:</text>
        <text class="fs-ct-num">{{flashStrip.countdown.h}}</text>
        <text class="fs-ct-sep">:</text>
        <text class="fs-ct-num">{{flashStrip.countdown.m}}</text>
        <text class="fs-ct-sep">:</text>
        <text class="fs-ct-num">{{flashStrip.countdown.s}}</text>
      </view>
    </view>
  </view>
  <scroll-view wx:if="{{flashStrip.cards.length}}" class="fs-cards" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view wx:for="{{flashStrip.cards}}" wx:key="id" class="fs-card"
          data-id="{{item.id}}" bindtap="onFlashCardTap">
      <view class="fs-card-img">
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="img-full"/>
        <view wx:if="{{item.badge}}" class="fs-badge">{{item.badge}}</view>
      </view>
      <view class="fs-card-meta">
        <view class="fs-card-name">{{item.name}}</view>
        <view class="fs-card-prices">
          <text class="fs-price-now" style="{{flashAccent ? 'color:' + flashAccent : ''}}">{{item.priceNow}}</text>
          <text wx:if="{{item.priceWas}}" class="fs-price-was">{{item.priceWas}}</text>
        </view>
        <view wx:if="{{item.meterPct !== null}}" class="fs-meter">
          <view class="fs-meter-bar" style="width:{{item.meterPct}}%;{{flashAccent ? 'background:' + flashAccent : ''}}"></view>
        </view>
        <view class="fs-meter-lbl">{{item.meterLabel}}</view>
      </view>
    </view>
  </scroll-view>
  <view wx:elif="{{flashStrip.isEmpty}}" class="fs-empty">{{flashStrip.emptyText}}</view>
</view>

<!-- Flash sale: hero view (big centered countdown + products below) -->
<!-- Flash sale: banner view (big countdown + CTA only, no products) -->
<view wx:elif="{{type === 'flash_sale_strip' && !flashHidden && flashStrip && (flashView === 'hero' || flashView === 'banner')}}" class="flash-hero flash-{{flashView}}" style="background:{{bg}};color:{{fg}}">
  <view wx:if="{{flashStrip.kicker}}" class="fh-kicker">{{flashStrip.kicker}}</view>
  <view wx:if="{{flashStrip.title}}" class="fh-title">{{flashStrip.title}}</view>
  <view wx:if="{{!flashStrip.isEmpty && flashStrip.cells.length}}" class="fh-ends">{{flashStrip.endsLabel}}</view>
  <view wx:if="{{!flashStrip.isEmpty && flashStrip.cells.length}}" class="fh-clock">
    <block wx:for="{{flashStrip.cells}}" wx:key="lbl">
      <view class="fh-cell">
        <view class="fh-num">{{item.num}}</view>
        <view class="fh-lbl">{{item.lbl}}</view>
      </view>
      <view wx:if="{{index < flashStrip.cells.length - 1}}" class="fh-sep">:</view>
    </block>
  </view>
  <view wx:if="{{!flashStrip.isEmpty && flashStrip.ctaLabel}}" class="fh-cta" bindtap="onFlashCtaTap">{{flashStrip.ctaLabel}}</view>
  <scroll-view wx:if="{{flashView === 'hero' && flashStrip.cards.length}}" class="fs-cards fh-cards" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view wx:for="{{flashStrip.cards}}" wx:key="id" class="fs-card"
          data-id="{{item.id}}" bindtap="onFlashCardTap">
      <view class="fs-card-img">
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="img-full"/>
        <view wx:if="{{item.badge}}" class="fs-badge">{{item.badge}}</view>
      </view>
      <view class="fs-card-meta">
        <view class="fs-card-name">{{item.name}}</view>
        <view class="fs-card-prices">
          <text class="fs-price-now" style="{{flashAccent ? 'color:' + flashAccent : ''}}">{{item.priceNow}}</text>
          <text wx:if="{{item.priceWas}}" class="fs-price-was">{{item.priceWas}}</text>
        </view>
        <view wx:if="{{item.meterPct !== null}}" class="fs-meter">
          <view class="fs-meter-bar" style="width:{{item.meterPct}}%;{{flashAccent ? 'background:' + flashAccent : ''}}"></view>
        </view>
        <view class="fs-meter-lbl">{{item.meterLabel}}</view>
      </view>
    </view>
  </scroll-view>
  <view wx:if="{{flashStrip.isEmpty}}" class="fs-empty">{{flashStrip.emptyText}}</view>
</view>

<!-- Flash sale: design directions (classic / editorial / urgency) — coral band,
     cream zigzag edge, live countdown, SHOP NOW pill and a product carousel. -->
<view wx:elif="{{type === 'flash_sale_strip' && !flashHidden && flashDesign}}"
      class="fsd-wrap fsd-{{flashDesign.view}} corner-{{flashDesign.corner}}"
      style="background:{{bg}};color:{{fg}};{{flashDesign.styleVars}}">
  <view class="fsd-zig" style="clip-path:{{flashDesign.zigClip}};-webkit-clip-path:{{flashDesign.zigClip}}"></view>
  <view class="fsd-body">

    <!-- A · Classic — centred, cream tiles with ":" separators -->
    <block wx:if="{{flashDesign.view === 'classic'}}">
      <view class="fsd-head">
        <view wx:if="{{flashDesign.kicker}}" class="fsd-kicker">{{flashDesign.kicker}}</view>
        <view wx:if="{{flashDesign.title}}" class="fsd-title">{{flashDesign.title}}</view>
      </view>
      <view class="fsd-ends">
        <view class="fsd-ends-lbl">{{flashDesign.endsLabel}}</view>
        <view class="fsd-clock {{flashDesign.pulse ? 'fs-pulse' : ''}}">
          <block wx:for="{{flashDesign.tiles}}" wx:key="lbl">
            <view class="fsd-tile"><view class="fsd-tile-num">{{item.num}}</view><view class="fsd-tile-lbl">{{item.lbl}}</view></view>
            <text wx:if="{{index < 3}}" class="fsd-colon">:</text>
          </block>
        </view>
      </view>
      <view wx:if="{{flashDesign.shop}}" class="fsd-cta-wrap"><view class="fsd-cta" bindtap="onFlashCtaTap">{{flashDesign.shop}} →</view></view>
      <scroll-view class="fsd-cards" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <template is="fsdCard" wx:for="{{flashDesign.cards}}" wx:key="id" data="{{c: item, badge: 'corner'}}"/>
      </scroll-view>
    </block>

    <!-- B · Editorial — left headline, horizontal cream ticker -->
    <block wx:elif="{{flashDesign.view === 'editorial'}}">
      <view class="fsd-head">
        <view wx:if="{{flashDesign.kicker}}" class="fsd-kicker">{{flashDesign.kicker}}</view>
        <view wx:if="{{flashDesign.title}}" class="fsd-title">{{flashDesign.title}}</view>
        <view class="fsd-ticker {{flashDesign.pulse ? 'fs-pulse' : ''}}">
          <block wx:for="{{flashDesign.tiles}}" wx:key="lbl">
            <view class="fsd-seg"><view class="fsd-seg-num">{{item.num}}</view><view class="fsd-seg-lbl">{{item.lbl}}</view></view>
            <view wx:if="{{index < 3}}" class="fsd-seg-div"></view>
          </block>
        </view>
        <view class="fsd-cta-row">
          <view wx:if="{{flashDesign.shop}}" class="fsd-cta" bindtap="onFlashCtaTap">{{flashDesign.shop}} →</view>
          <view class="fsd-off">{{flashDesign.offMain}}<text class="cn">{{flashDesign.offSub}}</text></view>
        </view>
      </view>
      <scroll-view class="fsd-cards" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <template is="fsdCard" wx:for="{{flashDesign.cards}}" wx:key="id" data="{{c: item, badge: 'ribbon'}}"/>
      </scroll-view>
    </block>

    <!-- C · Urgency — LIVE tag, accent tiles popping on the band -->
    <block wx:else>
      <view class="fsd-head">
        <view class="fsd-live"><view class="fsd-live-dot {{flashDesign.pulse ? 'fs-pulse-dot' : ''}}"></view><text class="fsd-live-lbl">{{flashDesign.liveLbl}}</text></view>
        <view wx:if="{{flashDesign.title}}" class="fsd-title">{{flashDesign.title}}</view>
        <view wx:if="{{flashDesign.subLine}}" class="fsd-sub">{{flashDesign.subLine}}</view>
      </view>
      <view class="fsd-clock {{flashDesign.pulse ? 'fs-pulse' : ''}}">
        <view wx:for="{{flashDesign.tiles}}" wx:key="lbl" class="fsd-tile"><view class="fsd-tile-num">{{item.num}}</view><view class="fsd-tile-lbl">{{item.lbl}}</view></view>
      </view>
      <view wx:if="{{flashDesign.shop}}" class="fsd-cta-wrap"><view class="fsd-cta" bindtap="onFlashCtaTap">{{flashDesign.shop}} →</view></view>
      <scroll-view class="fsd-cards" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <template is="fsdCard" wx:for="{{flashDesign.cards}}" wx:key="id" data="{{c: item, badge: 'stamp'}}"/>
      </scroll-view>
    </block>

  </view>
</view>

<view wx:elif="{{type === 'coupon_block' && coupon}}" class="coupon-blk cp-st-{{coupon.style}}" style="background:{{bg}};color:{{fg}}">
  <view wx:if="{{coupon.discount}}" class="cp-disc">
    <view class="cp-big">{{coupon.discount}}</view>
  </view>
  <view class="cp-body">
    <view wx:if="{{coupon.kicker}}" class="cp-kicker">{{coupon.kicker}}</view>
    <view wx:if="{{coupon.title}}" class="cp-title">{{coupon.title}}</view>
    <view wx:if="{{coupon.subtitle}}" class="cp-sub">{{coupon.subtitle}}</view>
    <view wx:if="{{coupon.code && !coupon.ctaLabel}}" class="cp-code" bindtap="onCouponCodeTap">
      <text class="cp-code-label">CODE</text>
      <text class="cp-code-val">{{coupon.code}}</text>
      <text class="cp-code-copy">{{coupon.codeLabel}}</text>
    </view>
  </view>
  <view wx:if="{{coupon.ctaLabel}}" class="cp-cta" style="background:{{coupon.btnBg}};color:{{coupon.btnFg}}" bindtap="onCouponCtaTap">{{coupon.ctaLabel}}</view>
</view>

<view wx:elif="{{type === 'points_widget' && points}}" class="points-blk" style="background:{{bg}};color:{{fg}}">
  <view class="pt-star">
    <view class="pt-star-glyph">★</view>
  </view>
  <view class="pt-body">
    <view wx:if="{{points.kicker}}" class="pt-kicker">{{points.kicker}}</view>
    <view wx:if="{{points.title}}" class="pt-title">{{points.title}}</view>
    <view wx:if="{{points.subtitle}}" class="pt-sub">{{points.subtitle}}</view>
  </view>
  <view wx:if="{{points.ctaLabel}}" class="pt-cta" style="background:{{points.btnBg}};color:{{points.btnFg}}" bindtap="onPointsCtaTap">{{points.ctaLabel}}</view>
</view>

<view wx:elif="{{type === 'top_up' && topUp}}" class="topup-blk topup-blk--{{topUp.layout}}" style="background:{{bg}};color:{{fg}};--tu-accent:{{topUp.accent}};--tu-bg:{{bg}}">
  <view class="tu-head">
    <view wx:if="{{topUp.kicker}}" class="tu-kicker">{{topUp.kicker}}</view>
    <view wx:if="{{topUp.title}}" class="tu-title">{{topUp.title}}<text wx:if="{{topUp.titleHl}}" class="tu-hl"> {{topUp.titleHl}}</text></view>
  </view>

  <!-- B · Receipt list — full-bleed stacked bands, perforated dividers -->
  <block wx:if="{{topUp.layout === 'b'}}">
    <view wx:if="{{topUp.tiers.length}}" class="tu-receipt">
      <view
        wx:for="{{topUp.tiers}}"
        wx:key="id"
        class="tu-band tu-card--{{item.kind}}"
        data-target="{{topUp.ctaTarget}}"
        bindtap="onTopUpCtaTap"
      >
        <view class="tu-notch tu-notch--l"></view>
        <view class="tu-notch tu-notch--r"></view>
        <view class="tu-band-l">
          <view class="tu-num">{{item.numLabel}}</view>
          <view class="tu-amt">¥{{item.amountDisplay}}</view>
        </view>
        <view class="tu-band-r">
          <view wx:if="{{item.best}}" class="tu-best tu-best--band">{{lang === 'cn' ? '超值首选' : 'BEST VALUE'}}</view>
          <view class="tu-pts">+{{item.bonus}} {{lang === 'cn' ? '积分' : 'PTS'}}</view>
          <view class="tu-meta">{{item.pct}}% {{lang === 'cn' ? '加赠' : 'BONUS'}} · ≈¥{{item.valueDisplay}} {{lang === 'cn' ? '价值' : 'VALUE'}}</view>
        </view>
      </view>
    </view>
    <view class="tu-linkout" data-target="{{topUp.ctaTarget}}" bindtap="onTopUpCtaTap">
      <text class="tu-sub">{{lang === 'cn' ? '在钱包中选择套餐' : 'Pick a pack in the wallet'}}</text>
      <view class="tu-cta">{{lang === 'cn' ? '立即充值' : 'Top up now'}} →</view>
    </view>
  </block>

  <!-- C · Hero tier + strip — push one best-value pack big -->
  <block wx:elif="{{topUp.layout === 'c'}}">
    <view wx:if="{{topUp.hero}}" class="tu-hero" data-target="{{topUp.ctaTarget}}" bindtap="onTopUpCtaTap">
      <view class="tu-best tu-best--hero">{{lang === 'cn' ? '超值首选' : 'BEST VALUE'}}</view>
      <view class="tu-hero-top">
        <view class="tu-hero-l">
          <view class="tu-num">{{topUp.hero.numLabel}}</view>
          <view class="tu-amt tu-amt--hero">¥{{topUp.hero.amountDisplay}}</view>
        </view>
        <view class="tu-hero-r">
          <view class="tu-pts">+{{topUp.hero.bonus}} {{lang === 'cn' ? '积分' : 'PTS'}}</view>
          <view class="tu-meta">{{topUp.hero.pct}}% {{lang === 'cn' ? '加赠' : 'BONUS'}} · ≈¥{{topUp.hero.valueDisplay}} {{lang === 'cn' ? '价值' : 'VALUE'}}</view>
        </view>
      </view>
      <view class="tu-hero-cta">{{lang === 'cn' ? '立即充值' : 'Top up now'}} →</view>
    </view>
    <scroll-view wx:if="{{topUp.rest.length}}" class="tu-strip" scroll-x enable-flex>
      <view
        wx:for="{{topUp.rest}}"
        wx:key="id"
        class="tu-chipcard tu-card--{{item.kind}}"
        data-target="{{topUp.ctaTarget}}"
        bindtap="onTopUpCtaTap"
      >
        <view class="tu-num">{{item.numLabel}}</view>
        <view class="tu-amt tu-amt--sm">¥{{item.amountDisplay}}</view>
        <view class="tu-pts tu-pts--sm">+{{item.bonus}} {{lang === 'cn' ? '积分' : 'PTS'}}</view>
        <view class="tu-meta tu-meta--sm">≈¥{{item.valueDisplay}} {{lang === 'cn' ? '价值' : 'VALUE'}}</view>
      </view>
    </scroll-view>
  </block>

  <!-- A · Card row (default) — swipeable tier cards -->
  <block wx:else>
    <scroll-view wx:if="{{topUp.tiers.length}}" class="tu-row" scroll-x enable-flex>
      <view
        wx:for="{{topUp.tiers}}"
        wx:key="id"
        class="tu-card tu-card--{{item.kind}}"
        data-target="{{topUp.ctaTarget}}"
        bindtap="onTopUpCtaTap"
      >
        <view wx:if="{{item.best}}" class="tu-best">{{lang === 'cn' ? '超值首选' : 'BEST VALUE'}}</view>
        <view class="tu-num">{{item.numLabel}}</view>
        <view class="tu-amt">¥{{item.amountDisplay}}</view>
        <view class="tu-pts">+{{item.bonus}} {{lang === 'cn' ? '积分' : 'PTS'}}</view>
        <view class="tu-meta">{{item.pct}}% {{lang === 'cn' ? '加赠' : 'BONUS'}} · ≈¥{{item.valueDisplay}} {{lang === 'cn' ? '价值' : 'VALUE'}}</view>
      </view>
    </scroll-view>
    <view class="tu-linkout" data-target="{{topUp.ctaTarget}}" bindtap="onTopUpCtaTap">
      <text class="tu-sub">{{lang === 'cn' ? '在钱包中选择套餐' : 'Pick a pack in the wallet'}}</text>
      <view class="tu-cta">{{lang === 'cn' ? '立即充值' : 'Top up now'}} →</view>
    </view>
  </block>
</view>

<view wx:elif="{{type === 'review_card' && reviews.length}}" class="review-blk review-{{reviewView}}" style="background:{{bg}};color:{{fg}};{{rvVars}}">
  <view wx:if="{{reviewKicker && reviewView !== 'editorial' && reviewView !== 'riso' && reviewView !== 'spotlight'}}" class="rv-kicker">{{reviewKicker}}</view>

  <!-- A · Editorial — calm bordered card, first review only -->
  <block wx:if="{{reviewView === 'editorial'}}">
    <view class="rv-card">
      <view wx:if="{{reviewKicker}}" class="ed-kicker"><view class="ed-tick"/><text class="ed-klabel">{{reviewKicker}}</text><view class="ed-tick"/></view>
      <view class="rv-stars" style="margin-top:{{reviewKicker ? 24 : 0}}rpx">
        <text wx:for="{{reviews[0].stars}}" wx:key="*this" class="rv-star {{item.on ? 'on' : 'off'}}" style="{{item.on && starColor ? 'color:' + starColor : ''}}">★</text>
      </view>
      <view wx:if="{{reviews[0].quote}}" class="rv-quote">{{reviews[0].quote}}</view>
      <view class="rv-divider"/>
      <view class="rv-person">
        <view class="rv-mono">
          <image wx:if="{{reviews[0].avatar}}" src="{{reviews[0].avatar}}" mode="aspectFill" class="rv-mono-img"/>
          <text wx:else>{{reviews[0].avatarInitial}}</text>
        </view>
        <view class="rv-person-text">
          <view wx:if="{{reviews[0].authorName}}" class="rv-name">{{reviews[0].authorName}}</view>
          <view wx:if="{{reviews[0].authorSub}}" class="rv-role">{{reviews[0].authorSub}}</view>
        </view>
      </view>
    </view>
  </block>

  <!-- B · Riso pop — ink border, sticker badge + verified stamp.
       One review → a static card; 2+ → an autoplay swiper that cycles through
       every review, each keeping the full sticker + VERIFIED look. -->
  <block wx:elif="{{reviewView === 'riso'}}">
    <view wx:if="{{reviews.length < 2}}" class="rv-card">
      <view class="riso-badge">
        <text class="riso-badge-star">★</text><text class="riso-badge-star">★</text><text class="riso-badge-star">★</text><text class="riso-badge-star">★</text><text class="riso-badge-star">★</text>
      </view>
      <view class="riso-stamp">{{lang === 'cn' ? '真实评价' : 'VERIFIED'}}</view>
      <view wx:if="{{reviewKicker}}" class="riso-kicker">{{reviewKicker}}</view>
      <view wx:if="{{reviews[0].quote}}" class="rv-quote rv-quote-left">{{reviews[0].quote}}</view>
      <view class="rv-person">
        <view class="rv-mono rv-mono-sticker">
          <image wx:if="{{reviews[0].avatar}}" src="{{reviews[0].avatar}}" mode="aspectFill" class="rv-mono-img"/>
          <text wx:else class="rv-mono-inner">{{reviews[0].avatarInitial}}</text>
        </view>
        <view class="rv-person-text">
          <view wx:if="{{reviews[0].authorName}}" class="rv-name">{{reviews[0].authorName}}</view>
          <view wx:if="{{reviews[0].authorSub}}" class="rv-role">{{reviews[0].authorSub}}</view>
        </view>
      </view>
    </view>
    <swiper wx:else class="rv-swiper riso-swiper" style="height:{{reviewSwiperH || 420}}rpx" indicator-dots="{{true}}" indicator-color="rgba(0,0,0,0.18)" indicator-active-color="rgba(0,0,0,0.7)" autoplay="{{true}}" interval="{{5000}}" circular="{{true}}">
      <swiper-item wx:for="{{reviews}}" wx:key="key">
        <view class="rv-card riso-swiper-card">
          <view class="riso-badge">
            <text class="riso-badge-star">★</text><text class="riso-badge-star">★</text><text class="riso-badge-star">★</text><text class="riso-badge-star">★</text><text class="riso-badge-star">★</text>
          </view>
          <view class="riso-stamp">{{lang === 'cn' ? '真实评价' : 'VERIFIED'}}</view>
          <view wx:if="{{reviewKicker}}" class="riso-kicker">{{reviewKicker}}</view>
          <view wx:if="{{item.quote}}" class="rv-quote rv-quote-left">{{item.quote}}</view>
          <view class="rv-person">
            <view class="rv-mono rv-mono-sticker">
              <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" class="rv-mono-img"/>
              <text wx:else class="rv-mono-inner">{{item.avatarInitial}}</text>
            </view>
            <view class="rv-person-text">
              <view wx:if="{{item.authorName}}" class="rv-name">{{item.authorName}}</view>
              <view wx:if="{{item.authorSub}}" class="rv-role">{{item.authorSub}}</view>
            </view>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </block>

  <!-- C · Spotlight — header band + dark hero card + thumbnail rail -->
  <block wx:elif="{{reviewView === 'spotlight'}}">
    <view class="spot-head">
      <view class="spot-head-text">
        <view wx:if="{{reviewKicker}}" class="spot-kicker">{{reviewKicker}}</view>
        <view class="spot-title">{{spotTitle}}</view>
      </view>
      <view class="spot-nav">
        <view class="spot-arrow prev" data-step="-1" bindtap="spotStep">‹</view>
        <view class="spot-arrow next" data-step="1" bindtap="spotStep">›</view>
      </view>
    </view>
    <view class="spot-stage">
      <view class="spot-peek"/>
      <view class="rv-card">
        <view class="spot-top">
          <view class="rv-stars rv-stars-left">
            <text wx:for="{{reviews[spotActive].stars}}" wx:key="*this" class="rv-star {{item.on ? 'on' : 'off'}}" style="{{item.on && starColor ? 'color:' + starColor : ''}}">★</text>
          </view>
          <text class="spot-count">{{spotCount}}</text>
        </view>
        <view wx:if="{{reviews[spotActive].quote}}" class="rv-quote rv-quote-left">{{reviews[spotActive].quote}}</view>
        <view class="rv-person">
          <view class="rv-mono">
            <image wx:if="{{reviews[spotActive].avatar}}" src="{{reviews[spotActive].avatar}}" mode="aspectFill" class="rv-mono-img"/>
            <text wx:else>{{reviews[spotActive].avatarInitial}}</text>
          </view>
          <view class="rv-person-text">
            <view wx:if="{{reviews[spotActive].authorName}}" class="rv-name">{{reviews[spotActive].authorName}}</view>
            <view wx:if="{{reviews[spotActive].authorSub}}" class="rv-role">{{reviews[spotActive].authorSub}}</view>
          </view>
        </view>
      </view>
    </view>
    <view class="spot-rail">
      <view wx:for="{{reviews}}" wx:key="key" class="spot-thumb {{index === spotActive ? 'on' : ''}}" data-idx="{{index}}" bindtap="spotPick">{{item.avatarInitial}}</view>
    </view>
  </block>

  <!-- Carousel view: swipe through all -->
  <swiper wx:elif="{{reviewView === 'carousel'}}" class="rv-swiper" style="height:{{reviewSwiperH || 360}}rpx" indicator-dots="{{true}}" indicator-color="rgba(0,0,0,0.18)" indicator-active-color="rgba(0,0,0,0.7)" autoplay="{{true}}" interval="{{5000}}" circular="{{true}}">
    <swiper-item wx:for="{{reviews}}" wx:key="key">
      <view class="rv-item">
        <view class="rv-stars">
          <text wx:for="{{item.stars}}" wx:key="*this" wx:for-item="s" class="rv-star {{s.on ? 'on' : 'off'}}" style="{{s.on && starColor ? 'color:' + starColor : ''}}">★</text>
        </view>
        <view wx:if="{{item.quote}}" class="rv-quote">{{item.quote}}</view>
        <view class="rv-byline">
          <view class="rv-avatar">
            <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" class="rv-avatar-img"/>
            <text wx:else class="rv-avatar-fallback">{{item.avatarInitial}}</text>
          </view>
          <view class="rv-byline-text">
            <view wx:if="{{item.authorName}}" class="rv-name">{{item.authorName}}</view>
            <view wx:if="{{item.authorSub}}" class="rv-sub">{{item.authorSub}}</view>
          </view>
        </view>
      </view>
    </swiper-item>
  </swiper>

  <!-- Card view (default): first review only -->
  <block wx:else>
    <view class="rv-item">
      <view class="rv-stars">
        <text wx:for="{{reviews[0].stars}}" wx:key="*this" class="rv-star {{item.on ? 'on' : 'off'}}" style="{{item.on && starColor ? 'color:' + starColor : ''}}">★</text>
      </view>
      <view wx:if="{{reviews[0].quote}}" class="rv-quote">{{reviews[0].quote}}</view>
      <view class="rv-byline">
        <view class="rv-avatar">
          <image wx:if="{{reviews[0].avatar}}" src="{{reviews[0].avatar}}" mode="aspectFill" class="rv-avatar-img"/>
          <text wx:else class="rv-avatar-fallback">{{reviews[0].avatarInitial}}</text>
        </view>
        <view class="rv-byline-text">
          <view wx:if="{{reviews[0].authorName}}" class="rv-name">{{reviews[0].authorName}}</view>
          <view wx:if="{{reviews[0].authorSub}}" class="rv-sub">{{reviews[0].authorSub}}</view>
        </view>
      </view>
    </view>
  </block>
</view>

<!-- Favorites block — "your saved" rail / grid from customer favorites -->
<view wx:elif="{{type === 'favorites_block' && favoritesCard && !favoritesHidden}}" class="fav-blk fav-{{favoritesCard.view}} corner-{{favoritesCorner}}" style="background:{{bg}};color:{{fg}}">
  <view class="fav-head">
    <view class="fav-head-text">
      <view class="fav-kicker">{{favoritesCard.kicker}}</view>
      <view class="fav-title">{{favoritesCard.title}}</view>
    </view>
    <view wx:if="{{!favoritesCard.isEmpty}}" class="fav-see-all" bindtap="onFavoritesTap">{{favoritesCard.seeAllLabel}} →</view>
  </view>
  <view wx:if="{{favoritesCard.isEmpty}}" class="fav-empty">
    <view class="fav-empty-title">{{favoritesCard.emptyTitle}}</view>
    <view class="fav-empty-sub">{{favoritesCard.emptySub}}</view>
  </view>
  <scroll-view wx:elif="{{favoritesCard.view === 'scroll'}}" class="fav-rail" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view wx:for="{{favoritesCard.items}}" wx:key="id" class="fav-rail-card {{item.soldOut ? 'fav-out' : ''}}"
          data-id="{{item.id}}" bindtap="onProductTap">
      <view class="fav-img">
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="img-full"/>
        <view wx:if="{{item.soldOut}}" class="fav-out-tag">{{lang === 'cn' ? '已售罄' : 'SOLD OUT'}}</view>
      </view>
      <view class="fav-name">{{item.name}}</view>
      <view class="fav-price-row">
        <text wx:if="{{item.priceWas}}" class="fav-price-was">{{item.priceWas}}</text>
        <text class="fav-price {{item.isFlash ? 'is-flash' : ''}}">{{item.price}}</text>
      </view>
    </view>
  </scroll-view>
  <view wx:else class="fav-grid">
    <view wx:for="{{favoritesCard.items}}" wx:key="id" class="fav-card {{item.soldOut ? 'fav-out' : ''}}"
          data-id="{{item.id}}" bindtap="onProductTap">
      <view class="fav-img">
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="img-full"/>
        <view wx:if="{{item.soldOut}}" class="fav-out-tag">{{lang === 'cn' ? '已售罄' : 'SOLD OUT'}}</view>
      </view>
      <view class="fav-name">{{item.name}}</view>
      <view class="fav-price-row">
        <text wx:if="{{item.priceWas}}" class="fav-price-was">{{item.priceWas}}</text>
        <text class="fav-price {{item.isFlash ? 'is-flash' : ''}}">{{item.price}}</text>
      </view>
    </view>
  </view>
</view>

<!-- Voting block — 4 views (teaser/peek/inline/past_result) + auto-pull/static -->
<view wx:elif="{{type === 'voting_block' && voting && !votingHidden}}" class="voting-blk voting-{{voting.view}}" style="background:{{bg}};color:{{fg}}">

  <!-- TEASER: just kicker + title + subtitle + CTA -->
  <block wx:if="{{voting.view === 'teaser'}}">
    <view class="voting-row" bindtap="onVotingTap">
      <view class="vb-body">
        <view wx:if="{{voting.kicker}}" class="vb-kicker">{{voting.kicker}}</view>
        <view wx:if="{{voting.title}}" class="vb-title">{{voting.title}}</view>
        <view wx:if="{{voting.subtitle}}" class="vb-sub">{{voting.subtitle}}</view>
      </view>
      <view wx:if="{{voting.ctaLabel}}" class="vb-cta vb-cta-pill" style="color:{{voting.accent}}">{{voting.ctaLabel}} →</view>
    </view>
  </block>

  <!-- PEEK / PAST_RESULT / INLINE share a header. Static-copy fallback when no livePoll. -->
  <block wx:elif="{{voting.dataSource === 'static' && !voting.livePoll}}">
    <view bindtap="onVotingTap">
      <view wx:if="{{voting.kicker}}" class="vb-kicker">{{voting.kicker}}</view>
      <view wx:if="{{voting.title}}" class="vb-q">{{voting.title}}</view>
      <view wx:if="{{voting.subtitle}}" class="vb-sub">{{voting.subtitle}}</view>
      <view wx:if="{{voting.ctaLabel && voting.view !== 'inline'}}" class="vb-cta" style="color:{{voting.accent}}">{{voting.ctaLabel}} →</view>
    </view>
  </block>

  <!-- AUTO-PULL with no poll + hide_when_empty=false: empty stub (only in static dev) -->
  <block wx:elif="{{!voting.livePoll}}">
    <view class="vb-stub">{{lang === 'cn' ? '暂无投票' : 'No live poll'}}</view>
  </block>

  <!-- PEEK: question + days-left + CTA -->
  <block wx:elif="{{voting.view === 'peek'}}">
    <view bindtap="onVotingTap">
      <view class="vb-status-row">
        <view class="vb-status-pill" style="color:{{voting.statusColor}}">●  {{lang === 'cn' ? '投票' : 'OPEN'}}{{voting.livePoll.daysLeft ? ' · ' + voting.livePoll.daysLeft + 'D ' + (lang === 'cn' ? '剩余' : 'LEFT') : ''}}</view>
        <view wx:if="{{voting.livePoll.category}}" class="vb-cat">{{voting.livePoll.category}}</view>
      </view>
      <view class="vb-q">{{voting.livePoll.question}}</view>
      <view class="vb-meta">{{voting.livePoll.totalVotes}} {{lang === 'cn' ? '票' : 'votes'}} · +{{voting.livePoll.rewardPoints}} {{lang === 'cn' ? '积分' : 'pts'}}</view>
      <view wx:if="{{voting.ctaLabel}}" class="vb-cta" style="color:{{voting.accent}}">{{voting.ctaLabel}} +{{voting.livePoll.rewardPoints}} →</view>
    </view>
  </block>

  <!-- PAST_RESULT: winner card -->
  <block wx:elif="{{voting.view === 'past_result' || voting.livePoll.isClosed}}">
    <view bindtap="onVotingTap">
      <view class="vb-status-pill closed">{{lang === 'cn' ? '已结束' : 'CLOSED'}}</view>
      <view class="vb-q">{{voting.livePoll.question}}</view>
      <view wx:if="{{voting.livePoll.winner}}" class="vb-winner">
        <view class="vb-winner-label">{{lang === 'cn' ? '获胜者' : 'WINNER'}}</view>
        <view class="vb-winner-name" style="background:{{voting.accent}}">{{voting.livePoll.winner.label}}</view>
        <view class="vb-winner-meta">{{voting.livePoll.winner.pct}}% · {{voting.livePoll.winner.votes}} {{lang === 'cn' ? '票' : 'votes'}}</view>
      </view>
      <view wx:if="{{voting.ctaLabel}}" class="vb-cta" style="color:{{voting.accent}}">{{voting.ctaLabel}} →</view>
    </view>
  </block>

  <!-- INLINE: full poll with A/B/C/D options + cast vote button -->
  <block wx:elif="{{voting.view === 'inline'}}">
    <view class="vb-status-row">
      <view class="vb-status-pill" style="color:{{voting.statusColor}}">●  {{lang === 'cn' ? '投票' : 'OPEN'}}{{voting.livePoll.daysLeft ? ' · ' + voting.livePoll.daysLeft + 'D ' + (lang === 'cn' ? '剩余' : 'LEFT') : ''}}</view>
      <view wx:if="{{voting.livePoll.category}}" class="vb-cat">{{voting.livePoll.category}}</view>
    </view>
    <view class="vb-q">{{voting.livePoll.question}}</view>
    <view class="vb-opts">
      <view wx:for="{{voting.livePoll.options}}" wx:key="id" wx:for-item="opt"
            class="vb-opt {{opt.id === voting.chosenOptionId ? 'on' : ''}} {{voting.livePoll.showResults ? 'opt-results' : ''}} {{opt.isMax ? 'opt-winner' : ''}}"
            data-id="{{opt.id}}" bindtap="onVotingPick">
        <view wx:if="{{voting.livePoll.showResults}}" class="vb-opt-fill {{opt.isMine ? 'fill-mine' : ''}}" style="width: {{opt.pctWidth}};"></view>
        <view class="vb-opt-row">
          <view class="vb-opt-letter {{opt.id === voting.chosenOptionId ? 'on' : ''}}">{{opt.letter}}</view>
          <view class="vb-opt-label">{{opt.label}}</view>
          <view wx:if="{{voting.livePoll.showResults}}" class="vb-opt-pct">
            <view class="vb-opt-pct-num">{{opt.pctStr}}%</view>
            <view class="vb-opt-pct-lbl">{{opt.votes}} {{lang === 'cn' ? '票' : 'VOTES'}}</view>
          </view>
          <view wx:else class="vb-opt-tick {{opt.id === voting.chosenOptionId ? 'on' : ''}}">
            <text wx:if="{{opt.id === voting.chosenOptionId}}">✓</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{voting.livePoll.showResults}}" class="vb-voted" style="background:{{voting.accent}}">
      <view class="vb-voted-dot" style="color:{{voting.accent}}">✓</view>
      <view class="vb-voted-text">{{lang === 'cn' ? '已投票 · 谢谢' : 'Vote counted. Thanks!'}}</view>
    </view>
    <view wx:else class="vb-cta {{voting.chosenOptionId ? 'on' : ''}}"
          style="{{voting.chosenOptionId ? 'background:#1a1a17;color:' + voting.accent : ((voting.promptBg ? 'background:' + voting.promptBg + ';' : '') + (voting.promptText ? 'color:' + voting.promptText : ''))}}"
          bindtap="onVotingCast">
      <block wx:if="{{voting.chosenOptionId}}">{{lang === 'cn' ? '投票 +' + voting.livePoll.rewardPoints + ' 积分' : 'CAST VOTE · +' + voting.livePoll.rewardPoints + ' PTS'}} →</block>
      <block wx:else>{{lang === 'cn' ? '请选择' : 'PICK ONE TO VOTE'}}</block>
    </view>
    <view class="vb-foot">{{voting.livePoll.totalVotes}} {{lang === 'cn' ? '票' : 'VOTES SO FAR'}}</view>
  </block>
</view>

<!-- ─── Affiliate · CARD view (default) ─── -->
<view wx:elif="{{type === 'affiliate_block' && affiliateCard && (!affiliateCard.view || affiliateCard.view === 'card')}}" class="aff-blk aff-card" style="background:{{bg}};color:{{fg}}" bindtap="onAffiliateTap">
  <view class="aff-head">
    <view wx:if="{{affiliateCard.kicker}}" class="aff-kicker">{{affiliateCard.kicker}}</view>
    <view wx:if="{{affiliateCard.title}}" class="aff-title">{{affiliateCard.title}}</view>
    <view wx:if="{{affiliateCard.subtitle}}" class="aff-sub">{{affiliateCard.subtitle}}</view>
  </view>
  <view wx:if="{{!affiliateCard.enabled}}" class="aff-disabled">{{affiliateCard.disabledMsg}}</view>
  <block wx:elif="{{affiliateCard.code}}">
    <view class="aff-code-row">
      <view class="aff-code-pill">
        <text class="aff-code-lbl">{{affiliateCard.codeLabel}}</text>

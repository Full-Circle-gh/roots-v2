    <view wx:if="{{affiliateCard.statsLabel}}" class="aff-receipt-row aff-receipt-row-muted">
      <text class="aff-receipt-lbl">STATS</text>
      <text class="aff-receipt-val">{{affiliateCard.statsLabel}}</text>
    </view>
    <view class="aff-receipt-sep">- - - - - - - - - - - - - - - - - -</view>
    <view class="aff-receipt-actions">
      <view class="aff-receipt-copy" style="background:{{affiliateCard.accent}}" catchtap="onAffiliateCopyTap">{{affiliateCard.copyLabel}}</view>
      <button class="aff-receipt-share" open-type="share" catchtap="noop">{{affiliateCard.shareLabel}} →</button>
    </view>
  </block>
  <view wx:else class="aff-receipt-signin">{{affiliateCard.signinHint}}</view>
</view>

<view wx:elif="{{type === 'store_info' && stores && stores.length}}" class="store-blk" style="background:{{bg}};color:{{fg}}">
  <view wx:if="{{storeKicker}}" class="st-kicker">{{storeKicker}}</view>
  <view class="st-cards">
    <view wx:for="{{stores}}" wx:key="key" wx:for-item="s" class="st-card">
      <view wx:if="{{s.name}}" class="st-title">{{s.name}}</view>
      <view wx:if="{{s.hasStatus}}" class="st-status">
        <view class="st-dot" style="background:{{s.statusColor}}"></view>
        <text class="st-status-lbl">{{s.statusLabel}}</text>
        <text wx:if="{{s.hours}}" class="st-hours"> · {{s.hours}}</text>
      </view>
      <view wx:elif="{{s.hours}}" class="st-row">
        <text class="st-icon">🕒</text>
        <text class="st-val">{{s.hours}}</text>
      </view>
      <view wx:if="{{s.etaLabel}}" class="st-eta">{{s.etaLabel}}</view>
      <view wx:if="{{s.address}}" class="st-row">
        <text class="st-icon">📍</text>
        <text class="st-val">{{s.address}}</text>
      </view>
      <view wx:if="{{s.phone}}" class="st-row" data-phone="{{s.phone}}" bindtap="onStorePhoneTap">
        <text class="st-icon">📞</text>
        <text class="st-val st-phone">{{s.phone}}</text>

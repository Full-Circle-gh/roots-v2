<!-- Switch on block.type and render the appropriate sub-template.
     All data normalisation happens in JS; the template stays declarative.
     Everything is wrapped in .blk-outer so a block can opt into a brand-
     colored outline frame and/or edge-to-edge full-bleed width. -->
<view class="blk-outer {{frameOn ? 'framed' : ''}} {{fullBleed ? 'bleed' : ''}} {{blockFill ? 'fill' : ''}} corner-{{blockCorner}}" style="{{frameOn ? 'border-color:' + frameColor : ''}}">

<view wx:if="{{type === 'announcement_bar'}}" class="announce anim-{{anim}} speed-{{speed}} {{announceLink ? 'announce-linked' : ''}}" style="background:{{bg}};color:{{fg}}" bindtap="onAnnounceTap">
  <!-- Marquee: clipped wrapper around a duplicated track for seamless loop -->
  <view wx:if="{{anim === 'marquee_rtl' || anim === 'marquee_ltr'}}" class="anim-clip">
    <view class="anim-track">
      <text class="announce-text">{{label}}</text>
      <text class="announce-text">{{label}}</text>
    </view>
  </view>
  <!-- Vertical scroll: fixed-height clip with stacked duplicates -->
  <view wx:elif="{{anim === 'scroll_up' || anim === 'scroll_down'}}" class="anim-vclip">
    <view class="anim-vtrack">
      <text class="announce-text">{{label}}</text>
      <text class="announce-text">{{label}}</text>
    </view>
  </view>
  <!-- Per-letter: each char on its own with --i for staggered delay -->
  <view wx:elif="{{anim === 'typewriter' || anim === 'wave' || anim === 'fade_in_letters'}}" class="letters">
    <text wx:for="{{chars}}" wx:key="index" class="ch" style="--i:{{index}}">{{item}}</text>
  </view>
  <!-- static, flicker — plain text -->
  <text wx:else class="announce-text">{{label}}</text>
  <text wx:if="{{announceLink}}" class="announce-chev">›</text>
</view>

<!-- Hero: full view (current — image fills, CTAs float) -->
<view wx:elif="{{type === 'hero_banner' && heroView !== 'split'}}" class="hero hero-full scrim-{{heroScrim}} enter-{{heroEnter}}" style="{{heroFit === 'contain' ? (aspectRatio ? 'aspect-ratio:' + aspectRatio + ';height:auto' : 'height:' + (placeholderH * 2) + 'rpx') : 'aspect-ratio:' + fillAspect + ';height:auto'}}">
  <video wx:if="{{heroVideo}}" class="hero-video" src="{{heroVideo}}" poster="{{imageUrl}}"
         autoplay="{{true}}" loop="{{true}}" muted="{{true}}" controls="{{false}}"
         show-center-play-btn="{{false}}" show-play-btn="{{false}}" show-fullscreen-btn="{{false}}"
         show-progress="{{false}}" enable-progress-gesture="{{false}}" object-fit="{{heroFit === 'contain' ? 'contain' : heroFit === 'stretch' ? 'fill' : 'cover'}}" vslide-gesture="{{false}}"/>
  <image wx:elif="{{imageUrl}}" src="{{imageUrl}}" mode="{{heroImgMode}}" class="hero-img"/>
  <view wx:else class="hero-placeholder">No image</view>
  <view wx:if="{{(heroVideo || imageUrl) && ctas.length && heroScrim !== 'none'}}" class="hero-scrim"></view>
  <view wx:if="{{(heroVideo || imageUrl) && ctas.length}}" class="cta-stack">
    <button wx:for="{{ctas}}" wx:key="index" class="cta-btn cta-{{item.style}}"
            style="background:{{item.btnBg}};color:{{item.btnFg}}"
            data-idx="{{index}}" bindtap="onCtaTap">
      {{item.label}}
    </button>
  </view>
</view>

<!-- Hero: split view (image left, copy panel right) -->
<view wx:elif="{{type === 'hero_banner' && heroView === 'split'}}" class="hero hero-split">
  <view class="split-img">
    <video wx:if="{{heroVideo}}" class="hero-video" src="{{heroVideo}}" poster="{{imageUrl}}"
           autoplay="{{true}}" loop="{{true}}" muted="{{true}}" controls="{{false}}"
           show-center-play-btn="{{false}}" show-play-btn="{{false}}" show-fullscreen-btn="{{false}}"
           show-progress="{{false}}" enable-progress-gesture="{{false}}" object-fit="cover" vslide-gesture="{{false}}"/>
    <image wx:elif="{{imageUrl}}" src="{{imageUrl}}" mode="aspectFill" class="hero-img"/>
    <view wx:else class="hero-placeholder">No image</view>
  </view>
  <view class="split-panel" style="background:{{heroPanelBg}};color:{{heroPanelFg}}">
    <view wx:if="{{heroHeadline}}" class="headline">{{heroHeadline}}</view>
    <view wx:if="{{heroSubtitle}}" class="subtitle">{{heroSubtitle}}</view>
    <view wx:if="{{ctas.length}}" class="cta-stack">
      <button wx:for="{{ctas}}" wx:key="index" class="cta-btn cta-{{item.style}}"
              style="background:{{item.btnBg}};color:{{item.btnFg}}"
              data-idx="{{index}}" bindtap="onCtaTap">
        {{item.label}}
      </button>
    </view>
  </view>
</view>

<view wx:elif="{{type === 'category_tabs'}}" class="cattabs cattabs-{{catView}}" style="{{catBg ? 'background:' + catBg : ''}}">
  <view class="head">
    <view>
      <view class="kicker">{{kicker}}</view>
      <view class="ttl">{{title}}</view>
    </view>
    <view class="more" data-target="{{seeAllTarget}}" bindtap="onSeeAllTap">{{seeAll}}</view>
  </view>
  <!-- Tiles view (default) -->
  <view wx:if="{{tiles.length && catView === 'tiles'}}" class="grid">
    <view wx:for="{{tiles}}" wx:key="id" class="tile"
          style="background:{{item.bg}};color:{{item.fg}}"
          data-id="{{item.id}}" bindtap="onCategoryTap">
      <view class="num">{{item.num}} · {{catWord}}</view>
      <view class="name">{{item.name}}</view>
    </view>
  </view>
  <!-- Icons view -->
  <view wx:elif="{{tiles.length && catView === 'icons'}}" class="icons-grid icons-cols-{{catCols}}">
    <view wx:for="{{tiles}}" wx:key="id" class="icon-tile"
          data-id="{{item.id}}" bindtap="onCategoryTap">
      <view class="icon-circle" style="background:{{item.bg}};color:{{item.fg}}">{{item.letter}}</view>
      <view class="icon-name">{{item.name}}</view>
    </view>
  </view>
  <!-- Scroll view — single horizontal row, drag left/right -->
  <scroll-view wx:elif="{{tiles.length && catView === 'scroll'}}" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" class="scroll-rail">
    <view wx:for="{{tiles}}" wx:key="id" class="scroll-tile"
          data-id="{{item.id}}" bindtap="onCategoryTap">
      <view class="icon-circle" style="background:{{item.bg}};color:{{item.fg}}">{{item.letter}}</view>
      <view class="icon-name">{{item.name}}</view>
    </view>
  </scroll-view>
  <view wx:else class="empty">No categories yet.</view>
</view>

<view wx:elif="{{type === 'featured_item'}}" class="featured featured-view-{{featuredView}} corner-{{featuredCorner}} enter-{{featuredEnter}}" style="background:{{featuredBg}}">
  <view wx:if="{{featuredProduct}}" class="card" data-id="{{featuredProduct.id}}" bindtap="onProductTap" style="background:{{featuredCardBg}};color:{{featuredCardFg}}">
    <view class="img">
      <image wx:if="{{featuredProduct.image}}" src="{{featuredProduct.image}}" mode="aspectFill" class="img-full"/>
      <view wx:if="{{featuredShowSale}}" class="feat-badge">{{featuredSaleLabel}}</view>
    </view>
    <view class="meta">
      <view class="kicker" style="color:{{featuredCardFg}}">{{featuredKicker}}</view>
      <view class="name">{{featuredProduct.name}}</view>
      <view wx:if="{{featuredPriceMode !== 'hide_price'}}" class="price-row">
        <text wx:if="{{featuredPriceMode === 'both' && featuredProduct.priceWas}}" class="price-was" style="color:{{featuredCardFg}};opacity:.55">{{featuredProduct.priceWas}}</text>
        <text class="price {{featuredProduct.isFlash ? 'is-flash' : ''}}">{{price}}</text>
      </view>
    </view>
  </view>
  <view wx:else class="empty">No featured product</view>
</view>

<view wx:elif="{{type === 'product_grid'}}" class="grid-block grid-view-{{gridView}} corner-{{gridCorner}} density-{{gridDensity}}" style="{{gridBg ? 'background:' + gridBg + ';padding-top:32rpx;padding-bottom:32rpx' : ''}}">
  <view class="head">
    <view>
      <view class="kicker">{{kicker}}</view>
      <view class="ttl">{{title}}</view>
    </view>
    <view class="more" data-target="{{seeAllTarget}}" bindtap="onSeeAllTap">{{seeAll}}</view>
  </view>
  <!-- Grid view (default) -->
  <view wx:if="{{gridView !== 'scroll' && gridView !== 'list'}}" class="grid cols-{{cols}}">
    <view wx:for="{{gridProducts}}" wx:key="id" class="card {{item.rank ? 'has-rank rank-card-' + item.rank : ''}}"
          data-id="{{item.id}}" bindtap="onProductTap">
      <view class="img">
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="img-full"/>
        <view wx:if="{{item.rank}}" class="rank-badge {{item.rankClass}}">{{item.rankLabel}}</view>
        <view wx:elif="{{item.isFlash}}" class="grid-flash-badge" style="{{gridSaleColor ? 'background:' + gridSaleColor + ';color:' + gridSaleFg : ''}}">{{lang === 'cn' ? '秒杀' : 'FLASH'}}</view>
      </view>
      <view class="name">{{item.name}}</view>
      <view class="price-row">
        <text wx:if="{{item.priceWas}}" class="price-was">{{item.priceWas}}</text>
        <text class="price {{item.priceWas ? 'is-flash' : ''}}" style="{{item.priceWas && gridSaleColor ? 'color:' + gridSaleColor : ''}}">{{item.price}}</text>
      </view>
      <view wx:if="{{item.soldCaption}}" class="sold-caption" style="{{gridSaleColor ? 'color:' + gridSaleColor : ''}}">{{item.soldCaption}}</view>
    </view>
    <view wx:if="{{!gridProducts.length}}" class="empty">No products yet</view>
  </view>
  <!-- Scroll view — horizontal rail -->
  <scroll-view wx:if="{{gridView === 'scroll'}}" class="scroll-rail" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view wx:for="{{gridProducts}}" wx:key="id" class="rail-card {{item.rank ? 'has-rank rank-card-' + item.rank : ''}}"
          data-id="{{item.id}}" bindtap="onProductTap">
      <view class="img">
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="img-full"/>
        <view wx:if="{{item.rank}}" class="rank-badge {{item.rankClass}}">{{item.rankLabel}}</view>
        <view wx:elif="{{item.isFlash}}" class="grid-flash-badge" style="{{gridSaleColor ? 'background:' + gridSaleColor + ';color:' + gridSaleFg : ''}}">{{lang === 'cn' ? '秒杀' : 'FLASH'}}</view>
      </view>
      <view class="name">{{item.name}}</view>
      <view class="price-row">
        <text wx:if="{{item.priceWas}}" class="price-was">{{item.priceWas}}</text>
        <text class="price {{item.priceWas ? 'is-flash' : ''}}" style="{{item.priceWas && gridSaleColor ? 'color:' + gridSaleColor : ''}}">{{item.price}}</text>
      </view>
      <view wx:if="{{item.soldCaption}}" class="sold-caption" style="{{gridSaleColor ? 'color:' + gridSaleColor : ''}}">{{item.soldCaption}}</view>
    </view>
    <view wx:if="{{!gridProducts.length}}" class="empty">No products yet</view>
  </scroll-view>
  <!-- List view — single column with bigger images + tagline -->
  <view wx:if="{{gridView === 'list'}}" class="list-rows">
    <view wx:for="{{gridProducts}}" wx:key="id" class="list-row {{item.rank ? 'has-rank rank-card-' + item.rank : ''}}"
          data-id="{{item.id}}" bindtap="onProductTap">
      <view class="img">
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="img-full"/>
        <view wx:if="{{item.rank}}" class="rank-badge {{item.rankClass}}">{{item.rankLabel}}</view>
        <view wx:elif="{{item.isFlash}}" class="grid-flash-badge" style="{{gridSaleColor ? 'background:' + gridSaleColor + ';color:' + gridSaleFg : ''}}">{{lang === 'cn' ? '秒杀' : 'FLASH'}}</view>
      </view>
      <view class="meta">
        <view class="name">{{item.name}}</view>
        <view wx:if="{{item.tagline}}" class="tagline">{{item.tagline}}</view>
        <view class="price-row">
          <text wx:if="{{item.priceWas}}" class="price-was">{{item.priceWas}}</text>
          <text class="price {{item.priceWas ? 'is-flash' : ''}}" style="{{item.priceWas && gridSaleColor ? 'color:' + gridSaleColor : ''}}">{{item.price}}</text>
        </view>
        <view wx:if="{{item.soldCaption}}" class="sold-caption" style="{{gridSaleColor ? 'color:' + gridSaleColor : ''}}">{{item.soldCaption}}</view>
      </view>
    </view>
    <view wx:if="{{!gridProducts.length}}" class="empty">No products yet</view>
  </view>
</view>

<view wx:elif="{{type === 'spacer'}}" class="spacer-blk divider-{{dividerStyle}}" style="height:{{height * 2}}rpx">
  <view wx:if="{{dividerStyle !== 'none'}}" class="spacer-divider" style="border-color:{{dividerColor}};background:{{dividerStyle === 'line' ? dividerColor : 'transparent'}}"></view>
</view>

<!-- Order tracker — only renders when the customer has a live order -->
<view wx:elif="{{type === 'order_tracker'}}" class="ot-wrap">
  <view wx:if="{{orderTracker}}" class="ot-card corner-{{orderTrackerCorner}}" style="{{orderTracker.cardStyle}}" bindtap="onOrderTrackerTap">
    <view class="ot-head">
      <view class="ot-title">{{orderTracker.title}}</view>
      <view class="ot-status {{orderTracker.isUnpaid ? 'unpaid' : ''}}" style="{{orderTracker.isUnpaid ? '' : 'background:' + orderTracker.accent}}">{{orderTracker.statusLabel}}</view>
    </view>
    <view class="ot-body">
      <image wx:if="{{orderTracker.thumb}}" src="{{orderTracker.thumb}}" mode="aspectFill" class="ot-thumb"/>
      <view class="ot-info">
        <view class="ot-no">{{orderTracker.orderNo}}</view>
        <view wx:if="{{orderTracker.countLabel}}" class="ot-sub">{{orderTracker.countLabel}}<text wx:if="{{orderTracker.total}}"> · {{orderTracker.total}}</text></view>
        <view wx:if="{{orderTracker.eta}}" class="ot-sub">{{orderTracker.eta}}</view>
      </view>
      <view class="ot-cta" style="background:{{orderTracker.accent}}">{{orderTracker.ctaLabel}}</view>
    </view>
    <view wx:if="{{!orderTracker.isUnpaid}}" class="ot-track">
      <view wx:for="{{orderTracker.steps}}" wx:key="label" class="ot-node {{item.filled ? 'filled' : 'upcoming'}} {{item.current ? 'current' : ''}}">
        <view wx:if="{{index > 0}}" class="ot-bar {{item.filled ? 'on' : ''}}"></view>
        <view class="ot-circle" style="{{item.filled ? 'background:' + item.candy : ''}}">
          <image class="ot-ic" src="{{item.icon}}" mode="aspectFit"/>
        </view>
        <view class="ot-node-label">{{item.label}}</view>
      </view>
    </view>
  </view>
</view>

<!-- Notification bar — standalone unread strip; only renders when notifUnread>0.
     view variants: bar (slim full-width) / card (rounded inset) / pill
     (compact centred) / banner (tall, big icon). All colours operator-set. -->
<view wx:elif="{{type === 'notification_bar'}}" class="nbar nbar-{{nbarView}}">
  <view wx:if="{{notifUnread > 0}}" class="nbar-row" style="background:{{nbarBg}};color:{{nbarFg}}" catchtap="onNotifTap">
    <text class="nbar-icon {{notifIsFresh ? 'fresh' : ''}}">{{notifHasBroadcast ? '📣' : '🔔'}}</text>
    <text class="nbar-text">{{notifPreviewText}}</text>
    <view class="nbar-btn" style="{{nbarBtnBg ? 'background:' + nbarBtnBg + ';color:' + nbarBtnFg : ''}}">→</view>
  </view>
</view>

<!-- Flash sale: strip view (default — compact header + side clock + cards) -->
<view wx:elif="{{type === 'flash_sale_strip' && !flashHidden && flashStrip && flashView === 'strip'}}" class="flash-strip" style="background:{{bg}};color:{{fg}}">
  <view class="fs-head">
    <view class="fs-head-l">
      <view wx:if="{{flashStrip.kicker}}" class="fs-kicker">{{flashStrip.kicker}}</view>
      <view wx:if="{{flashStrip.title}}" class="fs-title">{{flashStrip.title}}</view>
    </view>
    <view wx:if="{{flashStrip.countdown}}" class="fs-clock">
      <view class="fs-clock-lbl">{{flashStrip.endsLabel}}</view>
      <view class="fs-clock-cells">
        <text class="fs-ct-num">{{flashStrip.countdown.d}}</text>
        <text class="fs-ct-sep">:</text>
        <text class="fs-ct-num">{{flashStrip.countdown.h}}</text>
        <text class="fs-ct-sep">:</text>
        <text class="fs-ct-num">{{flashStrip.countdown.m}}</text>
        <text class="fs-ct-sep">:</text>
        <text class="fs-ct-num">{{flashStrip.countdown.s}}</text>
      </view>
    </view>
  </view>
  <scroll-view wx:if="{{flashStrip.cards.length}}" class="fs-cards" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view wx:for="{{flashStrip.cards}}" wx:key="id" class="fs-card"
          data-id="{{item.id}}" bindtap="onFlashCardTap">
      <view class="fs-card-img">
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="img-full"/>
        <view wx:if="{{item.badge}}" class="fs-badge">{{item.badge}}</view>
      </view>
      <view class="fs-card-meta">
        <view class="fs-card-name">{{item.name}}</view>
        <view class="fs-card-prices">
          <text class="fs-price-now" style="{{flashAccent ? 'color:' + flashAccent : ''}}">{{item.priceNow}}</text>
          <text wx:if="{{item.priceWas}}" class="fs-price-was">{{item.priceWas}}</text>
        </view>
        <view wx:if="{{item.meterPct !== null}}" class="fs-meter">
          <view class="fs-meter-bar" style="width:{{item.meterPct}}%;{{flashAccent ? 'background:' + flashAccent : ''}}"></view>
        </view>
        <view class="fs-meter-lbl">{{item.meterLabel}}</view>
      </view>
    </view>
  </scroll-view>
  <view wx:elif="{{flashStrip.isEmpty}}" class="fs-empty">{{flashStrip.emptyText}}</view>
</view>

<!-- Flash sale: hero view (big centered countdown + products below) -->
<!-- Flash sale: banner view (big countdown + CTA only, no products) -->
<view wx:elif="{{type === 'flash_sale_strip' && !flashHidden && flashStrip && (flashView === 'hero' || flashView === 'banner')}}" class="flash-hero flash-{{flashView}}" style="background:{{bg}};color:{{fg}}">
  <view wx:if="{{flashStrip.kicker}}" class="fh-kicker">{{flashStrip.kicker}}</view>
  <view wx:if="{{flashStrip.title}}" class="fh-title">{{flashStrip.title}}</view>
  <view wx:if="{{!flashStrip.isEmpty && flashStrip.cells.length}}" class="fh-ends">{{flashStrip.endsLabel}}</view>
  <view wx:if="{{!flashStrip.isEmpty && flashStrip.cells.length}}" class="fh-clock">
    <block wx:for="{{flashStrip.cells}}" wx:key="lbl">
      <view class="fh-cell">
        <view class="fh-num">{{item.num}}</view>
        <view class="fh-lbl">{{item.lbl}}</view>
      </view>
      <view wx:if="{{index < flashStrip.cells.length - 1}}" class="fh-sep">:</view>
    </block>
  </view>
  <view wx:if="{{!flashStrip.isEmpty && flashStrip.ctaLabel}}" class="fh-cta" bindtap="onFlashCtaTap">{{flashStrip.ctaLabel}}</view>
  <scroll-view wx:if="{{flashView === 'hero' && flashStrip.cards.length}}" class="fs-cards fh-cards" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view wx:for="{{flashStrip.cards}}" wx:key="id" class="fs-card"
          data-id="{{item.id}}" bindtap="onFlashCardTap">
      <view class="fs-card-img">
        <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="img-full"/>
        <view wx:if="{{item.badge}}" class="fs-badge">{{item.badge}}</view>
      </view>
      <view class="fs-card-meta">
        <view class="fs-card-name">{{item.name}}</view>
        <view class="fs-card-prices">
          <text class="fs-price-now" style="{{flashAccent ? 'color:' + flashAccent : ''}}">{{item.priceNow}}</text>
          <text wx:if="{{item.priceWas}}" class="fs-price-was">{{item.priceWas}}</text>
        </view>
        <view wx:if="{{item.meterPct !== null}}" class="fs-meter">
          <view class="fs-meter-bar" style="width:{{item.meterPct}}%;{{flashAccent ? 'background:' + flashAccent : ''}}"></view>
        </view>
        <view class="fs-meter-lbl">{{item.meterLabel}}</view>
      </view>
    </view>
  </scroll-view>
  <view wx:if="{{flashStrip.isEmpty}}" class="fs-empty">{{flashStrip.emptyText}}</view>
</view>

<view wx:elif="{{type === 'coupon_block' && coupon}}" class="coupon-blk" style="background:{{bg}};color:{{fg}}">
  <view wx:if="{{coupon.discount}}" class="cp-disc">
    <view class="cp-big">{{coupon.discount}}</view>
  </view>
  <view class="cp-body">
    <view wx:if="{{coupon.kicker}}" class="cp-kicker">{{coupon.kicker}}</view>
    <view wx:if="{{coupon.title}}" class="cp-title">{{coupon.title}}</view>
    <view wx:if="{{coupon.subtitle}}" class="cp-sub">{{coupon.subtitle}}</view>
    <view wx:if="{{coupon.code}}" class="cp-code" bindtap="onCouponCodeTap">
      <text class="cp-code-label">CODE</text>
      <text class="cp-code-val">{{coupon.code}}</text>
      <text class="cp-code-copy">{{coupon.codeLabel}}</text>
    </view>
  </view>
  <view wx:if="{{coupon.ctaLabel}}" class="cp-cta" style="background:{{coupon.btnBg}};color:{{coupon.btnFg}}" bindtap="onCouponCtaTap">{{coupon.ctaLabel}}</view>
</view>

<view wx:elif="{{type === 'points_widget' && points}}" class="points-blk" style="background:{{bg}};color:{{fg}}">
  <view class="pt-star">
    <view class="pt-star-glyph">★</view>
  </view>
  <view class="pt-body">
    <view wx:if="{{points.kicker}}" class="pt-kicker">{{points.kicker}}</view>
    <view wx:if="{{points.title}}" class="pt-title">{{points.title}}</view>
    <view wx:if="{{points.subtitle}}" class="pt-sub">{{points.subtitle}}</view>
  </view>
  <view wx:if="{{points.ctaLabel}}" class="pt-cta" style="background:{{points.btnBg}};color:{{points.btnFg}}" bindtap="onPointsCtaTap">{{points.ctaLabel}}</view>
</view>

<view wx:elif="{{type === 'review_card' && reviews.length}}" class="review-blk review-{{reviewView}}" style="background:{{bg}};color:{{fg}}">
  <view wx:if="{{reviewKicker}}" class="rv-kicker">{{reviewKicker}}</view>
  <!-- Card view: first review only -->
  <block wx:if="{{reviewView !== 'carousel'}}">
    <view class="rv-item">
      <view class="rv-stars">
        <text wx:for="{{reviews[0].stars}}" wx:key="*this" class="rv-star {{item.on ? 'on' : 'off'}}" style="{{item.on && starColor ? 'color:' + starColor : ''}}">★</text>
      </view>
      <view wx:if="{{reviews[0].quote}}" class="rv-quote">{{reviews[0].quote}}</view>
      <view class="rv-byline">
        <view class="rv-avatar">
          <image wx:if="{{reviews[0].avatar}}" src="{{reviews[0].avatar}}" mode="aspectFill" class="rv-avatar-img"/>
          <text wx:else class="rv-avatar-fallback">{{reviews[0].avatarInitial}}</text>
        </view>
        <view class="rv-byline-text">
          <view wx:if="{{reviews[0].authorName}}" class="rv-name">{{reviews[0].authorName}}</view>
          <view wx:if="{{reviews[0].authorSub}}" class="rv-sub">{{reviews[0].authorSub}}</view>
        </view>
      </view>
    </view>
  </block>
  <!-- Carousel view: swipe through all -->
  <swiper wx:else class="rv-swiper" style="height:{{reviewSwiperH || 360}}rpx" indicator-dots="{{true}}" indicator-color="rgba(0,0,0,0.18)" indicator-active-color="rgba(0,0,0,0.7)" autoplay="{{true}}" interval="{{5000}}" circular="{{true}}">
    <swiper-item wx:for="{{reviews}}" wx:key="key">
      <view class="rv-item">
        <view class="rv-stars">
          <text wx:for="{{item.stars}}" wx:key="*this" wx:for-item="s" class="rv-star {{s.on ? 'on' : 'off'}}" style="{{s.on && starColor ? 'color:' + starColor : ''}}">★</text>
        </view>
        <view wx:if="{{item.quote}}" class="rv-quote">{{item.quote}}</view>
        <view class="rv-byline">
          <view class="rv-avatar">
            <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" class="rv-avatar-img"/>
            <text wx:else class="rv-avatar-fallback">{{item.avatarInitial}}</text>
          </view>
          <view class="rv-byline-text">
            <view wx:if="{{item.authorName}}" class="rv-name">{{item.authorName}}</view>
            <view wx:if="{{item.authorSub}}" class="rv-sub">{{item.authorSub}}</view>
          </view>
        </view>
      </view>
    </swiper-item>
  </swiper>
</view>

<!-- Favorites block — "your saved" rail / grid from customer favorites -->
<view wx:elif="{{type === 'favorites_block' && favoritesCard && !favoritesHidden}}" class="fav-blk fav-{{favoritesCard.view}} corner-{{favoritesCorner}}" style="background:{{bg}};color:{{fg}}">
  <view class="fav-head">
    <view class="fav-head-text">
      <view class="fav-kicker">{{favoritesCard.kicker}}</view>
      <view class="fav-title">{{favoritesCard.title}}</view>
    </view>

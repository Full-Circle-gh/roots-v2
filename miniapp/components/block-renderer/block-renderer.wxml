  <view wx:if="{{!affiliateCard.enabled}}" class="aff-strip-disabled">{{affiliateCard.disabledMsg}}</view>
  <block wx:elif="{{affiliateCard.code}}">
    <view class="aff-strip-copy" style="background:{{affiliateCard.accent}}" catchtap="onAffiliateCopyTap">{{affiliateCard.copyLabel}}</view>
    <button class="aff-strip-share" open-type="share" catchtap="noop">{{affiliateCard.shareLabel}}</button>
  </block>
  <view wx:else class="aff-strip-cta">{{affiliateCard.ctaLabel}} →</view>

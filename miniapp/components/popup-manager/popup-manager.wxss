.pm-bg {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(20, 20, 24, .72);
  z-index: 300;
  display: flex; align-items: center; justify-content: center;
  padding: 60rpx 56rpx;
}
.pm-card {
  width: 100%;
  max-width: 600rpx;
  background: #fff;
  border-radius: 28rpx;
  overflow: hidden;
  position: relative;
  animation: pm-rise 220ms cubic-bezier(.16, 1, .3, 1);
}
@keyframes pm-rise {
  from { opacity: 0; transform: translateY(20rpx) scale(.96); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
.pm-close {
  position: absolute; top: 18rpx; right: 18rpx;
  width: 56rpx; height: 56rpx; border-radius: 50%;
  background: rgba(0, 0, 0, .42);
  color: #fff; font-size: calc(36rpx * var(--font-scale)); line-height: 52rpx; text-align: center;
  z-index: 2;
}
.pm-img {
  display: block; width: 100%; height: 440rpx;
  background: #f7f3ee;
}
.pm-text {
  padding: 32rpx 36rpx 36rpx;
  text-align: center;
}
.pm-title {
  font-size: calc(36rpx * var(--font-scale)); font-weight: 700; color: #1a1a17;
  line-height: 1.3;
}
.pm-body {
  font-size: calc(26rpx * var(--font-scale)); color: #5a564f;
  margin-top: 12rpx;
  line-height: 1.55;
}
.pm-cta {
  display: inline-block;
  margin-top: 28rpx;
  padding: 20rpx 56rpx;
  border-radius: 999rpx;
  background: #365329;
  color: #fff;
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 600;
}

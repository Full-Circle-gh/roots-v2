<view class="page">
  <!-- Hero — full-bleed welcome comp -->
  <view class="hero">
    <image class="hero-img" src="/assets/brand/welcome-roots.jpg" mode="aspectFit"/>
  </view>

  <!-- Manifesto pull-quote -->
  <view class="section section-manifesto">
    <view class="kicker f-toni">
      <text>{{lang === 'cn' ? (c.kicker_cn || c.kicker_en) : c.kicker_en}}</text>
    </view>
    <view class="manifesto f-aleo">
      <text wx:for="{{manifestoSegments}}" wx:key="index" class="{{item.bold ? 'bold' : ''}}">{{item.text}}</text>
    </view>
    <view wx:if="{{lang === 'cn' && c.manifesto_cn && c.manifesto_cn !== c.manifesto_en}}" class="manifesto-cn f-yuan">
      {{c.manifesto_cn}}
    </view>
  </view>

  <!-- Stats strip -->
  <view class="stats">
    <view wx:for="{{c.stats}}" wx:key="index" class="stat-cell">
      <view class="stat-val f-bear">{{lang === 'cn' ? (item.value_cn || item.value_en) : (item.value_en || item.value_cn)}}</view>
      <view class="stat-lbl f-toni">{{lang === 'cn' ? (item.label_cn || item.label_en) : (item.label_en || item.label_cn)}}</view>
    </view>
  </view>

  <!-- Founder -->
  <view class="section">
    <view class="kicker f-toni">
      <text>{{lang === 'cn' ? (c.founder_kicker_cn || c.founder_kicker_en) : c.founder_kicker_en}}</text>
    </view>
    <view class="founder-row">
      <view class="founder-photo">
        <image wx:if="{{founderPhoto}}" class="founder-photo-img" src="{{founderPhoto}}" mode="aspectFill"/>
        <view wx:else class="founder-photo-empty f-toni">{{lang === 'cn' ? '照片' : 'PHOTO'}}</view>
      </view>
      <view class="founder-meta">
        <view class="founder-name f-bear">{{lang === 'cn' ? (c.founder_name_cn || c.founder_name_en) : (c.founder_name_en || c.founder_name_cn)}}</view>
        <view class="founder-title f-toni">
          <text>{{lang === 'cn' ? (c.founder_title_cn || c.founder_title_en) : c.founder_title_en}}</text>
        </view>
        <view class="founder-quote f-aleo {{storyExpanded ? '' : 'clamp'}}">"{{lang === 'cn' ? (c.founder_quote_cn || c.founder_quote_en) : (c.founder_quote_en || c.founder_quote_cn)}}"</view>
        <view class="founder-link f-toni" bindtap="toggleStory">{{storyExpanded ? (lang === 'cn' ? '收起 ↑' : 'SHOW LESS ↑') : (lang === 'cn' ? '阅读完整故事 →' : 'READ THE FULL STORY →')}}</view>
      </view>
    </view>
  </view>

  <!-- What's IN / What's OUT -->
  <view class="section">
    <view class="kicker f-toni">
      <text>{{lang === 'cn' ? (c.promise_kicker_cn || c.promise_kicker_en) : c.promise_kicker_en}}</text>
    </view>
    <view class="promise-title f-bear">
      <block wx:if="{{lang === 'cn'}}">
        <text class="line">留下<text class="hl">该有的</text>。</text>
        <text class="line">剔除<text class="strike">多余的</text>。</text>
      </block>
      <block wx:else>
        <text class="line">What's <text class="hl">in</text>.</text>
        <text class="line">What's <text class="strike">out</text>.</text>
      </block>
    </view>

    <view class="promise-grid">
      <view class="promise-col promise-in">
        <view class="promise-head f-gothic">
          <view class="promise-tick">✓</view>
          <text>{{lang === 'cn' ? '是' : 'IN'}}</text>
        </view>
        <view wx:for="{{c.in_items}}" wx:key="index" class="promise-item f-aleo">
          · {{lang === 'cn' ? (item.cn || item.en) : item.en}}
        </view>
      </view>

      <view class="promise-col promise-out">
        <view class="promise-head light f-gothic">
          <view class="promise-tick light">✕</view>
          <text>{{lang === 'cn' ? '否' : 'OUT'}}</text>
        </view>
        <view wx:for="{{c.out_items}}" wx:key="index" class="promise-item dark strike f-aleo">
          · {{lang === 'cn' ? (item.cn || item.en) : item.en}}
        </view>
      </view>
    </view>
  </view>

  <!-- Outro sign-off — show only the active language -->
  <view class="section outro">
    <view wx:if="{{lang === 'cn'}}" class="outro-cn f-yuan">{{c.outro_cn || c.outro_en}}</view>
    <view wx:else class="outro-title f-bear">{{c.outro_en}}</view>
    <view class="outro-cta f-gothic" bindtap="goShop">{{lang === 'cn' ? (c.cta_cn || c.cta_en) : (c.cta_en || c.cta_cn)}} →</view>
  </view>
</view>

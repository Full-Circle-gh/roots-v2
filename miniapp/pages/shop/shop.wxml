<view class="page page-{{layout}}">

  <!-- ════ FLY-TO-CART ANIMATION ════════════════════════════════ -->
  <view wx:if="{{flyShow}}"
        class="fly-wrap"
        style="left:{{flyStartX}}px; top:{{flyStartY}}px; transform: translateX({{flyDx}}px);">
    <view class="fly-ball"
          style="transform: translateY({{flyDy}}px);">
      <image wx:if="{{flyImg}}" class="fly-img" src="{{flyImg}}" mode="aspectFill"/>
      <text  wx:else            class="fly-plus f-bear">+</text>
    </view>
  </view>


  <!-- ════ HEADER ═══════════════════════════════════════════════ -->
  <block wx:if="{{railLayout}}">
    <view class="hdr-list">
      <view class="hdr-title f-bear">{{listTitle}}</view>
    </view>
  </block>
  <block wx:else>
    <view class="header">
      <view class="kicker f-toni">{{lang === 'cn' ? '商品' : 'SHOP'}}</view>
      <view class="title f-bear">{{lang === 'cn' ? '生鲜花园' : 'The garden.'}}</view>
    </view>
  </block>

  <!-- ════ STICKY TOP — search / switcher / filters / category chips -->
  <view class="sticky-top {{railLayout ? '' : 'sticky-grid'}}">
    <view class="search-bar {{railLayout ? 'search-bar-list' : ''}}">
      <view class="search-icon">🔍</view>
      <input class="search-input" placeholder="{{searchPlaceholder}}" value="{{query}}" bindinput="onSearchInput" confirm-type="search"/>
      <view wx:if="{{query}}" class="search-clear" bindtap="clearSearch">×</view>
    </view>

    <view wx:if="{{!layoutLocked}}" class="view-switcher {{railLayout ? 'view-switcher-list' : ''}}">
      <view wx:for="{{layoutOptions}}" wx:key="key"
            class="vs-btn {{layout === item.key ? 'on' : ''}}"
            data-key="{{item.key}}" bindtap="setLayout"
            aria-label="{{item.label}}">
        <text class="vs-icon">{{item.icon}}</text>
      </view>
    </view>

    <view wx:if="{{showAnyFilter}}" class="filter-bar">
      <view wx:if="{{showSort}}" class="filter-row">
        <picker class="filter-picker" bindchange="onSortChange" value="{{sortIndex}}" range="{{sortLabels}}">
          <view class="picker-pill f-toni">
            {{sortLabel}} <text class="picker-arrow">▾</text>
          </view>
        </picker>
        <view wx:if="{{showStockFilter}}"
              class="filter-pill {{inStockOnly ? 'on' : ''}}"
              bindtap="toggleInStock">
          <text class="f-toni">{{inStockLabel}}</text>
        </view>
      </view>

      <scroll-view wx:if="{{showBadgeFilter}}" scroll-x class="filter-chips" enhanced show-scrollbar="{{false}}">
        <view wx:for="{{badgeFilters}}" wx:key="key"
              class="badge-chip {{activeBadge === item.key ? 'on' : ''}}"
              data-key="{{item.key}}" bindtap="setBadge">
          {{item.label}}
        </view>
      </scroll-view>

      <view wx:if="{{showPriceFilter}}" class="filter-row price-row">
        <text class="price-label f-toni">{{priceFromLabel}}</text>
        <input class="price-input" type="digit" value="{{priceMin}}"
               placeholder="0" bindblur="onPriceMinBlur"/>
        <text class="price-sep">–</text>
        <input class="price-input" type="digit" value="{{priceMax}}"
               placeholder="∞" bindblur="onPriceMaxBlur"/>
        <view wx:if="{{priceMin || priceMax}}" class="price-clear" bindtap="clearPriceRange">×</view>
      </view>

      <scroll-view wx:if="{{showDietary}}" scroll-x class="diet-chips" enhanced show-scrollbar="{{false}}">
        <view wx:for="{{dietaryFilters}}" wx:key="key"
              class="diet-chip {{activeDietary === item.key ? 'on' : ''}}"
              data-key="{{item.key}}" bindtap="setDietary">
          {{item.label}}
        </view>
      </scroll-view>
    </view>

    <!-- Category chips (non-list layouts) — auto-highlights from scroll
         and auto-scrolls horizontally to keep the active chip in view. -->
    <scroll-view wx:if="{{!railLayout}}" scroll-x class="chips"
                 scroll-into-view="{{activeChipId}}"
                 scroll-with-animation
                 enhanced show-scrollbar="{{false}}">
      <!-- TOP LEVEL chips: ALL + top categories (› = drills into subs). -->
      <view wx:if="{{!drillTop}}" class="chip-pane">
        <view id="chip-all" class="chip {{!activeCategory ? 'on' : ''}}" data-name="" bindtap="setCategory">{{seeAll}}</view>
        <view wx:for="{{sections}}" wx:key="id"
              id="chip-{{item.id}}"
              class="chip {{activeCategory === item.name ? 'on' : ''}}"
              data-name="{{item.name}}" bindtap="onTopTab">{{item.label}}<text wx:if="{{item.drillable}}" class="chip-chev">›</text></view>
      </view>
      <!-- DRILLED chips: back (olive exit) + ALL-of-category + subcategories. -->
      <view wx:else class="chip-pane">
        <view id="chip-back" class="chip chip-back" bindtap="drillBack">‹ {{backLabel}}</view>
        <view id="chip-suball" class="chip {{!activeSub ? 'on' : ''}}" data-sub="" bindtap="setSub">{{seeAll}}</view>
        <view wx:for="{{subTabs}}" wx:key="id"
              id="chip-{{item.id}}"
              class="chip {{activeSub === item.id ? 'on' : ''}}"
              data-sub="{{item.id}}" bindtap="setSub">{{item.label}}</view>
      </view>
    </scroll-view>
  </view>

  <!-- ════ LIST + LIST-COMPACT + GRID-2COL (left-rail body) ═════ -->
  <block wx:if="{{railLayout}}">
    <view class="list-body">
      <scroll-view scroll-y class="list-side" enhanced show-scrollbar="{{false}}"
                   scroll-into-view="{{sidebarScrollId}}"
                   scroll-with-animation>
        <!-- TOP LEVEL — ALL + top categories. A ›-chevron marks the ones
             that drill into their own subcategories (≥2 subs). -->
        <block wx:if="{{!drillTop}}">
          <view class="rail-pane">
            <view id="s-top-anchor"
                  class="side-tab {{!activeCategory ? 'on' : ''}}"
                  data-name="" bindtap="setCategory">
              <text class="side-label f-bear">{{seeAll}}</text>
            </view>
            <view wx:for="{{sections}}" wx:key="id"
                  id="s-{{item.id}}"
                  class="side-tab {{item.drillable ? 'has-chev' : ''}} {{activeCategory === item.name ? 'on' : ''}}"
                  data-name="{{item.name}}" bindtap="onTopTab">
              <text class="side-label f-bear">{{item.label}}</text>
              <text wx:if="{{item.drillable}}" class="side-chev">›</text>
            </view>
          </view>
        </block>

        <!-- DRILLED — back bar (the exit) + parent label + ALL-of-category
             + this category's subcategories as jump targets. -->
        <block wx:else>
          <view class="rail-pane">
            <view id="sub-top" class="side-back" bindtap="drillBack">
              <text class="side-back-chev">‹</text>
              <text class="side-back-txt f-bear">{{backLabel}}</text>
            </view>
            <view class="side-parent f-toni">{{drillLabel}}</view>
            <view id="sub-all"
                  class="side-tab side-sub {{!activeSub ? 'on' : ''}}"
                  data-sub="" bindtap="setSub">
              <text class="side-label f-bear">{{seeAll}}</text>
            </view>
            <view wx:for="{{subTabs}}" wx:key="id"
                  id="sub-{{item.id}}"
                  class="side-tab side-sub {{activeSub === item.id ? 'on' : ''}}"
                  data-sub="{{item.id}}" bindtap="setSub">
              <text class="side-label f-bear">{{item.label}}</text>
            </view>
          </view>
        </block>
      </scroll-view>

      <scroll-view scroll-y class="list-main" enhanced show-scrollbar="{{false}}"
                   bindscroll="onListScroll"
                   scroll-into-view="{{scrollIntoListId}}"
                   scroll-with-animation>
        <view id="top-anchor" class="top-anchor"></view>

        <view wx:if="{{loading && !sections.length}}" class="loading-list">
          <view class="skeleton list-row-skel"></view>
          <view class="skeleton list-row-skel"></view>
          <view class="skeleton list-row-skel"></view>
        </view>

        <view wx:elif="{{!sections.length}}" class="empty empty-inline">
          <view class="empty-title f-bear">{{emptyTitle}}</view>
          <view class="empty-sub">{{emptySub}}</view>
        </view>

        <block wx:else>
          <view wx:for="{{visibleSections}}" wx:key="id" wx:for-item="section"
                id="{{section.id}}" class="cat-section">
            <view wx:for="{{section.groups}}" wx:key="id" wx:for-item="group"
                  id="g-{{group.id}}" class="cat-group">

              <!-- GRID-2COL inside the rail: section heading + 2-col cards -->
              <block wx:if="{{isGridRail}}">
                <view wx:if="{{group.label}}" class="grid-section-head">
                  <view class="grid-section-kicker f-toni">{{group.label}}</view>
                  <view class="grid-section-count f-gothic">{{group.countStr}}</view>
                </view>
                <view class="grid grid-2 grid-rail">
                  <view wx:for="{{group.items}}" wx:key="id" wx:for-item="item"
                        class="card" data-id="{{item.id}}" bindtap="openProduct">
                    <view class="img">
                      <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="img-full" lazy-load/>
                      <image wx:else src="/assets/icons/product-placeholder.svg" mode="aspectFit" class="img-placeholder"/>
                      <view wx:if="{{item.badge}}" class="card-badge f-gothic">{{item.badge}}</view>
                      <view wx:if="{{item.isFlash}}" class="card-flash f-toni">{{lang === 'cn' ? '秒杀' : 'FLASH'}}</view>
                      <view wx:if="{{item.outOfStock}}" class="card-oos f-toni">{{oosLabel}}</view>
                      <view wx:elif="{{item.nextBatch}}" class="card-oos card-batch f-toni">{{item.nextBatchText}}</view>
                    </view>
                    <view class="name f-bear">{{item.name}}</view>
                    <view wx:if="{{item.hasVariants}}" class="vhint f-toni">{{item.variantHint}}</view>
                    <view wx:if="{{item.soldCaption}}" class="sold-cap f-toni">{{item.soldCaption}}</view>
                    <view class="card-foot">
                      <view class="price-stack">
                        <text wx:if="{{item.priceWas}}" class="price-was f-aleo">{{item.priceWas}}</text>
                        <text wx:if="{{item.pricePrefix}}" class="price-prefix f-toni">{{item.pricePrefix}}</text>
                        <text class="price f-bear {{item.isFlash ? 'is-flash' : ''}}">{{item.price}}</text>
                      </view>
                      <view wx:if="{{!item.outOfStock && !item.nextBatch}}" class="card-plus"
                            id="plus-{{item.id}}" data-id="{{item.id}}" catchtap="addToCart"></view>
                    </view>
                  </view>
                </view>
              </block>

              <!-- LIST / LIST-COMPACT: section heading + rows -->
              <block wx:else>
              <view wx:if="{{group.label}}" class="list-section-head">
                <view>
                  <view class="list-section-kicker f-toni">{{group.label}}</view>
                </view>
                <view class="list-section-count f-gothic">{{group.countStr}}</view>
              </view>

              <view wx:for="{{group.items}}" wx:key="id" wx:for-item="item"
                    class="row {{layout === 'list-compact' ? 'row-compact' : ''}}"
                    data-id="{{item.id}}" bindtap="openProduct">
                <view wx:if="{{layout !== 'list-compact'}}" class="row-img">
                  <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="img-full" lazy-load/>
                  <image wx:else src="/assets/icons/product-placeholder.svg" mode="aspectFit" class="img-placeholder"/>
                </view>
                <view class="row-body">
                  <view class="row-name f-bear">{{item.name}}</view>
                  <view wx:if="{{item.subline}}" class="row-sub f-yuan">{{item.subline}}</view>
                  <view wx:if="{{item.hasVariants}}" class="vhint f-toni">{{item.variantHint}}</view>
                  <view wx:if="{{item.soldCaption}}" class="sold-cap f-toni">{{item.soldCaption}}</view>
                  <view wx:if="{{item.isFlash}}" class="row-flash f-toni">{{lang === 'cn' ? '秒杀' : 'FLASH'}}</view>
                  <view wx:if="{{item.badge}}" class="row-badge f-gothic">{{item.badge}}</view>
                  <view wx:if="{{item.outOfStock}}" class="row-oos f-toni">{{oosLabel}}</view>
                  <view wx:elif="{{item.nextBatch}}" class="row-oos row-batch f-toni">{{item.nextBatchText}}</view>
                </view>
                <view class="row-right">
                  <view class="row-price-stack">
                    <view wx:if="{{item.priceWas}}" class="row-was f-aleo">{{item.priceWas}}</view>
                    <view wx:if="{{item.pricePrefix}}" class="row-price-prefix f-toni">{{item.pricePrefix}}</view>
                    <view class="row-price f-bear {{item.isFlash ? 'is-flash' : ''}}">{{item.price}}</view>
                  </view>
                  <view wx:if="{{!item.outOfStock && !item.nextBatch}}"
                        class="row-plus"
                        id="plus-{{item.id}}"
                        data-id="{{item.id}}"
                        catchtap="addToCart"></view>
                </view>
              </view>
              </block>
            </view>
          </view>
        </block>
      </scroll-view>
    </view>
  </block>

  <!-- ════ GALLERY (1-col big editorial) ════════════════════════ -->
  <block wx:elif="{{layout === 'gallery'}}">
    <view wx:if="{{loading && !sections.length}}" class="loading-gal">
      <view class="skeleton gal-skel"></view>
      <view class="skeleton gal-skel"></view>
    </view>

    <view wx:elif="{{!sections.length}}" class="empty">
      <view class="empty-title f-bear">{{emptyTitle}}</view>
      <view class="empty-sub">{{emptySub}}</view>
    </view>

    <view wx:else>
      <view wx:for="{{visibleSections}}" wx:key="id" wx:for-item="section"
            id="{{section.id}}" class="cat-section">
        <view wx:for="{{section.groups}}" wx:key="id" wx:for-item="group"
              id="g-{{group.id}}" class="cat-group">
          <view wx:if="{{group.label}}" class="grid-section-head">
            <view class="grid-section-kicker f-toni">{{group.label}}</view>
            <view class="grid-section-count f-gothic">{{group.countStr}}</view>
          </view>
          <view class="gallery">
            <view wx:for="{{group.items}}" wx:key="id" wx:for-item="item"
                  class="gal-card" data-id="{{item.id}}" bindtap="openProduct">
              <view class="gal-img">
                <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="img-full" lazy-load/>
                <image wx:else src="/assets/icons/product-placeholder.svg" mode="aspectFit" class="img-placeholder"/>
                <view wx:if="{{item.badge}}" class="gal-badge f-gothic">{{item.badge}}</view>
                <view wx:if="{{item.isFlash}}" class="gal-flash f-toni">{{lang === 'cn' ? '秒杀' : 'FLASH'}}</view>
                <view wx:if="{{item.outOfStock}}" class="gal-oos f-toni">{{oosLabel}}</view>
                <view wx:elif="{{item.nextBatch}}" class="gal-oos gal-batch f-toni">{{item.nextBatchText}}</view>
              </view>
              <view class="gal-meta">
                <view class="gal-name f-bear">{{item.name}}</view>
                <view wx:if="{{item.subline}}" class="gal-sub f-yuan">{{item.subline}}</view>
                <view wx:if="{{item.hasVariants}}" class="vhint f-toni">{{item.variantHint}}</view>
                <view wx:if="{{item.soldCaption}}" class="sold-cap f-toni">{{item.soldCaption}}</view>
              </view>
              <view class="gal-foot">
                <view class="gal-price-stack">
                  <text wx:if="{{item.priceWas}}" class="gal-was f-aleo">{{item.priceWas}}</text>
                  <text wx:if="{{item.pricePrefix}}" class="gal-price-prefix f-toni">{{item.pricePrefix}}</text>
                  <text class="gal-price f-bear {{item.isFlash ? 'is-flash' : ''}}">{{item.price}}</text>
                </view>
                <view wx:if="{{!item.outOfStock && !item.nextBatch}}" class="gal-plus"
                      id="plus-{{item.id}}" data-id="{{item.id}}" catchtap="addToCart"></view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- ════ GRID 2/3 col ═════════════════════════════════════════ -->
  <block wx:else>
    <view wx:if="{{loading && !sections.length}}" class="loading {{layout === 'grid-3col' ? 'loading-3' : ''}}">
      <view class="skeleton" style="height: 360rpx"></view>
      <view class="skeleton" style="height: 360rpx"></view>
      <view wx:if="{{layout === 'grid-3col'}}" class="skeleton" style="height: 360rpx"></view>
    </view>

    <view wx:elif="{{!sections.length}}" class="empty">
      <view class="empty-title f-bear">{{emptyTitle}}</view>
      <view class="empty-sub">{{emptySub}}</view>
    </view>

    <view wx:else>
      <view wx:for="{{visibleSections}}" wx:key="id" wx:for-item="section"
            id="{{section.id}}" class="cat-section">
        <view wx:for="{{section.groups}}" wx:key="id" wx:for-item="group"
              id="g-{{group.id}}" class="cat-group">
          <view wx:if="{{group.label}}" class="grid-section-head">
            <view class="grid-section-kicker f-toni">{{group.label}}</view>
            <view class="grid-section-count f-gothic">{{group.countStr}}</view>
          </view>
          <view class="grid {{layout === 'grid-3col' ? 'grid-3' : 'grid-2'}}">
            <view wx:for="{{group.items}}" wx:key="id" wx:for-item="item"
                  class="card" data-id="{{item.id}}" bindtap="openProduct">
              <view class="img">
                <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="img-full" lazy-load/>
                <image wx:else src="/assets/icons/product-placeholder.svg" mode="aspectFit" class="img-placeholder"/>
                <view wx:if="{{item.badge}}" class="card-badge f-gothic">{{item.badge}}</view>
                <view wx:if="{{item.isFlash}}" class="card-flash f-toni">{{lang === 'cn' ? '秒杀' : 'FLASH'}}</view>
                <view wx:if="{{item.outOfStock}}" class="card-oos f-toni">{{oosLabel}}</view>
                <view wx:elif="{{item.nextBatch}}" class="card-oos card-batch f-toni">{{item.nextBatchText}}</view>
              </view>
              <view class="name f-bear">{{item.name}}</view>
              <view wx:if="{{item.hasVariants}}" class="vhint f-toni">{{item.variantHint}}</view>
              <view wx:if="{{item.soldCaption}}" class="sold-cap f-toni">{{item.soldCaption}}</view>
              <view class="card-foot">
                <view class="price-stack">
                  <text wx:if="{{item.priceWas}}" class="price-was f-aleo">{{item.priceWas}}</text>
                  <text wx:if="{{item.pricePrefix}}" class="price-prefix f-toni">{{item.pricePrefix}}</text>
                  <text class="price f-bear {{item.isFlash ? 'is-flash' : ''}}">{{item.price}}</text>
                </view>
                <view wx:if="{{!item.outOfStock && !item.nextBatch}}" class="card-plus"
                      id="plus-{{item.id}}" data-id="{{item.id}}" catchtap="addToCart"></view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- ════ SIZE PICKER (variant sheet) ══════════════════════════ -->
  <!-- Opened by tapping + on a collapsed variant card. Pick a size →
       that sibling product is added to the cart. Sits outside the
       layout if/elif/else chain so it shows in every view mode. -->
  <view wx:if="{{vpShow}}" class="vp-mask" bindtap="closeVariantPicker">
    <view class="vp-sheet" catchtap="vpStop">
      <view class="vp-head">
        <view>
          <view class="vp-title f-bear">{{vpTitle}}</view>
          <view wx:if="{{vpName}}" class="vp-name f-yuan">{{vpName}}</view>
        </view>
        <view class="vp-close" bindtap="closeVariantPicker">×</view>
      </view>
      <view class="vp-opts">
        <view wx:for="{{vpOptions}}" wx:key="id" wx:for-item="opt"
              class="vp-opt {{opt.soldOut ? 'sold-out' : ''}}"
              data-id="{{opt.id}}" bindtap="vpChoose">
          <view class="vp-opt-main">
            <text class="vp-opt-label f-bear">{{opt.label}}</text>
            <text wx:if="{{opt.weight}}" class="vp-opt-weight f-toni">{{opt.weight}}</text>
            <text wx:if="{{opt.low}}" class="vp-opt-low f-toni">{{opt.low}}</text>
            <text wx:if="{{opt.save}}" class="vp-opt-save f-toni">{{opt.save}}</text>
            <text wx:if="{{opt.soldOut}}" class="vp-opt-oos f-toni">{{oosLabel}}</text>
          </view>
          <view class="vp-opt-price-stack">
            <text wx:if="{{opt.priceWas}}" class="vp-opt-was f-aleo">{{opt.priceWas}}</text>
            <text class="vp-opt-price f-bear {{opt.isFlash ? 'is-flash' : ''}}">{{opt.price}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

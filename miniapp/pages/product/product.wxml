<view class="page">
  <!-- Back button — floats over the hero -->
  <view class="back-btn" bindtap="back">
    <view class="back-glyph">←</view>
  </view>

  <!-- Heart pip — top-right, toggles favorite. Filled berry when saved. -->
  <view wx:if="{{!notFound}}" class="fav-pip {{isFavorited ? 'is-on' : ''}}" bindtap="onFavoriteToggle">
    <view class="fav-glyph">♥</view>
  </view>

  <view wx:if="{{notFound}}" class="empty">
    <view class="empty-title f-bear">Product not found</view>
    <view class="empty-sub">It might have been unpublished. Go back to the shop.</view>
    <view class="empty-btn f-toni" bindtap="back">← Back</view>
  </view>

  <view wx:elif="{{loading && !product}}" class="loading">
    <view class="skeleton hero-skel"></view>
    <view class="skeleton title-skel"></view>
    <view class="skeleton body-skel"></view>
  </view>

  <block wx:else>
    <view class="hero" style="{{aspectRatio ? 'aspect-ratio:' + aspectRatio + ';height:auto' : 'height: 880rpx'}}">
      <image wx:if="{{image}}" src="{{image}}" mode="aspectFill" class="hero-img"/>
      <image wx:else src="/assets/icons/product-placeholder.svg" mode="aspectFit" class="hero-placeholder-img"/>
      <view wx:if="{{stockTag}}" class="stock-badge stock-{{stockTagKind}} f-toni">{{stockTag}}</view>
    </view>

    <view class="body">
      <view wx:if="{{isFlash}}" class="flash-banner">
        <view class="flash-banner-top">
          <text class="flash-tag f-toni">{{lang === 'cn' ? '限时秒杀' : 'FLASH SALE'}}</text>
          <text class="flash-was f-aleo">{{flashWas}}</text>
          <text wx:if="{{flashOff}}" class="flash-off f-gothic">{{flashOff}}</text>
        </view>
        <view wx:if="{{flashCountdown}}" class="flash-countdown">
          <text class="flash-cd-label f-toni">{{lang === 'cn' ? '剩余' : 'ENDS IN'}}</text>
          <view class="flash-cd-cells">
            <view wx:if="{{flashCountdown.showDays}}" class="flash-cd-cell">
              <text class="flash-cd-num f-gothic">{{flashCountdown.d}}</text>
              <text class="flash-cd-lbl f-toni">{{lang === 'cn' ? '天' : 'D'}}</text>
            </view>
            <view class="flash-cd-cell">
              <text class="flash-cd-num f-gothic">{{flashCountdown.h}}</text>
              <text class="flash-cd-lbl f-toni">{{lang === 'cn' ? '时' : 'H'}}</text>
            </view>
            <view class="flash-cd-cell">
              <text class="flash-cd-num f-gothic">{{flashCountdown.m}}</text>
              <text class="flash-cd-lbl f-toni">{{lang === 'cn' ? '分' : 'M'}}</text>
            </view>
            <view class="flash-cd-cell">
              <text class="flash-cd-num f-gothic">{{flashCountdown.s}}</text>
              <text class="flash-cd-lbl f-toni">{{lang === 'cn' ? '秒' : 'S'}}</text>
            </view>
          </view>
        </view>
        <view wx:elif="{{flashEnded}}" class="flash-countdown flash-countdown-ended">
          <text class="flash-cd-label f-toni">{{lang === 'cn' ? '本场已结束' : "THAT'S A WRAP"}}</text>
        </view>
      </view>
      <!-- Product header — v1 editorial: serif display name, Yuan W7 olive
           CN subtitle, Aleo italic tagline with optional [[ink-mark]]
           inline highlight. Bottom hairline ink rule divides from the
           Spec Strip / first block below. -->
      <view class="product-head">
        <view class="title-row">
          <view class="name f-bear">{{name}}</view>
        </view>
        <view wx:if="{{(subtitle && subtitle !== name) || keywords}}" class="subtitle f-yuan">
          <text wx:if="{{subtitle && subtitle !== name}}">{{subtitle}}</text>
          <text wx:if="{{(subtitle && subtitle !== name) && keywords}}"> · </text>
          <text wx:if="{{keywords}}">{{keywords}}</text>
        </view>
        <view wx:if="{{taglineSegments.length}}" class="tagline f-aleo">
          <text wx:for="{{taglineSegments}}" wx:for-item="seg" wx:key="*this"
                class="{{seg.kind === 'mark' ? 'ink-mark' : ''}}">{{seg.text}}</text>
        </view>
      </view>

      <!-- Social proof — live "N people bought this …" nudge. Real sales
           only (narrowest window with data); hidden when there's none. -->
      <view wx:if="{{socialProof}}" class="social-proof">
        <view class="sp-dot"></view>
        <text class="sp-text f-toni">{{socialProof}}</text>
      </view>
      <view wx:if="{{viewingText}}" class="social-proof">
        <view class="sp-dot sp-dot-view"></view>
        <text class="sp-text f-toni">{{viewingText}}</text>
      </view>

      <!-- Block-based body (designer-styled per-section). When present,
           the legacy description parts are skipped. -->
      <product-blocks wx:if="{{descriptionBlocks.length}}"
                      blocks="{{descriptionBlocks}}"
                      lang="{{lang}}"/>
      <block wx:elif="{{descriptionParts.length}}">
        <block wx:for="{{descriptionParts}}" wx:key="text">
          <view wx:if="{{item.kind === 'heading'}}" class="desc-heading f-bear">{{item.text}}</view>
          <view wx:else class="description f-aleo">{{item.text}}</view>
        </block>
      </block>

      <view wx:if="{{badges.length}}" class="badges">
        <view wx:for="{{badges}}" wx:key="*this" class="badge f-toni">{{item}}</view>
      </view>

      <!-- Reviews summary + recent -->
      <view wx:if="{{reviewCount > 0}}" class="reviews-block">
        <view class="reviews-head">
          <view class="reviews-stars">
            <text wx:for="{{reviewStars}}" wx:key="*this" class="rs {{item}}">★</text>
          </view>
          <view class="reviews-meta">
            <text class="reviews-avg f-bear">{{reviewAvgDisplay}}</text>
            <text class="reviews-count muted">{{reviewCount}} {{lang === 'cn' ? '条评价' : 'reviews'}}</text>
          </view>
        </view>
        <view wx:for="{{reviewsRecent}}" wx:key="id" class="review-row">
          <view class="review-row-head">
            <view class="review-row-byline">
              <view class="review-stars">
                <text wx:for="{{item.stars}}" wx:key="*this" wx:for-item="s" class="rs {{s}}">★</text>
              </view>
              <text class="review-name f-bear">{{item.customer_name || (lang === 'cn' ? '匿名' : 'Anonymous')}}</text>
            </view>
            <text class="review-date f-toni">{{item.created_short}}</text>
          </view>
          <view wx:if="{{item.comment}}" class="review-comment">{{item.comment}}</view>
          <view wx:if="{{item.tags_view.length}}" class="review-tags">
            <text wx:for="{{item.tags_view}}" wx:for-item="tg" wx:key="id"
                  class="review-tag review-tag-{{tg.color}} f-aleo">{{tg.label}}</text>
          </view>
          <view wx:if="{{item.photo_urls.length}}" class="review-photos">
            <image wx:for="{{item.photo_urls}}" wx:for-item="ph" wx:key="*this"
                   src="{{ph}}" mode="aspectFill" class="review-photo"
                   data-urls="{{item.photo_urls}}" data-idx="{{index}}" bindtap="previewReviewPhoto"/>
          </view>
        </view>
      </view>

      <!-- Nutrition facts — v1 nut-card: bordered card, basis line top-right
           italic Aleo, parent rows bold w/ forest value, child rows indented
           with em-dash prefix and muted styling. -->
      <view wx:if="{{nutritionRows.length}}" class="nutrition">
        <view class="nut-card">
          <view class="nut-card-top">
            <text class="nut-card-ttl f-bear">{{lang === 'cn' ? '营养成分' : 'Nutrition'}}</text>
            <text wx:if="{{nutritionBasis}}" class="nut-card-basis f-aleo">{{nutritionBasis}}</text>
          </view>
          <view wx:for="{{nutritionRows}}" wx:key="label" class="nrow {{item.kind === 'parent' ? 'bold' : ''}} {{item.kind === 'child' ? 'child' : ''}}">
            <text class="nrow-l">{{item.label}}</text>
            <text class="nrow-r f-gothic">{{item.value}}</text>
          </view>
        </view>
      </view>

      <!-- Variant switcher — sibling products in the same variant group.
           Tapping loads that variant (its own price / stock / image). -->
      <block wx:if="{{hasVariants}}">
        <view class="option-group">
          <view class="option-label f-toni">{{lang === 'cn' ? '规格' : 'Variants'}}</view>
          <view class="option-choices">
            <view wx:for="{{variants}}" wx:for-item="v" wx:key="id"
                  class="choice variant-choice {{v.isCurrent ? 'on' : ''}} {{v.soldOut ? 'sold-out' : ''}}"
                  data-id="{{v.id}}" bindtap="pickVariant">
              <text>{{v.label}}</text>
              <text wx:if="{{v.price}}" class="choice-delta">{{v.price}}</text>
            </view>
          </view>
        </view>
      </block>

      <!-- Per-product options (size, cutlery, etc.) -->
      <block wx:if="{{options.length}}">
        <view wx:for="{{options}}" wx:for-item="opt" wx:key="id" class="option-group">
          <view class="option-label f-toni">
            {{opt.question}}{{opt.is_required ? ' *' : ''}}
          </view>
          <view class="option-choices">
            <view wx:for="{{opt.choices}}" wx:for-item="ch" wx:key="id"
                  class="choice {{selectedChoices[opt.id] === ch.id ? 'on' : ''}}"
                  data-option-id="{{opt.id}}" data-choice-id="{{ch.id}}"
                  bindtap="pickChoice">
              <text>{{ch.label}}</text>
              <text wx:if="{{ch.delta_text}}" class="choice-delta">{{ch.delta_text}}</text>
            </view>
          </view>
        </view>
      </block>

      <!-- Colophon — page sign-off. One IP character (mapped by category)
           centred on oat fill, "From Soil to Soul" tagline below, then a
           small "Roots · ESTD 2017" meta line bracketed by hairlines.
           Renders ONCE per page per v1 spec. -->
      <view class="colophon">
        <view wx:if="{{colophonImg}}" class="colophon-character">
          <image src="{{colophonImg}}" mode="aspectFit" class="colophon-character-img"/>
        </view>
        <view class="colophon-tagline f-bear">{{colophonTagline}}</view>
        <view class="colophon-meta f-toni">
          <view class="colophon-rule"></view>
          <text>Roots · ESTD 2017</text>
          <view class="colophon-rule"></view>
        </view>
      </view>
    </view>

    <!-- Sticky bottom: qty stepper + add to cart -->
    <view class="sticky-bar">
      <cs-button variant="inline" placement="product"></cs-button>
      <view class="qty">
        <view class="qty-btn" bindtap="decQty">−</view>
        <view class="qty-val f-gothic">{{qty}}</view>
        <view class="qty-btn" bindtap="incQty">+</view>
      </view>
      <button class="add-btn f-toni {{soldOut ? 'sold-out' : ''}}" bindtap="addToCart" disabled="{{soldOut}}">
        <text class="add-label">{{addBtnLabel}}</text>
        <text wx:if="{{!soldOut}}" class="add-price f-gothic">{{price}}</text>
      </button>
    </view>
  </block>
  <popup-manager page="product"></popup-manager>
</view>

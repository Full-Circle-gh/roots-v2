.page {
  background: var(--oat);
  min-height: 100vh;
  padding-bottom: 200rpx;
  position: relative;
}

/* Floating back button over the hero */
.back-btn {
  position: fixed;
  top: 88rpx;
  left: 30rpx;
  z-index: 100;
  width: 72rpx;
  height: 72rpx;
  background: rgba(26, 26, 23, 0.78);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8rpx);
}
.back-glyph {
  color: #fff;
  font-size: calc(36rpx * var(--font-scale));
  line-height: 1;
}

/* Hero — full-bleed top image */
.hero {
  width: 100%;
  background: linear-gradient(135deg, #c4c4c4, #a8a8a8);
  overflow: hidden;
}
.hero-img { width: 100%; height: 100%; display: block; }

/* Stock badge — top-right corner of the hero */
.stock-badge {
  position: absolute;
  top: 88rpx;
  right: 30rpx;
  padding: 12rpx 22rpx;
  font-size: calc(22rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 rgba(0, 0, 0, 0.85);
  transform: rotate(-3deg);
  z-index: 5;
}
.stock-out  { background: var(--berry); color: #fff; }
.stock-low  { background: var(--carrot); color: #fff; }
.hero-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  min-height: 500rpx;
  color: rgba(0, 0, 0, 0.3);
  font-size: calc(28rpx * var(--font-scale));
}

/* Body content */
.body { padding: 44rpx 44rpx 60rpx; }

.flash-banner {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 20rpx;
  padding: 16rpx 22rpx;
  background: #E96174;
  color: #fff;
  border-radius: 8rpx;
}
.flash-banner-top {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.flash-tag {
  font-weight: 700;
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.14em;
}
.flash-was {
  font-size: calc(22rpx * var(--font-scale));
  text-decoration: line-through;
  opacity: 0.7;
}
.flash-off {
  margin-left: auto;
  font-weight: 700;
  font-size: calc(28rpx * var(--font-scale));
  letter-spacing: 0.03em;
}

.flash-countdown {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.flash-cd-label {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.14em;
  font-weight: 700;
  opacity: 0.92;
}
.flash-cd-cells {
  display: flex;
  gap: 8rpx;
  margin-left: auto;
}
.flash-cd-cell {
  background: rgba(26, 26, 23, 0.85);
  color: #fff;
  padding: 6rpx 10rpx;
  border-radius: 6rpx;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  min-width: 56rpx;
  justify-content: center;
}
.flash-cd-num {
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.02em;
  font-variant-numeric: tabular-nums;
}
.flash-cd-lbl {
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.1em;
  opacity: 0.8;
}
.flash-countdown-ended .flash-cd-label {
  opacity: 1;
  letter-spacing: 0.12em;
}

.title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.name {
  font-size: calc(64rpx * var(--font-scale));
  font-weight: 500;
  line-height: 1.05;
  color: var(--ink);
}

.subtitle {
  margin-top: 12rpx;
  font-size: calc(26rpx * var(--font-scale));
  color: var(--olive);
}

/* Bold one-liner slogan below the subtitle. Office writes it in the
   Tagline field on the product edit page. */
.tagline {
  margin-top: 18rpx;
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 700;
  line-height: 1.3;
  color: var(--ink);
}

.description {
  margin-top: 16rpx;
  font-size: calc(28rpx * var(--font-scale));
  line-height: 1.5;
  color: var(--ink);
  /* Preserve line breaks the office types in the product description
     textarea — without this, WeChat collapses every \n into a space and
     the whole blurb runs together as one wall of text. */
  white-space: pre-line;
}
/* Brand-font section heading inside the description body. The office
   inserts these via "## Title" lines (an insert-picker in the product
   edit form drops the marker at the cursor). */
.desc-heading {
  margin-top: 36rpx;
  margin-bottom: 4rpx;
  font-size: calc(38rpx * var(--font-scale));
  font-weight: 500;
  line-height: 1.2;
  color: var(--ink);
}
.desc-heading:first-child { margin-top: 28rpx; }

/* Free-of / dietary badges */
.badges {
  margin-top: 32rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.badge {
  padding: 12rpx 20rpx;
  border: 3rpx solid var(--ink);
  font-size: calc(20rpx * var(--font-scale));
  font-weight: 600;
  letter-spacing: 0.08em;
  background: transparent;
  color: var(--ink);
}

/* Reviews block */
.reviews-block {
  margin-top: 40rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid rgba(0, 0, 0, 0.08);
}
.reviews-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.reviews-stars { display: flex; gap: 4rpx; }
.rs { font-size: calc(32rpx * var(--font-scale)); color: rgba(0, 0, 0, 0.18); line-height: 1; }
.rs.on { color: var(--carrot); }
.reviews-meta { display: flex; align-items: baseline; gap: 12rpx; }
.reviews-avg { font-size: calc(36rpx * var(--font-scale)); font-weight: 500; }
.reviews-count { font-size: calc(22rpx * var(--font-scale)); }

/* Reviews list — flush, editorial. No card box; reviews are separated by
   a hairline so the oat background carries through the whole section. */
.review-row {
  padding: 28rpx 0 32rpx;
  border-top: 2rpx solid rgba(26, 26, 23, 0.14);
}
.review-row:first-of-type {
  padding-top: 4rpx;
  border-top: 0;
}

.review-row-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 14rpx;
}
.review-row-byline {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  flex-wrap: wrap;
  min-width: 0;
}
.review-stars { display: flex; gap: 2rpx; }
.review-stars .rs { font-size: calc(26rpx * var(--font-scale)); }

.review-name {
  font-size: calc(28rpx * var(--font-scale));
  letter-spacing: 0.01em;
  color: var(--ink);
}

.review-date {
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.18em;
  color: var(--olive);
  white-space: nowrap;
}

.review-comment {
  font-family: var(--f-aleo);
  font-size: calc(28rpx * var(--font-scale));
  line-height: 1.5;
  color: var(--ink);
  margin: 0 0 14rpx;
}

.review-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 4rpx 0 0;
}
.review-tag {
  display: inline-block;
  padding: 5rpx 14rpx;
  border: 2rpx solid var(--ink);
  color: var(--ink);
  background: var(--lime);
  font-size: calc(20rpx * var(--font-scale));
  line-height: 1.4;
  box-shadow: 3rpx 3rpx 0 rgba(26, 26, 23, 0.85);
}
/* Brand colour palette for chip backgrounds. The class name comes from
   the `color` field on each tag in storefront_config (editable from
   /retail-admin → Reviews) — that way staff can add a brand-new tag
   and pick any of these without a code change. */
.review-tag-lime     { background: var(--lime); }
.review-tag-papaya   { background: var(--papaya); }
.review-tag-sky      { background: var(--sky); }
.review-tag-corn     { background: var(--corn); }
.review-tag-pea      { background: var(--pea); }
.review-tag-cucumber { background: var(--cucumber); }
.review-tag-pink     { background: var(--pink); }
.review-tag-berry    { background: var(--berry);   color: #fff; }
.review-tag-carrot   { background: var(--carrot);  color: #fff; }
.review-tag-lotus    { background: var(--lotus); }
.review-tag-almond   { background: var(--almond);  color: #fff; }
.review-tag-lemon    { background: var(--lemon); }
.review-tag-avocado  { background: var(--avocado); }
.review-tag-forest   { background: var(--forest);  color: var(--lime); }

.review-photos {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
  flex-wrap: wrap;
}
.review-photo {
  width: 140rpx;
  height: 140rpx;
  box-shadow: 4rpx 4rpx 0 rgba(26, 26, 23, 0.85);
}

.muted { color: var(--olive); }

/* Nutrition facts panel — matches the design reference: small uppercase
   heading + basis ("Per 100ml"), then label/value rows divided by hairlines. */
.nutrition-block {
  margin-top: 40rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid rgba(0, 0, 0, 0.08);
}
.nutrition-head {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
  margin-bottom: 12rpx;
}
.nutrition-title {
  font-size: calc(22rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.14em;
  color: var(--olive);
  text-transform: uppercase;
}
.nutrition-basis {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.nutrition-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 16rpx 0;
  border-top: 2rpx solid rgba(0, 0, 0, 0.06);
  font-size: calc(28rpx * var(--font-scale));
  color: var(--ink);
}
.nutrition-row:first-of-type { border-top: 0; }
.nutrition-label { color: var(--ink); }
.nutrition-value { color: var(--ink); }

/* Option groups (size, cutlery, etc.) */
.option-group { margin-top: 40rpx; }
.option-label {
  font-size: calc(22rpx * var(--font-scale));
  font-weight: 600;
  letter-spacing: 0.12em;
  color: var(--olive);
  margin-bottom: 16rpx;
}
.option-choices {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.choice {
  padding: 18rpx 24rpx;
  border: 3rpx solid var(--ink);
  font-size: calc(26rpx * var(--font-scale));
  background: transparent;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.choice.on {
  background: var(--ink);
  color: var(--oat);
}
.choice-delta {
  font-size: calc(22rpx * var(--font-scale));
  opacity: 0.75;
}

/* Sticky bottom bar */
.sticky-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: var(--oat);
  border-top: 3rpx solid var(--ink);
  padding: 24rpx 32rpx 32rpx;
  display: flex;
  gap: 20rpx;
  align-items: center;
}
.qty {
  display: flex;
  align-items: stretch;
  border: 3rpx solid var(--ink);
  flex-shrink: 0;
}
.qty-btn {
  width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--f-bear);
  font-size: calc(36rpx * var(--font-scale));
  color: var(--ink);
  user-select: none;
}
.qty-val {
  width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-left: 3rpx solid var(--ink);
  border-right: 3rpx solid var(--ink);
  font-size: calc(32rpx * var(--font-scale));
}
.add-btn {
  flex: 1;
  background: var(--ink);
  color: var(--lime);
  padding: 24rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  border-radius: 0;
  letter-spacing: 0.1em;
}
.add-btn.sold-out {
  background: rgba(0, 0, 0, 0.3);
  color: rgba(255, 255, 255, 0.7);
  justify-content: center;
}
.add-label {
  font-size: calc(28rpx * var(--font-scale));
  margin-left: 28rpx;
}
.add-price {
  font-size: calc(36rpx * var(--font-scale));
  margin-right: 28rpx;
}

.loading { padding: 0 0 60rpx; }
.hero-skel  { width: 100%; height: 800rpx; }
.title-skel { width: 60%; height: 80rpx; margin: 44rpx 44rpx 24rpx; }
.body-skel  { margin: 0 44rpx; height: 400rpx; }

.empty { padding: 200rpx 44rpx 0; text-align: center; }
.empty-title { font-size: calc(56rpx * var(--font-scale)); font-weight: 500; margin-bottom: 16rpx; }
.empty-sub { color: var(--olive); font-size: calc(26rpx * var(--font-scale)); line-height: 1.5; margin-bottom: 40rpx; }
.empty-btn {
  display: inline-block;
  background: var(--ink); color: var(--oat);
  padding: 20rpx 36rpx;
  font-size: calc(24rpx * var(--font-scale));
  letter-spacing: 0.1em;
  border-radius: 999rpx;
}

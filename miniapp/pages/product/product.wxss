.page {
  background: var(--oat);
  min-height: 100vh;
  padding-bottom: 200rpx;
  position: relative;
}

/* Floating back button over the hero */
.back-btn {
  position: fixed;
  top: 88rpx;
  left: 30rpx;
  z-index: 100;
  width: 72rpx;
  height: 72rpx;
  background: rgba(26, 26, 23, 0.78);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8rpx);
}
.back-glyph {
  color: #fff;
  font-size: calc(36rpx * var(--font-scale));
  line-height: 1;
}

/* Heart pip — bottom-right of the hero, clear of WeChat's native capsule */
.fav-pip {
  position: absolute;
  bottom: 30rpx;
  right: 30rpx;
  z-index: 100;
  width: 72rpx;
  height: 72rpx;
  background: rgba(26, 26, 23, 0.78);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(8rpx);
}
.fav-pip .fav-glyph {
  color: rgba(255, 255, 255, 0.85);
  font-size: calc(40rpx * var(--font-scale));
  line-height: 1;
}
.fav-pip.is-on { background: var(--berry); }
.fav-pip.is-on .fav-glyph { color: #fff; }

/* Hero — full-bleed top image */
.hero {
  width: 100%;
  /* Soft oat fill instead of grey gradient so an unphotographed product
     reads as "intentionally minimal" on the brand cream background
     rather than "broken image". */
  background: #F2E7DF;
  overflow: hidden;
  position: relative;
}
.hero-img { width: 100%; height: 100%; display: block; }
/* Multi-photo hero — swiper fills the hero box; each slide aspect-fills. */
.hero-swiper { width: 100%; height: 100%; }
.hero-swiper .hero-img { width: 100%; height: 100%; }

/* Stock badge — bottom-LEFT of the hero, mirroring the heart on bottom-right
   so it stays clear of WeChat's top-right capsule (the … / ⊙ system buttons). */
.stock-badge {
  position: absolute;
  bottom: 30rpx;
  left: 30rpx;
  padding: 12rpx 22rpx;
  font-size: calc(22rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  border-radius: 999rpx;
  box-shadow: 4rpx 4rpx 0 rgba(0, 0, 0, 0.85);
  transform: rotate(-3deg);
  z-index: 5;
}
.stock-out  { background: var(--berry); color: #fff; }
.stock-low  { background: var(--carrot); color: #fff; }
.stock-pre  { background: var(--olive); color: #fff; }
/* PDP hero placeholder — minimalist jar at 25% of the hero size,
   centred. Matches the tab-bar icon weight and the shop-card placeholder
   so a product without a photo looks consistent everywhere. */
.hero-placeholder-img {
  position: absolute;
  width: 25%; height: 25%;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  opacity: 0.5;
}

/* Thumbnail strip under the hero — shown only for multi-photo products.
   Horizontal scroll when the row overflows; the active thumb is ringed in ink
   and fully opaque, the rest are dimmed. */
.thumb-strip {
  white-space: nowrap;
  padding: 24rpx 44rpx 8rpx;
  background: var(--oat);
}
.thumb {
  display: inline-block;
  width: 120rpx;
  height: 120rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 3rpx solid transparent;
  background: #F2E7DF;
  box-sizing: border-box;
  opacity: 0.5;
  transition: opacity 0.15s ease, border-color 0.15s ease;
}
.thumb:last-child { margin-right: 0; }
.thumb.on { border-color: var(--ink); opacity: 1; }
.thumb-img { width: 100%; height: 100%; display: block; }

/* Body content */
.body { padding: 44rpx 44rpx 60rpx; }

.flash-banner {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 20rpx;
  padding: 16rpx 22rpx;
  background: #E96174;
  color: #fff;
  border-radius: 8rpx;
}
.flash-banner-top {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}
.flash-tag {
  font-weight: 700;
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.14em;
}
.flash-was {
  font-size: calc(22rpx * var(--font-scale));
  text-decoration: line-through;
  opacity: 0.7;
}
.flash-off {
  margin-left: auto;
  font-weight: 700;
  font-size: calc(28rpx * var(--font-scale));
  letter-spacing: 0.03em;
}

.flash-countdown {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.flash-cd-label {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.14em;
  font-weight: 700;
  opacity: 0.92;
}
.flash-cd-cells {
  display: flex;
  gap: 8rpx;
  margin-left: auto;
}
.flash-cd-cell {
  background: rgba(26, 26, 23, 0.85);
  color: #fff;
  padding: 6rpx 10rpx;
  border-radius: 6rpx;
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  min-width: 56rpx;
  justify-content: center;
}
.flash-cd-num {
  font-size: calc(28rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.02em;
  font-variant-numeric: tabular-nums;
}
.flash-cd-lbl {
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.1em;
  opacity: 0.8;
}
.flash-countdown-ended .flash-cd-label {
  opacity: 1;
  letter-spacing: 0.12em;
}

/* ─── Product header (v1 editorial) ─────────────────────────────────
   Wraps name + CN subtitle + tagline as one band with a hairline ink
   rule bottom border, dividing it from the first designer block /
   spec strip. Sizes match the design at 375px canvas (× 2 for rpx). */
.product-head {
  padding: 0 0 36rpx;
  margin: 56rpx -44rpx 0;
  padding-left: 44rpx;
  padding-right: 44rpx;
  border-bottom: 2rpx solid var(--ink);
}
.title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}
.name {
  font-size: calc(88rpx * var(--font-scale));
  font-weight: 400;
  line-height: 0.92;
  letter-spacing: -0.015em;
  color: var(--ink);
}

.subtitle {
  margin-top: 16rpx;
  font-size: calc(36rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.02em;
  color: var(--olive);
}

/* Tagline — Toni Grotesk bold display caps (matches the product editor
   preview's .pa-prev-tagline so what the office sees IS what the customer
   sees). Optional inline [[ink-mark]] span renders the bracketed word(s)
   on a lime slab (v1 ink-mark spec). The office types the markers in the
   Tagline field, e.g. "Bright, punchy, [[alive]]." The f-toni class on
   the view itself applies the uppercase + letter-spacing — don't repeat
   them here. */
.tagline {
  margin-top: 20rpx;
  font-size: calc(26rpx * var(--font-scale));
  font-weight: 700;
  line-height: 1.25;
  color: var(--ink);
}
.ink-mark {
  background: linear-gradient(transparent 60%, var(--lime) 60% 92%, transparent 92%);
  padding: 0 0.12em;
  color: var(--ink);
  box-decoration-break: clone;
  -webkit-box-decoration-break: clone;
}

/* ─── Social proof — live "N people bought this …" nudge ─────────────
   Sits just under the product header. The carrot dot gently pulses to
   read as "live"; copy is real-data only (socialProofForProduct in
   routes/retail.js) so it never shows a fabricated or zero count. */
.social-proof {
  display: flex;
  /* Baseline (not centre): WeChat doesn't centre the uppercase f-toni
     glyphs within the flex line-box, so align-items:center floats the dot
     high. Pinning the dot's bottom to the text baseline — with the dot
     height ≈ the cap height — lands its centre on the caps' optical centre,
     and stays correct at any --font-scale. */
  align-items: baseline;
  gap: 14rpx;
  margin-top: 28rpx;
}
.sp-dot {
  /* Scale with the text so the dot stays proportional at larger
     accessibility font sizes (otherwise it shrinks relative to the copy). */
  width: calc(16rpx * var(--font-scale));
  height: calc(16rpx * var(--font-scale));
  border-radius: 999rpx;
  background: var(--carrot);
  flex-shrink: 0;
  animation: sp-pulse 2s ease-out infinite;
}
.sp-text {
  font-size: calc(24rpx * var(--font-scale));
  font-weight: 600;
  letter-spacing: 0.04em;
  /* Tight line-height so the uppercase caps fill their box — lets
     align-items:center sit the dot on the optical centre of the text
     instead of floating high against an inherited tall line-box. */
  line-height: 1;
  color: var(--forest);
}
@keyframes sp-pulse {
  0%   { box-shadow: 0 0 0 0 rgba(255, 107, 12, 0.45); }
  70%  { box-shadow: 0 0 0 14rpx rgba(255, 107, 12, 0); }
  100% { box-shadow: 0 0 0 0 rgba(255, 107, 12, 0); }
}
/* Supplier-direct (drop-ship) notice — soft oat card with a forest accent so
   it reads as helpful information, not an error. Sits between the header and
   the social-proof line. */
.supplier-note {
  display: flex;
  gap: 18rpx;
  align-items: flex-start;
  margin-top: 28rpx;
  padding: 22rpx 24rpx;
  background: #F2E7DF;
  border-left: 6rpx solid var(--forest);
  border-radius: 14rpx;
}
.supplier-note-ico {
  flex-shrink: 0;
  width: calc(40rpx * var(--font-scale));
  height: calc(40rpx * var(--font-scale));
  border-radius: 999rpx;
  background: var(--forest);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
}
.supplier-note-glyph {
  color: var(--lime);
  font-size: calc(26rpx * var(--font-scale));
  font-weight: 700;
  line-height: 1;
}
.supplier-note-body { display: flex; flex-direction: column; gap: 6rpx; min-width: 0; }
.supplier-note-title {
  font-size: calc(26rpx * var(--font-scale));
  color: var(--ink);
  line-height: 1.25;
}
.supplier-note-sub {
  font-size: calc(23rpx * var(--font-scale));
  color: var(--olive);
  line-height: 1.45;
}
/* "N viewing now" reuses the social-proof row but with a green "live"
   dot (presence, not a purchase) to read like an online indicator. */
.sp-dot-view {
  background: var(--pea);
  animation-name: sp-pulse-view;
}
@keyframes sp-pulse-view {
  0%   { box-shadow: 0 0 0 0 rgba(123, 189, 59, 0.5); }
  70%  { box-shadow: 0 0 0 14rpx rgba(123, 189, 59, 0); }
  100% { box-shadow: 0 0 0 0 rgba(123, 189, 59, 0); }
}

/* Formatted (rich-text) description — authored in the backend editor. */
.description-rich {
  display: block;
  margin-top: 16rpx;
  font-size: calc(28rpx * var(--font-scale));
  line-height: 1.6;
  color: var(--ink);
}
.description {
  margin-top: 16rpx;
  font-size: calc(28rpx * var(--font-scale));
  line-height: 1.5;
  color: var(--ink);
  /* Preserve line breaks the office types in the product description
     textarea — without this, WeChat collapses every \n into a space and
     the whole blurb runs together as one wall of text. */
  white-space: pre-line;
}
/* Brand-font section heading inside the description body. The office
   inserts these via "## Title" lines (an insert-picker in the product
   edit form drops the marker at the cursor). */
.desc-heading {
  margin-top: 36rpx;
  margin-bottom: 4rpx;
  font-size: calc(38rpx * var(--font-scale));
  font-weight: 500;
  line-height: 1.2;
  color: var(--ink);
}
.desc-heading:first-child { margin-top: 28rpx; }

/* Reviews block */
.reviews-block {
  margin-top: 40rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid rgba(0, 0, 0, 0.08);
}
.reviews-head {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.reviews-stars { display: flex; gap: 4rpx; }
.rs { font-size: calc(32rpx * var(--font-scale)); color: rgba(0, 0, 0, 0.18); line-height: 1; }
.rs.on { color: var(--carrot); }
.reviews-meta { display: flex; align-items: baseline; gap: 12rpx; }
.reviews-avg { font-size: calc(36rpx * var(--font-scale)); font-weight: 500; }
.reviews-count { font-size: calc(22rpx * var(--font-scale)); }

/* Reviews list — flush, editorial. No card box; reviews are separated by
   a hairline so the oat background carries through the whole section. */
.review-row {
  padding: 28rpx 0 32rpx;
  border-top: 2rpx solid rgba(26, 26, 23, 0.14);
}
.review-row:first-of-type {
  padding-top: 4rpx;
  border-top: 0;
}

.review-row-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 14rpx;
}
.review-row-byline {
  display: flex;
  align-items: baseline;
  gap: 14rpx;
  flex-wrap: wrap;
  min-width: 0;
}
.review-stars { display: flex; gap: 2rpx; }
.review-stars .rs { font-size: calc(26rpx * var(--font-scale)); }

.review-name {
  font-size: calc(28rpx * var(--font-scale));
  letter-spacing: 0.01em;
  color: var(--ink);
}

.review-date {
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.18em;
  color: var(--olive);
  white-space: nowrap;
}

.review-comment {
  font-family: var(--f-aleo);
  font-size: calc(28rpx * var(--font-scale));
  line-height: 1.5;
  color: var(--ink);
  margin: 0 0 14rpx;
}

/* Merchant reply — public seller response shown under a customer review. */
.review-reply {
  margin: 0 0 14rpx;
  padding: 14rpx 18rpx;
  border-left: 4rpx solid var(--forest, #5a7d4f);
  background: rgba(0, 0, 0, 0.035);
  border-radius: 0 10rpx 10rpx 0;
}
.review-reply-lbl {
  display: block;
  font-size: calc(22rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.04em;
  color: var(--muted, #8a8a82);
  margin-bottom: 4rpx;
}
.review-reply-body {
  font-family: var(--f-aleo);
  font-size: calc(27rpx * var(--font-scale));
  line-height: 1.5;
  color: var(--ink);
}

.review-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 4rpx 0 0;
}
.review-tag {
  display: inline-block;
  padding: 5rpx 14rpx;
  border: 2rpx solid var(--ink);
  color: var(--ink);
  background: var(--lime);
  font-size: calc(20rpx * var(--font-scale));
  line-height: 1.4;
  box-shadow: 3rpx 3rpx 0 rgba(26, 26, 23, 0.85);
}
/* Brand colour palette for chip backgrounds. The class name comes from
   the `color` field on each tag in storefront_config (editable from
   /retail-admin → Reviews) — that way staff can add a brand-new tag
   and pick any of these without a code change. */
.review-tag-lime     { background: var(--lime); }
.review-tag-papaya   { background: var(--papaya); }
.review-tag-sky      { background: var(--sky); }
.review-tag-corn     { background: var(--corn); }
.review-tag-pea      { background: var(--pea); }
.review-tag-cucumber { background: var(--cucumber); }
.review-tag-pink     { background: var(--pink); }
.review-tag-berry    { background: var(--berry);   color: #fff; }
.review-tag-carrot   { background: var(--carrot);  color: #fff; }
.review-tag-lotus    { background: var(--lotus); }
.review-tag-almond   { background: var(--almond);  color: #fff; }
.review-tag-lemon    { background: var(--lemon); }
.review-tag-avocado  { background: var(--avocado); }
.review-tag-forest   { background: var(--forest);  color: var(--lime); }

.review-photos {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
  flex-wrap: wrap;
}
.review-photo {
  width: 140rpx;
  height: 140rpx;
  box-shadow: 4rpx 4rpx 0 rgba(26, 26, 23, 0.85);
}

.muted { color: var(--olive); }

/* ─── Nutrition · v1 nut-card ────────────────────────────────────────
   Bordered card; title in Bear Serif top-left, italic Aleo basis line
   top-right. Parent rows (Energy / Fat / Carbohydrate) render with a bold
   label; child rows (Saturated / Unsaturated / Sugars) indent with em-dash
   prefix, smaller, muted. All top-level values are ink. Tabular nums right. */
.nutrition {
  margin-top: 48rpx;
  margin-left: -44rpx;
  margin-right: -44rpx;
  padding: 0 44rpx 60rpx;
  border-bottom: 2rpx solid var(--ink);
}
.nut-card {
  margin-top: 24rpx;
  border: 2rpx solid var(--ink);
  padding: 28rpx 28rpx 18rpx;
}
.nut-card-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  padding-bottom: 18rpx;
  margin-bottom: 8rpx;
  border-bottom: 4rpx solid var(--ink);
}
.nut-card-ttl {
  font-size: calc(40rpx * var(--font-scale));
  font-weight: 400;
  line-height: 1;
  color: var(--ink);
}
.nut-card-basis {
  font-style: italic;
  font-size: calc(22rpx * var(--font-scale));
  color: rgba(26, 26, 23, 0.6);
  text-align: right;
  line-height: 1.3;
}
.nrow {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  padding: 16rpx 0;
  border-bottom: 2rpx solid rgba(26, 26, 23, 0.12);
}
.nrow:last-child { border-bottom: 0; }
/* --f-bear, not --f-toni: this is the SAME nutrition card the product-blocks
   component draws (.pb-nrow-l), shown only when the product carries nutrition
   rows without a nutrition_facts block. The component moved to one display
   face; if this copy did not, the card would read in a different face
   depending on which path a product took. */
.nrow-l {
  font-family: var(--f-bear);
  font-size: calc(27rpx * var(--font-scale));
  letter-spacing: 0.01em;
  color: var(--ink);
}
.nrow-r {
  /* SET AT ALL, WHICH IT WAS NOT. This rule carried no font-family, so the
     value fell through to whatever the page inherits while its sibling
     .pb-nrow-l two rules up explicitly names the display face and says why:
     "the card would read in a different face depending on which path a
     product took". The value was that drift. --f-num closes it and fixes the
     unit weight in the same line -- see the token in app.wxss. */
  font-family: var(--f-num);
  font-size: calc(40rpx * var(--font-scale));
  line-height: 1;
  font-variant-numeric: tabular-nums;
  color: var(--ink);
}
.nrow.bold .nrow-l { font-weight: 700; }
.nrow.child {
  padding: 10rpx 0 10rpx 44rpx;
  border-bottom: 2rpx dashed rgba(26, 26, 23, 0.12);
}
.nrow.child .nrow-l {
  font-family: var(--f-aleo);
  font-style: italic;
  font-size: calc(25rpx * var(--font-scale));
  color: rgba(26, 26, 23, 0.6);
  position: relative;
}
.nrow.child .nrow-l::before {
  content: "—";
  margin-right: 12rpx;
  color: rgba(26, 26, 23, 0.3);
  font-style: normal;
}
.nrow.child .nrow-r {
  font-size: calc(32rpx * var(--font-scale));
  color: rgba(26, 26, 23, 0.6);
}

/* ─── Colophon · page sign-off (v1 ALWAYS) ──────────────────────────
   IP character mapped by category (resolved in product.js), centered
   on oat fill, brand-serif "From Soil to Soul" tagline, small caps
   meta line ("Roots · ESTD 2017") bracketed by hairline rules. */
.colophon {
  margin: 56rpx -44rpx 0;
  padding: 72rpx 44rpx 56rpx;
  background: var(--oat);
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 28rpx;
}
.colophon-character {
  width: 240rpx;
  height: 240rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.colophon-character-img {
  width: 100%;
  height: 100%;
  /* Drop the white background on the b&w line-art IP files. WeChat
     mini-app supports mix-blend-mode; if a target SDK doesn't, the
     character still renders correctly with its white square. */
  mix-blend-mode: multiply;
}
.colophon-tagline {
  font-size: calc(44rpx * var(--font-scale));
  line-height: 1;
  letter-spacing: -0.005em;
  color: var(--ink);
}
.colophon-meta {
  display: flex;
  align-items: center;
  gap: 20rpx;
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.32em;
  text-transform: uppercase;
  color: rgba(26, 26, 23, 0.6);
}
.colophon-rule {
  width: 44rpx;
  height: 2rpx;
  background: rgba(26, 26, 23, 0.3);
}

/* Option groups (size, cutlery, etc.) */
.option-group { margin-top: 40rpx; }
.option-label {
  font-size: calc(22rpx * var(--font-scale));
  font-weight: 600;
  letter-spacing: 0.12em;
  color: var(--olive);
  margin-bottom: 16rpx;
}
.option-choices {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.choice {
  padding: 18rpx 24rpx;
  border: 3rpx solid var(--ink);
  font-size: calc(26rpx * var(--font-scale));
  background: transparent;
  color: var(--ink);
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.choice.on {
  background: var(--ink);
  color: var(--oat);
}
.choice-delta {
  font-size: calc(22rpx * var(--font-scale));
  opacity: 0.75;
}

/* ─── Variant size-picker bottom sheet (shared design w/ the shop grid) ── */
.vp-mask {
  position: fixed; top: 0; right: 0; bottom: 0; left: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 9000;
  display: flex; align-items: flex-end;
}
.vp-sheet {
  width: 100%;
  background: var(--oat);
  border-top-left-radius: 28rpx; border-top-right-radius: 28rpx;
  border-top: 4rpx solid var(--ink);
  padding: 32rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  max-height: 76vh;
  overflow-y: auto;
  animation: vp-rise 220ms cubic-bezier(0.2, 0.7, 0.3, 1);
}
@keyframes vp-rise {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
.vp-head {
  display: flex; align-items: flex-start; justify-content: space-between;
  margin-bottom: 20rpx;
}
.vp-title { font-size: calc(36rpx * var(--font-scale)); color: var(--ink); line-height: 1.2; }
.vp-name { font-size: calc(24rpx * var(--font-scale)); color: var(--olive); margin-top: 4rpx; }
.vp-close {
  width: 56rpx; height: 56rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: calc(44rpx * var(--font-scale)); color: var(--olive); line-height: 1;
}
.vp-opts { display: flex; flex-direction: column; gap: 16rpx; }
.vp-opt {
  display: flex; align-items: center; justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx 28rpx;
  background: #FFFCF7;
  border: 3rpx solid var(--ink);
  border-radius: 14rpx;
}
.vp-opt.sold-out { opacity: 0.5; }
.vp-opt-main { display: flex; align-items: baseline; gap: 16rpx; flex-wrap: wrap; min-width: 0; flex: 1; }
.vp-opt-label { font-size: calc(32rpx * var(--font-scale)); color: var(--ink); }
.vp-opt-weight { font-size: calc(22rpx * var(--font-scale)); color: var(--ink-soft, #8a8575); letter-spacing: 0.02em; }
.vp-opt-low { font-size: calc(20rpx * var(--font-scale)); color: #E96174; font-weight: 700; letter-spacing: 0.04em; }
.vp-opt-oos {
  font-size: calc(18rpx * var(--font-scale)); letter-spacing: 0.1em;
  background: rgba(0,0,0,.1); color: var(--olive); padding: 2rpx 12rpx; border-radius: 999rpx;
}
/* Pre-order: an out-of-stock size out-of-city shoppers can still reserve. */
.vp-opt-pre {
  font-size: calc(18rpx * var(--font-scale)); letter-spacing: 0.08em; font-weight: 700;
  background: var(--olive); color: #fff; padding: 2rpx 12rpx; border-radius: 999rpx;
}
.vp-opt-price-stack { display: flex; align-items: baseline; gap: 10rpx; flex-shrink: 0; }
.vp-opt-price { font-size: calc(36rpx * var(--font-scale)); color: var(--ink); letter-spacing: 0.04em; }
.vp-opt-price.is-flash { color: #E96174; font-weight: 700; }
.vp-opt-was {
  font-size: calc(22rpx * var(--font-scale));
  color: rgba(0, 0, 0, 0.4);
  text-decoration: line-through;
}
/* "SAVE ¥X" deal pill on a discounted variant (compare-at price set). */
.vp-opt-save {
  font-size: calc(18rpx * var(--font-scale)); letter-spacing: 0.06em; font-weight: 700;
  background: #E96174; color: #fff; padding: 2rpx 12rpx; border-radius: 999rpx;
}

/* ─── Options picker bottom sheet (dressing, spice…). Reuses .vp-mask /
   .vp-sheet / .vp-head; each choice is a full-width tappable row. ─── */
.op-body { max-height: 50vh; }
.op-group { margin-bottom: 28rpx; }
.op-group:last-child { margin-bottom: 8rpx; }
.op-q {
  font-size: calc(24rpx * var(--font-scale)); letter-spacing: 0.08em;
  text-transform: uppercase; color: var(--olive); margin-bottom: 14rpx;
}
.op-choices { display: flex; flex-direction: column; gap: 14rpx; }
.op-choice {
  display: flex; align-items: center; justify-content: space-between; gap: 16rpx;
  padding: 24rpx 28rpx;
  background: #FFFCF7;
  border: 3rpx solid var(--ink);
  border-radius: 14rpx;
}
.op-choice.on { background: var(--ink); }
.op-choice-label { font-size: calc(32rpx * var(--font-scale)); color: var(--ink); }
.op-choice.on .op-choice-label { color: var(--oat); }
.op-choice-delta { font-size: calc(24rpx * var(--font-scale)); color: var(--olive); flex-shrink: 0; }
.op-choice.on .op-choice-delta { color: var(--oat); opacity: 0.85; }
/* The choice's picture — its linked product's photo, small and square so a
   sheet of six extras still fits. A choice without one keeps the empty frame. */
.op-choice-img {
  flex: none; width: 88rpx; height: 88rpx; border-radius: 10rpx;
  background: rgba(0,0,0,.06); margin: -8rpx 0;
}
/* A row with a picture: the name takes the middle, the price stays right. */
.op-has-img .op-choice-label { flex: 1; }
.op-foot { margin-top: 24rpx; }
.op-add {
  width: 100%;
  background: var(--ink); color: var(--oat);
  border-radius: 14rpx;
  padding: 26rpx 0;
  font-size: calc(30rpx * var(--font-scale)); letter-spacing: 0.06em;
  line-height: 1.1;
}
.op-add::after { border: none; }
/* Extras sheet: multi-select rows with a tick box; sold-out rows greyed out. */
.op-extra { justify-content: flex-start; }
.op-extra .op-choice-label { flex: 1; }
.op-extra-box {
  flex: none; width: 40rpx; height: 40rpx; border: 3rpx solid var(--ink);
  border-radius: 8rpx; display: flex; align-items: center; justify-content: center;
  font-size: calc(28rpx * var(--font-scale)); color: var(--oat); line-height: 1;
}
.op-extra.on .op-extra-box { background: var(--ink); }
.op-extra-oos {
  flex: none; font-size: calc(20rpx * var(--font-scale)); letter-spacing: 0.08em;
  color: var(--olive); background: rgba(0,0,0,.08); padding: 2rpx 12rpx; border-radius: 999rpx;
}
.op-extra.sold-out { opacity: 0.45; }
/* At the ceiling the rows NOT already ticked go quiet. A ticked row stays live —
   untick is how you change your mind, and a sheet with nothing tappable is dead. */
.op-extra.capped { opacity: 0.38; }
/* A repeat group's row: − n + at its end in place of the tick box. On a picked
   (ink) row the buttons and number turn oat to stay readable. */
.op-count { flex: none; display: flex; align-items: center; gap: 8rpx; }
.op-count-btn {
  width: 56rpx; height: 56rpx; box-sizing: border-box;
  border: 3rpx solid var(--ink); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-family: var(--f-bear); font-size: calc(32rpx * var(--font-scale));
  color: var(--ink); line-height: 1; user-select: none;
}
.op-count-btn.off { opacity: 0.3; }
.op-count-n {
  min-width: 40rpx; text-align: center;
  font-size: calc(30rpx * var(--font-scale)); color: var(--ink);
}
.op-extra.on .op-count-btn { border-color: var(--oat); color: var(--oat); }
.op-extra.on .op-count-n { color: var(--oat); }
/* HOW MANY a pick-any group takes, under its question. */
.op-lim {
  font-size: calc(22rpx * var(--font-scale)); letter-spacing: 0.06em;
  color: var(--olive); opacity: 0.75; margin: -8rpx 0 14rpx;
}

/* Sticky bottom bar */
.sticky-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  background: var(--oat);
  border-top: 3rpx solid var(--ink);
  padding: 24rpx 32rpx 32rpx;
  display: flex;
  gap: 20rpx;
  align-items: center;
}
.qty {
  display: flex;
  align-items: stretch;
  border: 3rpx solid var(--ink);
  flex-shrink: 0;
}
.qty-btn {
  width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--f-bear);
  font-size: calc(36rpx * var(--font-scale));
  color: var(--ink);
  user-select: none;
}
.qty-val {
  width: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-left: 3rpx solid var(--ink);
  border-right: 3rpx solid var(--ink);
  font-size: calc(32rpx * var(--font-scale));
}
/* THE LABEL AND THE PRICE SHARE ONE LINE, AND THE BAR MAY NOT GROW PAST THE
   SCREEN. Both halves of that were missing: the button is flex:1 in the bar,
   whose default min-width:auto let its min-content width (a nowrap label +
   the price) push the bar wider than the 750, so the price slid off the right
   edge — `NEXT BATCH · TOMORROW¥4`, reported by Ash from the PDP, 2026-09-20.
   min-width:0 lets the button be as wide as the bar allows and no wider; the
   gap replaces the child margins that used to do the spacing, so the two
   halves can never touch. The label shrinks (.add-label) rather than the
   price: a digit lost is a wrong number, a letter lost is still readable.
   The side padding comes in from 28rpx and the gap sits at 16rpx: together
   they hand the label 24rpx it did not have, which is a quarter of what the
   long band needed back. */
.add-btn {
  flex: 1;
  min-width: 0;
  background: var(--ink);
  color: var(--lime);
  padding: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  border-radius: 0;
  letter-spacing: 0.1em;
}
.add-btn.sold-out {
  background: rgba(0, 0, 0, 0.3);
  color: rgba(255, 255, 255, 0.7);
  justify-content: center;
}
/* No price on the right (variant products, price lives in the size picker):
   center the lone label instead of leaving it pinned to the left edge. */
.add-btn.no-price { justify-content: center; }
.add-label {
  font-size: calc(32rpx * var(--font-scale));
  white-space: nowrap;
  /* Last line of defence at the largest font scales: clip the WORD, never
     let it push the price out of the button. It should never be reached —
     .is-long below sizes the §170 label to fit first. */
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}
/* THE APPENDER'S ANSWER SITS UNDER THE WORD, NOT BESIDE IT.
   Two attempts to shrink it onto one line both clipped it, the second because
   it was sized against `¥44` while this button draws its price in full. There
   is no readable single size: the button leaves label and price 404rpx
   together, and this page's widest price column — a struck `¥158.50` over
   `SAVE ¥30.50` — takes 231 of them, leaving 173 where even 21rpx type needs
   214.

   Stacked, the label needs only the WIDER of its two pieces. Measured from
   public/fonts/ToniGroteskPro.otf at the 1.15 --font-scale:

     NEXT BATCH   28rpx/0.1em    160rpx  ← the widest piece, so the column
     PRE-ORDER    28rpx/0.1em    132rpx
     TOMORROW     20rpx/0.06em    91rpx
     10-14 DAYS   20rpx/0.06em    92rpx
     下批现做       28rpx/0.1em     77rpx
     9月23日       20rpx/0.06em    55rpx

   160 against the worst case's 173 clears it, and against a plain `¥44` it
   clears by 155. The word keeps near its full size instead of shrinking to a
   caption, and the ` · ` goes, having only ever cost width.

   DO NOT SIZE THIS BY EYE OR FROM ANOTHER SURFACE'S PRICE — that is the
   mistake this replaces, twice over. §8 of scripts/test_fresh_batch_eta.js
   reads these fonts and adds up every label the page can build beside every
   price column it can draw; change a size here and it names the pair that
   stopped fitting. */
.add-label-stack {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  min-width: 0;
  gap: 2rpx;
}
.add-word {
  font-size: calc(28rpx * var(--font-scale));
  line-height: 1.1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}
/* Quieter than the word above it: this informs, the word is what you tap.
   Tracking is its own rather than the button's 0.1em — a short arrival or a
   day count does not need spacing out, and the em it saves is real. */
.add-qual {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.06em;
  line-height: 1.1;
  opacity: 0.85;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 100%;
}
/* Compare-at + live price grouped on the right of the add button. Stacked
   (was over now) so the pair stays narrow — the label keeps to one line
   instead of wrapping and knocking the alignment off. */
.add-prices {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0;
  /* Never shrinks — a clipped price is a wrong price. */
  flex-shrink: 0;
  line-height: 1.05;
}
.add-price {
  font-size: calc(36rpx * var(--font-scale));
}
/* Compare-at "was" + SAVE badge stacked above the live price in the add button
   (single, non-variant products). On the dark button: muted struck was + a
   bright savings tag. */
.add-was-row { display: flex; align-items: baseline; gap: 10rpx; justify-content: flex-end; }
.add-was {
  font-size: calc(24rpx * var(--font-scale));
  text-decoration: line-through;
  color: rgba(255, 255, 255, 0.6);
}
.add-save {
  font-size: calc(20rpx * var(--font-scale)); font-weight: 700; letter-spacing: 0.04em;
  color: var(--lime, #c8f560);
}

.loading { padding: 0 0 60rpx; }
.hero-skel  { width: 100%; height: 800rpx; }
.title-skel { width: 60%; height: 80rpx; margin: 44rpx 44rpx 24rpx; }
.body-skel  { margin: 0 44rpx; height: 400rpx; }

.empty { padding: 200rpx 44rpx 0; text-align: center; }
.empty-title { font-size: calc(56rpx * var(--font-scale)); font-weight: 500; margin-bottom: 16rpx; }
.empty-sub { color: var(--olive); font-size: calc(26rpx * var(--font-scale)); line-height: 1.5; margin-bottom: 40rpx; }
.empty-btn {
  display: inline-block;
  background: var(--ink); color: var(--oat);
  padding: 20rpx 36rpx;
  font-size: calc(24rpx * var(--font-scale));
  letter-spacing: 0.1em;
  border-radius: 999rpx;
}
/* Retry — only on the load-failed state, never on "the store removed it".
   Same pill as the home page's; its 48rpx gap above is made here of the
   40rpx this page's .empty-sub already carries plus the 8rpx below, so the
   two screens sit identically. */
.empty-retry {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
  padding: 0 56rpx;
  height: 84rpx;
  background: var(--lime);
  color: var(--ink);
  font-family: var(--f-toni);
  font-size: calc(24rpx * var(--font-scale));
  font-weight: 600;
  letter-spacing: 0.08em;
  border-radius: 999rpx;
}
.empty-retry-tap { opacity: 0.72; }

/* ─── "Buy together" bundle card ───────────────────────────────────────── */
.pd-bundle {
  margin: 40rpx 0 12rpx;
  background: #FFFCF7;
  border: 4rpx solid var(--ink);
  border-radius: 20rpx;
  padding: 24rpx 24rpx 28rpx;
}
.pd-bundle-head {
  display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx;
  margin-bottom: 18rpx;
}
.pd-bundle-title { font-size: calc(34rpx * var(--font-scale)); color: var(--ink); line-height: 1.1; }
.pd-bundle-save {
  font-size: calc(20rpx * var(--font-scale)); letter-spacing: 0.08em; color: #fff;
  background: var(--berry); padding: 4rpx 14rpx; border-radius: 999rpx; flex-shrink: 0;
}
.pd-bundle-scroll { width: 100%; white-space: nowrap; }
.pd-bundle-row { display: flex; align-items: flex-start; gap: 10rpx; padding-bottom: 6rpx; }
.pd-bundle-card { width: 150rpx; flex-shrink: 0; display: flex; flex-direction: column; }
.pd-bundle-card.is-out { opacity: 0.45; }
.pd-bundle-img {
  width: 150rpx; height: 150rpx; border-radius: 12rpx;
  border: 3rpx solid var(--ink); background: var(--oat); box-sizing: border-box;
}
.pd-bundle-name {
  margin-top: 8rpx; font-size: calc(22rpx * var(--font-scale)); color: var(--ink);
  line-height: 1.25; white-space: normal; max-height: 2.5em; overflow: hidden;
}
.pd-bundle-price { margin-top: 2rpx; font-size: calc(24rpx * var(--font-scale)); color: var(--olive); }
.pd-bundle-oos {
  margin-top: 4rpx; align-self: flex-start; font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.1em; background: rgba(0,0,0,.1); color: var(--olive);
  padding: 2rpx 10rpx; border-radius: 999rpx;
}
.pd-bundle-plus { font-size: calc(34rpx * var(--font-scale)); color: var(--olive); align-self: center; flex-shrink: 0; }
.pd-bundle-foot {
  display: flex; align-items: center; justify-content: space-between; gap: 20rpx;
  margin-top: 22rpx;
}
.pd-bundle-price-block { display: flex; align-items: baseline; gap: 12rpx; flex-shrink: 0; }
.pd-bundle-was {
  font-size: calc(22rpx * var(--font-scale)); color: rgba(0,0,0,0.4); text-decoration: line-through;
}
.pd-bundle-total { font-size: calc(44rpx * var(--font-scale)); color: var(--ink); line-height: 1; }
.pd-bundle-cta {
  flex: 1; margin: 0; padding: 18rpx 24rpx;
  background: var(--ink); color: var(--oat);
  border-radius: 12rpx; border: none;
  font-size: calc(24rpx * var(--font-scale)); letter-spacing: 0.08em; line-height: 1.2;
}
.pd-bundle-cta::after { border: none; }
.pd-bundle-cta[disabled] { background: var(--olive); opacity: 0.55; color: var(--oat); }

/* ─── Bundle PRODUCT "what's inside" (read-only component list) ──────────── */
.pd-inside {
  margin: 40rpx 0 12rpx;
  background: #FFFCF7;
  border: 4rpx solid var(--ink);
  border-radius: 20rpx;
  padding: 24rpx;
}
.pd-inside-title { display: block; font-size: calc(32rpx * var(--font-scale)); color: var(--ink); line-height: 1.1; margin-bottom: 18rpx; }
.pd-inside-list { display: flex; flex-direction: column; gap: 14rpx; }
.pd-inside-item { display: flex; align-items: center; gap: 16rpx; }
.pd-inside-img {
  width: 84rpx; height: 84rpx; border-radius: 12rpx; flex-shrink: 0;
  border: 3rpx solid var(--ink); background: var(--oat); box-sizing: border-box;
}
.pd-inside-name { flex: 1; min-width: 0; font-size: calc(26rpx * var(--font-scale)); color: var(--ink); line-height: 1.3; }
.pd-inside-qty {
  flex-shrink: 0; font-size: calc(24rpx * var(--font-scale)); color: var(--olive);
  background: rgba(0,0,0,.06); padding: 4rpx 14rpx; border-radius: 999rpx;
}
/* Tappable component → opens its own product page. Gentle inset so the
   tap-down highlight has room to read, plus a chevron affordance. */
.pd-inside-item.is-link {
  padding: 8rpx 6rpx 8rpx 8rpx; margin: -8rpx -6rpx -8rpx -8rpx;
  border-radius: 14rpx; transition: background-color .18s var(--ease-out, ease-out);
}
.pd-inside-item--tap { background: rgba(0,0,0,.06); }
.pd-inside-arrow {
  flex-shrink: 0; font-size: calc(40rpx * var(--font-scale)); color: var(--olive);
  line-height: 1; padding-left: 4rpx; opacity: .7;
}

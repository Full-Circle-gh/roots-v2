.picker {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  background: #F2E7DF;
}

/* ── Map ── */
.picker__mapwrap {
  position: relative;
  flex: none;
  width: 100%;
  height: 44vh;
}
.picker__map { width: 100%; height: 100%; }

/* Fixed centre pin: 50%/50% of the map = what getCenterLocation() samples;
   translate -100% Y drops the pin's TIP onto that point. */
.picker__pin {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -100%);
  pointer-events: none;
  z-index: 10;
}
.picker__pin-head {
  font-size: 68rpx;
  line-height: 1;
  filter: drop-shadow(0 4rpx 6rpx rgba(0, 0, 0, 0.35));
}
.picker__locate {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  width: 80rpx;
  height: 80rpx;
  background: #FFFCF7;
  border: 3rpx solid var(--ink);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--ink);
  z-index: 11;
}

/* ── Panel ── */
.picker__panel {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background: #F2E7DF;
  border-top: 4rpx solid var(--ink);
}

.picker__search {
  flex: none;
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 22rpx 28rpx 8rpx;
  padding: 0 22rpx;
  background: #FFFCF7;
  border: 3rpx solid var(--ink);
  min-height: 80rpx;
}
.picker__search-ico { font-size: 30rpx; opacity: 0.6; }
.picker__search-input {
  flex: 1;
  height: 80rpx;
  font-size: calc(28rpx * var(--font-scale));
  font-family: var(--f-aleo);
  color: var(--ink);
}
.picker__search-ph { color: var(--ink); opacity: 0.45; }
.picker__search-clear {
  font-size: 30rpx;
  color: var(--ink);
  opacity: 0.55;
  padding: 8rpx;
}

/* ── List ── */
.picker__list {
  flex: 1;
  min-height: 0;
}
.picker__item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 28rpx;
  border-bottom: 2rpx solid rgba(26, 26, 23, 0.1);
}
.picker__item.is-sel { background: rgba(204, 217, 0, 0.16); }
.picker__item-main { flex: 1; min-width: 0; }
.picker__item-name {
  font-size: calc(28rpx * var(--font-scale));
  color: var(--ink);
  line-height: 1.3;
}
.picker__item-sub {
  font-size: calc(22rpx * var(--font-scale));
  color: var(--ink);
  opacity: 0.6;
  line-height: 1.35;
  margin-top: 4rpx;
}
.picker__check {
  flex: none;
  font-size: 36rpx;
  color: #365329;
  font-weight: 700;
}
.picker__hint {
  text-align: center;
  padding: 32rpx;
  font-size: calc(24rpx * var(--font-scale));
  color: var(--ink);
  opacity: 0.5;
}

/* ── Actions ── */
.picker__actions {
  flex: none;
  display: flex;
  gap: 20rpx;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 3rpx solid rgba(26, 26, 23, 0.12);
}
.picker__btn {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: calc(26rpx * var(--font-scale));
  letter-spacing: 0.08em;
}
.picker__btn--ghost {
  background: #FFFCF7;
  color: var(--ink);
  border: 3rpx solid var(--ink);
}
.picker__btn--primary {
  background: var(--ink);
  color: var(--lime);
}
.picker__btn--disabled { opacity: 0.45; }

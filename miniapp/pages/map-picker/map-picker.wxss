.picker {
  display: flex;
  flex-direction: column;
  width: 100vw;
  height: 100vh;
  background: #F2E7DF;
}

/* ── Map ── */
.picker__mapwrap {
  position: relative;
  flex: none;
  width: 100%;
  height: 42vh;
  border-bottom: 4rpx solid var(--ink);
}
.picker__map { width: 100%; height: 100%; }

/* Fixed centre pin: 50%/50% of the map = what getCenterLocation() samples;
   translate -100% Y drops the pin's TIP onto that point. */
.picker__pin {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -100%);
  pointer-events: none;
  z-index: 10;
}
.picker__pin-head {
  font-size: 64rpx;
  line-height: 1;
  filter: drop-shadow(0 6rpx 8rpx rgba(0, 0, 0, 0.3));
}
.picker__locate {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  width: 84rpx;
  height: 84rpx;
  background: #FFFCF7;
  border: 3rpx solid var(--ink);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 46rpx;
  color: var(--ink);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.18);
  z-index: 11;
}
.picker__locate:active { background: #F0EADF; transform: scale(0.96); }

/* ── Panel ── */
.picker__panel {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background: #F2E7DF;
}

/* Search */
.picker__search {
  flex: none;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 26rpx 32rpx 16rpx;
  padding: 0 28rpx;
  height: 96rpx;
  background: #FFFCF7;
  border: 3rpx solid var(--ink);
  box-shadow: 6rpx 6rpx 0 rgba(26, 26, 23, 0.12);
}
.picker__search-ico { font-size: 32rpx; opacity: 0.5; }
.picker__search-input {
  flex: 1;
  height: 96rpx;
  font-size: calc(30rpx * var(--font-scale));
  color: var(--ink);
}
.picker__search-ph { color: var(--ink); opacity: 0.4; }
.picker__search-clear {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: var(--ink);
  opacity: 0.55;
}

/* List */
.picker__list {
  flex: 1;
  min-height: 0;
  padding: 4rpx 0 8rpx;
}
.picker__item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 32rpx;
  border-bottom: 2rpx solid rgba(26, 26, 23, 0.08);
  transition: background 0.12s ease;
}
.picker__item:active { background: rgba(26, 26, 23, 0.04); }
.picker__item.is-sel {
  background: rgba(204, 217, 0, 0.18);
  box-shadow: inset 8rpx 0 0 var(--lime);
}
.picker__item-main { flex: 1; min-width: 0; }
.picker__item-label {
  font-size: calc(21rpx * var(--font-scale));
  color: #365329;
  margin-bottom: 6rpx;
}
.picker__item-name {
  font-size: calc(30rpx * var(--font-scale));
  font-family: var(--f-aleo);
  font-weight: 500;
  color: var(--ink);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.picker__item-sub {
  font-size: calc(23rpx * var(--font-scale));
  font-family: var(--f-aleo);
  color: var(--ink);
  opacity: 0.6;
  line-height: 1.4;
  margin-top: 6rpx;
}
.picker__dist {
  display: inline-block;
  margin-right: 12rpx;
  padding: 2rpx 12rpx;
  background: rgba(54, 83, 41, 0.1);
  color: #365329;
  border-radius: 999rpx;
  font-size: calc(20rpx * var(--font-scale));
  opacity: 1;
}
.picker__check {
  flex: none;
  font-size: 38rpx;
  color: #365329;
  font-weight: 700;
}
.picker__hint {
  text-align: center;
  padding: 40rpx;
  font-size: calc(24rpx * var(--font-scale));
  color: var(--ink);
  opacity: 0.45;
}

/* Actions */
.picker__actions {
  flex: none;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #F2E7DF;
  border-top: 3rpx solid rgba(26, 26, 23, 0.12);
}
.picker__btn {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  font-size: calc(26rpx * var(--font-scale));
}
.picker__btn--ghost {
  background: #FFFCF7;
  color: var(--ink);
  border: 3rpx solid var(--ink);
}
.picker__btn--primary {
  background: var(--ink);
  color: var(--lime);
  border: 3rpx solid var(--ink);
}
.picker__btn--primary.picker__btn--disabled { opacity: 0.4; }

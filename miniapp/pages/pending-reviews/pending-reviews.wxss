.page { background: var(--oat); min-height: 100vh; padding-bottom: 80rpx; }

.head { padding: 60rpx 44rpx 24rpx; }
.kicker { font-size: calc(20rpx * var(--font-scale)); letter-spacing: 0.2em; color: var(--olive); }
.title  { font-size: calc(64rpx * var(--font-scale)); line-height: 0.94; color: var(--ink); margin-top: 12rpx; }
.subtitle { font-size: calc(24rpx * var(--font-scale)); color: var(--olive); margin-top: 12rpx; }

.empty {
  margin: 40rpx 44rpx;
  padding: 40rpx 28rpx;
  text-align: center;
  font-size: calc(26rpx * var(--font-scale));
  color: var(--olive);
  background: rgba(0, 0, 0, 0.03);
  border-radius: 12rpx;
}

.list { padding: 8rpx 44rpx 0; }
.item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(0, 0, 0, 0.1);
}
.item:last-child { border-bottom: 1rpx solid rgba(0, 0, 0, 0.1); }
.thumb {
  width: 120rpx;
  height: 120rpx;
  background: rgba(0, 0, 0, 0.04);
  border-radius: 8rpx;
  overflow: hidden;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.thumb-img { width: 100%; height: 100%; }
.body { flex: 1; min-width: 0; }
.name {
  font-size: calc(30rpx * var(--font-scale));
  line-height: 1.2;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.meta {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.08em;
  color: var(--olive);
  margin-top: 8rpx;
}
.delivered {
  font-size: calc(22rpx * var(--font-scale));
  color: var(--olive);
  margin-top: 4rpx;
}
.cta {
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.12em;
  color: var(--forest);
  text-decoration: underline;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* Wallet + Points — design page #16. Logical px×2 → rpx. */

.page {
  background: var(--oat);
  min-height: 100vh;
  padding: 0 0 80rpx;
}

/* Returning-customer phone-bind card (migration restore CTA) */
.bind-card {
  margin: 32rpx 44rpx 0;
  border: 3rpx solid var(--ink);
  background: #FFFCF7;
  padding: 32rpx 32rpx 36rpx;
}
.bind-card .bind-title {
  font-size: calc(38rpx * var(--font-scale));
  line-height: 1.05;
  letter-spacing: -0.01em;
  color: var(--ink);
}
.bind-card .bind-desc {
  font-size: calc(24rpx * var(--font-scale));
  line-height: 1.4;
  color: var(--olive);
  margin-top: 12rpx;
}
.bind-card .bind-btn {
  margin-top: 28rpx;
  background: var(--ink);
  color: var(--oat);
  border: none;
  border-radius: 0;
  font-size: calc(26rpx * var(--font-scale));
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 22rpx 0;
  line-height: 1.1;
}
.bind-card .bind-btn::after { border: none; }
.bind-card .bind-btn[disabled] { opacity: 0.6; }

/* Header */
.head {
  padding: 40rpx 44rpx 16rpx;
}
.head .kicker {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.25em;
  color: var(--olive);
}
.head .cn {
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.08em;
  text-transform: none;
}
.head .title {
  font-size: calc(60rpx * var(--font-scale));
  line-height: 0.95;
  letter-spacing: -0.01em;
  margin-top: 12rpx;
  color: var(--ink);
}

/* Tabs strip */
.tabs {
  margin: 32rpx 44rpx 0;
  display: flex;
  border: 3rpx solid var(--ink);
}
.tab {
  flex: 1;
  padding: 24rpx 28rpx;
  background: #FFFCF7;
  color: var(--ink);
  position: relative;
}
.tab + .tab-points { border-left: 3rpx solid var(--ink); }
.tab .tab-lbl {
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.22em;
  color: var(--olive);
}
.tab .cn {
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.05em;
  text-transform: none;
}
.tab .tab-val {
  font-size: calc(44rpx * var(--font-scale));
  line-height: 1;
  letter-spacing: -0.01em;
  margin-top: 8rpx;
  display: block;
}
.tab .tab-val-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 8rpx;
}
.tab .tab-val-row .tab-val { margin-top: 0; }
.tab .tab-val-unit {
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.08em;
  color: var(--forest);
}
.tab-wallet.active {
  background: var(--ink);
  color: #fff;
}
.tab-wallet.active .tab-lbl { color: rgba(255,255,255,0.55); }
.tab-wallet.active .tab-val { color: var(--lime); }
.tab-points.active {
  background: var(--lime);
  color: var(--ink);
}
.tab-points.active .tab-lbl { color: var(--forest); }
.tab-arrow {
  position: absolute;
  bottom: -10rpx;
  left: 50%;
  width: 20rpx;
  height: 20rpx;
  transform: translateX(-50%) rotate(45deg);
}
.tab-arrow-ink    { background: var(--ink); }
.tab-arrow-accent {
  background: var(--lime);
  border-right: 3rpx solid var(--ink);
  border-bottom: 3rpx solid var(--ink);
}

/* Balance card */
.bal-card {
  margin: 40rpx 44rpx 0;
  border: 3rpx solid var(--ink);
  padding: 30rpx 36rpx 28rpx;
}
.bal-wallet { background: var(--ink); color: #fff; }
.bal-points { background: var(--lime); color: var(--ink); }
.bal-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.bal-lbl {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.2em;
}
.bal-meta {
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.15em;
}
.bal-wallet .bal-lbl,
.bal-wallet .bal-meta { color: rgba(255,255,255,0.55); }
.bal-points .bal-lbl,
.bal-points .bal-meta { color: var(--forest); }
.bal-amt {
  font-size: calc(88rpx * var(--font-scale));
  line-height: 1;
  letter-spacing: -0.01em;
  margin-top: 12rpx;
  color: var(--lime);
}
.pts-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-top: 4rpx;
}
.pts-amt {
  font-size: calc(104rpx * var(--font-scale));
  line-height: 0.9;
  letter-spacing: -0.02em;
}
.pts-cash {
  font-size: calc(30rpx * var(--font-scale));
  letter-spacing: 0.04em;
  color: var(--forest);
}
.pts-hint {
  font-size: calc(22rpx * var(--font-scale));
  color: var(--forest);
  margin-top: 8rpx;
  line-height: 1.3;
}
.bal-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
.btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-family: var(--f-gothic);
  font-size: calc(28rpx * var(--font-scale));
  letter-spacing: 0.1em;
}
.btn-primary {
  background: var(--lime);
  color: var(--ink);
  border: 3rpx solid var(--lime);
}
.btn-dark {
  background: var(--ink);
  color: var(--lime);
}
.btn-outline {
  background: transparent;
  color: var(--ink);
  border: 3rpx solid var(--ink);
}

/* Earned / redeemed pair */
.stat-pair {
  margin: 24rpx 44rpx 0;
  display: flex;
  gap: 12rpx;
}
.stat-box {
  flex: 1;
  border: 3rpx solid var(--ink);
  padding: 14rpx 20rpx;
  background: #FFFCF7;
}
.stat-lbl {
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.15em;
  color: var(--olive);
}
.stat-val {
  font-size: calc(40rpx * var(--font-scale));
  margin-top: 6rpx;
  letter-spacing: 0.04em;
}
.stat-val.pos { color: var(--forest); }
.stat-val.neg { color: var(--berry); }

/* Filter chips */
.filters {
  margin: 32rpx 44rpx 0;
  display: flex;
  gap: 12rpx;
}
.chip {
  padding: 12rpx 24rpx;
  border: 3rpx solid var(--ink);
  background: transparent;
  color: var(--ink);
  font-size: calc(24rpx * var(--font-scale));
  letter-spacing: 0.08em;
}
.chip.on {
  background: var(--ink);
  color: var(--lime);
}
.chip .cn {
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.04em;
  text-transform: none;
}

/* Section header */
.sec-head {
  margin: 36rpx 44rpx 0;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.sec-lbl {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.22em;
  color: var(--olive);
}
.sec-meta {
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.15em;
  color: var(--olive);
}

/* Transaction list */
.list { margin-top: 16rpx; }
.row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 22rpx 44rpx;
  border-top: 2rpx dashed rgba(0,0,0,0.2);
}
.row.first { border-top: 3rpx solid var(--ink); }
.row-date {
  width: 80rpx;
  flex-shrink: 0;
}
.row-day {
  font-size: calc(28rpx * var(--font-scale));
  letter-spacing: 0.04em;
  line-height: 1;
  color: var(--ink);
}
.row-mon {
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.15em;
  color: var(--olive);
  margin-top: 6rpx;
}
.pip {
  width: 16rpx;
  height: 64rpx;
  flex-shrink: 0;
  background: var(--olive);
}
.pip-spend  { background: var(--ink); }
.pip-topup  { background: var(--lime); }
.pip-refund { background: var(--papaya); }
.pip-reward { background: var(--pink); }
.pip-earn   { background: var(--lime); }
.pip-bonus  { background: var(--lime); }
.pip-redeem { background: var(--berry); }
.pip-expiry { background: var(--olive); }
.row-expiry { font-size: calc(18rpx * var(--font-scale)); letter-spacing: 0.06em; color: var(--carrot); }
.row-expiry.expired { color: var(--olive); text-decoration: line-through; }
.row-body { flex: 1; min-width: 0; }
.row-label {
  font-size: calc(27rpx * var(--font-scale));
  line-height: 1.1;
  color: var(--ink);
}
.row-sub {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 6rpx;
}
.row-cn {
  font-size: calc(20rpx * var(--font-scale));
  color: var(--olive);
}
.row-time {
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.08em;
  color: var(--olive);
}
.row-bonus {
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.06em;
  background: var(--lime);
  color: var(--ink);
  padding: 0 8rpx;
}
.row-amt {
  font-size: calc(36rpx * var(--font-scale));
  letter-spacing: 0.02em;
  color: var(--ink);
}
.row-amt.pos    { color: var(--forest); }
.row-amt.neg    { color: var(--ink); }
.row-amt.berry  { color: var(--berry); }

/* Empty */
.empty {
  margin: 60rpx 44rpx;
  padding: 60rpx 20rpx;
  text-align: center;
  background: #FFFCF7;
  border: 3rpx dashed rgba(0,0,0,0.15);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.15em;
  color: var(--olive);
}

/* Modal */
.modal-backdrop {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(26,26,23,0.6);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal {
  width: 620rpx;
  background: var(--oat);
  border: 3rpx solid var(--ink);
  padding: 40rpx 36rpx 28rpx;
}
.modal-narrow { width: 540rpx; }
.modal-kicker {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.22em;
  color: var(--olive);
}
.modal-title {
  font-size: calc(40rpx * var(--font-scale));
  line-height: 1;
  margin-top: 10rpx;
}
.modal-body {
  margin-top: 18rpx;
  font-size: calc(26rpx * var(--font-scale));
  line-height: 1.5;
  color: var(--ink);
}
.modal-close {
  margin-top: 28rpx;
  padding: 18rpx 0;
  text-align: center;
  background: var(--ink);
  color: var(--lime);
  font-size: calc(24rpx * var(--font-scale));
  letter-spacing: 0.1em;
}


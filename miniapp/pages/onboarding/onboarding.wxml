<view class="page {{splash ? 'page-splash' : ''}}">
  <block-renderer
    wx:for="{{layout}}"
    wx:key="id"
    block="{{item}}"
    lang="{{lang}}"
    leaderboards="{{leaderboards}}"/>

  <view class="footer {{splash ? 'footer-splash' : ''}}">
    <view class="next f-toni" hover-class="btn-hover" bindtap="goHome">{{nextLabel}}</view>
  </view>
</view>

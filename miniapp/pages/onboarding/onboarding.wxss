.page {
  min-height: 100vh;
  background: var(--oat);
  padding-bottom: 200rpx;
  position: relative;
}

.footer {
  position: fixed;
  bottom: 60rpx;
  left: 44rpx;
  right: 44rpx;
}
/* <view bindtap> instead of <button> — WeChat's native <button> drops
   taps inconsistently on some Android builds. */
.next {
  padding: 28rpx 0;
  font-size: calc(26rpx * var(--font-scale));
  letter-spacing: 0.1em;
  text-align: center;
  border-radius: 8rpx;
  line-height: 1.1;
  background: var(--lime);
  color: var(--ink);
}
.btn-hover { opacity: 0.7; }

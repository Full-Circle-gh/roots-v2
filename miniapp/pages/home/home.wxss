.page {
  background: var(--oat);
  min-height: 100vh;
  /* Reserve room for the custom tab bar so the last block isn't covered.
     --tabbar-clear is a fixed 170rpx that covers Android (no safe area) and
     iPhone home-indicator (~68rpx). The chained-var form with env() is
     broken in WeChat — see app.wxss. */
  padding-bottom: var(--tabbar-clear);
}

/* Floating language toggle — top-left, above the hero. Compact pill so
   it doesn't compete with the rest of the layout. */
.lang-fab {
  position: fixed;
  top: 88rpx;
  left: 30rpx;
  z-index: 100;
  display: flex;
  background: rgba(26, 26, 23, 0.78);
  border-radius: 999rpx;
  padding: 4rpx;
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
}
.lang-opt {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 30rpx;
  height: 36rpx;
  padding: 0 22rpx;
  color: rgba(255, 255, 255, 0.6);
  font-family: var(--f-toni);
  font-size: calc(22rpx * var(--font-scale));
  font-weight: 600;
  line-height: 1;
  letter-spacing: 0.08em;
  border-radius: 999rpx;
  transition: background 0.15s ease, color 0.15s ease;
}
.lang-opt.on {
  background: var(--lime);
  color: var(--ink);
}
.loading {
  padding: 0 0 60rpx;
}
.loading .hero-skel  { width: 100%; height: 800rpx; }
.loading .title-skel { width: 60%; height: 60rpx; margin: 40rpx 44rpx; }
.loading .grid-skel  { margin: 0 44rpx; height: 600rpx; }

.empty {
  padding: 200rpx 44rpx 0;
  text-align: center;
}
.empty-title {
  font-family: var(--f-bear);
  font-size: calc(56rpx * var(--font-scale));
  font-weight: 500;
  color: var(--ink);
  margin-bottom: 16rpx;
}
.empty-sub {
  color: var(--olive);
  font-size: calc(26rpx * var(--font-scale));
  line-height: 1.5;
}
/* Retry — only shown when the layout is missing because the fetch failed. */
.empty-retry {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 48rpx;
  padding: 0 56rpx;
  height: 84rpx;
  background: var(--lime);
  color: var(--ink);
  font-family: var(--f-toni);
  font-size: calc(24rpx * var(--font-scale));
  font-weight: 600;
  letter-spacing: 0.08em;
  border-radius: 999rpx;
}
.empty-retry-tap { opacity: 0.72; }

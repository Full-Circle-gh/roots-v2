<view class="page" style="{{themeVars}}{{themeBg ? ';background:' + themeBg : ''}}">
  <!-- Floating language toggle — top-right, always visible. Customer-facing
       quick swap; the bigger picker on Me tab is the "settings" home. -->
  <view class="lang-fab">
    <view class="lang-opt {{lang === 'en' ? 'on' : ''}}" data-lang="en" bindtap="switchLang">EN</view>
    <view class="lang-opt {{lang === 'cn' ? 'on' : ''}}" data-lang="cn" bindtap="switchLang">中</view>
  </view>

  <view wx:if="{{loading && !layout.length}}" class="loading">
    <view class="skeleton hero-skel"></view>
    <view class="skeleton title-skel"></view>
    <view class="skeleton grid-skel"></view>
  </view>

  <!-- Two different empty states. loadError = we never reached the server, so
       this is the customer's network, not a missing layout — say so and give
       them a way out. Only the genuinely-unpublished case gets the operator
       copy, which a customer should never be shown for a dropped request. -->
  <view wx:elif="{{!layout.length}}" class="empty">
    <block wx:if="{{loadError}}">
      <view class="empty-title f-bear">{{lang === 'cn' ? '网络连接失败' : 'No connection'}}</view>
      <view class="empty-sub">{{lang === 'cn' ? '请检查网络后重试。' : 'Check your network and try again.'}}</view>
      <view class="empty-retry" hover-class="empty-retry-tap" bindtap="retry">{{lang === 'cn' ? '重试' : 'TRY AGAIN'}}</view>
    </block>
    <block wx:else>
      <view class="empty-title f-bear">{{lang === 'cn' ? '这里还没有内容' : 'Nothing here yet'}}</view>
      <view class="empty-sub">{{lang === 'cn' ? '请在 Roots 后台发布首页布局后开始使用。' : 'Publish a home layout from the Roots admin to get started.'}}</view>
    </block>
  </view>

  <view wx:else class="font-gate {{fontsReady ? '' : 'fonts-pending'}}">
  <block-renderer
    wx:for="{{layout}}"
    wx:key="id"
    block="{{item}}"
    lang="{{lang}}"
    products="{{products}}"
    categories="{{categories}}"
    flash-sales="{{flashSales}}"
    top-products="{{topProducts}}"
    leaderboards="{{leaderboards}}"
    new-arrivals="{{newArrivals}}"
    cat-grids="{{catGrids}}"
    products-by-id="{{productsById}}"
    active-order="{{activeOrder}}"
    active-order-count="{{activeOrderCount}}"
    affiliate="{{affiliate}}"
    polls="{{polls}}"
    topup-packages="{{topupPackages}}"
    customer="{{customer}}"
    favorites="{{favorites}}"
    notif-unread="{{notifUnread}}"
    notif-latest-en="{{notifLatestEn}}"
    notif-latest-cn="{{notifLatestCn}}"
    notif-has-broadcast="{{notifHasBroadcast}}"
    notif-is-fresh="{{notifIsFresh}}"
    notif-no-order-unread="{{notifNoOrderUnread}}"
    notif-no-order-latest-en="{{notifNoOrderLatestEn}}"
    notif-no-order-latest-cn="{{notifNoOrderLatestCn}}"
    notif-no-order-fresh="{{notifNoOrderFresh}}"
    notif-color="{{notifColor}}"
    bind:cta="onCta"
    bind:customerchanged="onCustomerChanged"
    bind:category="onCategory"
    bind:product="onProduct"
    bind:vote="onVote"
    bind:bundle="onBundle"
    bind:order="onOrder"/>
  </view>

  <cs-button variant="fab" placement="home"></cs-button>
  <popup-manager page="home"></popup-manager>
  <referral-popup open="{{showReferralPopup}}" affiliate="{{affiliate}}" lang="{{lang}}" bind:close="onReferralPopupClose"></referral-popup>
  <recent-buyers lang="{{lang}}"></recent-buyers>
</view>

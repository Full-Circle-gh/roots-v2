<view class="page" style="{{themeBg ? 'background:' + themeBg : ''}}">
  <!-- Floating language toggle — top-right, always visible. Customer-facing
       quick swap; the bigger picker on Me tab is the "settings" home. -->
  <view class="lang-fab">
    <view class="lang-opt {{lang === 'en' ? 'on' : ''}}" data-lang="en" bindtap="switchLang">EN</view>
    <view class="lang-opt {{lang === 'cn' ? 'on' : ''}}" data-lang="cn" bindtap="switchLang">中</view>
  </view>

  <view wx:if="{{loading && !layout.length}}" class="loading">
    <view class="skeleton hero-skel"></view>
    <view class="skeleton title-skel"></view>
    <view class="skeleton grid-skel"></view>
  </view>

  <view wx:elif="{{!layout.length}}" class="empty">
    <view class="empty-title f-bear">Nothing here yet</view>
    <view class="empty-sub">Publish a home layout from the Roots admin to get started.</view>
  </view>

  <block-renderer
    wx:for="{{layout}}"
    wx:key="id"
    block="{{item}}"
    lang="{{lang}}"
    products="{{products}}"
    categories="{{categories}}"
    flash-sales="{{flashSales}}"
    top-products="{{topProducts}}"
    leaderboards="{{leaderboards}}"
    new-arrivals="{{newArrivals}}"
    active-order="{{activeOrder}}"
    active-order-count="{{activeOrderCount}}"
    affiliate="{{affiliate}}"
    polls="{{polls}}"
    customer="{{customer}}"
    favorites="{{favorites}}"
    notif-unread="{{notifUnread}}"
    notif-latest-en="{{notifLatestEn}}"
    notif-latest-cn="{{notifLatestCn}}"
    notif-has-broadcast="{{notifHasBroadcast}}"
    notif-is-fresh="{{notifIsFresh}}"
    notif-no-order-unread="{{notifNoOrderUnread}}"
    notif-no-order-latest-en="{{notifNoOrderLatestEn}}"
    notif-no-order-latest-cn="{{notifNoOrderLatestCn}}"
    notif-no-order-fresh="{{notifNoOrderFresh}}"
    notif-color="{{notifColor}}"
    bind:cta="onCta"
    bind:category="onCategory"
    bind:product="onProduct"
    bind:vote="onVote"
    bind:bundle="onBundle"
    bind:order="onOrder"/>

  <cs-button variant="fab" placement="home"></cs-button>
  <popup-manager page="home"></popup-manager>
  <recent-buyers lang="{{lang}}"></recent-buyers>
</view>

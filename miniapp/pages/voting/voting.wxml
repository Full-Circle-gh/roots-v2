<view class="page">
  <!-- Header -->
  <view class="head">
    <view class="kicker f-toni">{{copy.kicker}} <text class="cn f-yuan">· 投票</text></view>
    <view class="title f-bear">
      <text>{{copy.title1}}</text><text class="title-mark">{{copy.titleVote}}</text><text>{{copy.title2}}</text>
      <text class="title-br">{{copy.title3}}</text>
    </view>
    <view wx:if="{{introLine}}" class="intro f-aleo">{{introLine}}</view>
  </view>

  <!-- Empty / loading state -->
  <view wx:if="{{loading}}" class="empty f-toni">…</view>
  <view wx:elif="{{!featured && !otherOpen.length && !closed.length}}" class="empty f-toni">{{copy.pollEmpty}}</view>

  <!-- Featured open poll -->
  <view wx:if="{{featured}}" class="card">
    <view class="card-head">
      <view class="status-pill">
        <view class="status-dot"></view>
        <text class="status-lbl f-gothic" wx:if="{{!featured.isClosed}}">{{copy.open}}{{featured.daysLeftStr ? ' · ' + featured.daysLeftStr + 'D ' + copy.left : ''}}</text>
        <text class="status-lbl status-lbl-closed f-gothic" wx:else>{{copy.closed}}</text>
      </view>
      <view class="cat-lbl f-toni" wx:if="{{featured.category_en || featured.category_cn}}">
        <text wx:if="{{featured.category_en}}">{{featured.category_en}}</text>
        <text wx:if="{{featured.category_cn}}" class="cn f-yuan"> · {{featured.category_cn}}</text>
      </view>
    </view>

    <view class="q f-bear">{{featured.question_en}}</view>
    <view wx:if="{{featured.question_cn}}" class="q-cn f-yuan">{{featured.question_cn}}</view>
    <view wx:if="{{featured.explainer_en || featured.explainer_cn}}" class="explainer f-aleo">
      {{lang === 'cn' && featured.explainer_cn ? featured.explainer_cn : featured.explainer_en}}
    </view>

    <!-- Options -->
    <view class="opts">
      <view wx:for="{{featured.options}}" wx:key="id" wx:for-item="opt"
            class="opt {{opt.isChosen ? 'opt-chosen' : ''}} {{featured.showResults ? 'opt-results' : ''}} {{featured.isClosed && opt.isMax ? 'opt-winner' : ''}}"
            data-poll-id="{{featured.id}}" data-option-id="{{opt.id}}" bindtap="pickOption">
        <!-- Result fill bar (only after voting or closed) -->
        <view wx:if="{{featured.showResults}}" class="opt-fill {{opt.isMine ? 'opt-fill-mine' : ''}} {{opt.isMax ? 'opt-fill-max' : ''}}" style="width: {{opt.pctWidth}};"></view>

        <view class="opt-row">
          <view class="opt-letter f-gothic {{opt.isChosen ? 'on' : ''}}">{{opt.letter}}</view>
          <view class="opt-body">
            <view class="opt-label f-bear">{{opt.label_en}}</view>
            <view wx:if="{{opt.label_cn}}" class="opt-cn f-yuan">{{opt.label_cn}}</view>
          </view>
          <view wx:if="{{featured.showResults}}" class="opt-pct">
            <view class="opt-pct-num f-gothic">{{opt.pctStr}}%</view>
            <view class="opt-pct-lbl f-toni">{{opt.votesLbl}} VOTES</view>
          </view>
          <view wx:else class="opt-tick {{opt.isChosen ? 'on' : ''}}">
            <text wx:if="{{opt.isChosen}}" class="opt-check">✓</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Vote / Voted state -->
    <view wx:if="{{featured.voted}}" class="voted f-aleo">
      <view class="voted-dot">✓</view>
      <view class="voted-text">
        <text class="voted-strong f-bear">{{copy.voteCounted}}</text>
        <text wx:if="{{featured.rewardPoints > 0}}"> +{{featured.rewardPoints}} pts.</text>
      </view>
    </view>
    <view wx:elif="{{featured.isClosed}}" class="closed-note f-toni">{{copy.closed}} · {{copy.votesSoFar ? '' : ''}}</view>
    <view wx:else class="cta f-gothic {{chosenByPoll[featured.id] ? 'on' : ''}}"
          data-poll-id="{{featured.id}}" bindtap="castVote">
      <block wx:if="{{chosenByPoll[featured.id]}}">{{copy.castVote}} · +{{featured.rewardPoints}} PTS →</block>
      <block wx:else>{{copy.pickOne}}</block>
    </view>

    <view class="card-foot f-toni">
      <text>{{featured.totalVotes}} VOTES <text wx:if="{{lang === 'cn'}}" class="cn f-yuan">· 已投</text></text>
      <text class="share-lnk" bindtap="share">{{copy.share}}</text>
    </view>
  </view>

  <!-- Other open polls -->
  <view wx:if="{{otherOpen.length}}" class="section">
    <view class="sec-head f-toni">{{copy.otherPolls}} <text class="cn f-yuan">· 其他投票</text></view>
    <view class="sec-list">
      <view wx:for="{{otherOpen}}" wx:key="id" class="op-row {{index === 0 ? 'first' : ''}}"
            data-id="{{item.id}}" bindtap="openOtherPoll">
        <view class="op-days">
          <view wx:if="{{item.daysLeftStr}}" class="op-days-n f-gothic">{{item.daysLeftStr}}d</view>
          <view class="op-days-lbl f-toni">{{copy.left}}</view>
        </view>
        <view class="op-body">
          <view class="op-cat f-toni" wx:if="{{item.category_en || item.category_cn}}">
            <text wx:if="{{item.category_en}}">{{item.category_en}}</text>
            <text wx:if="{{item.category_cn}}" class="cn f-yuan"> · {{item.category_cn}}</text>
          </view>
          <view class="op-q f-bear">{{item.question_en}}</view>
          <view wx:if="{{item.question_cn}}" class="op-q-cn f-yuan">{{item.question_cn}}</view>
        </view>
        <view class="op-arrow f-bear">→</view>
      </view>
    </view>
  </view>

  <!-- Past results -->
  <view wx:if="{{closed.length}}" class="section">
    <view class="sec-head f-toni">{{copy.pastResults}} <text class="cn f-yuan">· 已结束</text></view>
    <view class="sec-list">
      <view wx:for="{{closed}}" wx:key="id" class="pr-row {{index === 0 ? 'first' : ''}}">
        <view class="pr-pill f-gothic">{{copy.closed}}</view>
        <view class="pr-body">
          <view class="pr-q f-bear">{{item.question_en}}</view>
          <view wx:if="{{item.question_cn}}" class="pr-q-cn f-yuan">{{item.question_cn}}</view>
          <block wx:for="{{item.options}}" wx:for-item="o" wx:key="id">
            <view wx:if="{{o.isMax}}" class="pr-winner f-aleo">
              {{copy.winnerLbl}}<text class="pr-winner-name f-bear">{{lang === 'cn' && o.label_cn ? o.label_cn : o.label_en}}</text>
            </view>
          </block>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && featured}}" class="quote f-bear">{{copy.quote}}</view>

  <popup-manager page="voting"></popup-manager>
</view>

<view class="page">
  <view class="head">
    <view class="title f-bear">{{t.title}}</view>
  </view>

  <!-- loading -->
  <view wx:if="{{loading}}" class="state f-aleo">
    <view class="spinner"></view>
  </view>

  <!-- error -->
  <view wx:elif="{{error}}" class="state">
    <view class="err f-aleo">{{error}}</view>
    <button class="btn secondary f-toni" bindtap="retry">{{t.retry}}</button>
  </view>

  <!-- qr + flow -->
  <block wx:else>
    <!-- 1 · amount due — the first thing the customer must read -->
    <view class="amount-card">
      <view class="amount-lbl f-toni">{{t.amount}}</view>
      <view class="amount-val f-bear">{{total}}</view>
    </view>

    <!-- 2 · the QR to scan -->
    <view class="qr-wrap">
      <image wx:if="{{qrPng}}" class="qr" src="{{qrPng}}" mode="widthFix" show-menu-by-longpress></image>
      <view wx:if="{{paid}}" class="paid-overlay">
        <view class="paid-check">✓</view>
      </view>
    </view>

    <!-- 3 · how to pay -->
    <view class="steps">
      <view wx:for="{{ manual ? t.manualSteps : t.steps }}" wx:key="*this" class="step f-aleo">
        <view class="num f-bear">{{index + 1}}</view>
        <view class="step-txt">{{item}}</view>
      </view>
    </view>

    <!-- 4 · actions — upload is the real next step (manual), save is secondary -->
    <view wx:if="{{!paid}}" class="actions">
      <button wx:if="{{manual}}" class="btn primary f-toni" bindtap="uploadProof" loading="{{uploading}}" disabled="{{uploading}}">
        {{ proofUploaded ? t.reupload : t.upload }}
      </button>
      <button class="btn secondary f-toni" bindtap="saveQr">{{t.save}}</button>
    </view>

    <!-- 5 · quiet meta — deadline / order / payee, demoted below the fold -->
    <view class="meta f-aleo">
      <view wx:if="{{manual && payWindowMin > 0 && !paid}}" class="meta-deadline f-toni">
        ⏱ {{t.deadlinePre}}{{payWindowMin}}{{t.deadlinePost}}
      </view>
      <view wx:if="{{orderNo}}" class="meta-row"><text class="meta-lbl">{{t.order}}</text><text class="meta-val">{{orderNo}}</text></view>
      <view wx:if="{{manual && account}}" class="meta-row"><text class="meta-lbl">{{t.payee}}</text><text class="meta-val">{{account}}</text></view>
    </view>

    <view wx:if="{{!paid && (!manual || proofUploaded)}}" class="waiting f-aleo">
      <view class="dot"></view>
      <text>{{ manual ? t.manualWaiting : t.waiting }}</text>
    </view>
  </block>

  <popup-manager page="alipay-pay"></popup-manager>
</view>

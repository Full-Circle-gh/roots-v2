<view class="page">
  <view class="hero" bindtap="goProfile">
    <image class="hero-ip" src="/assets/brand/ip-onion.png" mode="aspectFit"></image>
    <view class="hero-inner">
      <image wx:if="{{avatarPreview}}" class="hero-avatar" src="{{avatarPreview}}" mode="aspectFill"></image>
      <view class="hero-text">
        <view class="kicker f-toni">
          <text wx:if="{{customer}}">{{copy.memberSince}} {{memberYear}} · {{copy.memberLvl}} {{tierLevel}}</text>
          <text wx:else>{{copy.welcomeKicker}}</text>
        </view>
        <view class="title f-bear">
          <text wx:if="{{customer && customer.nickname}}">Hey, {{customer.nickname}}.</text>
          <text wx:else>{{copy.welcome}}</text>
        </view>
        <view wx:if="{{customer && customer.nickname}}" class="hero-meta">
          ID {{customer.id}} · {{stats.total || 0}} {{copy.ordersWord}}
        </view>
        <view wx:else class="hero-cta f-toni">{{copy.bindCta}} →</view>
      </view>
    </view>
  </view>

  <view class="stats">
    <view class="stat">
      <view class="val f-bear">¥{{balanceDisplay}}</view>
      <view class="lbl f-toni">{{copy.balance}}</view>
    </view>
    <view class="stat tap" bindtap="goCoupons">
      <view class="val f-bear">{{customer.coupon_count || 0}}</view>
      <view class="lbl f-toni">{{copy.coupons}}</view>
    </view>
    <view class="stat">
      <view class="val f-bear">{{customer.points_balance || 0}}</view>
      <view class="lbl f-toni">{{copy.points}}</view>
    </view>
  </view>

  <!-- My orders — status bucket icons -->
  <view class="section">
    <view class="section-head">
      <view class="section-title f-bear">{{copy.ordersTitle}}</view>
      <view class="view-all f-toni" bindtap="goOrders">{{copy.allOrders}} →</view>
    </view>
    <view class="bucket-row">
      <view class="bucket" data-status="pending_payment" bindtap="goOrdersFiltered">
        <view class="bucket-icon">
          <image class="bucket-img" src="/assets/icons/bucket/unpaid.svg" mode="aspectFit"></image>
          <view wx:if="{{stats.unpaid}}" class="bucket-badge">{{stats.unpaid}}</view>
        </view>
        <view class="bucket-lbl f-toni">{{copy.bUnpaid}}</view>
      </view>
      <view class="bucket" data-status="paid" bindtap="goOrdersFiltered">
        <view class="bucket-icon">
          <image class="bucket-img" src="/assets/icons/bucket/pending.svg" mode="aspectFit"></image>
          <view wx:if="{{stats.pending}}" class="bucket-badge">{{stats.pending}}</view>
        </view>
        <view class="bucket-lbl f-toni">{{copy.bPending}}</view>
      </view>
      <view class="bucket" data-status="preparing" bindtap="goOrdersFiltered">
        <view class="bucket-icon">
          <image class="bucket-img" src="/assets/icons/bucket/preparing.svg" mode="aspectFit"></image>
          <view wx:if="{{stats.preparing}}" class="bucket-badge">{{stats.preparing}}</view>
        </view>
        <view class="bucket-lbl f-toni">{{copy.bPreparing}}</view>
      </view>
      <view class="bucket" data-status="dispatched" bindtap="goOrdersFiltered">
        <view class="bucket-icon">
          <image class="bucket-img" src="/assets/icons/bucket/sent.svg" mode="aspectFit"></image>
          <view wx:if="{{stats.shipped}}" class="bucket-badge">{{stats.shipped}}</view>
        </view>
        <view class="bucket-lbl f-toni">{{copy.bSent}}</view>
      </view>
      <view class="bucket" data-status="to_review" bindtap="goOrdersFiltered">
        <view class="bucket-icon">
          <image class="bucket-img" src="/assets/icons/bucket/review.svg" mode="aspectFit"></image>
          <view wx:if="{{stats.to_review}}" class="bucket-badge">{{stats.to_review}}</view>
        </view>
        <view class="bucket-lbl f-toni">{{copy.bReview}}</view>
      </view>
    </view>
  </view>

  <!-- Menu rows (borderless, hairline-separated). Order + visibility are
       operator-controlled from the Mini App Backend (Settings → Me page menu);
       the resolved list is built in me.js → buildRows() as data.menuRows. -->
  <view class="rows">
    <view wx:for="{{menuRows}}" wx:key="id"
          class="row {{item.accent ? 'row-accent' : ''}}"
          data-handler="{{item.handler}}" bindtap="onRowTap">
      <view class="row-body">
        <view class="row-title">
          <text class="f-bear">{{item.title}}</text>
          <text wx:if="{{item.badge}}" class="row-badge">{{item.badge}}</text>
          <text class="row-cn muted">  · {{item.titleCn}}</text>
        </view>
        <view wx:if="{{item.meta}}" class="row-meta">{{item.meta}}</view>
      </view>
      <view class="row-arrow">→</view>
    </view>
  </view>

  <view class="lang-section">
    <view class="section-title f-toni">{{copy.langLabel}}</view>
    <view class="lang-row">
      <view class="lang-opt {{lang === 'en' ? 'on' : ''}}" data-lang="en" bindtap="switchLang">English</view>
      <view class="lang-opt {{lang === 'cn' ? 'on' : ''}}" data-lang="cn" bindtap="switchLang">中文</view>
    </view>
  </view>

  <view class="legal-links">
    <navigator url="/pages/legal/legal?doc=privacy" class="legal-link">
      {{lang === 'cn' ? '隐私政策' : 'Privacy'}}
    </navigator>
    <view class="legal-sep">·</view>
    <navigator url="/pages/legal/legal?doc=terms" class="legal-link">
      {{lang === 'cn' ? '服务条款' : 'Terms'}}
    </navigator>
  </view>

  <view class="app-footer">
    <!-- Wordmark: prefer an operator-uploaded image; otherwise render the
         brand text ('Full Circle' by default, or whatever the operator typed).
         Edited per-tenant from the Mini App Backend → Settings → Mini-app
         footer. Roots' production row is seeded with their wordmark image so
         their customers see the existing Roots mark, not 'Full Circle'. -->
    <image wx:if="{{footer.wordmark_image}}" class="footer-mark" src="{{footer.wordmark_image}}" mode="aspectFit"></image>
    <view  wx:else class="footer-mark-text">{{footer.wordmark_text}}</view>
    <view class="footer-sub">{{footer.tagline}}</view>
    <view class="footer-version">{{footer.credit}}</view>
  </view>
  <cs-button variant="fab" placement="me"></cs-button>
  <popup-manager page="me"></popup-manager>
</view>

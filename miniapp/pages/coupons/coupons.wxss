.page {
  background: var(--oat);
  min-height: 100vh;
  padding: 40rpx 44rpx 80rpx;
}

/* ─── Header ─────────────────────────────────────────────── */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}
.header-text { flex: 1; }
.kicker {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.25em;
  color: var(--olive);
}
.title {
  font-size: calc(64rpx * var(--font-scale));
  /* f-bear glyphs + CJK fill the full em box; line-height < 1 clips the top
     of 我 etc. Give the line room. */
  line-height: 1.12;
  margin-top: 12rpx;
  padding-top: 6rpx;
}
.active-pill {
  background: var(--ink);
  color: var(--lime);
  padding: 16rpx 24rpx;
  text-align: center;
  min-width: 120rpx;
}
.active-pill-val {
  font-size: calc(52rpx * var(--font-scale));
  line-height: 0.85;
  color: var(--lime);
}
.active-pill-lbl {
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.15em;
  color: #fff;
  opacity: 0.7;
  margin-top: 8rpx;
}

/* ─── Redeem code input ───────────────────────────────────── */
.redeem {
  margin-top: 36rpx;
  background: #FFFCF7;
  border: 4rpx solid var(--ink);
  padding: 12rpx 12rpx 12rpx 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.redeem-input {
  flex: 1;
  font-size: calc(26rpx * var(--font-scale));
  color: var(--ink);
  background: transparent;
  height: 56rpx;
  line-height: 56rpx;
}
.redeem-btn {
  background: var(--ink);
  color: var(--lime);
  padding: 16rpx 28rpx;
  font-size: calc(24rpx * var(--font-scale));
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.redeem-btn.is-busy { opacity: 0.5; }

/* ─── Tabs ───────────────────────────────────────────────── */
.tabs {
  margin-top: 32rpx;
  display: flex;
  border: 3rpx solid var(--ink);
}
.tab {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: calc(24rpx * var(--font-scale));
  letter-spacing: 0.08em;
  color: var(--ink);
  background: transparent;
}
.tab + .tab { border-left: 3rpx solid var(--ink); }
.tab.on {
  background: var(--ink);
  color: var(--lime);
}
.tab.on .tab-count { color: var(--lime); }
.tab-count {
  opacity: 0.7;
  margin-left: 8rpx;
  font-size: calc(22rpx * var(--font-scale));
}

/* ─── Ticket list ────────────────────────────────────────── */
.list { margin-top: 28rpx; }

.ticket {
  display: flex;
  align-items: stretch;
  background: #FFFCF7;
  border: 3rpx solid var(--ink);
  margin-bottom: 24rpx;
  position: relative;
  min-height: 200rpx;
}
.ticket.dimmed {
  opacity: 0.65;
  border-style: dashed;
  border-color: rgba(0,0,0,0.3);
}

/* Left stub */
.ticket-stub {
  flex: 0 0 192rpx;
  background: var(--lime);
  color: var(--ink);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx 12rpx;
  border-right: 3rpx solid var(--ink);
}
.ticket.dimmed .ticket-stub {
  background: rgba(0,0,0,0.04);
  color: rgba(0,0,0,0.5);
  border-right-style: dashed;
  border-right-color: rgba(0,0,0,0.3);
}
.stub-big {
  font-size: calc(64rpx * var(--font-scale));
  line-height: 0.9;
  letter-spacing: -0.02em;
  text-align: center;
}
.stub-sub {
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.08em;
  margin-top: 8rpx;
  text-align: center;
  opacity: 0.8;
}

/* Perforation notches — the gap between the stub and body */
.notch {
  position: absolute;
  left: 180rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--oat);
  border: 3rpx solid var(--ink);
}
.notch-top { top: -14rpx; }
.notch-bot { bottom: -14rpx; }
.ticket.dimmed .notch {
  border-style: dashed;
  border-color: rgba(0,0,0,0.3);
}

/* Right body */
.ticket-body {
  flex: 1;
  padding: 24rpx 28rpx;
  min-width: 0;
}
.ticket-tag {
  display: inline-block;
  background: var(--ink);
  color: var(--lime);
  padding: 2rpx 12rpx;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.08em;
  margin-bottom: 8rpx;
}
.ticket-name {
  font-size: calc(30rpx * var(--font-scale));
  line-height: 1.15;
}
.ticket-cn {
  font-size: calc(20rpx * var(--font-scale));
  color: var(--olive);
  margin-top: 4rpx;
}
.ticket-foot {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: 22rpx;
}
.exp-lbl {
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.15em;
  color: var(--olive);
}
.exp-val {
  font-size: calc(26rpx * var(--font-scale));
  margin-top: 4rpx;
  color: var(--ink);
}
.ticket.dimmed .exp-val { color: var(--olive); }
.use-btn {
  background: var(--ink);
  color: var(--lime);
  padding: 12rpx 24rpx;
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.state-lbl {
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.15em;
  color: var(--olive);
  text-transform: uppercase;
}

/* ─── Empty state ────────────────────────────────────────── */
.empty {
  text-align: center;
  padding: 100rpx 40rpx;
  background: #FFFCF7;
  border: 3rpx dashed rgba(0,0,0,0.2);
  margin-top: 12rpx;
}
.empty-title {
  font-size: calc(40rpx * var(--font-scale));
  color: var(--olive);
}
.empty-sub {
  font-size: calc(24rpx * var(--font-scale));
  color: var(--olive);
  opacity: 0.7;
  margin-top: 12rpx;
  line-height: 1.5;
  max-width: 480rpx;
  margin-left: auto;
  margin-right: auto;
}

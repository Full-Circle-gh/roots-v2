.page {
  background: var(--oat);
  min-height: 100vh;
  padding: 40rpx 44rpx 200rpx;
}

/* ─── Header ─────────────────────────────────────────────── */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}
.header-text { flex: 1; }
.kicker {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.25em;
  color: var(--olive);
}
.title {
  font-size: calc(64rpx * var(--font-scale));
  /* f-bear glyphs + CJK fill the full em box; line-height < 1 clips the top
     of 我 etc. Give the line room. */
  line-height: 1.12;
  margin-top: 12rpx;
  padding-top: 6rpx;
}
.count-pill {
  background: var(--ink);
  color: var(--lime);
  padding: 16rpx 24rpx;
  text-align: center;
  min-width: 100rpx;
}
.count-pill-val {
  font-size: calc(52rpx * var(--font-scale));
  line-height: 0.85;
  color: var(--lime);
}
.count-pill-lbl {
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.18em;
  color: #fff;
  opacity: 0.7;
  margin-top: 6rpx;
}

/* ─── Category chips + view toggle ───────────────────────── */
.chip-row {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.chips { flex: 1; white-space: nowrap; }
.chip {
  display: inline-block;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  border: 3rpx solid var(--ink);
  color: var(--ink);
  background: transparent;
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.08em;
}
.chip.on {
  background: var(--ink);
  color: var(--lime);
}
.view-toggle {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}
.vt-btn {
  width: 56rpx;
  height: 56rpx;
  border: 3rpx solid var(--ink);
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}
.vt-btn.on { background: var(--ink); }
.vt-grid {
  display: grid;
  grid-template-columns: 12rpx 12rpx;
  grid-template-rows: 12rpx 12rpx;
  gap: 4rpx;
}
.vt-grid-cell {
  background: var(--ink);
  width: 12rpx;
  height: 12rpx;
}
.vt-btn.on .vt-grid-cell { background: var(--lime); }
.vt-list {
  width: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.vt-list-row {
  width: 100%;
  height: 6rpx;
  background: var(--ink);
}
.vt-btn.on .vt-list-row { background: var(--lime); }

/* ─── Section meta line ──────────────────────────────────── */
.section-meta {
  margin-top: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  color: var(--olive);
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.16em;
}
.section-meta-right { text-decoration: underline; }

/* ─── Empty ──────────────────────────────────────────────── */
.empty {
  padding: 120rpx 44rpx 80rpx;
  text-align: center;
}
.empty-title {
  font-size: calc(48rpx * var(--font-scale));
  color: var(--olive);
}
.empty-sub {
  font-size: calc(26rpx * var(--font-scale));
  color: var(--olive);
  margin-top: 12rpx;
  line-height: 1.5;
}

/* ─── GRID view ──────────────────────────────────────────── */
.grid {
  margin-top: 16rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}
.card { position: relative; }
.card-img {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 5;
  background: var(--oat);
  border: 2rpx solid var(--ink);
  overflow: hidden;
}
.img-full { width: 100%; height: 100%; }
.card-img.is-out .img-full { filter: grayscale(0.6); opacity: 0.55; }
.heart-pip {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 56rpx;
  height: 56rpx;
  background: #FFFCF7;
  border: 3rpx solid var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
}
.heart-glyph {
  color: var(--berry, #E96174);
  font-size: 32rpx;
  line-height: 1;
}
.tag-drop {
  position: absolute;
  top: 12rpx;
  left: 12rpx;
  background: var(--berry, #E96174);
  color: #fff;
  padding: 4rpx 12rpx;
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.08em;
}
.tag-out {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  background: var(--ink);
  color: #fff;
  padding: 4rpx 12rpx;
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.08em;
}
/* Pre-order: a sold-out favourite the operator lets out-of-city shoppers
   reserve. Olive instead of the dead ink SOLD OUT tag — the + stays live. */
.tag-pre {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  background: var(--olive);
  color: #fff;
  padding: 4rpx 12rpx;
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.08em;
}
.card-name {
  margin-top: 12rpx;
  font-size: calc(28rpx * var(--font-scale));
  line-height: 1.1;
}
.card-sub {
  font-size: calc(20rpx * var(--font-scale));
  color: var(--olive);
  margin-top: 4rpx;
}
.card-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 8rpx;
}
.card-price {
  font-size: calc(32rpx * var(--font-scale));
  line-height: 1;
}
.quick-add {
  width: 52rpx;
  height: 52rpx;
  background: var(--ink);
  color: var(--lime);
  border: 3rpx solid var(--ink);
  display: flex;
  align-items: center;
  justify-content: center;
}
.quick-add-glyph {
  font-size: 36rpx;
  line-height: 1;
}
.quick-add-disabled {
  background: transparent;
  border-color: rgba(0,0,0,0.3);
  color: var(--olive);
}

/* ─── LIST view ──────────────────────────────────────────── */
.list { margin-top: 12rpx; }
.row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 20rpx 0;
  border-top: 2rpx dashed rgba(0,0,0,0.2);
}
.row:first-child { border-top: 3rpx solid var(--ink); }
.row-img {
  width: 112rpx;
  height: 140rpx;
  background: var(--oat);
  overflow: hidden;
  flex-shrink: 0;
}
.row-img.is-out .img-full { filter: grayscale(0.6); opacity: 0.55; }
.row-meta { flex: 1; min-width: 0; }
.row-name {
  font-size: calc(30rpx * var(--font-scale));
  line-height: 1.1;
}
.row-sub {
  font-size: calc(20rpx * var(--font-scale));
  color: var(--olive);
  margin-top: 4rpx;
}
.row-tags {
  display: flex;
  gap: 12rpx;
  align-items: center;
  flex-wrap: wrap;
  margin-top: 8rpx;
}
.row-saved {
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.1em;
  color: var(--olive);
}
.row-drop {
  background: var(--berry, #E96174);
  color: #fff;
  padding: 2rpx 10rpx;
  font-size: calc(18rpx * var(--font-scale));
}
.row-out {
  background: var(--ink);
  color: #fff;
  padding: 2rpx 10rpx;
  font-size: calc(18rpx * var(--font-scale));
}
.row-pre {
  background: var(--olive);
  color: #fff;
  padding: 2rpx 10rpx;
  font-size: calc(18rpx * var(--font-scale));
}
.row-right {
  text-align: right;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
}
.row-price {
  font-size: calc(36rpx * var(--font-scale));
  line-height: 1;
}

/* ─── Sticky bottom bar ──────────────────────────────────── */
.sticky-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 44rpx calc(52rpx + env(safe-area-inset-bottom));
  background: var(--oat);
  border-top: 3rpx solid var(--ink);
  display: flex;
  align-items: center;
  gap: 20rpx;
  z-index: 50;
}
.sticky-text { flex: 1; min-width: 0; }
.sticky-kicker {
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.18em;
  color: var(--olive);
}
.sticky-total {
  font-size: calc(40rpx * var(--font-scale));
  line-height: 1;
  margin-top: 4rpx;
}
.sticky-cta {
  background: var(--ink);
  color: var(--lime);
  padding: 24rpx 36rpx;
  font-size: calc(28rpx * var(--font-scale));
  letter-spacing: 0.1em;
}

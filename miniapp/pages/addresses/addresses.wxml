<wxs src="../../utils/region.wxs" module="region" />
<view class="page">
  <view class="header">
    <view class="kicker f-toni">{{lang === 'cn' ? '收货地址' : 'ADDRESSES'}}</view>
    <view class="title f-bear">{{lang === 'cn' ? '我的地址' : 'Saved spots.'}}</view>
  </view>

  <!-- ── LIST MODE ── -->
  <block wx:if="{{mode === 'list'}}">

    <!-- Unbound: bind-empty card in place of the list + Add button. Same
         contract as checkout — we only store addresses against a WeChat-
         verified identity, so the manual form is never offered until bind. -->
    <block wx:if="{{!isBound}}">
      <view class="bind-empty">
        <view class="bind-empty__icon">🪪</view>
        <view class="bind-empty__title f-bear">{{copy.bindTitle}}</view>
        <view class="bind-empty__body">{{copy.bindBody}}</view>
        <view class="bind-empty__cta f-toni" bindtap="bindWechat">{{copy.bindCta}}</view>
      </view>
    </block>

    <block wx:else>
      <view wx:if="{{loading && !addresses.length}}" class="loading">
        <view class="skeleton" style="height:200rpx;margin:24rpx 44rpx"></view>
        <view class="skeleton" style="height:200rpx;margin:24rpx 44rpx"></view>
      </view>

      <view wx:elif="{{!addresses.length}}" class="empty">
        <view class="empty-msg muted">{{copy.empty}}</view>
      </view>

      <view wx:else class="list">
        <view wx:if="{{addresses.length > 1}}" class="list-hint muted f-toni">{{copy.tapToSelectHint}}</view>
        <view wx:for="{{addresses}}" wx:key="id"
              class="addr-card {{item.is_default ? 'is-selected' : ''}}"
              data-id="{{item.id}}"
              bindtap="pickAddress">
          <view class="addr-top">
            <view class="addr-name"><text class="f-bear">{{item.recipient_name}}</text> · {{item.phone}}</view>
            <view wx:if="{{item.is_default}}" class="default-badge f-toni">{{copy.selectedBadge}}</view>
          </view>
          <view class="addr-full">{{item.address}}{{item.detail ? ' · ' + item.detail : ''}}</view>
          <view wx:if="{{item.city}}" class="addr-city muted">{{region.region(item, lang)}}</view>
          <!-- Rider ETA pill — distance from the nearest store + estimated
               e-bike ride time (≈35 km/h + 8 min pickup buffer). Beyond
               ~30 km the server flags courier:true and we show "ships by
               courier" instead of an unrealistic ride time. -->
          <view wx:if="{{item.delivery_eta}}" class="addr-eta f-toni">
            <block wx:if="{{item.delivery_eta.courier}}">📦 {{lang === 'cn' ? '快递配送' : 'Ships by courier'}}</block>
            <block wx:else>🛵 {{lang === 'cn' ? '约 ' : '~'}}{{item.delivery_eta.km}}{{lang === 'cn' ? ' 公里 · 约 ' : ' km · ~'}}{{item.delivery_eta.min}}{{lang === 'cn' ? ' 分钟' : ' min'}}</block>
          </view>
          <view class="addr-actions">
            <!-- Edit / Delete use catchtap so taps on these links don't
                 bubble up to the card's pickAddress handler. -->
            <view class="action-link" data-id="{{item.id}}" catchtap="showEditForm">{{copy.editLabel}}</view>
            <view class="action-link danger" data-id="{{item.id}}" catchtap="deleteAddr">{{copy.deleteLabel}}</view>
          </view>
        </view>
      </view>

      <view class="add-btn-wrap">
        <button class="add-btn f-toni" bindtap="showAddForm">{{copy.addBtn}}</button>
      </view>
    </block>
  </block>

  <!-- ── FORM MODE ── -->
  <block wx:elif="{{mode === 'form'}}">
    <view class="form-title f-bear">{{form.id ? copy.formEdit : copy.formAdd}}</view>

    <view class="wx-pick-wrap">
      <button class="wx-pick-btn f-toni" bindtap="pickFromWechat" disabled="{{wxPicking}}">
        {{wxPicking ? '...' : copy.wxPickBtn}}
      </button>
      <button class="map-pick-btn f-toni" bindtap="pickOnMap" disabled="{{mapPicking}}">
        {{mapPicking ? '...' : copy.mapPickBtn}}
      </button>
    </view>

    <view class="field">
      <input class="input" placeholder-class="input-placeholder" placeholder="{{copy.placeholders.name}}" value="{{form.recipient_name}}" data-field="recipient_name" bindinput="onField"/>
    </view>
    <view class="field">
      <input class="input" placeholder-class="input-placeholder" placeholder="{{copy.placeholders.phone}}" type="number" value="{{form.phone}}" data-field="phone" bindinput="onField"/>
    </view>
    <!-- Delivery-area selector. CN → WeChat native region picker (complete +
         current, Chinese). EN → bilingual city → district from our dataset.
         Both write canonical Chinese province/city/district onto the form. -->
    <block wx:if="{{lang === 'cn'}}">
      <view class="field region-field">
        <picker mode="region" value="{{regionValue}}" bindchange="onRegionChange">
          <view class="region-pick {{areaLabel ? '' : 'placeholder'}}">
            <text wx:if="{{areaLabel}}">{{areaLabel}}</text>
            <text wx:else>{{copy.placeholders.region}}</text>
            <text class="region-chevron">›</text>
          </view>
        </picker>
      </view>
    </block>
    <block wx:else>
      <view class="field region-field">
        <picker mode="multiSelector" range="{{areaArray}}" value="{{areaIndex}}" bindcolumnchange="onAreaColumn" bindchange="onAreaConfirm">
          <view class="region-pick {{areaLabel ? '' : 'placeholder'}}">
            <text wx:if="{{areaLabel}}">{{areaLabel}}</text>
            <text wx:else>{{copy.placeholders.region}}</text>
            <text class="region-chevron">›</text>
          </view>
        </picker>
      </view>
    </block>
    <view class="field">
      <input class="input" placeholder-class="input-placeholder" placeholder="{{copy.placeholders.addr}}" value="{{form.address}}" data-field="address" bindinput="onField"/>
    </view>
    <view class="field">
      <input class="input" placeholder-class="input-placeholder" placeholder="{{copy.placeholders.detail}}" value="{{form.detail}}" data-field="detail" bindinput="onField"/>
    </view>
    <!-- Editing only. A new address is always the one we'll use, so the switch
         would just be a redundant thing to tick. -->
    <view wx:if="{{form.id}}" class="default-row">
      <switch checked="{{form.is_default}}" bindchange="onDefaultToggle" color="#1a1a17"/>
      <view class="default-label">{{copy.setDefault}}</view>
    </view>

    <view class="form-actions">
      <button class="btn secondary f-toni" bindtap="cancelForm" disabled="{{saving}}">{{copy.cancelBtn}}</button>
      <button class="btn primary f-toni" bindtap="save" disabled="{{saving}}">{{saving ? '...' : copy.saveBtn}}</button>
    </view>
  </block>
  <popup-manager page="addresses"></popup-manager>
</view>

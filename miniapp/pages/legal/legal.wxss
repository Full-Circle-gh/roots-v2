.page { background: var(--oat); min-height: 100vh; padding-bottom: 80rpx; }

.header { padding: 60rpx 44rpx 24rpx; border-bottom: 2rpx solid rgba(0, 0, 0, 0.08); }
.title { font-size: calc(80rpx * var(--font-scale)); font-weight: 500; line-height: 1; color: var(--ink); }
.updated {
  font-size: calc(22rpx * var(--font-scale));
  margin-top: 12rpx;
  font-family: monospace;
}

.body { padding: 32rpx 44rpx; }
.paragraph {
  font-size: calc(28rpx * var(--font-scale));
  line-height: 1.55;
  color: var(--ink);
  margin-bottom: 28rpx;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  font-size: calc(26rpx * var(--font-scale));
}

.muted { color: var(--olive); }

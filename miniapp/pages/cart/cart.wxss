/* Bottom of the Cart page has TWO fixed bars stacked:
     ┌─────────────────────────┐  ← page content scrolls behind this
     │  Total + CHECK OUT bar  │  height: var(--checkout-h)
     ├─────────────────────────┤
     │  Custom tab bar         │  height: var(--tabbar-clear) (app.wxss)
     └─────────────────────────┘  ← bottom of screen + safe area
   The last product would tuck under either bar unless the scrollable .page
   reserves the combined height as padding-bottom.

   --checkout-h is set generously (300rpx) so the bar can grow a row or two
   without re-clipping the last item. Measured against the rendered .checkout
   bar at --font-scale 1.15: padding 24+32 + total-row ~85 + 20 margin + btn
   ~115 + 3 border ≈ 279rpx. 300rpx gives ~20rpx of headroom.

   Why not env(safe-area-inset-bottom) here? WeChat does NOT resolve env()
   when it lives inside a chained var(): `calc(var(--checkout-h) +
   var(--tabbar-h))` returns just 98rpx for --tabbar-h on iPhone instead of
   ~166rpx, leaving the last item ~70rpx short of the bar's top. We use the
   sibling --tabbar-clear (fixed 170rpx) which covers both Android no-safe
   and iPhone home-indicator cases. */
.page {
  background: var(--oat);
  min-height: 100vh;
  --checkout-h: 300rpx;
  padding-bottom: calc(var(--checkout-h) + var(--tabbar-clear));
}

.header { padding: 80rpx 44rpx 24rpx; }
.kicker { font-size: calc(20rpx * var(--font-scale)); letter-spacing: 0.18em; color: var(--olive); }
.title-row { display: flex; align-items: baseline; justify-content: space-between; margin-top: 12rpx; }
.title { font-size: calc(80rpx * var(--font-scale)); font-weight: 500; line-height: 1; color: var(--ink); }
.count { font-size: calc(56rpx * var(--font-scale)); color: var(--olive); }

.progress-card {
  margin: 0 44rpx;
  background: #FFFCF7;
  border: 3rpx solid var(--ink);
  padding: 24rpx;
}
.progress-text { font-family: var(--f-aleo); font-size: calc(26rpx * var(--font-scale)); }
.progress-text .strong { font-family: var(--f-bear); }
/* .progress-bar / .progress-fill removed with the markup: the line states
   policy and has no progress to show. */

.items { margin: 0; }
.row {
  display: flex;
  align-items: center;
  gap: 28rpx;
  padding: 28rpx 44rpx;
  border-top: 2rpx dashed rgba(0, 0, 0, 0.25);
}
.row:first-child { border-top: 3rpx solid var(--ink); margin-top: 24rpx; }
.thumb { width: 128rpx; height: 152rpx; background: var(--oat); border: 2rpx solid var(--ink); }
.thumb-empty { background: var(--oat); padding: 24rpx; box-sizing: border-box; opacity: 0.55; }
.info { flex: 1; min-width: 0; }
.name { font-size: calc(34rpx * var(--font-scale)); line-height: 1.05; }
.meta { font-size: calc(20rpx * var(--font-scale)); color: var(--olive); margin-top: 4rpx; }
/* Supplier-direct (drop-ship) tag — forest accent, reads as a delivery note. */
.supplier-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 6rpx;
  font-size: calc(19rpx * var(--font-scale));
  letter-spacing: 0.03em;
  color: var(--forest);
  background: rgba(28, 58, 38, 0.08);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}
.supplier-tag-glyph { font-weight: 700; }
/* Chosen options (e.g. dressing) — darker than the size meta so the pick reads
   as a real choice, not a spec. */
.opt-meta { font-size: calc(22rpx * var(--font-scale)); color: var(--ink); margin-top: 4rpx; line-height: 1.2; }
.qty { display: flex; align-items: center; gap: 20rpx; margin-top: 12rpx; }
.qty-btn {
  width: 48rpx; height: 48rpx;
  border: 2rpx solid var(--ink);
  font-family: var(--f-bear);
  font-size: calc(28rpx * var(--font-scale));
  display: flex; align-items: center; justify-content: center;
}
.qty-val {
  min-width: 52rpx;
  text-align: center;
  font-size: calc(26rpx * var(--font-scale));
}
.media { position: relative; flex-shrink: 0; }
.del {
  position: absolute;
  top: -20rpx;
  left: -20rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: var(--ink);
  color: var(--oat);
  font-size: calc(32rpx * var(--font-scale));
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}
.line-total { font-size: calc(44rpx * var(--font-scale)); }
.line-total.is-flash { color: #E96174; }
.line-total-stack {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 4rpx;
}
.line-was {
  font-size: calc(22rpx * var(--font-scale));
  color: rgba(0, 0, 0, 0.4);
  text-decoration: line-through;
}
.line-save {
  color: #5a8a2f;
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.04em;
}
.line-flash {
  background: #E96174;
  color: #fff;
  font-weight: 700;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.12em;
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
}

.checkout {
  position: fixed;
  /* Sit just above the custom tab bar — both share `position: fixed`, so
     stacking them with the tab bar's full height keeps the CTA tappable.
     Inline calc with env() — see app.wxss note on why we don't go through
     var(--tabbar-h) here. */
  bottom: calc(98rpx + env(safe-area-inset-bottom));
  left: 0; right: 0;
  background: var(--oat);
  border-top: 3rpx solid var(--ink);
  padding: 24rpx 44rpx 32rpx;
  z-index: 10;
}
.total-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
}
.total-label { font-size: calc(28rpx * var(--font-scale)); }
.total-amount { font-size: calc(60rpx * var(--font-scale)); }
/* "You saved" — green so the total discount reads as a win above the total. */
.saved-row { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 8rpx; }
.saved-label { font-size: calc(20rpx * var(--font-scale)); letter-spacing: 0.12em; color: #5a8a2f; }
.saved-amount { font-size: calc(30rpx * var(--font-scale)); color: #5a8a2f; font-weight: 700; }
.checkout-btn {
  margin-top: 20rpx;
  background: var(--ink);
  color: var(--lime);
  padding: 28rpx 0;
  font-size: calc(36rpx * var(--font-scale));
  letter-spacing: 0.1em;
  width: 100%;
}

/* ──── "Complete your profile" checkout gate ───────────────────────────
   Branded replacement for wx.showModal. Hard square ink border + oat card
   + lime CTA so it reads as part of the cart, not a system alert. */
.bind-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(26, 35, 20, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
}
.bind-card {
  width: 100%;
  max-width: 600rpx;
  background: #FFFCF7;
  border: 3rpx solid var(--ink);
  box-shadow: 12rpx 12rpx 0 var(--ink);
  padding: 48rpx 44rpx 40rpx;
  animation: bindPop 200ms cubic-bezier(.2,.9,.3,1.1);
}
@keyframes bindPop {
  from { opacity: 0; transform: translateY(16rpx) scale(0.96); }
  to   { opacity: 1; transform: translateY(0) scale(1); }
}
.bind-icon { font-size: 72rpx; line-height: 1; margin-bottom: 16rpx; }
.bind-kicker {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.18em;
  color: var(--olive);
  margin-bottom: 12rpx;
}
.bind-title {
  font-size: calc(56rpx * var(--font-scale));
  line-height: 1.05;
  color: var(--ink);
  margin-bottom: 18rpx;
}
.bind-body {
  font-size: calc(28rpx * var(--font-scale));
  line-height: 1.5;
  color: rgba(26, 35, 20, 0.82);
  margin-bottom: 40rpx;
}
.bind-actions { display: flex; gap: 16rpx; }
.bind-btn {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  font-size: calc(28rpx * var(--font-scale));
  letter-spacing: 0.08em;
  border: 3rpx solid var(--ink);
}
.bind-btn--secondary { background: transparent; color: var(--ink); }
.bind-btn--secondary:active { background: rgba(26, 35, 20, 0.06); }
.bind-btn--primary { background: var(--ink); color: var(--lime); }
.bind-btn--primary:active { background: #2a3a22; }

.empty { padding: 200rpx 44rpx 0; text-align: center; }
.empty-title { font-size: calc(44rpx * var(--font-scale)); font-weight: 500; margin-bottom: 32rpx; line-height: 1.3; }
.empty-btn {
  background: var(--ink); color: var(--oat);
  padding: 24rpx 44rpx;
  font-size: calc(26rpx * var(--font-scale));
  letter-spacing: 0.1em;
  border-radius: 999rpx;
  display: inline-block;
}

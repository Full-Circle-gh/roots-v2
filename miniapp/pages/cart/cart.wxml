<view class="page">
  <view class="header">
    <view class="kicker f-toni">{{copy.kicker}}</view>
    <view class="title-row">
      <view class="title f-bear">{{copy.title}}</view>
      <view class="count f-gothic">0{{items.length}}</view>
    </view>
  </view>

  <block wx:if="{{items.length}}">
    <!-- Free-shipping bar. Three states, set by the server (shipState):
         'zone'   — the area is named, so the promise is checkable by eye:
                    "天河区 · 再差 ¥14 即可免运费。" A customer shipping to
                    Shanghai can see the figure is for the wrong place.
         'policy' — no address resolved. States the store threshold as a
                    condition, never as an achievement, and shows no progress.
         'none'   — nothing to promise (zone has no free state, or nothing
                    fetched yet). The bar doesn't render at all. -->
    <view wx:if="{{shipState !== 'none'}}" class="progress-card">
      <view class="progress-text">
        <block wx:if="{{shipState === 'zone'}}">
          <text class="ship-zone">{{shipZoneName}} · </text>
          <text wx:if="{{!unlocked}}"><block wx:if="{{lang === 'cn'}}">再差 <text class="f-bear strong">¥{{remaining}}</text> 即可<text class="f-bear strong">免运费</text>。</block><block wx:else>You're <text class="f-bear strong">¥{{remaining}}</text> away from <text class="f-bear strong">free shipping.</text></block></text>
          <text wx:else><text class="f-bear strong">{{lang === 'cn' ? '已享免运费。' : 'Free shipping unlocked.'}}</text></text>
        </block>
        <block wx:else>
          <text class="f-bear strong">{{lang === 'cn' ? '满 ¥' + threshold + ' 包邮' : 'Free shipping ¥' + threshold + '+'}}</text>
        </block>
      </view>
      <view wx:if="{{shipState === 'zone'}}" class="progress-bar">
        <view class="progress-fill" style="width: {{pct}}%;"></view>
      </view>
    </view>

    <view class="items">
      <view wx:for="{{items}}" wx:key="key" class="row">
        <view class="media">
          <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="thumb"/>
          <image wx:else src="/assets/icons/product-placeholder.svg" mode="aspectFit" class="thumb thumb-empty"/>
          <view class="del" data-key="{{item.key}}" bindtap="removeItem">×</view>
        </view>
        <view class="info">
          <view class="name f-bear">{{item.display_name}}</view>
          <view wx:if="{{item.ship_from_supplier}}" class="supplier-tag f-toni">
            <text class="supplier-tag-glyph">↗</text>{{lang === 'cn' ? '供应商直发 · 单独送达' : 'Ships from supplier · separately'}}
          </view>
          <view wx:if="{{item.display_options}}" class="opt-meta f-toni">{{item.display_options}}</view>
          <view class="meta">{{item.display_size}}</view>
          <view class="qty">
            <view class="qty-btn" data-key="{{item.key}}" bindtap="decQty">−</view>
            <view class="qty-val f-gothic">{{item.qty}}</view>
            <view class="qty-btn" data-key="{{item.key}}" bindtap="incQty">+</view>
          </view>
        </view>
        <view class="line-total-stack">
          <view wx:if="{{item.is_flash}}" class="line-flash f-toni">{{lang === 'cn' ? '秒杀' : 'FLASH'}}</view>
          <view wx:if="{{item.regular_total}}" class="line-was f-aleo">¥{{item.regular_total}}</view>
          <view class="line-total f-bear {{item.is_flash ? 'is-flash' : ''}}">¥{{item.line_total}}</view>
          <view wx:if="{{item.save_text}}" class="line-save f-toni">{{item.save_text}}</view>
        </view>
      </view>
    </view>

    <view class="checkout">
      <view wx:if="{{savedTotal}}" class="saved-row">
        <view class="saved-label f-toni">{{lang === 'cn' ? '已省' : 'YOU SAVED'}}</view>
        <view class="saved-amount f-bear">−¥{{savedTotal}}</view>
      </view>
      <view class="total-row">
        <view class="f-bear total-label">{{lang === 'cn' ? '合计' : 'Total'}}</view>
        <view class="f-bear total-amount">¥{{subtotal}}</view>
      </view>
      <button class="checkout-btn f-toni" bindtap="goCheckout">{{copy.checkout}} →</button>
    </view>
  </block>

  <view wx:else class="empty">
    <view class="empty-title f-bear">{{copy.empty}}</view>
    <button class="empty-btn f-toni" bindtap="goShop">{{lang === 'cn' ? '去逛逛 →' : 'Browse the shop →'}}</button>
  </view>
  <!-- Branded "complete your profile" modal — replaces wx.showModal so the
       checkout-gate matches the cart's Bear/Toni type + oat/ink/lime palette. -->
  <view wx:if="{{showBindModal}}" class="bind-backdrop" bindtap="bindModalCancel">
    <view class="bind-card" catchtap="noop">
      <view class="bind-icon">🪪</view>
      <view class="bind-kicker f-toni">{{ lang === 'cn' ? '差一步' : 'ONE LAST STEP' }}</view>
      <view class="bind-title f-bear">{{ lang === 'cn' ? '先完善资料' : 'Complete your profile' }}</view>
      <view class="bind-body f-aleo">{{ lang === 'cn'
        ? '结账前请先绑定您的微信昵称与头像。'
        : 'Bind your WeChat nickname and avatar before checking out.' }}</view>
      <view class="bind-actions">
        <view class="bind-btn bind-btn--secondary f-toni" bindtap="bindModalCancel">{{ lang === 'cn' ? '取消' : 'Cancel' }}</view>
        <view class="bind-btn bind-btn--primary f-toni" bindtap="bindModalConfirm">{{ lang === 'cn' ? '去绑定 →' : 'Bind now →' }}</view>
      </view>
    </view>
  </view>

  <popup-manager page="cart"></popup-manager>
</view>

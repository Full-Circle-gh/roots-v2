<view class="page">
  <view wx:if="{{notFound}}" class="empty">
    <view class="empty-title f-bear">Order not found</view>
    <view class="empty-btn f-toni" bindtap="back">{{copy.back}}</view>
  </view>

  <view wx:elif="{{loading && !order}}" class="loading">
    <view class="skeleton" style="height:120rpx;margin:60rpx 44rpx"></view>
    <view class="skeleton" style="height:400rpx;margin:24rpx 44rpx"></view>
  </view>

  <block wx:elif="{{order}}">
    <view class="header">
      <view class="kicker f-toni">{{copy.title}} · {{order.order_no}}</view>
      <view class="title-row">
        <view class="title f-bear">{{statusLabel}}</view>
        <view class="status-pill status-{{order.status}}">{{statusLabel}}</view>
      </view>
    </view>

    <!-- Timeline -->
    <view class="section">
      <view class="section-label f-toni">{{copy.timelineLabel}}</view>
      <view class="timeline">
        <view wx:for="{{timeline}}" wx:key="key" class="step {{item.done ? 'done' : ''}} {{item.active ? 'active' : ''}}">
          <view class="marker"></view>
          <view class="step-body">
            <view class="step-label">{{item.label_display}}</view>
            <view wx:if="{{item.at_short}}" class="step-at muted">{{item.at_short}}</view>
          </view>
        </view>
      </view>
    </view>

    <!-- Late air shipment — a fresh/perishable parcel that arrived a day-plus
         late and may no longer be safe. Food-safety warning, shown above all
         other banners because it's the most urgent thing on the order. -->
    <view wx:if="{{airDelay}}" class="air-delay-banner">
      <view class="air-delay-icon">🚨</view>
      <view class="air-delay-body">
        <view class="air-delay-line f-bear">{{airDelay.line}}</view>
        <view class="air-delay-sub">{{airDelay.sub}}</view>
      </view>
    </view>

    <!-- Local (same-city) delivery ETA — Guangzhou orders have no waybill, so
         the store sets an estimated arrival time the customer can see here. -->
    <view wx:if="{{etaLabel}}" class="eta-banner">
      <view class="eta-icon">🛵</view>
      <view class="eta-body">
        <view class="eta-label">{{copy.etaLabel}}</view>
        <view class="eta-time f-bear">{{etaLabel}}</view>
      </view>
    </view>

    <!-- Live courier tracking (青云聚信 same-city e-bike) — status + a live map of
         the rider en route. Self-hides when no Qingyun delivery is linked. -->
    <view wx:if="{{deliveryTrack}}" class="section qy-track">
      <view class="section-label f-toni">{{deliveryTrack.mapLabel}}</view>
      <view class="qy-head">
        <view class="qy-stage f-bear">{{deliveryTrack.stageLabel}}</view>
        <view wx:if="{{deliveryTrack.carrier}}" class="qy-carrier">{{deliveryTrack.carrier}}</view>
      </view>
      <view wx:if="{{deliveryTrack.subLine}}" class="qy-sub muted">{{deliveryTrack.subLine}}</view>

      <map wx:if="{{deliveryTrack.hasMap}}" class="qy-map"
           longitude="{{deliveryTrack.center.lng}}" latitude="{{deliveryTrack.center.lat}}"
           scale="14" markers="{{deliveryTrack.markers}}" polyline="{{deliveryTrack.polyline}}"
           include-points="{{deliveryTrack.includePoints}}"
           show-location="{{false}}" enable-rotate="{{false}}" enable-overlooking="{{false}}"></map>

      <view wx:if="{{deliveryTrack.rider && deliveryTrack.rider.phone}}" class="qy-call" bindtap="callRider">
        {{deliveryTrack.callLabel}} →
      </view>
    </view>

    <!-- Partial shipment — some parcels are out, the rest still to follow.
         Shows regardless of whether the shipped parcel carries a waybill. -->
    <view wx:if="{{partialShip}}" class="partial-banner">
      <view class="partial-icon">📦</view>
      <view class="partial-body">
        <view class="partial-line f-bear">{{partialShip.line}}</view>
        <view class="partial-sub muted">{{partialShip.sub}}</view>
      </view>
    </view>

    <!-- Split-package tracking — one card per parcel so the customer sees
         every waybill, not just the primary shipment's. -->
    <view wx:if="{{shipments.length > 1}}" class="section tracking-section">
      <view class="section-label f-toni">{{copy.trackingLabel}}</view>
      <view wx:for="{{shipments}}" wx:key="shipment_id" wx:for-item="sh" class="trk-pkg">
        <view class="trk-pkg-head">
          <view class="trk-pkg-label f-bear">{{sh.label}}</view>
          <view wx:if="{{sh.state_label}}" class="trk-status-pill trk-state-{{sh.state}}">
            <view class="trk-status-dot"></view>
            <text>{{sh.state_label}}</text>
          </view>
        </view>
        <view wx:if="{{sh.items_str}}" class="trk-pkg-items muted">{{sh.items_str}}</view>
        <view wx:if="{{sh.is_supplier}}" class="trk-pkg-supplier f-toni">
          {{lang === 'cn' ? '此商品由供应商直接发货,可能与其他包裹分开送达。' : 'Ships directly from the supplier — may arrive separately from your other items.'}}
        </view>

        <!-- Waybill attached → carrier + live events. -->
        <block wx:if="{{sh.has_tracking}}">
          <view class="trk-head">
            <view class="trk-carrier">
              <view class="trk-carrier-name f-bear">{{sh.carrier_name}}</view>
              <view class="trk-number-row" bindtap="copyShipmentTracking" data-number="{{sh.number}}" hover-class="trk-number-row-tap">
                <view class="trk-number">{{sh.number}}</view>
                <image class="trk-copy-icon" src="/assets/icons/copy.svg" mode="aspectFit" aria-label="copy"></image>
              </view>
            </view>
          </view>
          <view wx:if="{{sh.latest_event}}" class="trk-events">
            <view class="trk-event latest">
              <view class="trk-event-dot"></view>
              <view class="trk-event-body">
                <view class="trk-event-line">{{sh.latest_event.description}}</view>
                <view class="trk-event-meta muted">
                  <text class="trk-event-time">{{sh.latest_event.time}}</text>
                  <text wx:if="{{sh.latest_event.location}}" class="trk-event-loc"> · {{sh.latest_event.location}}</text>
                </view>
              </view>
            </view>
            <view class="trk-toggle" bindtap="openShipmentLink" data-number="{{sh.number}}">{{copy.trackingViewLive}} →</view>
          </view>
          <view wx:elif="{{sh.synced_at}}" class="trk-empty muted">{{copy.trackingNoEvents}}</view>
          <view wx:else class="trk-empty muted">{{copy.trackingPending}}</view>
        </block>

        <!-- No waybill yet — show parcel status instead of a tracking block. -->
        <view wx:elif="{{sh.state === 'dispatched' || sh.state === 'delivered'}}" class="trk-empty muted">{{copy.trackingAwaitingNo}}</view>
        <view wx:elif="{{sh.is_supplier}}" class="trk-empty muted">{{lang === 'cn' ? '等待供应商提供物流单号' : 'Waiting for the supplier to provide tracking'}}</view>
        <view wx:else class="trk-empty muted">{{copy.trackingNotShipped}}</view>
      </view>
    </view>

    <!-- Shipment tracking — only shown once a waybill is attached -->
    <view wx:elif="{{tracking}}" class="section tracking-section">
      <view class="section-label f-toni">{{copy.trackingLabel}}</view>

      <!-- Scenario banner — appears once kd100 has classified the latest
           event. Pickup-point / locker show a big copyable code. No-contact
           shows red urgency. Others (in-person / door / proxy) show success
           styling. -->
      <view wx:if="{{tracking.scenario}}" class="trk-banner trk-banner-{{tracking.scenario.urgency}}" bindtap="onScenarioTap">
        <view class="trk-banner-icon">{{tracking.scenario.icon}}</view>
        <view class="trk-banner-body">
          <view class="trk-banner-title f-bear">{{lang === 'cn' ? tracking.scenario.label_cn : tracking.scenario.label_en}}</view>
          <view wx:if="{{tracking.scenario.location_label}}" class="trk-banner-sub">{{tracking.scenario.location_label}}</view>
          <view wx:if="{{tracking.scenario.signer}}" class="trk-banner-sub">{{lang === 'cn' ? '签收人:' : 'Signed by '}}{{tracking.scenario.signer}}</view>
          <view wx:if="{{tracking.scenario.pickup_code}}" class="trk-banner-code-wrap">
            <view class="trk-banner-code-label">{{lang === 'cn' ? '取件码 · 点击复制' : 'PICKUP CODE · TAP TO COPY'}}</view>
            <view class="trk-banner-code f-gothic">{{tracking.scenario.pickup_code}}</view>
          </view>
          <view wx:if="{{tracking.scenario.scenario === 'no_contact'}}" class="trk-banner-action">
            {{lang === 'cn' ? '请尽快回拨快递员电话 →' : 'Call the courier back ASAP →'}}
          </view>
        </view>
      </view>

      <view class="trk-head">
        <view class="trk-carrier">
          <view class="trk-carrier-name f-bear">{{lang === 'cn' ? tracking.carrier_name_cn : tracking.carrier_name_en}}</view>
          <view class="trk-number-row" bindtap="copyTracking" hover-class="trk-number-row-tap">
            <view class="trk-number">{{tracking.number}}</view>
            <image class="trk-copy-icon" src="/assets/icons/copy.svg" mode="aspectFit" aria-label="copy"></image>
          </view>
        </view>
        <view wx:if="{{tracking.status_label_en}}" class="trk-status-pill">
          <view class="trk-status-dot"></view>
          <text>{{lang === 'cn' ? tracking.status_label_cn : tracking.status_label_en}}</text>
        </view>
      </view>
      <!-- Collapsed by default: only the latest event renders. Tapping
           "Show all N events" expands the full list inline. -->
      <view wx:if="{{trackingEvents.length}}" class="trk-events {{trackingEventsExpanded ? 'expanded' : 'collapsed'}}">
        <view wx:for="{{trackingEvents}}" wx:key="idx" wx:for-item="ev" wx:for-index="idx" class="trk-event {{idx === 0 ? 'latest' : 'trk-event-extra'}}">
          <view class="trk-event-dot"></view>
          <view class="trk-event-body">
            <view class="trk-event-line">{{ev.description}}</view>
            <view class="trk-event-meta muted">
              <text class="trk-event-time">{{ev.time}}</text>
              <text wx:if="{{ev.location}}" class="trk-event-loc"> · {{ev.location}}</text>
            </view>
          </view>
        </view>
        <view wx:if="{{trackingEvents.length > 1}}" class="trk-toggle" bindtap="toggleTrackingEvents">
          {{trackingEventsExpanded
            ? (lang === 'cn' ? '收起 ↑' : 'Show less ↑')
            : (lang === 'cn' ? '显示全部 ' + trackingEvents.length + ' 条 ↓' : 'Show all ' + trackingEvents.length + ' events ↓')
          }}
        </view>
      </view>
      <view wx:elif="{{tracking.synced_at}}" class="trk-empty muted">{{copy.trackingNoEvents}}</view>
      <view wx:else class="trk-empty muted">{{copy.trackingPending}}</view>
    </view>

    <!-- Items -->
    <view class="section">
      <view class="section-label f-toni">{{copy.itemsLabel}}</view>
      <view wx:for="{{items}}" wx:key="id" class="item-row">
        <view class="item-thumb">
          <image wx:if="{{item.image}}" src="{{item.image}}" mode="aspectFill" class="thumb-img"/>
        </view>
        <view class="item-info">
          <view class="item-name f-bear">{{item.display_name}}<text wx:if="{{item.is_addon}}" class="item-addon-tag f-toni">{{lang === 'cn' ? '后加' : 'Added later'}}</text></view>
          <view wx:if="{{item.ship_from_supplier}}" class="item-supplier-tag f-toni">
            <text class="item-supplier-glyph">↗</text>{{lang === 'cn' ? '供应商直发 · 单独送达' : 'Ships from supplier · arrives separately'}}
          </view>
          <view wx:if="{{item.options_str}}" class="item-options muted">{{item.options_str}}</view>
          <view class="item-meta muted">×{{item.qty}}</view>
          <view wx:if="{{order.status === 'delivered' && item.product_id}}" class="review-link"
                data-product-id="{{item.product_id}}"
                data-name="{{item.display_name}}"
                data-image="{{item.image}}"
                data-qty="{{item.qty}}"
                bindtap="writeReview">
            {{lang === 'cn' ? '写评价 →' : 'Leave a review →'}}
          </view>
        </view>
        <view class="item-total f-bear">{{item.line_total_display}}</view>
      </view>
    </view>

    <!-- Money summary -->
    <view class="section">
      <view class="money-row">
        <view>{{copy.subtotalLabel}}</view>
        <view class="f-bear">{{subtotal}}</view>
      </view>
      <view class="money-row">
        <view>{{copy.shippingLabel}}</view>
        <view class="f-bear">{{shipping}}</view>
      </view>
      <view class="money-row total">
        <view class="f-bear">{{copy.totalLabel}}</view>
        <view class="f-bear">{{total}}</view>
      </view>
    </view>

    <!-- Pickup location — collect at store (pickup orders have no shipping address) -->
    <view wx:if="{{isPickup}}" class="section">
      <view class="section-label f-toni">{{copy.collectAtLabel}}</view>
      <view class="addr-name"><text class="f-bear">🏬 {{pickupStoreName}}</text></view>
      <view wx:if="{{pickupAddress}}" class="addr-full muted">{{pickupAddress}}</view>
      <view wx:if="{{pickupPhone}}" class="addr-full muted">{{pickupPhone}}</view>
      <view wx:if="{{pickupTime}}" class="addr-pickup-time">
        <text class="f-toni" style="opacity:0.6;">{{copy.pickupTimeLabel}} · </text>
        <text class="f-bear">{{pickupTime}}</text>
      </view>
      <view class="addr-name" style="margin-top:8rpx;"><text class="f-bear">{{order.recipient_name}}</text> · {{order.recipient_phone}}</view>
    </view>

    <!-- Shipping address -->
    <view wx:else class="section">
      <view class="section-label f-toni">{{copy.shipToLabel}}</view>
      <view class="addr-name"><text class="f-bear">{{order.recipient_name}}</text> · {{order.recipient_phone}}</view>
      <view class="addr-full muted">{{address}}</view>
    </view>

    <!-- Change delivery/pickup time (before departure) -->
    <view wx:if="{{canReschedule}}" class="cust-actions rsc-cta">
      <button class="btn ghost f-toni" bindtap="openReschedule">{{rescheduleKind === 'pickup' ? copy.rescheduleBtnPickup : copy.rescheduleBtnDelivery}}</button>
    </view>
    <view wx:elif="{{rescheduleHint}}" class="rsc-hint-row"><text class="muted">{{rescheduleHint}}</text></view>

    <!-- Payment -->
    <view class="section">
      <view class="section-label f-toni">{{copy.payLabel}}</view>
      <view class="pay-method">{{paymentLabel}}</view>
    </view>

    <!-- Customer note -->
    <view wx:if="{{order.customer_note}}" class="section">
      <view class="section-label f-toni">{{copy.noteLabel}}</view>
      <view class="note-body">{{order.customer_note}}</view>
    </view>

    <!-- Refund status banner — single block driven by computed refundView -->
    <view wx:if="{{refundView}}" class="refund-banner refund-{{refundView.theme}}">
      <view class="rb-line">{{refundView.label}}</view>
      <view wx:if="{{refundView.reason}}" class="rb-reason muted">{{refundView.reason}}</view>
      <view wx:if="{{refundView.review_note}}" class="rb-reason muted">{{refundView.review_note}}</view>
      <view wx:if="{{refundView.show_amounts}}" class="rb-amounts">
        <view wx:if="{{refundView.requested_disp}}" class="rb-amt">
          <text class="rb-amt-k">{{lang === 'cn' ? '申请' : 'Requested'}}</text>
          <text class="rb-amt-v">{{refundView.requested_disp}}</text>
        </view>
        <view wx:if="{{refundView.approved_disp}}" class="rb-amt">
          <text class="rb-amt-k">{{lang === 'cn' ? '已批准' : 'Approved'}}</text>
          <text class="rb-amt-v">{{refundView.approved_disp}}</text>
        </view>
        <view wx:if="{{refundView.paid_disp}}" class="rb-amt">
          <text class="rb-amt-k">{{lang === 'cn' ? '已退' : 'Paid back'}}</text>
          <text class="rb-amt-v">{{refundView.paid_disp}}</text>
        </view>
        <view wx:if="{{refundView.is_partial}}" class="rb-amt">
          <text class="rb-amt-k">{{lang === 'cn' ? '订单总额' : 'Order total'}}</text>
          <text class="rb-amt-v rb-amt-muted">{{refundView.total_disp}}</text>
        </view>
      </view>
      <view wx:if="{{refundView.payout_method}}" class="rb-reason muted">
        {{lang === 'cn' ? '退款方式' : 'Via'}}: {{refundView.payout_method}}
      </view>
      <button wx:if="{{refundView.can_withdraw}}" class="btn ghost f-toni rb-action" bindtap="withdrawRefund">
        {{copy.refundWithdraw}}
      </button>
    </view>

    <!-- Customer-actionable buttons depending on status -->
    <view wx:if="{{order.status === 'pending_payment'}}" class="cust-actions">
      <button class="btn primary f-toni" bindtap="payNow" disabled="{{paying}}">
        {{paying ? copy.paying : copy.payNowBtn}}
      </button>
      <button class="btn danger f-toni" bindtap="cancelOrder" disabled="{{paying}}">{{copy.cancelBtn}}</button>
    </view>
    <view wx:elif="{{order.status === 'delivered'}}" class="cust-actions">
      <button class="btn primary f-toni" bindtap="reorder">{{copy.reorderBtn}} →</button>
      <button wx:if="{{!order.refund_status || order.refund_status === 'rejected' || order.refund_status === 'withdrawn'}}" class="btn ghost f-toni" bindtap="openRefundSheet">{{copy.refundBtn}}</button>
    </view>
    <view wx:elif="{{order.status === 'paid' || order.status === 'preparing' || order.status === 'dispatched'}}" class="cust-actions">
      <button wx:if="{{canAddItems}}" class="btn primary f-toni" bindtap="addToOrder">{{copy.addToOrderBtn}}</button>
      <button wx:if="{{!order.refund_status || order.refund_status === 'rejected' || order.refund_status === 'withdrawn'}}" class="btn ghost f-toni" bindtap="openRefundSheet">{{copy.refundBtn}}</button>
    </view>

    <!-- Invoice (发票) — request post-purchase, or show its state. Paid orders only. -->
    <view wx:if="{{order.status !== 'pending_payment' && order.status !== 'cancelled'}}" class="cust-actions">
      <view wx:if="{{order.invoice_status === 'issued'}}" class="inv-state muted">{{copy.invoiceIssued}}</view>
      <view wx:elif="{{order.needs_invoice}}" class="inv-state muted">{{copy.invoiceProcessing}}</view>
      <button wx:else class="btn ghost f-toni" bindtap="openInvoiceSheet">{{copy.invoiceBtn}}</button>
    </view>
  </block>
  <cs-button variant="fab" placement="order"></cs-button>
</view>

<!-- ── Refund request bottom sheet ──────────────────────────────────── -->
<view wx:if="{{refundSheetOpen}}" class="rs-mask" bindtap="onRefundSheetMaskTap">
  <view class="rs-sheet" catchtap="noop">
    <view class="rs-handle"></view>
    <view class="rs-title f-toni">{{copy.refundTitle}}</view>

    <view class="rs-modes">
      <view class="rs-mode {{refundMode === 'full'   ? 'on' : ''}}" data-mode="full"   bindtap="onRefundModeTap">{{copy.refundModeFull}}</view>
      <view class="rs-mode {{refundMode === 'amount' ? 'on' : ''}}" data-mode="amount" bindtap="onRefundModeTap">{{copy.refundModeAmount}}</view>
      <view class="rs-mode {{refundMode === 'lines'  ? 'on' : ''}}" data-mode="lines"  bindtap="onRefundModeTap">{{copy.refundModeLines}}</view>
    </view>

    <view wx:if="{{refundMode === 'full' || refundMode === 'amount'}}" class="rs-field">
      <text class="rs-label">{{copy.refundAmountLabel}}</text>
      <view class="rs-input-wrap">
        <input class="rs-input" type="digit" value="{{refundAmount}}" bindinput="onRefundAmountInput" disabled="{{refundMode === 'full'}}"/>
      </view>
      <view class="rs-hint muted">{{lang === 'cn' ? '订单总额' : 'Order total'}}: ¥{{refundOrderTotalDisp}}</view>
    </view>

    <view wx:if="{{refundMode === 'lines'}}" class="rs-field">
      <text class="rs-label">{{copy.refundLinesLabel}}</text>
      <view class="rs-lines">
        <view wx:for="{{refundLines}}" wx:key="item_id" class="rs-line">
          <view class="rs-line-row">
            <view class="rs-chk {{item.picked ? 'on' : ''}}" data-idx="{{index}}" bindtap="onRefundLineToggle">
              <text wx:if="{{item.picked}}">✓</text>
            </view>
            <text class="rs-line-name">{{item.name}}</text>
            <text class="rs-line-unit muted">{{item.unit_disp}}</text>
          </view>
          <view wx:if="{{item.picked}}" class="rs-line-row rs-line-qtyrow">
            <text class="rs-line-qty-label muted">{{lang === 'cn' ? '数量' : 'Qty'}}</text>
            <input class="rs-qty" type="digit" value="{{item.refund_qty}}" data-idx="{{index}}" bindinput="onRefundLineQty"/>
            <text class="muted">/ {{item.max_qty}}</text>
            <text class="rs-line-amt">{{item.amount_disp}}</text>
          </view>
        </view>
      </view>
      <view class="rs-lines-total">
        <text class="muted">{{copy.refundLinesTotal}}</text>
        <text class="rs-lines-total-v">{{refundLinesTotalDisp}}</text>
      </view>
    </view>

    <view class="rs-field">
      <view class="rs-input-wrap rs-input-wrap-area">
        <textarea class="rs-textarea" placeholder="{{copy.refundReasonPlaceholder}}" value="{{refundReason}}" bindinput="onRefundReasonInput" maxlength="500"/>
      </view>
    </view>

    <view class="rs-actions">
      <button class="btn ghost f-toni" bindtap="closeRefundSheet" disabled="{{refundBusy}}">{{copy.refundCancelBtn}}</button>
      <button class="btn primary f-toni" bindtap="submitRefund" disabled="{{refundBusy}}">
        {{refundBusy ? (lang === 'cn' ? '提交中…' : 'Submitting…') : copy.refundSubmit}}
      </button>
    </view>
  </view>
</view>

<!-- ── Invoice (发票) request bottom sheet ──────────────────────────── -->
<view wx:if="{{invoiceSheetOpen}}" class="rs-mask" bindtap="onInvoiceSheetMaskTap">
  <view class="rs-sheet" catchtap="noop">
    <view class="rs-handle"></view>
    <view class="rs-title f-toni">{{copy.invoiceTitle}}</view>

    <view class="rs-modes">
      <view class="rs-mode {{invoiceType === 'personal' ? 'on' : ''}}" data-type="personal" bindtap="onInvTypeTap">{{copy.invPersonal}}</view>
      <view class="rs-mode {{invoiceType === 'company'  ? 'on' : ''}}" data-type="company"  bindtap="onInvTypeTap">{{copy.invCompany}}</view>
    </view>

    <view class="rs-field">
      <text class="rs-label">{{copy.invTitleLabel}}</text>
      <view class="rs-input-wrap">
        <input class="rs-input" value="{{invoiceTitle}}" placeholder="{{copy.invTitlePh}}" bindinput="onInvTitleInput"/>
      </view>
    </view>

    <view wx:if="{{invoiceType === 'company'}}" class="rs-field">
      <text class="rs-label">{{copy.invTaxLabel}}</text>
      <view class="rs-input-wrap">
        <input class="rs-input" value="{{invoiceTaxId}}" placeholder="{{copy.invTaxPh}}" bindinput="onInvTaxInput"/>
      </view>
    </view>

    <view class="rs-field">
      <text class="rs-label">{{copy.invEmailLabel}}</text>
      <view class="rs-input-wrap">
        <input class="rs-input" value="{{invoiceEmail}}" placeholder="{{copy.invEmailPh}}" bindinput="onInvEmailInput"/>
      </view>
    </view>

    <view class="rs-actions">
      <button class="btn ghost f-toni" bindtap="closeInvoiceSheet" disabled="{{invoiceBusy}}">{{copy.refundCancelBtn}}</button>
      <button class="btn primary f-toni" bindtap="submitInvoice" disabled="{{invoiceBusy}}">
        {{invoiceBusy ? (lang === 'cn' ? '提交中…' : 'Submitting…') : copy.invoiceSubmit}}
      </button>
    </view>
  </view>
</view>

<!-- ── Reschedule (change delivery/pickup time) bottom sheet ─────────── -->
<view wx:if="{{rscSheetOpen}}" class="rs-mask" bindtap="onRescheduleMaskTap">
  <view class="rs-sheet" catchtap="noop">
    <view class="rs-handle"></view>
    <view class="rs-title f-toni">{{rescheduleKind === 'pickup' ? copy.rescheduleTitlePickup : copy.rescheduleTitleDelivery}}</view>

    <view wx:if="{{rscLoading}}" class="rsc-loading muted">…</view>

    <block wx:else>
      <view wx:if="{{rscCurrentLabel}}" class="rsc-current muted">{{copy.rescheduleCurrent}}: {{rscCurrentLabel}}</view>

      <!-- Delivery: soonest chips + a schedule-for-later calendar -->
      <block wx:if="{{rescheduleKind !== 'pickup'}}">
        <view wx:if="{{rscSlots.length}}" class="rsc-slots">
          <view wx:for="{{rscSlots}}" wx:key="slot_id"
                class="rsc-slot {{item.sel ? 'on' : ''}}"
                data-id="{{item.slot_id}}" bindtap="pickRscSlot">{{item.label}}{{item.surcharge_disp}}</view>
        </view>
        <view wx:if="{{rscSchedule}}" class="rs-field">
          <text class="rs-label">{{copy.reschedulePickDate}}</text>
          <picker mode="date" value="{{rscDate}}" start="{{rscSchedule.min_date}}" end="{{rscSchedule.max_date}}" bindchange="onRscDateChange">
            <view class="rsc-picker-val">{{rscDate || (lang === 'cn' ? '选择日期' : 'Select a date')}}</view>
          </picker>
        </view>
        <view wx:if="{{!rscSlots.length && !rscSchedule}}" class="rsc-empty muted">{{copy.rescheduleNoSlots}}</view>
      </block>

      <!-- Pickup: a date + a time within the pickup window -->
      <block wx:else>
        <view class="rs-field">
          <text class="rs-label">{{copy.reschedulePickupDate}}</text>
          <picker mode="date" value="{{rscPickupDate}}" bindchange="onRscPickupDateChange">
            <view class="rsc-picker-val">{{rscPickupDate || (lang === 'cn' ? '选择日期' : 'Select a date')}}</view>
          </picker>
        </view>
        <view class="rs-field">
          <text class="rs-label">{{copy.reschedulePickupTimeOfDay}} ({{rscPickupWindow.open}}–{{rscPickupWindow.close}})</text>
          <picker mode="time" value="{{rscPickupTime}}" start="{{rscPickupWindow.open}}" end="{{rscPickupWindow.close}}" bindchange="onRscPickupTimeChange">
            <view class="rsc-picker-val">{{rscPickupTime || (lang === 'cn' ? '选择时间' : 'Select a time')}}</view>
          </picker>
        </view>
      </block>

      <view wx:if="{{rscErr}}" class="rsc-err">{{rscErr}}</view>
      <view class="rs-actions">
        <button class="btn ghost f-toni" bindtap="closeRescheduleSheet" disabled="{{rscBusy}}">{{copy.refundCancelBtn}}</button>
        <button class="btn primary f-toni" bindtap="confirmReschedule" disabled="{{rscBusy}}">
          {{rscBusy ? copy.paying : copy.rescheduleConfirm}}
        </button>
      </view>
    </block>
  </view>
</view>

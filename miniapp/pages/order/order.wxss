/* env(safe-area-inset-bottom) is the iPhone home-indicator height. The
   Pay/Cancel actions are the last elements in normal flow, so without this
   the bottom button sits under the gesture strip — on iOS 16+ the OS clips it
   and eats taps, which is why "Cancel order" couldn't be tapped. max() keeps
   the brand spacing on Androids that have no indicator. */
.page { background: var(--oat); min-height: 100vh; padding-bottom: max(80rpx, calc(40rpx + env(safe-area-inset-bottom))); }

.header { padding: 60rpx 44rpx 24rpx; }
.kicker {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.16em;
  color: var(--olive);
  font-family: monospace;
}
.title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.title {
  font-size: calc(64rpx * var(--font-scale));
  font-weight: 500;
  line-height: 1;
  color: var(--ink);
}

.status-pill {
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: calc(22rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.04em;
  border: 2rpx solid;
  font-family: var(--f-toni);
}
.status-pending_payment { background: rgba(255,175,96,0.18); color: #c66800; border-color: rgba(255,175,96,0.4); }
.status-paid            { background: rgba(178,207,237,0.2);  color: #2456a3; border-color: rgba(178,207,237,0.5); }
.status-preparing       { background: rgba(242,202,108,0.2);  color: #7f5800; border-color: rgba(242,202,108,0.5); }
.status-dispatched      { background: rgba(123,189,59,0.18);  color: #3a6817; border-color: rgba(123,189,59,0.4); }
.status-delivered       { background: rgba(54,83,41,0.92);    color: #fff;    border-color: var(--forest); }
.status-cancelled       { background: rgba(0,0,0,0.06);       color: var(--olive); border-color: rgba(0,0,0,0.18); }
.status-refunded        { background: rgba(233,97,116,0.18);  color: #9c1f33; border-color: rgba(233,97,116,0.4); }

.section {
  padding: 32rpx 44rpx;
  border-top: 3rpx solid var(--ink);
}
.section-label {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.16em;
  color: var(--olive);
  margin-bottom: 20rpx;
}

/* Timeline */
.timeline {
  position: relative;
  padding-left: 16rpx;
}
.timeline::before {
  content: '';
  position: absolute;
  /* Anchor the line to the marker centerline (12rpx from .step top after
     the alignment tweak below). Start halfway down the first marker so
     the line emerges from the dot center, end at the last marker. */
  top: 24rpx; bottom: 36rpx;
  left: 24rpx;
  width: 3rpx;
  background: rgba(0,0,0,0.12);
}
.step {
  position: relative;
  padding-left: 44rpx;
  padding-bottom: 36rpx;
  min-height: 60rpx;
}
.step:last-child { padding-bottom: 0; }
/* Marker is vertically centered on the first text line of the label.
   Label is Bear font (display-weight) at ~30rpx with line-height: 1.05
   (set below), so the visual center sits at ~16rpx from the top of the
   step. Marker is 32rpx tall, so top = 16 − 16 = 0rpx for a true center. */
.marker {
  position: absolute;
  left: 8rpx;
  top: 0;
  width: 32rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: var(--oat);
  border: 3rpx solid rgba(0,0,0,0.25);
}
.step.done .marker {
  background: var(--olive);
  border-color: var(--olive);
  opacity: 0.55;
}
.step.active .marker {
  background: var(--lime);
  border-color: var(--lime);
  opacity: 1;
  box-shadow: 0 0 0 6rpx rgba(204,217,0,0.25);
}
.step-label {
  font-size: calc(30rpx * var(--font-scale));
  font-family: var(--f-bear);
  font-weight: 500;
  color: var(--ink);
  line-height: 1.05;
}
.step.done:not(.active) .step-label { color: var(--olive); opacity: 0.7; }
.step-at {
  font-size: calc(20rpx * var(--font-scale));
  margin-top: 6rpx;
  font-family: monospace;
  line-height: 1.2;
}

/* Items */
.item-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 16rpx 0;
}
.item-row + .item-row { border-top: 2rpx dashed rgba(0,0,0,0.1); }
.item-thumb {
  width: 96rpx;
  height: 120rpx;
  background: var(--oat);
  border: 2rpx solid var(--ink);
  overflow: hidden;
  flex-shrink: 0;
}
.thumb-img { width: 100%; height: 100%; }
.item-info { flex: 1; min-width: 0; }
.item-name { font-size: calc(28rpx * var(--font-scale)); line-height: 1.2; }
/* "Added later" chip — items the customer appended via Add-to-order. */
.item-addon-tag {
  display: inline-block;
  margin-left: 12rpx;
  vertical-align: middle;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.04em;
  color: var(--olive);
  background: rgba(106, 110, 45, 0.12);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}
/* Supplier-direct (drop-ship) tag — its own line under the name, forest accent
   so it reads as a delivery note rather than a warning. */
.item-supplier-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 6rpx;
  font-size: calc(19rpx * var(--font-scale));
  letter-spacing: 0.03em;
  color: var(--forest);
  background: rgba(28, 58, 38, 0.08);
  border-radius: 999rpx;
  padding: 3rpx 14rpx;
}
.item-supplier-glyph { font-weight: 700; }
.item-options { font-size: calc(20rpx * var(--font-scale)); margin-top: 4rpx; }
.item-meta { font-size: calc(22rpx * var(--font-scale)); margin-top: 4rpx; }
.review-link {
  font-family: var(--f-toni);
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.08em;
  color: var(--forest);
  text-decoration: underline;
  margin-top: 8rpx;
}
.item-total { font-size: calc(32rpx * var(--font-scale)); }

/* Money */
.money-row {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: calc(26rpx * var(--font-scale));
}
.money-row.total {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid var(--ink);
  font-size: calc(36rpx * var(--font-scale));
}

/* Address + payment */
.addr-name { font-size: calc(28rpx * var(--font-scale)); }
.addr-full { font-size: calc(24rpx * var(--font-scale)); margin-top: 6rpx; line-height: 1.4; }
.pay-method {
  font-family: var(--f-toni);
  font-size: calc(28rpx * var(--font-scale));
  letter-spacing: 0.08em;
}

.note-body {
  font-size: calc(26rpx * var(--font-scale));
  background: #FFFCF7;
  padding: 16rpx 20rpx;
  border: 2rpx solid rgba(0,0,0,0.1);
  line-height: 1.4;
}

/* Loading / empty */
.empty {
  padding: 200rpx 44rpx 0;
  text-align: center;
}
.empty-title { font-size: calc(56rpx * var(--font-scale)); font-weight: 500; margin-bottom: 32rpx; }
.empty-btn {
  display: inline-block;
  background: var(--ink); color: var(--oat);
  padding: 20rpx 36rpx;
  font-size: calc(24rpx * var(--font-scale));
  letter-spacing: 0.1em;
  border-radius: 999rpx;
}

.muted { color: var(--olive); }

/* Customer-side action buttons (Pay now / Cancel) */
.cust-actions {
  padding: 16rpx 44rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
/* Trim the doubled gap where two action blocks stack (refund + invoice). */
.cust-actions + .cust-actions { padding-top: 0; }
.cust-actions .btn {
  /* WeChat <button> defaults to ~568rpx wide instead of stretching to the
     flex column's cross-axis, so without an explicit width the bar is
     narrower than the container and the letter-spaced "REQUEST INVOICE"
     text looks like it's being cropped against the borders. */
  width: 100%;
  padding: 20rpx 20rpx;
  font-size: calc(28rpx * var(--font-scale));
  letter-spacing: 0.12em;
  text-align: center;
  border-radius: 0;
}
.cust-actions .btn.primary {
  background: var(--ink);
  color: var(--lime);
}
.cust-actions .btn.primary[hover-class] { opacity: 0.95; }
.cust-actions .btn.danger {
  background: transparent;
  color: var(--berry);
  border: 3rpx solid var(--berry);
}
.cust-actions .btn[disabled] { opacity: 0.5; }
.cust-actions .btn.ghost {
  background: transparent;
  color: var(--olive);
  border: 3rpx solid rgba(0, 0, 0, 0.15);
}

/* Refund banners */
/* Partial-shipment notice — "X of Y items shipped, rest to follow" */
.partial-banner {
  margin: 32rpx 44rpx 0;
  padding: 22rpx 26rpx;
  border-radius: 4rpx;
  border-left: 8rpx solid var(--corn);
  background: rgba(242, 202, 108, 0.18);
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
}
.partial-banner .partial-icon {
  font-size: calc(34rpx * var(--font-scale));
  line-height: 1.2;
}
.partial-banner .partial-body { flex: 1; min-width: 0; }
.partial-banner .partial-line {
  font-size: calc(28rpx * var(--font-scale));
  color: var(--ink);
}
.partial-banner .partial-sub {
  font-size: calc(22rpx * var(--font-scale));
  margin-top: 4rpx;
  line-height: 1.4;
}

/* Local (same-city) delivery arrival time. Green accent = "on its way",
   distinct from the amber partial-shipment banner above. */
.eta-banner {
  margin: 32rpx 44rpx 0;
  padding: 22rpx 26rpx;
  border-radius: 4rpx;
  border-left: 8rpx solid var(--forest);
  background: rgba(54, 83, 41, 0.10);
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.eta-banner .eta-icon {
  font-size: calc(40rpx * var(--font-scale));
  line-height: 1.2;
}
.eta-banner .eta-body { flex: 1; min-width: 0; }
.eta-banner .eta-label {
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--olive);
}
.eta-banner .eta-time {
  font-size: calc(36rpx * var(--font-scale));
  color: var(--forest);
  margin-top: 2rpx;
}

.refund-banner {
  margin: 32rpx 44rpx 0;
  padding: 24rpx 28rpx;
  border-radius: 4rpx;
  border-left: 8rpx solid;
}
.refund-banner .rb-line {
  font-size: calc(26rpx * var(--font-scale));
  font-weight: 500;
}
.refund-banner .rb-reason {
  font-size: calc(22rpx * var(--font-scale));
  margin-top: 8rpx;
  line-height: 1.4;
}
.refund-pending {
  background: rgba(242, 202, 108, 0.18);
  border-color: var(--corn);
  color: var(--ink);
}
.refund-rejected {
  background: rgba(233, 97, 116, 0.12);
  border-color: var(--berry);
  color: var(--ink);
}
.refund-approved {
  background: rgba(123, 189, 59, 0.15);
  border-color: var(--pea);
  color: var(--ink);
}
.refund-banner .rb-amounts {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 28rpx;
}
.refund-banner .rb-amt {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
}
.refund-banner .rb-amt-k {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--olive);
  font-family: monospace;
}
.refund-banner .rb-amt-v {
  font-size: calc(26rpx * var(--font-scale));
  font-weight: 700;
  color: var(--ink);
}
.refund-banner .rb-amt-muted { color: var(--olive); font-weight: 500; }
.refund-banner .rb-action {
  margin-top: 18rpx;
  align-self: flex-start;
}

/* Refund request sheet */
.rs-mask {
  position: fixed; inset: 0;
  background: rgba(0,0,0,.4);
  z-index: 999;
  display: flex; align-items: flex-end; justify-content: center;
}
.rs-sheet {
  width: 100%;
  background: var(--oat);
  border-radius: 32rpx 32rpx 0 0;
  /* Bottom pad clears the home indicator so action buttons aren't
     cropped against the safe-area bar. Fixed reservation (not
     env(safe-area-inset-bottom) inside calc) because WeChat WXSS
     silently resolves env() to 0 in padding contexts — see app.wxss
     --tabbar-clear comment. 120rpx = ~48rpx visual + ~68rpx safe-area
     + a kiss of buffer; harmless on phones without a home indicator. */
  padding: 24rpx 36rpx 120rpx;
  max-height: 88vh;
  overflow-y: auto;
}
.rs-handle {
  width: 80rpx; height: 6rpx; border-radius: 3rpx;
  background: rgba(0,0,0,.15);
  margin: 4rpx auto 20rpx;
}
.rs-title {
  font-size: calc(36rpx * var(--font-scale));
  font-weight: 500;
  margin-bottom: 24rpx;
}
.rs-modes {
  display: flex; flex-wrap: wrap; gap: 12rpx;
  margin-bottom: 24rpx;
}
.rs-mode {
  flex: 1 1 0;
  min-width: 0;
  min-height: 96rpx;
  padding: 12rpx 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  line-height: 1.25;
  border: 3rpx solid rgba(0,0,0,.15);
  border-radius: 12rpx;
  font-size: calc(24rpx * var(--font-scale));
  color: var(--olive);
}
.rs-mode.on {
  background: var(--ink);
  color: var(--oat);
  border-color: var(--ink);
}
.rs-field { margin-bottom: 24rpx; }
.rs-label {
  display: block;
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--olive);
  margin-bottom: 10rpx;
  font-family: monospace;
}
/* The wrapper owns the visual border + horizontal padding. WeChat's
   native <input>/<textarea> ignore CSS padding for the text-render
   area, so without a wrapper the first character ("2" in 229.00 or
   "y" in a placeholder) hugs the border and looks clipped. With a
   bare input inside this view, the text renders inside the wrapper's
   32rpx side padding and breathes properly. */
.rs-input-wrap {
  width: 100%;
  padding: 16rpx 32rpx;
  border: 3rpx solid rgba(0,0,0,.15);
  border-radius: 12rpx;
  background: rgba(255,255,255,.4);
  box-sizing: border-box;
}
.rs-input-wrap-area { padding: 16rpx 32rpx; }
.rs-input, .rs-textarea {
  width: 100%;
  padding: 0;
  border: none;
  background: transparent;
  font-size: calc(28rpx * var(--font-scale));
  box-sizing: border-box;
}
/* Inline quantity field — small, sits in a row with other text, keeps
   its own visible box (no wrapper around it). */
.rs-qty {
  width: 140rpx;
  padding: 16rpx 20rpx;
  border: 3rpx solid rgba(0,0,0,.15);
  border-radius: 12rpx;
  background: rgba(255,255,255,.4);
  font-size: calc(28rpx * var(--font-scale));
  box-sizing: border-box;
}
.rs-textarea { min-height: 140rpx; }
.rs-hint {
  margin-top: 8rpx;
  font-size: calc(22rpx * var(--font-scale));
}
.rs-lines { display: flex; flex-direction: column; gap: 16rpx; }
.rs-line {
  padding: 16rpx 20rpx;
  background: rgba(255,255,255,.4);
  border-radius: 12rpx;
  border: 3rpx solid rgba(0,0,0,.08);
}
.rs-line-row {
  display: flex; align-items: center; gap: 16rpx;
}
.rs-line-qtyrow { margin-top: 12rpx; }
.rs-chk {
  width: 40rpx; height: 40rpx;
  border-radius: 6rpx;
  border: 3rpx solid rgba(0,0,0,.25);
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx;
}
.rs-chk.on {
  background: var(--ink);
  color: var(--oat);
  border-color: var(--ink);
}
.rs-line-name { flex: 1; font-size: calc(26rpx * var(--font-scale)); }
.rs-line-unit { font-size: calc(22rpx * var(--font-scale)); }
.rs-line-qty-label { font-size: calc(22rpx * var(--font-scale)); }
.rs-line-amt {
  margin-left: auto;
  font-weight: 700;
  color: var(--ink);
}
.rs-lines-total {
  display: flex; justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid rgba(0,0,0,.1);
}
.rs-lines-total-v {
  font-weight: 700;
  font-size: calc(28rpx * var(--font-scale));
}
.rs-actions {
  display: flex; gap: 16rpx;
  margin-top: 12rpx;
}
.rs-actions .btn { flex: 1; }

/* ─── Shipment tracking section ─────────────────────────────────── */
.tracking-section { }

/* Scenario banner — the headline above the regular carrier card. Tapping
   it copies the pickup code (if present). Urgency drives the background
   accent: urgent = red, action_needed = amber, info = green, transit = neutral. */
.trk-banner {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 24rpx 24rpx 26rpx;
  border-radius: 18rpx;
  margin-bottom: 24rpx;
  border: 3rpx solid;
}
.trk-banner-urgent {
  background: rgba(233, 97, 116, 0.12);
  border-color: var(--berry);
}
.trk-banner-action_needed {
  background: rgba(242, 202, 108, 0.22);
  border-color: var(--corn);
}
.trk-banner-info {
  background: rgba(123, 189, 59, 0.16);
  border-color: var(--pea);
}
.trk-banner-transit {
  background: rgba(178, 207, 237, 0.18);
  border-color: rgba(178, 207, 237, 0.55);
}
.trk-banner-icon {
  font-size: 44rpx;
  line-height: 1;
  margin-top: 4rpx;
  flex-shrink: 0;
}
.trk-banner-body { flex: 1; min-width: 0; }
.trk-banner-title {
  font-size: calc(34rpx * var(--font-scale));
  font-weight: 600;
  line-height: 1.1;
  color: var(--ink);
}
.trk-banner-sub {
  margin-top: 8rpx;
  font-size: calc(24rpx * var(--font-scale));
  line-height: 1.3;
  color: var(--ink);
  opacity: 0.7;
}
.trk-banner-code-wrap {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 12rpx;
}
.trk-banner-code-label {
  font-size: 18rpx;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--olive);
  font-family: monospace;
}
.trk-banner-code {
  margin-top: 6rpx;
  font-size: calc(44rpx * var(--font-scale));
  font-weight: 700;
  letter-spacing: 0.08em;
  color: var(--ink);
  font-family: monospace;
}
.trk-banner-action {
  margin-top: 14rpx;
  font-size: calc(22rpx * var(--font-scale));
  font-weight: 600;
  letter-spacing: 0.04em;
  color: var(--berry);
  font-family: var(--f-toni);
}
.trk-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  flex-wrap: wrap;
  margin-bottom: 20rpx;
}
.trk-carrier-name {
  font-size: calc(30rpx * var(--font-scale));
  font-weight: 600;
  color: var(--ink);
}
.trk-number-row {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 4rpx;
  padding: 2rpx 0;
  line-height: 1;
}
.trk-number-row-tap { opacity: 0.55; }
.trk-number {
  font-family: monospace;
  font-size: calc(24rpx * var(--font-scale));
  color: var(--olive);
  letter-spacing: 0.04em;
  line-height: 1;
  display: inline-block;
}
.trk-copy-icon {
  width: 26rpx;
  height: 26rpx;
  opacity: 0.7;
  flex-shrink: 0;
}
.trk-status-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(123, 189, 59, 0.18);
  border: 2rpx solid rgba(123, 189, 59, 0.45);
  font-size: calc(22rpx * var(--font-scale));
  font-weight: 600;
  color: #3a6817;
  font-family: var(--f-toni);
}
.trk-status-dot {
  width: 12rpx; height: 12rpx;
  border-radius: 999rpx;
  background: #3a6817;
}
/* Per-parcel state pill — pending reads muted (nothing shipped yet); shipped
   and delivered keep the green default. */
.trk-status-pill.trk-state-pending {
  background: rgba(122, 122, 110, 0.14);
  border-color: rgba(122, 122, 110, 0.35);
  color: var(--olive);
}
.trk-status-pill.trk-state-pending .trk-status-dot { background: var(--olive); }
.trk-events {
  position: relative;
  padding-left: 16rpx;
  margin-top: 16rpx;
}
.trk-events::before {
  content: '';
  position: absolute;
  /* Match centerline of dots — see .trk-event-dot below. */
  top: 18rpx; bottom: 26rpx;
  left: 22rpx;
  width: 2rpx;
  background: rgba(0,0,0,0.12);
}
.trk-event {
  position: relative;
  padding-left: 42rpx;
  padding-bottom: 26rpx;
  min-height: 44rpx;
}
.trk-event:last-child { padding-bottom: 0; }
/* Smooth expand/collapse of the full event history. Extras are always
   rendered so they can animate; the container's collapsed/expanded class
   drives max-height + opacity transitions instead of an instant DOM swap. */
.trk-event-extra {
  overflow: hidden;
  transition: max-height 0.5s ease, min-height 0.5s ease,
              opacity 0.45s ease, padding-bottom 0.5s ease;
}
.trk-events.collapsed .trk-event-extra {
  max-height: 0;
  min-height: 0;
  opacity: 0;
  padding-bottom: 0;
}
.trk-events.expanded .trk-event-extra {
  max-height: 240rpx;
  opacity: 1;
}
/* Dot vertically centered on the first line of .trk-event-line
   (26rpx font, line-height 1.3 → first-line center ≈ 17rpx).
   Dot is 22rpx tall, so top = 17 − 11 = 6rpx. */
.trk-event-dot {
  position: absolute;
  left: 12rpx;
  top: 6rpx;
  width: 22rpx; height: 22rpx;
  border-radius: 999rpx;
  background: var(--oat);
  border: 3rpx solid rgba(0,0,0,0.25);
}
.trk-event.latest .trk-event-dot {
  background: var(--forest);
  border-color: var(--forest);
}
.trk-event-line {
  font-size: calc(26rpx * var(--font-scale));
  line-height: 1.3;
  color: var(--ink);
}
.trk-event.latest .trk-event-line { font-weight: 600; }
.trk-event-meta {
  font-size: calc(20rpx * var(--font-scale));
  margin-top: 6rpx;
  line-height: 1.3;
}
.trk-empty {
  padding: 16rpx 0;
  font-size: calc(24rpx * var(--font-scale));
}
.trk-toggle {
  margin-top: 8rpx;
  padding: 16rpx 0 4rpx 42rpx;
  font-family: var(--f-toni);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.08em;
  color: var(--olive);
  text-transform: uppercase;
}

/* Split-package: each parcel is its own bordered card so the customer can
   tell the two waybills apart at a glance. */
.trk-pkg {
  padding: 24rpx 0;
  border-top: 2rpx solid rgba(0,0,0,0.08);
}
.trk-pkg:first-of-type { border-top: none; }
.trk-pkg-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 8rpx;
}
.trk-pkg-label {
  font-size: calc(26rpx * var(--font-scale));
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--olive);
}
.trk-pkg-items {
  font-size: calc(22rpx * var(--font-scale));
  line-height: 1.35;
  margin-bottom: 16rpx;
}
.trk-toggle:active { opacity: 0.5; }
.trk-link {
  margin-top: 20rpx;
  display: inline-block;
  font-family: var(--f-toni);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.08em;
  color: var(--berry);
  border-bottom: 2rpx solid var(--berry);
  padding-bottom: 2rpx;
}

<view class="page">

  <!-- Disabled-state notice — admin turned the program off. -->
  <view wx:if="{{!loading && enabled === false}}" class="disabled-card">
    <view class="kicker f-toni">{{copy.kicker}}</view>
    <view class="title f-bear">{{copy.disabledTitle}}</view>
    <view class="disabled-body f-aleo">{{copy.disabledBody}}</view>
  </view>

  <block wx:else>
    <!-- Header -->
    <view class="head">
      <view class="kicker f-toni">{{copy.kicker}}</view>
      <view class="title f-bear">
        {{copy.title1}}
        <view><text class="hl">{{copy.title2}}</text>.</view>
      </view>
      <view class="sub f-aleo">{{taglineResolved}}</view>
      <view class="fine f-aleo">{{copy.applyNote}}</view>
    </view>

    <!-- Stats strip -->
    <view class="stats">
      <view class="stat">
        <view class="stat-val f-bear">¥{{stats.earned}}</view>
        <view class="stat-lbl f-toni">{{copy.earned}}</view>
      </view>
      <view class="stat stat-mid">
        <view class="stat-val f-bear">{{stats.total_invites}}</view>
        <view class="stat-lbl f-toni">{{copy.invited}}</view>
      </view>
      <view class="stat">
        <view class="stat-val f-bear">{{stats.converted}}</view>
        <view class="stat-lbl f-toni">{{copy.joined}}</view>
      </view>
    </view>

    <!-- Referral code card -->
    <view class="code-card">
      <view class="code-lbl f-toni">{{copy.yourCode}}</view>
      <view class="code-row">
        <view class="code f-bear">{{code || '——'}}</view>
        <view class="code-copy f-gothic tap" bindtap="copyCode">{{copy.copy}}</view>
      </view>
      <view class="share-row">
        <button class="share share-wechat f-gothic tap" open-type="share">
          <text>{{copy.wechat}}</text>
        </button>
        <view class="share share-moments f-gothic tap" bindtap="shareTimeline">
          <text>{{copy.moments}}</text>
        </view>
        <view class="share share-more f-gothic tap" bindtap="showQr">⊞</view>
      </view>
    </view>

    <!-- How it works -->
    <view class="how">
      <view class="how-head f-toni">{{copy.how}}</view>
      <view class="how-row">
        <view class="how-cell">
          <view class="how-num f-gothic">01</view>
          <view class="how-t f-bear">{{copy.how1}}</view>
          <view class="how-sub f-aleo">{{copy.how1sub}}</view>
        </view>
        <view class="how-cell">
          <view class="how-num f-gothic">02</view>
          <view class="how-t f-bear">{{copy.how2}}</view>
          <view class="how-sub f-aleo">{{copy.how2sub}}</view>
        </view>
        <view class="how-cell">
          <view class="how-num f-gothic">03</view>
          <view class="how-t f-bear">{{copy.how3}}</view>
          <view class="how-sub f-aleo">{{how3subResolved}}</view>
        </view>
      </view>
    </view>

    <!-- Apply someone else's code (only if not yet referred + customer is brand-new) -->
    <view wx:if="{{canApply}}" class="apply">
      <view class="apply-head f-toni">{{copy.applyHead}}</view>
      <view class="apply-row">
        <input class="apply-input f-bear" placeholder="{{copy.applyPlaceholder}}"
               value="{{applyInput}}" bindinput="onApplyInput" maxlength="32"/>
        <view class="apply-btn f-gothic tap {{applyInput ? '' : 'disabled'}}" bindtap="applyCode">{{copy.apply}}</view>
      </view>
      <view class="apply-note f-aleo">{{copy.applyNote}}</view>
      <view wx:if="{{applyError}}" class="apply-err f-aleo">{{applyError}}</view>
    </view>
    <view wx:elif="{{referredBy}}" class="applied">
      <view class="applied-lbl f-toni">{{copy.referredByLabel}}</view>
      <view class="applied-val f-bear">{{referredBy.nickname || referredBy.code}}</view>
    </view>

    <!-- Your invites list -->
    <view class="invites-head">
      <view class="invites-title f-toni">{{copy.yourInvites}} · {{stats.total_invites}}</view>
    </view>

    <view wx:if="{{invites.length}}" class="invites">
      <view wx:for="{{invites}}" wx:key="id" class="inv-row {{index === 0 ? 'first' : ''}}">
        <view class="avatar">
          <image wx:if="{{item.avatar_url}}" src="{{item.avatar_url}}" mode="aspectFill"/>
          <text wx:else class="avatar-letter f-bear">{{item.initial}}</text>
        </view>
        <view class="inv-body">
          <view class="inv-name f-bear">{{item.nickname || (lang === 'cn' ? '微信好友' : 'WeChat friend')}}</view>
          <view class="inv-date f-toni">{{item.dateLabel}}</view>
        </view>
        <view class="inv-status status-{{item.status}} f-gothic">{{item.statusLabel}}</view>
      </view>
    </view>
    <view wx:else class="empty f-aleo">{{copy.empty}}</view>

  </block>

  <!-- QR modal -->
  <view wx:if="{{showQrModal}}" class="modal-backdrop" bindtap="closeQr">
    <view class="modal" catchtap>
      <view class="modal-kicker f-toni">{{copy.shareTitle}}</view>
      <view class="modal-title f-bear">{{shareBodyResolved}}</view>
      <view wx:if="{{qrImage}}" class="modal-qr-wrap">
        <image class="modal-qr" src="{{qrImage}}" mode="widthFix" show-menu-by-longpress="{{true}}"/>
        <view class="modal-qr-hint f-aleo">{{copy.qrHint}}</view>
      </view>
      <view wx:elif="{{qrLoading}}" class="modal-qr-state f-aleo">{{copy.qrLoadingLabel}}</view>
      <view wx:elif="{{qrErrorText}}" class="modal-qr-state f-aleo">{{qrErrorText}}</view>
      <view class="modal-code f-bear {{qrImage ? 'small' : ''}}">{{code}}</view>
      <view class="modal-actions">
        <view wx:if="{{qrImage}}" class="modal-btn f-gothic tap" bindtap="saveQr">{{copy.saveQr}}</view>
        <view class="modal-btn f-gothic tap" bindtap="copyCode">{{copy.copy}}</view>
        <view class="modal-btn f-gothic tap" bindtap="closeQr">{{copy.close}}</view>
      </view>
    </view>
  </view>

  <popup-manager page="affiliate"></popup-manager>
</view>

.page {
  background: var(--oat);
  min-height: 100vh;
  padding-bottom: 220rpx;
}

.header { padding: 80rpx 44rpx 24rpx; }
.header-row { display: flex; align-items: flex-end; justify-content: space-between; gap: 16rpx; }
.header-text { flex: 1; }
.kicker { font-size: calc(22rpx * var(--font-scale)); letter-spacing: 0.22em; color: var(--olive); }
.title { font-size: calc(80rpx * var(--font-scale)); font-weight: 500; line-height: 0.95; margin-top: 10rpx; color: var(--ink); }

/* Sections: hairline separators between, with a heavier ink rule on the first. */
.section {
  padding: 28rpx 44rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.18);
  background: var(--oat);
}
.section-first { border-top: 3rpx solid var(--ink); }
.section-label {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.2em;
  color: var(--olive);
  margin-bottom: 14rpx;
}
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}
.section-title {
  font-size: calc(36rpx * var(--font-scale));
  font-weight: 500;
  color: var(--ink);
  line-height: 1.1;
}
.head-action {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.16em;
  color: var(--olive);
  text-decoration: underline;
}

/* Order receipt */
.receipt { padding-top: 4rpx; }
.order-line {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 5rpx 0;
}
.line-lead {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.line-thumb {
  width: 72rpx;
  height: 72rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f0ede6;
}
.line-thumb--empty { border: 1rpx solid rgba(0, 0, 0, 0.08); }
.line-name {
  flex: 1;
  font-size: calc(26rpx * var(--font-scale));
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.line-meta { color: var(--olive); }
.line-total { font-size: calc(28rpx * var(--font-scale)); display: flex; flex-direction: column; align-items: flex-end; }
/* Flash-sale line: struck-through original price + a green "save ¥X" tag. */
.line-was { color: var(--olive); text-decoration: line-through; margin-right: 10rpx; font-size: calc(24rpx * var(--font-scale)); }
.line-save { color: #5a8a2f; font-size: calc(22rpx * var(--font-scale)); margin-top: 2rpx; }
.voucher-line {
  margin-top: 8rpx;
  padding-top: 10rpx;
  border-top: 1rpx dashed rgba(0, 0, 0, 0.3);
  color: var(--berry);
}
.voucher-line .line-name { color: var(--berry); }

/* Address block */
.addr-text { font-size: calc(26rpx * var(--font-scale)); line-height: 1.5; }
.addr-line { display: flex; align-items: baseline; justify-content: space-between; gap: 16rpx; }
.addr-line__main { min-width: 0; flex: 1; }
.addr-change { flex-shrink: 0; }
.addr-name { font-weight: 500; }
.addr-phone { color: var(--ink); }
.addr-full { color: var(--ink); opacity: 0.8; font-size: calc(24rpx * var(--font-scale)); margin-top: 2rpx; }
.store-map-link { display: inline-block; margin-top: 8rpx; color: var(--forest); font-size: calc(24rpx * var(--font-scale)); font-weight: 500; }
.addr-default {
  font-size: calc(16rpx * var(--font-scale));
  letter-spacing: 0.16em;
  color: var(--forest);
  margin-left: 8rpx;
}
.addr-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  padding: 14rpx 0;
}
.addr-row + .addr-row { border-top: 1rpx dashed rgba(0, 0, 0, 0.18); }
.addr-body { flex: 1; min-width: 0; }
.link-row {
  padding: 14rpx 0 4rpx;
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.14em;
  color: var(--olive);
  text-decoration: underline;
}

/* Delivery ⇄ Pickup toggle — two equal pills, sharp-edged to match the
   2rpx-border ink aesthetic used by the region picker / inputs. */
.fulfill-toggle {
  display: flex;
  border: 2rpx solid var(--ink);
  margin: 4rpx 0 18rpx;
}
.ft-opt {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: calc(26rpx * var(--font-scale));
  color: var(--ink);
  background: transparent;
}
.ft-opt + .ft-opt { border-left: 2rpx solid var(--ink); }
.ft-opt.on { background: var(--ink); color: #FFFCF7; }

/* Pickup store list reuses .addr-row; just spacing around the block. */
.pickup-stores { margin-top: 4rpx; }

/* Pickup time row — two side-by-side picker buttons (date | time). */
.pickup-hours-hint {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.12em;
  color: var(--olive);
  margin-bottom: 12rpx;
}
.pickup-time-row { display: flex; gap: 16rpx; }
.pickup-time-row picker { flex: 1; }
.pickup-pick {
  background: #FFFCF7;
  border: 2rpx solid var(--ink);
  padding: 0 22rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: calc(26rpx * var(--font-scale));
  color: var(--ink);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.pickup-pick.placeholder { color: rgba(26, 26, 23, 0.42); }

/* Soft hint under "Deliver to" — clarifies that the shown name/phone/addr
   came from the customer's WeChat profile and is editable in their book. */
.addr-hint {
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.14em;
  color: var(--olive);
  margin-bottom: 10rpx;
  text-transform: uppercase;
}

/* Bind-WeChat empty state — replaces the address form for unbound customers.
   Soft lime-tinted card with a single dark CTA. */
.bind-empty {
  background: rgba(204, 217, 0, 0.14);
  border: 2rpx solid var(--ink);
  padding: 32rpx 28rpx;
  margin-top: 6rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 12rpx;
}
.bind-empty__icon { font-size: 56rpx; line-height: 1; }
.bind-empty__title {
  font-size: calc(34rpx * var(--font-scale));
  line-height: 1.2;
  color: var(--ink);
}
.bind-empty__body {
  font-size: calc(24rpx * var(--font-scale));
  line-height: 1.5;
  color: var(--ink);
  opacity: 0.78;
}
.bind-empty__cta {
  margin-top: 8rpx;
  padding: 18rpx 28rpx;
  background: var(--ink);
  color: var(--lime);
  font-size: calc(24rpx * var(--font-scale));
  letter-spacing: 0.14em;
}

/* Sticky-bar BIND variant — full-width button (no total amount on its left). */
.place-btn--bind { letter-spacing: 0.12em; }

/* Form fields */
.field { margin-bottom: 12rpx; }
/* Region picker row — same visual frame as .input, but acts as a button that
   opens the native WeChat 3-column province/city/district wheel. Mirrors the
   addresses page so the inline new-address form can't free-type a region. */
.region-pick {
  background: #FFFCF7;
  border: 2rpx solid var(--ink);
  padding: 0 22rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: calc(26rpx * var(--font-scale));
  font-family: inherit;
  color: var(--ink);
  border-radius: 0;
  box-sizing: border-box;
  display: flex; align-items: center; justify-content: space-between;
}
.region-pick.placeholder { color: rgba(26, 26, 23, 0.42); }
.region-chevron {
  font-size: calc(32rpx * var(--font-scale));
  color: rgba(26, 26, 23, 0.5);
  margin-left: 16rpx;
  line-height: 1;
}
.input {
  background: #FFFCF7;
  border: 2rpx solid var(--ink);
  padding: 0 22rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: calc(26rpx * var(--font-scale));
  font-family: inherit;
  border-radius: 0;
  box-sizing: border-box;
}
.textarea {
  width: 100%;
  background: #FFFCF7;
  border: 2rpx solid var(--ink);
  padding: 18rpx 22rpx;
  font-size: calc(26rpx * var(--font-scale));
  font-family: inherit;
  border-radius: 0;
  min-height: 100rpx;
  box-sizing: border-box;
}

/* Fapiao (发票) form — shown under the invoice switch */
.invoice-form { margin-top: 12rpx; }
.invoice-type { display: flex; gap: 12rpx; }
.it-opt {
  flex: 1;
  text-align: center;
  background: #FFFCF7;
  border: 2rpx solid var(--ink);
  height: 72rpx;
  line-height: 72rpx;
  font-size: calc(26rpx * var(--font-scale));
  font-family: inherit;
  border-radius: 0;
  box-sizing: border-box;
}
.it-opt.on { background: var(--lime); font-weight: 700; }

/* Radio dot — used for delivery/payment/address rows. The row itself stays
   unstyled when selected; only the dot fills. Matches the design. */
.dot {
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  border: 3rpx solid var(--ink);
  flex-shrink: 0;
  position: relative;
  background: transparent;
}
.dot.on::after {
  content: '';
  position: absolute;
  inset: 6rpx;
  background: var(--ink);
  border-radius: 999rpx;
}

/* Delivery / payment rows — simple list, no boxed border. */
.opt-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 14rpx 0;
}
.opt-row.opt-disabled { opacity: 0.45; }
.opt-body { flex: 1; min-width: 0; }
.opt-label {
  font-size: calc(30rpx * var(--font-scale));
  line-height: 1.2;
}
.opt-sub {
  font-size: calc(22rpx * var(--font-scale));
  margin-top: 2rpx;
  line-height: 1.3;
}
.opt-price {
  font-size: calc(30rpx * var(--font-scale));
  letter-spacing: 0.04em;
}

/* Delivery slot picker */
.slot-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 14rpx 0;
}
.slot-row.disabled {
  opacity: 0.45;
  pointer-events: none;
}
.slot-row.disabled .dot {
  opacity: 0.6;
}
.holiday-banner {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx 18rpx;
  background: rgba(255, 200, 87, 0.22);
  border-left: 4rpx solid #c98a2a;
  border-radius: 6rpx;
  margin: 8rpx 0 16rpx;
}
.holiday-banner .hb-icon {
  font-size: 32rpx;
  line-height: 1;
  flex-shrink: 0;
  padding-top: 2rpx;
}
.holiday-banner .hb-body { flex: 1; min-width: 0; }
.holiday-banner .hb-title {
  font-size: calc(26rpx * var(--font-scale));
  color: var(--ink);
  margin-bottom: 4rpx;
}
.holiday-banner .hb-msg {
  font-size: calc(22rpx * var(--font-scale));
  line-height: 1.45;
  color: var(--text-2, #555);
}
.slot-banner {
  padding: 12rpx 16rpx;
  background: rgba(204, 217, 0, 0.18);
  border-left: 4rpx solid var(--ink);
  margin: 12rpx 0;
  font-size: calc(24rpx * var(--font-scale));
}
.slot-day { margin-top: 18rpx; }
.slot-day-label {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.18em;
  color: var(--olive);
  margin-bottom: 10rpx;
}
.slot-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.slot-chip {
  border: 2rpx solid var(--ink);
  padding: 12rpx 18rpx;
  font-size: calc(24rpx * var(--font-scale));
  background: transparent;
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 140rpx;
  align-items: center;
}
.slot-chip.on {
  background: var(--ink);
  color: var(--lime);
}
.slot-chip .chip-label { line-height: 1.2; }
.slot-chip .chip-surcharge {
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.14em;
  opacity: 0.85;
}
.slot-empty { padding: 14rpx 0; font-size: calc(24rpx * var(--font-scale)); }

/* Day-only mode option rows — three card-like radios stacked. */
.slot-option {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 24rpx;
  margin-top: 14rpx;
  border: 2rpx solid var(--ink);
  background: transparent;
}
.slot-option.on { background: rgba(54, 83, 41, 0.06); }
.slot-option .opt-body { flex: 1; min-width: 0; }
.slot-option .opt-label { font-size: calc(28rpx * var(--font-scale)); line-height: 1.25; }
.slot-option .opt-sub { font-size: calc(22rpx * var(--font-scale)); margin-top: 4rpx; line-height: 1.35; }
.opt-check {
  width: 36rpx; height: 36rpx;
  border: 3rpx solid var(--ink);
  border-radius: 999rpx;
  flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
}
.slot-option.on .opt-check { background: var(--lime); border-color: var(--ink); }
.opt-check-dot { width: 14rpx; height: 14rpx; border-radius: 999rpx; background: transparent; }
.slot-option.on .opt-check-dot { background: var(--ink); }

/* Payment colored swatch */
.pay-swatch {
  width: 44rpx;
  height: 44rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

/* "Use my points" toggle row — sits above the payment radios and stacks
   a discount onto whichever method the customer picks. Visually grouped
   with the section by a lime tint so it reads as a modifier, not a peer
   payment option. */
.points-toggle-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 18rpx;
  margin-bottom: 14rpx;
  background: rgba(204, 217, 0, 0.10);
  border: 2rpx solid rgba(26, 26, 23, 0.10);
  border-radius: 8rpx;
}
.points-toggle-row .pt-body { flex: 1; min-width: 0; }
.points-toggle-row .pt-label {
  font-size: calc(28rpx * var(--font-scale));
  line-height: 1.2;
  color: var(--ink);
}
.points-toggle-row .pt-sub {
  font-size: calc(22rpx * var(--font-scale));
  margin-top: 4rpx;
  line-height: 1.3;
}
.points-toggle-row .pt-emph {
  color: var(--forest);
  font-weight: 600;
}

/* Footnote shown under the radios when points cover the whole bill — tells
   the customer the picked radio isn't actually charged. */
.points-covers-hint {
  margin-top: 10rpx;
  padding: 10rpx 14rpx;
  font-size: calc(22rpx * var(--font-scale));
  background: rgba(54, 83, 41, 0.08);
  border-left: 4rpx solid var(--forest);
  color: var(--forest);
}

/* Add-ons */
.checkbox-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 0;
}
.checkbox-label {
  font-size: calc(26rpx * var(--font-scale));
  color: var(--ink);
}

/* Voucher */
.voucher-input-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}
.voucher-input-row .input {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
}
.apply-link {
  height: 80rpx;
  padding: 0 28rpx;
  background: var(--ink);
  color: var(--lime);
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.1em;
  display: flex;
  align-items: center;
  justify-content: center;
}
.voucher-applied {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: rgba(204, 217, 0, 0.18);
  border: 2rpx solid var(--lime);
  padding: 16rpx 20rpx;
}
.va-code { font-size: calc(30rpx * var(--font-scale)); letter-spacing: 0.06em; color: var(--ink); }
.va-desc { font-size: calc(22rpx * var(--font-scale)); margin-top: 2rpx; }
.va-remove { font-size: calc(20rpx * var(--font-scale)); letter-spacing: 0.1em; color: var(--berry); text-decoration: underline; }

.coupon-chips {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 18rpx;
}
.coupon-chip {
  background: #fff;
  border: 2rpx dashed rgba(0,0,0,0.2);
  padding: 18rpx 20rpx;
  position: relative;
}
.coupon-chip.mine { background: rgba(204, 217, 0, 0.12); border: 2rpx solid var(--forest); }
.cc-badge {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.12em;
  background: var(--forest);
  color: var(--lime);
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}
.coupon-chip:active { background: rgba(204, 217, 0, 0.12); }
.cc-title { font-size: calc(28rpx * var(--font-scale)); font-weight: 500; color: var(--ink); line-height: 1.3; }
.cc-sub { font-size: calc(20rpx * var(--font-scale)); letter-spacing: 0.06em; opacity: 0.55; margin-top: 4rpx; }
.cc-apply {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.08em;
  color: var(--forest);
}
.coupon-code-toggle {
  text-align: center;
  padding: 12rpx 0;
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.14em;
  color: var(--ink);
  opacity: 0.55;
}

/* Zone error */
.zone-error {
  padding: 24rpx 22rpx;
  background: rgba(232, 85, 106, 0.08);
  border: 1rpx solid rgba(232, 85, 106, 0.35);
}
.ze-title { font-size: calc(26rpx * var(--font-scale)); color: #c14b5f; line-height: 1.4; }
.ze-sub { font-size: calc(22rpx * var(--font-scale)); margin-top: 8rpx; line-height: 1.5; }

/* Fee breakdown */
.breakdown { padding-bottom: 30rpx; }
.bd-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 8rpx 0;
}
.bd-label { font-size: calc(26rpx * var(--font-scale)); color: var(--olive); }
.bd-val { font-size: calc(28rpx * var(--font-scale)); color: var(--ink); }
.bd-points .bd-val { color: #5a8a2f; }
/* "You saved" summary — green + emphasised so the total discount stands out. */
.bd-saved .bd-label, .bd-saved .bd-val { color: #5a8a2f; font-weight: 600; }

/* Sticky bottom footer */
.sticky-bar {
  position: fixed;
  bottom: 0; left: 0; right: 0;
  /* z-index higher than cs-fab (50) and any inline popup-trigger; lower
     than popup-manager's full-screen sheet (300) so modals still cover it.
     Without an explicit z-index the bar lives at the default stacking
     context and any sibling with z-index can paint over the button. */
  z-index: 100;
  background: var(--oat);
  border-top: 3rpx solid var(--ink);
  /* env(safe-area-inset-bottom) is the iPhone home-indicator height. Without
     it, the button sits under the gesture strip and on iOS 16+ the OS
     visually clips it to the point it looks "missing" on a cream background.
     Pad the bottom by max(32rpx, safe-area) so we keep the brand spacing on
     Androids without indicators. */
  padding: 24rpx 32rpx max(32rpx, env(safe-area-inset-bottom));
  display: flex;
  gap: 24rpx;
  align-items: center;
}
.total-block { display: flex; flex-direction: column; gap: 2rpx; }
.total-label { font-size: calc(18rpx * var(--font-scale)); letter-spacing: 0.18em; color: var(--olive); }
.total-amount { font-size: calc(52rpx * var(--font-scale)); line-height: 1; }
/* PLACE ORDER tap target — implemented as a <view>, not a <button>.
 *
 * History: it used to be a <button>, and WeChat's native <button> ships
 * with a stack of defaults (background-color: #f8f8f8, an ::after
 * pseudo-border, hardcoded :disabled styling, min-height/line-height
 * presets) that bled through our .place-btn rules and made the button
 * render as "invisible" on the cream sticky-bar. Switching to a <view>
 * sidesteps all of it — no native styling, no surprises after SDK
 * updates. Disabled state is now a class on the view + a guard in
 * placeOrder() so a tap can't fire while it's intentionally inert.
 */
.place-btn {
  flex: 1;
  /* Explicit display so a future wxss tweak (or app-level reset) can't
     collapse the view to inline. min-height guarantees visible size even
     if the localized text were ever empty. */
  display: block;
  min-height: 84rpx;
  box-sizing: border-box;
  background: var(--ink);
  color: var(--lime);
  padding: 28rpx 0;
  font-size: calc(28rpx * var(--font-scale));
  letter-spacing: 0.14em;
  text-align: center;
  border-radius: 0;
  line-height: 1.4;
}
.place-btn--disabled {
  opacity: 0.5;
  color: rgba(204, 217, 0, 0.6);
}
/* Tap feedback — view doesn't have native :active styling like button does,
   so add a subtle press dim so the customer knows their tap landed. */
.place-btn--pressed {
  opacity: 0.7;
}

/* Fallback-routing warning — soft amber card shown above the Place Order
   button when the nearest store is short of stock and a farther store
   will fulfill. The check tick appears once the customer has accepted
   the longer delivery via the modal. */
.fallback-warning {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 24rpx 32rpx;
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  background: #fff7e0;
  border: 2rpx solid #f0c060;
}
.fallback-warning__icon {
  font-size: 36rpx;
  line-height: 1;
}
.fallback-warning__body {
  flex: 1;
  min-width: 0;
}
.fallback-warning__title {
  font-size: 26rpx;
  font-weight: 700;
  color: #6b4a00;
  line-height: 1.3;
}
.fallback-warning__sub {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #7a5a1a;
  line-height: 1.35;
}
.fallback-warning__check {
  font-size: 32rpx;
  color: #2a8d3a;
  font-weight: 700;
  padding: 0 4rpx;
}

/* ────────────────────────────────────────────────────────────────────
   Fallback-confirmation modal — replaces wx.showModal so it matches
   the brand. Layout: dimmed backdrop, oat-coloured card with rounded
   corners, brand fonts (Bear for headline, Toni for kicker + CTAs),
   two-button row (Cancel ghost / Continue black-on-lime).
   ──────────────────────────────────────────────────────────────────── */
.fb-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(26, 35, 20, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 56rpx;
  animation: fbFade 180ms ease-out;
}
@keyframes fbFade {
  from { opacity: 0; }
  to   { opacity: 1; }
}
.fb-modal-card {
  width: 100%;
  max-width: 620rpx;
  background: #FFFCF7;             /* same oat as the checkout page */
  border-radius: 28rpx;
  padding: 56rpx 48rpx 40rpx;
  box-shadow: 0 24rpx 60rpx rgba(26, 35, 20, 0.35);
  animation: fbPop 200ms cubic-bezier(.2,.9,.3,1.1);
}
@keyframes fbPop {
  from { transform: translateY(20rpx) scale(.94); opacity: 0; }
  to   { transform: translateY(0) scale(1);     opacity: 1; }
}
.fb-modal-icon {
  font-size: 80rpx;
  line-height: 1;
  margin-bottom: 18rpx;
}
.fb-modal-kicker {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #6d7a2a;                  /* muted lime-ink */
  margin-bottom: 14rpx;
}
.fb-modal-title {
  font-size: 56rpx;
  line-height: 1.05;
  font-weight: 400;                /* Bear is a serif display, weight comes from the glyphs */
  color: #1a2314;                  /* ink */
  margin-bottom: 24rpx;
}
.fb-modal-body {
  font-size: 28rpx;
  line-height: 1.5;
  color: #2a3a22;
  margin-bottom: 40rpx;
}
.fb-modal-body-em {
  font-weight: 700;
  color: #1a2314;
}
/* Out-of-stock items list inside the simple-confirm modal — gives the
   customer the same "which item is short" clarity the 5-option modal
   already provides. */
.fb-modal-missing {
  margin: -20rpx 0 28rpx;
  padding: 20rpx 24rpx;
  background: rgba(243, 235, 220, .55);
  border-radius: 12rpx;
  border: 2rpx solid rgba(58, 90, 48, .12);
}
.fb-modal-missing__kicker {
  font-size: 22rpx;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #6a6e2d;
  margin-bottom: 12rpx;
}
.fb-modal-missing__row {
  display: flex; align-items: center; gap: 14rpx;
  font-size: 26rpx; color: #2a3a22;
  padding: 8rpx 0;
}
.fb-modal-missing__row + .fb-modal-missing__row { border-top: 1rpx solid rgba(0,0,0,.06); }
.fb-modal-missing__img {
  width: 56rpx; height: 56rpx; border-radius: 8rpx; overflow: hidden;
  background: rgba(0,0,0,.04); flex-shrink: 0;
}
.fb-modal-missing__img image { width: 100%; height: 100%; }
.fb-modal-missing__name { flex: 1; min-width: 0; }
.fb-modal-missing__qty { color: rgba(42, 58, 34, .55); font-size: 24rpx; margin-left: 4rpx; }
/* Numeric delta chips — surface the extra distance + time so the customer
   knows what "longer" actually means before they continue. Sits between
   the prose body and the action row. */
.fb-modal-delta {
  display: flex;
  gap: 14rpx;
  margin: -16rpx 0 32rpx;          /* tighter against the body text above */
  flex-wrap: wrap;
}
.fb-modal-delta__chip {
  display: inline-flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 14rpx 18rpx;
  background: rgba(26, 35, 20, 0.06);
  border-radius: 12rpx;
  flex: 1;
  min-width: 0;
}
.fb-modal-delta__icon {
  font-size: 24rpx;
  line-height: 1;
}
.fb-modal-delta__val {
  font-family: 'Toni Grotesk', -apple-system, sans-serif;
  font-size: 30rpx;
  font-weight: 700;
  color: #1a2314;
  letter-spacing: -0.01em;
}
.fb-modal-delta__lbl {
  font-size: 22rpx;
  color: #6d7a2a;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-weight: 700;
}

.fb-modal-actions {
  display: flex;
  gap: 14rpx;
}
.fb-modal-btn {
  flex: 1;
  text-align: center;
  padding: 26rpx 0;
  border-radius: 14rpx;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.fb-modal-btn--secondary {
  background: transparent;
  color: #2a3a22;
  border: 2rpx solid rgba(26, 35, 20, 0.2);
}
.fb-modal-btn--secondary:active {
  background: rgba(26, 35, 20, 0.04);
}
.fb-modal-btn--primary {
  background: #1a2314;             /* ink */
  color: #ccd900;                  /* lime — same as Place Order */
}
.fb-modal-btn--primary:active {
  background: #2a3a22;
}

/* ──── 5-option in-stock fallback modal ─────────────────────────────────
   Branded bottom-sheet style, sits over the whole checkout. Backdrop is
   tap-to-close (except inside the .fb-modal card itself). The substitute
   picker reuses .fb-modal at a taller height.
   Modifier-scoped — must NOT redefine the bare .fb-modal-backdrop
   because the simpler 2-button "Longer delivery" modal shares the same
   base class but wants centered (not bottom-sheet) positioning. */
.fb-modal-backdrop--sheet {
  background: rgba(20, 20, 18, 0.62);
  z-index: 9000;
  align-items: flex-end;
  padding: 0;
}
.fb-modal {
  width: 100%;
  max-width: 720rpx;
  background: var(--bg, #fffdf6);
  border-top-left-radius: 36rpx;
  border-top-right-radius: 36rpx;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -12rpx 32rpx rgba(0, 0, 0, 0.18);
  max-height: 86vh;
  overflow-y: auto;
}
.fb-modal--tall { display: flex; flex-direction: column; max-height: 86vh; }
.fb-modal__head { margin-bottom: 22rpx; }
.fb-modal__title {
  font-size: 38rpx;
  line-height: 1.2;
  color: var(--ink, #1a2a0c);
  margin-bottom: 8rpx;
}
.fb-modal__sub { font-size: 24rpx; line-height: 1.45; }
.fb-modal__missing {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  background: rgba(232, 122, 58, 0.08);
  border-left: 6rpx solid #e87a3a;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.fb-modal__missing-row { display: flex; align-items: center; gap: 14rpx; font-size: 24rpx; }
.fb-modal__missing-img {
  width: 56rpx; height: 56rpx;
  border-radius: 10rpx;
  overflow: hidden; flex-shrink: 0;
  background: #fff;
}
.fb-modal__missing-img image { width: 100%; height: 100%; }
.fb-modal__missing-name { flex: 1; min-width: 0; }
.fb-modal__missing-name .muted { font-size: 22rpx; margin-top: 2rpx; }

.fb-modal__opts { display: flex; flex-direction: column; gap: 18rpx; }
/* Each card is a <view>, not a <button> — no native button quirks to
   fight. Sizing was bumped 2026-05-20 after the office reported the
   cards "looked too small": padding ~22→32, label 28→34, sub 22→26,
   number 44→60, card gap 12→18, and a soft outer ring so they pop
   off the cream modal bg. */
.fb-opt {
  display: flex;
  align-items: flex-start;
  gap: 22rpx;
  padding: 32rpx 28rpx;
  border-radius: 22rpx;
  border: 3rpx solid transparent;
  background: #fff;
  width: 100%;
  box-sizing: border-box;
  /* Soft elevation so a row of mostly-white cards reads as distinct from
     the cream/oat modal background. Subtle — not Material Design-y. */
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.fb-opt--disabled { opacity: 0.55; }
/* Hover-class variants for tap feedback (replaces button :active). */
.fb-opt--pressed { background: #f7f4e8; transform: scale(0.99); }
.fb-opt--pressed-lime { background: rgba(204, 217, 0, 0.20); transform: scale(0.99); }
.fb-opt__num {
  flex-shrink: 0;
  width: 60rpx; height: 60rpx;
  border-radius: 50%;
  background: var(--gray, #f0eee4);
  color: var(--ink, #1a2a0c);
  font-weight: 800;
  font-size: 30rpx;
  display: flex; align-items: center; justify-content: center;
  margin-top: 2rpx;
}
.fb-opt__body { flex: 1; min-width: 0; }
.fb-opt__label {
  font-size: 34rpx;
  color: var(--ink, #1a2a0c);
  margin-bottom: 8rpx;
  line-height: 1.25;
}
.fb-opt__sub {
  font-size: 26rpx;
  color: var(--text-2, #6a6a5a);
  line-height: 1.5;
}
.fb-opt--neutral { border-color: var(--border, #e0ddc6); }
.fb-opt--lime {
  border-color: var(--lime, #ccd900);
  border-width: 4rpx;
  background: rgba(204, 217, 0, 0.10);
  box-shadow: 0 4rpx 14rpx rgba(204, 217, 0, 0.18);
}
.fb-opt--lime .fb-opt__num {
  background: var(--lime, #ccd900);
  color: var(--ink, #1a2a0c);
}
.fb-opt--ghost {
  background: transparent;
  border-color: var(--border, #e0ddc6);
  border-style: dashed;
  box-shadow: none;
}
.fb-opt--ghost .fb-opt__num {
  background: transparent;
  color: var(--text-2, #6a6a5a);
  font-size: 32rpx;
}

/* Substitute picker sub-screen */
/* Curated ⇄ Browse-all mode toggle — sits below the title, above the list.
   Right-aligned underlined link, low-key by design so it doesn't compete
   with the recommended substitutes the office curated. */
.fb-mode-toggle {
  display: flex; justify-content: flex-end;
  padding: 0 2rpx 12rpx;
}
.fb-mode-toggle__link {
  font-size: 22rpx;
  letter-spacing: 0.12em;
  color: var(--olive, #6A6E2D);
  text-decoration: underline;
  padding: 4rpx 0;
}
/* Search input for browse-all mode — matches the cream + ink-bordered
   look from the rest of the mini-app (cart, shop). */
.fb-search {
  display: flex; align-items: center; gap: 10rpx;
  padding: 12rpx 18rpx;
  background: #FFFCF7;
  border: 2rpx solid var(--ink, #1a2a0c);
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}
.fb-search__icon { font-size: 24rpx; opacity: 0.55; flex-shrink: 0; }
.fb-search__input { flex: 1; font-size: 26rpx; background: transparent; border: 0; font-family: inherit; }
.fb-search__clear {
  width: 40rpx; height: 40rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 30rpx; color: var(--olive, #6A6E2D); flex-shrink: 0;
}
.fb-subs__scroll { flex: 1; margin: 12rpx 0; }
.fb-subs__empty { padding: 60rpx 24rpx; text-align: center; font-size: 26rpx; }
.fb-sub {
  display: flex; align-items: center; gap: 16rpx;
  padding: 18rpx 16rpx;
  border: 2rpx solid var(--border, #e0ddc6);
  border-radius: 14rpx;
  margin-bottom: 10rpx;
  background: #fff;
}
.fb-sub:active { background: #f7f4e8; }
.fb-sub__img {
  width: 90rpx; height: 90rpx; flex-shrink: 0;
  background: var(--gray, #f0eee4);
  border-radius: 12rpx; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
}
.fb-sub__img image { width: 100%; height: 100%; }
.fb-sub__body { flex: 1; min-width: 0; }
.fb-sub__name { font-size: 26rpx; color: var(--ink, #1a2a0c); }
.fb-sub__sub { font-size: 22rpx; margin-top: 4rpx; }
.fb-sub__curated { font-size: 22rpx; margin-left: 4rpx; }
.fb-sub__price { font-size: 28rpx; color: var(--ink, #1a2a0c); white-space: nowrap; }
.fb-subs__footer { margin-top: 12rpx; }

<wxs src="../../utils/region.wxs" module="region" />
<view class="page">
  <view class="header">
    <view class="header-row">
      <view class="header-text">
        <view class="kicker f-toni">{{copy.kicker}} · 02/03</view>
        <view class="title f-bear">{{copy.title}}</view>
      </view>
    </view>
  </view>

  <cs-button variant="fab" placement="checkout"></cs-button>

  <!-- Order receipt -->
  <view class="section section-first">
    <view class="section-label f-toni">
      {{copy.orderSummary}} · {{itemCount}} {{lang === 'cn' ? '件' : 'ITEMS'}}
    </view>
    <view class="receipt">
      <view wx:for="{{items}}" wx:key="key" class="order-line">
        <view class="line-lead">
          <image wx:if="{{item.image}}" class="line-thumb" src="{{item.image}}" mode="aspectFill"/>
          <view wx:else class="line-thumb line-thumb--empty"></view>
          <view class="line-name">
            <text class="f-bear">{{item.display_name}}</text>
            <text class="line-meta"> ×{{item.qty}}</text>
            <view wx:if="{{item.display_options}}" class="line-opts f-toni">{{item.display_options}}</view>
            <view wx:if="{{item.ship_from_supplier}}" class="line-supplier f-toni">
              <text class="line-supplier-glyph">↗</text>{{lang === 'cn' ? '供应商直发 · 单独送达' : 'Ships from supplier · separately'}}
            </view>
          </view>
        </view>
        <view class="line-total f-bear">
          <view class="lt-now"><text wx:if="{{item.show_save}}" class="line-was">{{item.was_total}}</text>{{item.line_total}}</view>
          <text wx:if="{{item.show_save}}" class="line-save">{{item.save_text}}</text>
        </view>
      </view>
      <view wx:if="{{voucherCode}}" class="order-line voucher-line">
        <view class="line-name">{{voucherCode}}</view>
        <view class="line-total f-bear">{{voucherFreeShip ? (lang === 'cn' ? '免运费' : 'Free ship') : '−¥' + voucherDiscount}}</view>
      </view>
    </view>
  </view>

  <!-- Deliver to / Pick up at -->
  <view class="section" id="addr-section">
    <view class="section-head">
      <view class="section-title f-bear">{{fulfillment === 'pickup' ? copy.pickupAtTitle : copy.shipToTitle}}</view>
    </view>

    <!-- Delivery ⇄ Pickup toggle — only when at least one store offers pickup
         AND the store actually delivers. Delivery not set up → pickup only, no
         toggle (fulfillment is forced to pickup in onLoad). -->
    <view wx:if="{{isBound && pickupStores.length && deliveryEnabled}}" class="fulfill-toggle">
      <view class="ft-opt {{fulfillment === 'delivery' ? 'on' : ''}} f-bear" data-mode="delivery" bindtap="setFulfillment">
        🛵 {{copy.deliveryTab}}
      </view>
      <view class="ft-opt {{fulfillment === 'pickup' ? 'on' : ''}} f-bear" data-mode="pickup" bindtap="setFulfillment">
        🏬 {{copy.pickupTab}}
      </view>
    </view>

    <!-- Unbound: empty state with bind CTA. We never show the manual fill
         form to an unbound customer — checkout requires a WeChat-verified
         identity. Tapping the CTA opens /pages/profile; onShow resumes here. -->
    <block wx:if="{{!isBound}}">
      <view class="bind-empty">
        <view class="bind-empty__icon">🪪</view>
        <view class="bind-empty__title f-bear">{{copy.bindTitle}}</view>
        <view class="bind-empty__body">{{copy.bindBody}}</view>
        <view class="bind-empty__cta f-toni" bindtap="bindWechat">{{copy.bindCta}}</view>
      </view>
    </block>

    <block wx:else>
      <!-- ───── Delivery: address picker / inline form ───── -->
      <block wx:if="{{fulfillment !== 'pickup'}}">
      <!-- Soft hint clarifying where the displayed shipping info comes from. -->
      <view wx:if="{{address.id && !pickerOpen && !showNewForm}}" class="addr-hint f-toni">{{copy.shipFromHint}}</view>

      <!-- Collapsed (default): just show the selected address as plain text. -->
      <block wx:if="{{address.id && !pickerOpen && !showNewForm}}">
        <view class="addr-text addr-line">
          <view class="addr-line__main">
            <text class="f-bear addr-name">{{address.recipient_name}}</text>
            <text class="addr-phone"> · {{address.phone}}</text>
          </view>
          <view class="head-action f-toni addr-change" bindtap="openPicker">{{lang === 'cn' ? '更换' : 'CHANGE'}}</view>
        </view>
        <view class="addr-text addr-full">
          {{region.line(address, lang)}}
        </view>
      </block>

      <!-- Picker: list of saved addresses w/ inline radios, no card boxes. -->
      <block wx:if="{{pickerOpen && savedAddresses.length && !showNewForm}}">
        <view wx:for="{{savedAddresses}}" wx:key="id"
              class="addr-row" data-id="{{item.id}}" bindtap="selectSaved">
          <view class="dot {{address.id === item.id ? 'on' : ''}}"></view>
          <view class="addr-body">
            <view class="addr-text"><text class="f-bear">{{item.recipient_name}}</text> · {{item.phone}} <text wx:if="{{item.is_default}}" class="addr-default f-toni">{{lang === 'cn' ? '默认' : 'DEFAULT'}}</text></view>
            <view class="addr-text addr-full">{{region.line(item, lang)}}</view>
          </view>
        </view>
        <view class="link-row f-toni" bindtap="showAddNew">+ {{lang === 'cn' ? '使用新地址' : 'USE A NEW ADDRESS'}}</view>
      </block>

      <!-- Inline form: shown when no saved addresses OR user wants new. -->
      <block wx:if="{{showNewForm || (!savedAddresses.length && !address.id)}}">
        <view class="map-pick-wrap">
          <button class="map-pick-btn f-toni" bindtap="pickOnMap" disabled="{{mapPicking}}">
            {{mapPicking ? '...' : copy.mapPickBtn}}
          </button>
        </view>
        <view class="field">
          <input class="input" placeholder="{{copy.name}}" value="{{address.recipient_name}}" data-field="recipient_name" bindinput="onAddrField"/>
        </view>
        <view class="field">
          <input class="input" placeholder="{{copy.phone}}" type="number" value="{{address.phone}}" data-field="phone" bindinput="onAddrField"/>
        </view>
        <!-- Delivery-area selector. CN → WeChat native region picker (complete +
             current, Chinese). EN → bilingual city → district from our dataset
             so an English-mode user reads the options. Both write canonical
             Chinese province/city/district onto the address. -->
        <!-- Required-area label + scroll anchor. The picker placeholder alone
             read as optional (same weight as "Floor/unit (optional)" below), so
             customers typed a full address but skipped this — leaving the area
             blank, which made the store falsely look closed. -->
        <view id="area-field" class="area-label f-toni">{{copy.regionLabel}} <text class="area-req">*</text></view>
        <block wx:if="{{lang === 'cn'}}">
          <view class="field">
            <picker mode="region" value="{{regionValue}}" bindchange="onRegionChange">
              <view class="region-pick {{areaLabel ? '' : 'placeholder'}} {{areaError ? 'field-error' : ''}}">
                <text wx:if="{{areaLabel}}">{{areaLabel}}</text>
                <text wx:else>{{copy.regionPlaceholder}}</text>
                <text class="region-chevron">›</text>
              </view>
            </picker>
          </view>
        </block>
        <block wx:else>
          <view class="field">
            <picker mode="multiSelector" range="{{areaArray}}" value="{{areaIndex}}" bindcolumnchange="onAreaColumn" bindchange="onAreaConfirm">
              <view class="region-pick {{areaLabel ? '' : 'placeholder'}} {{areaError ? 'field-error' : ''}}">
                <text wx:if="{{areaLabel}}">{{areaLabel}}</text>
                <text wx:else>{{copy.regionPlaceholder}}</text>
                <text class="region-chevron">›</text>
              </view>
            </picker>
          </view>
        </block>
        <view class="field">
          <input class="input" placeholder="{{copy.addr}}" value="{{address.address}}" data-field="address" bindinput="onAddrField"/>
        </view>
        <view class="field">
          <input class="input" placeholder="{{copy.detailPlaceholder}}" value="{{address.detail}}" data-field="detail" bindinput="onAddrField"/>
        </view>
        <view wx:if="{{savedAddresses.length}}" class="link-row f-toni" bindtap="cancelNew">← {{lang === 'cn' ? '使用已保存地址' : 'PICK A SAVED ADDRESS'}}</view>
      </block>

      <!-- A rider is carrying this order, and the number on it probably can't
           take their call. Advisory only — the order goes through either way,
           which is what the last line promises. Sits under whichever address
           view is open (collapsed or the inline form), because both can hold
           the number this is about. -->
      <view wx:if="{{riderPhoneWarn}}" class="rider-phone-note">
        <view class="rpn-msg">{{lang === 'cn' ? '骑手需要一个能接听的内地手机号。如有请填写，否则我们会联系您安排配送。' : "A rider needs a mainland number they can call. Add one if you have it — otherwise we'll contact you to arrange delivery."}}</view>
        <view wx:if="{{!riderPhoneFixOpen}}" class="rpn-action f-toni" bindtap="openRiderPhoneFix">{{lang === 'cn' ? '填写手机号' : 'ADD A NUMBER'}}</view>
        <view wx:else class="rpn-fix">
          <input class="input rpn-input" type="number" placeholder="{{lang === 'cn' ? '内地手机号' : 'Mainland mobile number'}}"
                 value="{{riderPhoneDraft}}" bindinput="onRiderPhoneDraft"/>
          <view class="rpn-save f-toni {{riderPhoneSaving ? 'is-saving' : ''}}" bindtap="saveRiderPhone">{{riderPhoneSaving ? (lang === 'cn' ? '保存中' : 'SAVING') : (lang === 'cn' ? '保存' : 'SAVE')}}</view>
        </view>
      </view>
      </block><!-- /delivery address -->

      <!-- ───── Pickup: store picker + contact ───── -->
      <block wx:if="{{fulfillment === 'pickup'}}">
        <view class="pickup-stores">
          <view wx:for="{{pickupStores}}" wx:key="id"
                class="addr-row" data-id="{{item.id}}" bindtap="selectPickupStore">
            <view class="dot {{pickupStoreId === item.id ? 'on' : ''}}"></view>
            <view class="addr-body">
              <view class="addr-text store-name-row">
                <text class="f-bear store-name">{{lang === 'cn' ? (item.name_cn || item.name_en) : (item.name_en || item.name_cn)}}</text>
                <text wx:if="{{item.lat && item.lng}}" class="store-map-link" catchtap="openStoreMap" data-id="{{item.id}}">📍 {{copy.viewOnMap}}</text>
              </view>
              <view class="addr-text addr-full">{{item.city}}{{item.district ? ' · ' + item.district : ''}}{{item.address ? ' · ' + item.address : ''}}</view>
            </view>
          </view>
        </view>
        <view class="field" style="margin-top: 16rpx">
          <input class="input" placeholder="{{copy.pickupContactName}}" value="{{pickupName}}" bindinput="onPickupName"/>
        </view>
        <view class="field">
          <input class="input" placeholder="{{copy.pickupContactPhone}}" type="number" value="{{pickupPhone}}" bindinput="onPickupPhone"/>
        </view>
      </block>
    </block>
  </view>

  <!-- All sections below depend on a bound customer + matched delivery zone.
       Hide them until bind completes; the sticky footer's BIND CTA is the
       only action on the page in the unbound state. -->
  <block wx:if="{{isBound}}">

  <!-- When -->
  <view class="section">
    <view class="section-title f-bear">{{fulfillment === 'pickup' ? copy.pickupTimeTitle : (lang === 'cn' ? '什么时候送' : 'When')}}</view>

    <!-- ───── Pickup time: date + time pickers, bounded by the global window ───── -->
    <block wx:if="{{fulfillment === 'pickup'}}">
      <view class="pickup-hours-hint f-toni">{{copy.pickupHoursHint}} · {{pickupWindow.open}}–{{pickupWindow.close}}</view>
      <view class="pickup-time-row">
        <picker mode="date" value="{{pickupDate || pickupMinDate}}" start="{{pickupMinDate}}" end="{{pickupMaxDate}}" bindchange="onPickupDateChange">
          <view class="pickup-pick {{pickupDate ? '' : 'placeholder'}}">
            <text>{{pickupDateLabel || copy.pickupDatePh}}</text>
            <text class="region-chevron">›</text>
          </view>
        </picker>
        <picker mode="time" value="{{pickupTime}}" start="{{pickupWindow.open}}" end="{{pickupWindow.close}}" bindchange="onPickupTimeChange">
          <view class="pickup-pick {{pickupTime ? '' : 'placeholder'}}">
            <text>{{pickupTime || copy.pickupTimePh}}</text>
            <text class="region-chevron">›</text>
          </view>
        </picker>
      </view>
    </block>

    <block wx:elif="{{zoneError}}">
    <view class="zone-error">
      <view class="ze-title f-bear">{{lang === 'cn' ? '抱歉，此地址暂不在配送范围内' : "Sorry, we don't deliver to this address yet"}}</view>
      <view wx:if="{{kitchenAddress}}" class="ze-sub muted">{{lang === 'cn' ? '厨房地址：' : 'Our kitchen: '}}{{kitchenAddress}}</view>
    </view>
    </block>

    <block wx:elif="{{localOnlyBlock}}">
    <view class="zone-error">
      <view class="ze-title f-bear">{{lang === 'cn' ? '部分商品仅广州可配送' : 'Some items only deliver in Guangzhou'}}</view>
      <view wx:if="{{localOnlyNames.length}}" class="ze-sub muted">{{lang === 'cn' ? '仅广州：' : 'Guangzhou only: '}}{{localOnlyNames}}</view>
      <view class="ze-sub muted">{{lang === 'cn' ? '请移除这些商品，或切换到广州的收货地址。' : 'Remove them, or switch to a Guangzhou address.'}}</view>
    </view>
    </block>

    <!-- No zone matched yet (area not chosen) → we have no scheduling to show.
         Prompt for the area instead of falling through to the "closed / no
         slots" copy below, which is what made an OPEN store look closed when
         the customer skipped the area picker. -->
    <block wx:elif="{{!scheduling}}">
      <view class="muted slot-empty">{{quoting ? copy.loadingTimes : copy.areaNeededForTimes}}</view>
    </block>

    <block wx:else>
      <!-- Holiday-mode banner — orders accepted, future ship dates only -->
      <view wx:if="{{scheduling.holiday_mode}}" class="holiday-banner">
        <view class="hb-icon">🌴</view>
        <view class="hb-body">
          <view class="hb-title f-bear">{{lang === 'cn' ? '假期模式' : 'Holiday mode'}}</view>
          <view class="hb-msg">{{lang === 'cn' ? (scheduling.holiday_message.cn || '我们短暂休假中 — 订单将在我们回来后第一时间发货。') : (scheduling.holiday_message.en || "We're closed for a short holiday — your order will ship as soon as we're back.")}}</view>
        </view>
      </view>

      <!-- Same-day cutoff banner — kitchen is still open but the order landed
           inside the last-orders buffer before close (e.g. ordering 19:59 when
           Tianhe closes 20:00). Same-day/right-away is withdrawn; the customer
           is told why and steered to tomorrow's slots. -->
      <view wx:if="{{scheduling.same_day_cutoff_passed}}" class="holiday-banner">
        <view class="hb-icon">⏰</view>
        <view class="hb-body">
          <view class="hb-title f-bear">{{lang === 'cn' ? '今日配送已截单' : 'Same-day cutoff reached'}}</view>
          <view class="hb-msg">{{lang === 'cn' ? scheduling.same_day_cutoff_message.cn : scheduling.same_day_cutoff_message.en}}</view>
        </view>
      </view>

      <!-- Fresh batch notice — outside-GZ or Panyu-style-district cart with a
           made-to-batch item. Tells the customer the exact day we make it +
           when it arrives. Tap to re-open the full popup. -->
      <view wx:if="{{batchNotice}}" class="holiday-banner" bindtap="openBatchNotice">
        <view class="hb-icon">🥗</view>
        <view class="hb-body">
          <view class="hb-title f-bear">{{lang === 'cn' ? batchNotice.title_cn : batchNotice.title_en}}</view>
          <view class="hb-msg">{{lang === 'cn' ? batchNotice.message_cn : batchNotice.message_en}}</view>
        </view>
        <view class="hb-more">{{lang === 'cn' ? '详情' : 'Details'}}</view>
      </view>

      <!-- Ships-soon pre-order notice — cart holds a sold-out backorder item the
           customer is pre-ordering (ships on the next restock). Tap to re-open. -->
      <view wx:if="{{preorderNotice}}" class="holiday-banner" bindtap="openPreorderNotice">
        <view class="hb-icon">📦</view>
        <view class="hb-body">
          <view class="hb-title f-bear">{{lang === 'cn' ? preorderNotice.title_cn : preorderNotice.title_en}}</view>
          <view class="hb-msg">{{lang === 'cn' ? preorderNotice.message_cn : preorderNotice.message_en}}</view>
        </view>
        <view class="hb-more">{{lang === 'cn' ? '详情' : 'Details'}}</view>
      </view>

      <!-- Next-fresh-batch notice — a Guangzhou (local run) cart holding a fresh
           meal we're sold out of. Unlike the pre-order banner above this one has
           a real date: the kitchen's next production day. Tap to re-open. -->
      <view wx:if="{{localFreshNotice}}" class="holiday-banner" bindtap="openLocalFreshNotice">
        <view class="hb-icon">🥬</view>
        <view class="hb-body">
          <view class="hb-title f-bear">{{lang === 'cn' ? localFreshNotice.title_cn : localFreshNotice.title_en}}</view>
          <view class="hb-msg">{{lang === 'cn' ? localFreshNotice.message_cn : localFreshNotice.message_en}}</view>
        </view>
        <view class="hb-more">{{lang === 'cn' ? '详情' : 'Details'}}</view>
      </view>

      <!-- Sent-from-another-shop notice — the shop that would normally serve this
           address is closed, so a different one is fulfilling and delivery may be
           slower. Informational only: it never blocks placing the order. Tap to
           re-open the full popup. -->
      <view wx:if="{{storeMoveNotice}}" class="holiday-banner" bindtap="openStoreMoveNotice">
        <view class="hb-icon">🚚</view>
        <view class="hb-body">
          <view class="hb-title f-bear">{{lang === 'cn' ? storeMoveNotice.title_cn : storeMoveNotice.title_en}}</view>
          <view class="hb-msg">{{lang === 'cn' ? storeMoveNotice.message_cn : storeMoveNotice.message_en}}</view>
        </view>
        <view class="hb-more">{{lang === 'cn' ? '详情' : 'Details'}}</view>
      </view>

      <!-- Right away — always visible in time-slot mode; greyed when kitchen closed
           or holiday mode is on. Disabled state shows a reason below the label. -->
      <view wx:if="{{scheduling.mode !== 'day_only'}}"
            class="slot-row {{!scheduling.right_away_available ? 'disabled' : ''}}"
            data-id="right_away"
            data-label-en="Right away"
            data-label-cn="立即配送"
            data-surcharge="0"
            bindtap="{{scheduling.right_away_available ? 'pickSlot' : ''}}">
        <view class="dot {{deliverySlotId === 'right_away' ? 'on' : ''}}"></view>
        <view class="opt-body">
          <view class="opt-label f-bear">{{lang === 'cn' ? '立即配送' : 'Right away'}}</view>
          <view wx:if="{{scheduling.right_away_available}}" class="opt-sub muted">{{lang === 'cn' ? '尽快出餐' : 'ASAP after the kitchen confirms'}}</view>
          <view wx:elif="{{scheduling.holiday_mode}}" class="opt-sub muted">{{lang === 'cn' ? '假期模式中 — 请选择未来日期' : 'Holiday mode — please pick a future date'}}</view>
          <view wx:elif="{{scheduling.same_day_cutoff_passed}}" class="opt-sub muted">{{lang === 'cn' ? '今日已停止当日配送' : 'Same-day orders are closed for today'}}</view>
          <view wx:elif="{{!scheduling.kitchen_open_now}}" class="opt-sub muted">{{lang === 'cn' ? (scheduling.kitchen_reopens_today ? '厨房已关闭 — 今天上午' : '厨房已关闭 — 明天上午') : 'Closed — reopens '}}{{scheduling.kitchen_hours.start}}{{lang === 'cn' ? '点重开' : (scheduling.kitchen_reopens_today ? 'am today' : 'am tomorrow')}}</view>
          <view wx:else class="opt-sub muted">{{lang === 'cn' ? '本配送区不支持立即配送' : 'Not available for this area'}}</view>
        </view>
      </view>

      <!-- Day-only mode: three radio options (Express / Today / Schedule).
           Express row only renders once we have an expressLabel — otherwise
           we'd show an unlabeled box with just a radio dot (older clients
           hit this when slots was empty; see applyDayOnlyDefaults). -->
      <block wx:if="{{scheduling.mode === 'day_only'}}">
        <!-- Same-day was picked but is no longer on offer. Never let that
             downgrade happen quietly — the customer chose (and expected to
             pay for) today, and would otherwise only find out on delivery. -->
        <view wx:if="{{sameDayLost}}" class="slot-lost">
          <view class="slot-lost__title f-bear">{{lang === 'cn' ? '今日送达已不可选' : 'Same-day is no longer available'}}</view>
          <view class="slot-lost__sub">{{lang === 'cn' ? '订单将按下方所选日期送达。' : 'Your order will arrive on the date selected below.'}}</view>
        </view>

        <view wx:if="{{expressLabel}}" class="slot-option {{selectedSlotKind === 'express' ? 'on' : ''}}" bindtap="pickExpress">
          <view class="opt-body">
            <view class="opt-label f-bear">{{expressLabel}}</view>
            <view class="opt-sub muted">{{expressSub}}</view>
          </view>
          <view class="opt-check"><view class="opt-check-dot"></view></view>
        </view>

        <view wx:if="{{hasTodayOption}}" class="slot-option {{selectedSlotKind === 'today' ? 'on' : ''}}" bindtap="pickToday">
          <view class="opt-body">
            <view class="opt-label f-bear">
              ⚡ {{lang === 'cn' ? '今日送达' : 'Get it today'}} (+¥{{scheduling.same_day_surcharge}})
            </view>
            <view class="opt-sub muted">{{lang === 'cn' ? '今天送达,最快配送' : 'Delivered today, fastest possible'}}</view>
          </view>
          <view class="opt-check"><view class="opt-check-dot"></view></view>
        </view>

        <picker wx:if="{{scheduleMinDate && scheduleMaxDate && scheduleMinDate <= scheduleMaxDate}}"
                mode="date"
                value="{{schedulePickedDate || scheduleMinDate}}"
                start="{{scheduleMinDate}}"
                end="{{scheduleMaxDate}}"
                bindchange="onScheduleDateChange">
          <view class="slot-option {{selectedSlotKind === 'schedule' ? 'on' : ''}}">
            <view class="opt-body">
              <view class="opt-label f-bear">{{lang === 'cn' ? '稍后送达' : 'Schedule for later'}}</view>
              <view class="opt-sub muted">{{schedulePickedLabel ? schedulePickedLabel : (lang === 'cn' ? '不在家?选择送达日期' : 'not home? pick your delivery date')}}</view>
            </view>
            <view class="opt-check"><view class="opt-check-dot"></view></view>
          </view>
        </picker>
        <!-- No bookable window at all (no Express, no Today chip, no calendar).
             The row used to just vanish, leaving a blank space with nothing to
             read; say what happened instead. -->
        <view wx:if="{{!expressLabel && !hasTodayOption && !(scheduleMinDate && scheduleMaxDate && scheduleMinDate <= scheduleMaxDate)}}" class="slot-none">
          <view class="slot-none__title f-bear">{{lang === 'cn' ? '暂无可选配送日期' : 'No delivery dates available'}}</view>
          <view class="slot-none__sub">{{lang === 'cn' ? '此地址目前没有可安排的配送日期。请稍后再试或联系我们。' : 'We can’t schedule a delivery to this address right now. Please try again later or contact us.'}}</view>
        </view>
      </block>

      <!-- Time-slot mode: today's 2-hour windows as chips + schedule-for-later picker -->
      <block wx:if="{{scheduling.mode !== 'day_only'}}">
        <view wx:if="{{scheduling.today_slots && scheduling.today_slots.length}}" class="slot-day">
          <view class="slot-day-label f-toni">{{scheduling.slot_day_kind === 'tomorrow' ? (lang === 'cn' ? '明天' : 'TOMORROW') : (lang === 'cn' ? '今天' : 'TODAY')}}</view>
          <view class="slot-chip-row">
            <view wx:for="{{scheduling.today_slots}}" wx:key="slot_id" wx:for-item="slot"
                  class="slot-chip {{deliverySlotId === slot.slot_id ? 'on' : ''}} {{slot.requires_surcharge ? 'has-surcharge' : ''}}"
                  data-id="{{slot.slot_id}}"
                  data-label-en="{{slot.label_en}}"
                  data-label-cn="{{slot.label_cn}}"
                  data-surcharge="{{slot.surcharge}}"
                  bindtap="pickSlot">
              <view class="chip-label">{{lang === 'cn' ? slot.start_minute === 0 ? slot.start_hour + ':00' : slot.start_hour + ':' + slot.start_minute : slot.start_hour}}<text wx:if="{{lang !== 'cn'}}">{{slot.start_hour < 12 ? 'am' : 'pm'}}</text>–{{lang === 'cn' ? slot.end_minute === 0 ? slot.end_hour + ':00' : slot.end_hour + ':' + slot.end_minute : slot.end_hour}}<text wx:if="{{lang !== 'cn'}}">{{slot.end_hour < 12 ? 'am' : 'pm'}}</text></view>
              <view wx:if="{{slot.requires_surcharge}}" class="chip-surcharge f-toni">+¥{{slot.surcharge}}</view>
            </view>
          </view>
        </view>

        <!-- Schedule for later (calendar) — same widget the day-only mode uses.
             "on" requires BOTH selectedSlotKind === 'schedule' AND the picked
             slot id to still match the scheduled date. Without the second
             check, picking Right away (or a 16-18pm chip) after scheduling
             a date left this dot stale-filled (the bug the user spotted on
             2026-05-20). pickSlot now also clears selectedSlotKind, so this
             is belt-and-suspenders for any future code path that forgets. -->
        <picker wx:if="{{scheduleMinDate && scheduleMaxDate && scheduleMinDate <= scheduleMaxDate}}"
                mode="date"
                value="{{schedulePickedDate || scheduleMinDate}}"
                start="{{scheduleMinDate}}"
                end="{{scheduleMaxDate}}"
                bindchange="onScheduleDateChange">
          <view class="slot-option {{selectedSlotKind === 'schedule' ? 'on' : ''}}">
            <view class="opt-body">
              <view class="opt-label f-bear">{{lang === 'cn' ? '稍后送达' : 'Schedule for later'}}</view>
              <view class="opt-sub muted">{{schedulePickedLabel ? schedulePickedLabel : (lang === 'cn' ? '选择送达日期' : 'pick a delivery date')}}</view>
            </view>
            <view class="opt-check"><view class="opt-check-dot"></view></view>
          </view>
        </picker>
        <!-- Neither today/tomorrow chips nor a calendar window — nothing to pick.
             Same copy as the day-only branch above. -->
        <view wx:if="{{!(scheduling.today_slots && scheduling.today_slots.length) && !(scheduleMinDate && scheduleMaxDate && scheduleMinDate <= scheduleMaxDate)}}" class="slot-none">
          <view class="slot-none__title f-bear">{{lang === 'cn' ? '暂无可选配送日期' : 'No delivery dates available'}}</view>
          <view class="slot-none__sub">{{lang === 'cn' ? '此地址目前没有可安排的配送日期。请稍后再试或联系我们。' : 'We can’t schedule a delivery to this address right now. Please try again later or contact us.'}}</view>
        </view>

        <!-- Hour windows for the scheduled-for-later day — same 2-hour chips as
             today/tomorrow, shown once the customer picks a future date. -->
        <view wx:if="{{selectedSlotKind === 'schedule' && scheduledSlots.length}}" class="slot-day">
          <view class="slot-day-label f-toni">{{schedulePickedLabel}}</view>
          <view class="slot-chip-row">
            <view wx:for="{{scheduledSlots}}" wx:key="slot_id" wx:for-item="slot"
                  class="slot-chip {{deliverySlotId === slot.slot_id ? 'on' : ''}}"
                  data-id="{{slot.slot_id}}"
                  data-label-en="{{slot.label_en}}"
                  data-label-cn="{{slot.label_cn}}"
                  data-surcharge="{{slot.surcharge}}"
                  bindtap="pickScheduledSlot">
              <view class="chip-label">{{lang === 'cn' ? slot.start_minute === 0 ? slot.start_hour + ':00' : slot.start_hour + ':' + slot.start_minute : slot.start_hour}}<text wx:if="{{lang !== 'cn'}}">{{slot.start_hour < 12 ? 'am' : 'pm'}}</text>–{{lang === 'cn' ? slot.end_minute === 0 ? slot.end_hour + ':00' : slot.end_hour + ':' + slot.end_minute : slot.end_hour}}<text wx:if="{{lang !== 'cn'}}">{{slot.end_hour < 12 ? 'am' : 'pm'}}</text></view>
            </view>
          </view>
        </view>
      </block>

      <view wx:if="{{!scheduling.right_away_available && (!scheduling.today_slots || !scheduling.today_slots.length) && scheduling.mode !== 'day_only' && !(scheduleMinDate && scheduleMaxDate)}}" class="muted slot-empty">
        {{lang === 'cn' ? '暂无可用时段' : 'No delivery slots available right now'}}
      </view>
    </block>
  </view>

  <!-- Pay with -->
  <view class="section">
    <view class="section-title f-bear">{{copy.payWithTitle}}</view>

    <!-- Points as a discount toggle ABOVE the radios — not a payment method
         peer. Stacks with whichever method is picked below (WeChat / Alipay).
         When pointsAffordable is true AND toggle is on, the total goes to
         ¥0 and the residual-charge step is skipped server-side; the chosen
         radio is then just the "fallback rail" in case the math changes
         on submit. Hidden entirely when the customer has 0 points.

         Subtitle states (avoid the "save ¥0.00" worthless-looking copy
         that confused users — only surface a money figure when it's
         meaningful and accurate):
           toggle OFF, potential >= ¥0.01:  "4 pts · worth ¥0.04 on this order"
           toggle OFF, potential <  ¥0.01:  "4 pts available · keep earning"
           toggle ON , covers all bill:     "Covers the bill ✓"
           toggle ON , partial cover:       "¥X off · ¥Y left to pay"
           toggle ON , potential = 0:       (toggle disables itself, not shown) -->
    <view wx:if="{{pointsBalance > 0}}" class="points-toggle-row">
      <view class="pt-body">
        <view class="pt-label f-bear">
          {{lang === 'cn' ? '使用积分' : 'Use my points'}}
        </view>
        <view class="pt-sub muted">
          <!-- OFF · meaningful potential -->
          <block wx:if="{{!usePoints && pointsPotentialDiscount > 0}}">
            <text>{{pointsBalance}} {{lang === 'cn' ? '积分 · 本单可抵 ¥' : 'pts · worth ¥'}}{{pointsPotentialDiscount}}{{lang === 'cn' ? '' : ' on this order'}}</text>
          </block>
          <!-- OFF · too few to matter -->
          <block wx:elif="{{!usePoints}}">
            <text>{{pointsBalance}} {{lang === 'cn' ? '积分 · 继续累积' : 'pts available · keep earning'}}</text>
          </block>
          <!-- ON · covers the whole bill -->
          <block wx:elif="{{usePoints && pointsAffordable}}">
            <text class="pt-emph">{{lang === 'cn' ? '抵全部 ✓' : 'Covers the bill ✓'}}</text>
          </block>
          <!-- ON · partial cover -->
          <block wx:else>
            <text class="pt-emph">{{lang === 'cn' ? '已抵 ¥' : '¥'}}{{pointsDiscount}}{{lang === 'cn' ? '' : ' off'}}</text>
            <text>{{lang === 'cn' ? ' · 还需支付 ¥' : ' · ¥'}}{{total}}{{lang === 'cn' ? '' : ' left to pay'}}</text>
          </block>
        </view>
      </view>
      <switch checked="{{usePoints}}" disabled="{{pointsPotentialDiscount <= 0}}" bindchange="onTogglePoints" color="#1a1a17"/>
    </view>

    <!-- "Use my balance" — prepaid wallet store credit. Mirrors the points
         toggle. Store credit never pays shipping, so the subtitle figures are
         the non-shipping amount the balance can cover (server-clamped). -->
    <view wx:if="{{balanceBalance > 0}}" class="points-toggle-row">
      <view class="pt-body">
        <view class="pt-label f-bear">
          {{lang === 'cn' ? '使用余额' : 'Use my balance'}}
        </view>
        <view class="pt-sub muted">
          <!-- OFF · balance can cover something -->
          <block wx:if="{{!useBalance && balancePotentialDiscount > 0}}">
            <text>{{lang === 'cn' ? '余额 ¥' : '¥'}}{{balanceBalance}}{{lang === 'cn' ? ' · 本单可抵 ¥' : ' · worth ¥'}}{{balancePotentialDiscount}}{{lang === 'cn' ? '' : ' on this order'}}</text>
          </block>
          <!-- OFF · nothing left for balance to cover (points already cover goods) -->
          <block wx:elif="{{!useBalance}}">
            <text>{{lang === 'cn' ? '余额 ¥' : '¥'}}{{balanceBalance}}{{lang === 'cn' ? ' 可用' : ' available'}}</text>
          </block>
          <!-- ON -->
          <block wx:else>
            <text class="pt-emph">{{lang === 'cn' ? '已抵 ¥' : '¥'}}{{balanceDiscount}}{{lang === 'cn' ? '' : ' off'}}</text>
            <text>{{lang === 'cn' ? ' · 余额不抵运费' : ' · balance never covers shipping'}}</text>
          </block>
        </view>
      </view>
      <switch checked="{{useBalance}}" disabled="{{balancePotentialDiscount <= 0}}" bindchange="onToggleBalance" color="#1a1a17"/>
    </view>

    <view class="opt-row" data-method="wechat" bindtap="setPayment">
      <view class="dot {{paymentMethod === 'wechat' ? 'on' : ''}}"></view>
      <view class="pay-swatch" style="background: #1AAD19;"></view>
      <view class="opt-body">
        <view class="opt-label f-bear">{{copy.wechatOpt}}</view>
      </view>
    </view>

    <view class="opt-row {{alipayEnabled ? '' : 'opt-disabled'}}" data-method="alipay" bindtap="{{alipayEnabled ? 'setPayment' : ''}}">
      <view class="dot {{alipayEnabled && paymentMethod === 'alipay' ? 'on' : ''}}"></view>
      <view class="pay-swatch" style="background: #1677FF;"></view>
      <view class="opt-body">
        <view class="opt-label f-bear">{{copy.alipayOpt}}</view>
      </view>
      <view wx:if="{{!alipayEnabled}}" class="soon-pill f-bear">{{copy.comingSoon}}</view>
    </view>

    <!-- When points fully cover the bill, the picked radio is purely a
         fallback — surface that so the customer isn't surprised that
         WeChat/Alipay doesn't get charged. -->
    <view wx:if="{{usePoints && pointsAffordable}}" class="points-covers-hint muted">
      {{lang === 'cn' ? '✓ 积分已覆盖全单,无需支付' : '✓ Points cover the bill — no charge to ' + (paymentMethod === 'alipay' ? 'Alipay' : 'WeChat')}}
    </view>
  </view>

  <!-- Add-ons -->
  <view class="section">
    <view class="section-title f-bear">{{copy.addOnsTitle}}</view>
    <view class="checkbox-row">
      <switch checked="{{needsCutlery}}" bindchange="onCutleryToggle" color="#1a1a17"/>
      <view class="checkbox-label">{{copy.cutlery}}</view>
    </view>
    <view class="checkbox-row">
      <switch checked="{{needsInvoice}}" bindchange="onInvoiceToggle" color="#1a1a17"/>
      <view class="checkbox-label">{{copy.invoice}}</view>
    </view>
    <!-- Fapiao form — appears when an invoice is requested -->
    <view wx:if="{{needsInvoice}}" class="invoice-form">
      <view class="invoice-type">
        <view class="it-opt {{invoiceType === 'personal' ? 'on' : ''}}" data-type="personal" bindtap="onInvoiceType">{{copy.invPersonal}}</view>
        <view class="it-opt {{invoiceType === 'company' ? 'on' : ''}}" data-type="company" bindtap="onInvoiceType">{{copy.invCompany}}</view>
      </view>
      <view class="field" style="margin-top: 12rpx">
        <input class="input" placeholder="{{copy.invTitlePh}}" value="{{invoiceTitle}}" bindinput="onInvoiceTitle" maxlength="100"/>
      </view>
      <view wx:if="{{invoiceType === 'company'}}" class="field" style="margin-top: 12rpx">
        <input class="input" placeholder="{{copy.invTaxIdPh}}" value="{{invoiceTaxId}}" bindinput="onInvoiceTaxId" maxlength="40"/>
      </view>
      <view class="field" style="margin-top: 12rpx">
        <input class="input" placeholder="{{copy.invEmailPh}}" value="{{invoiceEmail}}" bindinput="onInvoiceEmail" maxlength="80"/>
      </view>
    </view>
    <view class="field" style="margin-top: 16rpx">
      <input class="input" placeholder="{{copy.noteLabel}}" value="{{note}}" bindinput="onNoteChange" maxlength="200"/>
    </view>
  </view>

  <!-- Coupons -->
  <view class="section">
    <view class="section-title f-bear">{{copy.couponsTitle}}</view>

    <view wx:if="{{autoApplied}}" class="voucher-applied auto">
      <view>
        <view class="va-name f-bear">{{autoApplied.title}}</view>
        <view wx:if="{{autoApplied.code}}" class="va-code-tag f-gothic">{{autoApplied.code}}</view>
        <view class="va-desc muted">{{autoApplied.sub}}</view>
      </view>
    </view>

    <view wx:if="{{voucherCode && !autoApplied}}" class="voucher-applied">
      <view>
        <view class="va-code f-gothic">{{voucherCode}}</view>
        <view class="va-desc muted">{{voucherFreeShip ? (lang === 'cn' ? '免运费' : 'Free shipping') : '−¥' + voucherDiscount}}</view>
      </view>
      <view class="va-remove f-toni" bindtap="removeVoucher">{{lang === 'cn' ? '移除' : 'REMOVE'}}</view>
    </view>

    <block wx:else>
      <view wx:if="{{lockedVoucher}}" class="voucher-applied locked">
        <view>
          <view class="va-name f-bear">{{lockedVoucher.title}}</view>
          <view wx:if="{{lockedVoucher.code}}" class="va-code-tag f-gothic">{{lockedVoucher.code}}</view>
          <view class="va-desc muted">{{lockedVoucher.sub}}</view>
        </view>
        <view class="va-lock">🔒</view>
      </view>

      <view wx:if="{{myVouchers.length}}" class="coupon-chips">
        <view wx:for="{{myVouchers}}" wx:key="code"
              class="coupon-chip mine" data-code="{{item.code}}" bindtap="selectPublicCoupon">
          <view class="cc-badge f-toni">{{lang === 'cn' ? '专属' : 'YOURS'}}</view>
          <view class="cc-title f-bear">{{item.title}}</view>
          <view wx:if="{{item.sublabel}}" class="cc-sub f-toni">{{item.sublabel}}</view>
          <view class="cc-apply f-toni">{{lang === 'cn' ? '点击使用 →' : 'TAP TO USE →'}}</view>
        </view>
      </view>

      <view wx:if="{{publicCoupons.length}}" class="coupon-chips">
        <view wx:for="{{publicCoupons}}" wx:key="code"
              class="coupon-chip" data-code="{{item.code}}" bindtap="selectPublicCoupon">
          <view class="cc-title f-bear">{{item.title}}</view>
          <view wx:if="{{item.sublabel}}" class="cc-sub f-toni">{{item.sublabel}}</view>
          <view class="cc-apply f-toni">{{lang === 'cn' ? '点击使用 →' : 'TAP TO USE →'}}</view>
        </view>
      </view>

      <view class="coupon-code-toggle f-toni" bindtap="toggleCodeInput">
        {{showCodeInput ? (lang === 'cn' ? '收起' : 'HIDE') : (lang === 'cn' ? '有优惠码?' : 'HAVE A CODE?')}}
      </view>
      <view wx:if="{{showCodeInput}}" class="voucher-input-row">
        <input class="input" placeholder="{{lang === 'cn' ? '输入优惠码' : 'Enter code (e.g. NEWBIE20)'}}"
               value="{{voucherInput}}" bindinput="onVoucherInput" auto-focus="{{false}}"/>
        <view class="apply-link f-toni" bindtap="applyVoucher">{{lang === 'cn' ? '应用' : 'APPLY'}}</view>
      </view>
    </block>
  </view>

  <!-- Fee breakdown -->
  <view class="section breakdown">
    <view class="bd-row">
      <view class="bd-label">{{lang === 'cn' ? '小计' : 'Subtotal'}}</view>
      <view class="bd-val f-bear">¥{{subtotal}}</view>
    </view>
    <view wx:if="{{fulfillment === 'pickup'}}" class="bd-row">
      <view class="bd-label">{{lang === 'cn' ? '自提' : 'Pickup'}}</view>
      <view class="bd-val f-bear">{{copy.free}}</view>
    </view>
    <view wx:elif="{{!zoneError && !localOnlyBlock}}" class="bd-row">
      <view class="bd-label">{{lang === 'cn' ? '配送费' : 'Delivery'}}</view>
      <view class="bd-val f-bear">{{(freeShipping && !couponShown) || couponFreeShown ? copy.free : '¥' + deliveryFee}}</view>
    </view>
    <view wx:if="{{packingFee && packingFee !== '0.00'}}" class="bd-row">
      <view class="bd-label">{{lang === 'cn' ? '包装费' : 'Packing fee'}}</view>
      <view class="bd-val f-bear">¥{{packingFee}}</view>
    </view>
    <view wx:if="{{couponShown}}" class="bd-row">
      <view class="bd-label">{{lang === 'cn' ? '优惠券' : 'Coupon'}}</view>
      <view class="bd-val f-bear">−¥{{couponShown}}</view>
    </view>
    <!-- Tax (audit I-03). Absent entirely until a shop sets a rate, and it says
         WHICH KIND it is: on an inclusive shop the amount is already inside the
         prices above it, so a bare "Tax ¥2.00" would make this column stop
         adding up. The merchant's own word for it, in the reader's language. -->
    <view wx:if="{{taxShown}}" class="bd-row">
      <view class="bd-label">{{taxLabel}}{{taxMode === 'inclusive' ? (lang === 'cn' ? ' · 已含' : ' · included') : ''}}</view>
      <view class="bd-val f-bear">¥{{taxShown}}</view>
    </view>
    <view wx:if="{{paymentMethod === 'points' && pointsToUse > 0}}" class="bd-row">
      <view class="bd-label">{{lang === 'cn' ? '积分抵扣 · ' : 'Points · '}}{{pointsToUse}}{{lang === 'cn' ? ' 积分' : ' pts'}}</view>
      <view class="bd-val f-bear">−¥{{pointsDiscount}}</view>
    </view>
    <view wx:if="{{savedTotal}}" class="bd-row bd-saved">
      <view class="bd-label">{{lang === 'cn' ? '已省' : 'You saved'}}</view>
      <view class="bd-val f-bear">−¥{{savedTotal}}</view>
    </view>
    <view wx:if="{{pointsEarnedPreview > 0}}" class="bd-row bd-points">
      <view class="bd-label">{{lang === 'cn' ? '本单获得积分' : "You'll earn"}}</view>
      <view class="bd-val f-bear">+{{pointsEarnedPreview}} {{lang === 'cn' ? '积分' : 'pts'}}</view>
    </view>
  </view>

  <!-- Fallback-routing notice removed by request: the out-of-stock notice no
       longer shows on the checkout screen. The handling modal still opens on
       Place Order (driven by `needsFallback`/`fallbackGate`) when items are out. -->

  </block><!-- /isBound -->

  <!-- Sticky footer -->
  <view class="sticky-bar">
    <view wx:if="{{isBound}}" class="total-block">
      <view class="total-label f-toni">{{copy.pay}}</view>
      <view class="total-amount f-bear">¥{{total}}</view>
    </view>
    <!-- Use a <view> instead of <button> — WeChat <button> ships with a
         pile of native styling (background-color: #f8f8f8, ::after
         pseudo-border, hardcoded :disabled bg, min-height) that's tedious
         to fully override and tends to bleed back through after SDK
         updates. This button never needed form-type or open-type, so a
         tap-target view is strictly simpler and visually stable.
         Disabled state is a class — placeOrder() also no-ops on disabled
         so a stray tap can't fire. -->
    <view class="place-btn f-toni {{!isBound ? 'place-btn--bind' : ''}} {{(placing || (isBound && (zoneError || localOnlyBlock))) ? 'place-btn--disabled' : ''}}"
          hover-class="place-btn--pressed"
          hover-stay-time="80"
          bindtap="placeOrder"
          aria-disabled="{{!!(placing || (isBound && (zoneError || localOnlyBlock)))}}">
      {{placing ? '...' : (isBound ? copy.placeOrder : copy.placeOrderBind)}}
    </view>
  </view>

  <!-- 5-option fallback modal — GZ + non-excluded district + right_away.
       The substitute-picker overlays on top when the customer picks "replace". -->
  <view wx:if="{{showFallbackModal && fallbackGate === 'options_5'}}"
        class="fb-modal-backdrop fb-modal-backdrop--sheet" bindtap="closeFallbackModal" catchtouchmove="noop">
    <view class="fb-modal" catchtap="noop">
      <view class="fb-modal__head">
        <view class="fb-modal__title f-bear">
          {{ lang === 'cn' ? '部分商品缺货' : 'Some items out of stock' }}
        </view>
        <view class="fb-modal__sub muted">
          {{ lang === 'cn'
            ? ('就近门店 ' + nearestStoreName + ' 暂时缺货,请选择处理方式：')
            : (nearestStoreName + ' is out of these. Pick what to do:') }}
        </view>
        <view class="fb-modal__missing">
          <view wx:for="{{missingItems}}" wx:key="product_id" class="fb-modal__missing-row">
            <view wx:if="{{item.image_data}}" class="fb-modal__missing-img">
              <image src="{{item.image_data}}" mode="aspectFill"/>
            </view>
            <view class="fb-modal__missing-name">
              <view>{{ lang === 'cn' ? (item.name_cn || item.name_en) : (item.name_en || item.name_cn) }}</view>
              <view class="muted">× {{item.qty}}</view>
            </view>
          </view>
        </view>
      </view>

      <!-- Each option is a <view>, not a <button>. Mini-app native <button>
           drags in centred margins, a built-in min-width, and a ::after
           pseudo-border that together squeezed the cards into ~60% width
           and a smaller-than-designed look. Views have zero of that and
           the styling below is bulletproof against future SDK updates. -->
      <view class="fb-modal__opts">
        <view class="fb-opt fb-opt--neutral {{fallbackBusy ? 'fb-opt--disabled' : ''}}"
              hover-class="{{fallbackBusy ? '' : 'fb-opt--pressed'}}"
              hover-stay-time="80"
              bindtap="{{fallbackBusy ? '' : 'fbCancelMissing'}}">
          <view class="fb-opt__num">1</view>
          <view class="fb-opt__body">
            <view class="fb-opt__label f-bear">
              {{ lang === 'cn' ? '取消缺货商品' : 'Cancel the missing item(s)' }}
            </view>
            <view class="fb-opt__sub">
              {{ lang === 'cn' ? '其余商品照常从就近门店发出' : 'Ship the rest from the nearest store' }}
            </view>
          </view>
        </view>

        <view class="fb-opt fb-opt--neutral {{fallbackBusy ? 'fb-opt--disabled' : ''}}"
              hover-class="{{fallbackBusy ? '' : 'fb-opt--pressed'}}"
              hover-stay-time="80"
              bindtap="{{fallbackBusy ? '' : 'fbReplaceMissing'}}">
          <view class="fb-opt__num">2</view>
          <view class="fb-opt__body">
            <view class="fb-opt__label f-bear">
              {{ lang === 'cn' ? '替换缺货商品' : 'Replace the missing item(s)' }}
            </view>
            <view class="fb-opt__sub">
              {{ lang === 'cn' ? '挑选替代品 · 差价由您承担' : 'Pick a substitute · you pay any price difference' }}
            </view>
          </view>
        </view>

        <!-- "Ship from the other store" only makes sense when there IS an
             other store that can fulfil the order. Per docs: "If both
             stores out: same 4 minus 'ship from other store', plus wait
             for restock". Without this guard the empty button still
             showed as "Ship from ". -->
        <view wx:if="{{fallbackStoreName}}"
              class="fb-opt fb-opt--lime {{fallbackBusy ? 'fb-opt--disabled' : ''}}"
              hover-class="{{fallbackBusy ? '' : 'fb-opt--pressed-lime'}}"
              hover-stay-time="80"
              bindtap="{{fallbackBusy ? '' : 'fbFullFromFallback'}}">
          <view class="fb-opt__num">3</view>
          <view class="fb-opt__body">
            <view class="fb-opt__label f-bear">
              {{ lang === 'cn' ? ('从 ' + fallbackStoreName + ' 发整单货') : ('Ship from ' + fallbackStoreName) }}
            </view>
            <view class="fb-opt__sub">
              <text wx:if="{{fallbackExtraKm !== null}}">+{{fallbackExtraKm}} km</text>
              <text wx:if="{{fallbackExtraMin}}"> · ~{{fallbackExtraMin}} {{lang === 'cn' ? '分钟更慢' : 'min slower'}}</text>
              <text> · </text><text style="color:#3a5a30;font-weight:700">{{ lang === 'cn' ? '无额外费用' : 'no extra charge' }}</text>
            </view>
          </view>
        </view>

        <view class="fb-opt fb-opt--neutral {{fallbackBusy ? 'fb-opt--disabled' : ''}}"
              hover-class="{{fallbackBusy ? '' : 'fb-opt--pressed'}}"
              hover-stay-time="80"
              bindtap="{{fallbackBusy ? '' : 'fbWaitForRestock'}}">
          <view class="fb-opt__num">4</view>
          <view class="fb-opt__body">
            <view class="fb-opt__label f-bear">
              {{ lang === 'cn' ? '等补货后发货' : 'Wait for restock' }}
            </view>
            <view class="fb-opt__sub">
              {{ lang === 'cn' ? '不赶时间?到货当天或次日发货' : 'Not in a rush? We ship same-day or next-day once restocked' }}
            </view>
          </view>
        </view>

        <view class="fb-opt fb-opt--ghost {{fallbackBusy ? 'fb-opt--disabled' : ''}}"
              hover-class="{{fallbackBusy ? '' : 'fb-opt--pressed'}}"
              hover-stay-time="80"
              bindtap="{{fallbackBusy ? '' : 'fbCancelOrder'}}">
          <view class="fb-opt__num">✕</view>
          <view class="fb-opt__body">
            <view class="fb-opt__label f-bear">
              {{ lang === 'cn' ? '取消整单订单' : 'Cancel the whole order' }}
            </view>
            <view class="fb-opt__sub muted">
              {{ lang === 'cn' ? '不下单了 · 关闭此弹窗' : 'Don’t place it · close this dialog' }}
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Substitute picker — overlays on top of the 5-option modal.
       Two modes:
         • Curated (default): admin-recommended substitutes for the missing
           item, in stock at the same store. Tap a card to pick it.
         • Browse all: search the full catalogue and pick anything. Toggle
           via the "Browse all products" link. Customer also lands here
           automatically when there are no curated suggestions.
       Both modes render the same .fb-sub row template so the UI feels
       consistent whether the office curated a substitute or not. -->
  <view wx:if="{{showReplacePicker}}" class="fb-modal-backdrop" bindtap="onReplacePickerBack" catchtouchmove="noop">
    <view class="fb-modal fb-modal--tall" catchtap="noop">
      <view class="fb-modal__head">
        <view class="fb-modal__title f-bear">
          {{ lang === 'cn'
              ? ('替换：' + (missingItems[replacePickerIndex].name_cn || missingItems[replacePickerIndex].name_en))
              : ('Replace ' + (missingItems[replacePickerIndex].name_en || missingItems[replacePickerIndex].name_cn)) }}
        </view>
        <view class="fb-modal__sub muted">
          {{ lang === 'cn'
              ? (missingItems.length > 1 ? ('第 ' + (replacePickerIndex+1) + ' / ' + missingItems.length + ' 件 · ' + (browseAll ? '挑一个商品' : '选择一个替代品')) : (browseAll ? '挑一个商品' : '选择一个替代品'))
              : (missingItems.length > 1 ? ('Item ' + (replacePickerIndex+1) + ' of ' + missingItems.length + ' · ' + (browseAll ? 'pick any product' : 'pick a substitute')) : (browseAll ? 'Pick any product' : 'Pick a substitute')) }}
        </view>
      </view>

      <!-- Mode toggle: curated ⇄ browse-all. -->
      <view class="fb-mode-toggle">
        <view wx:if="{{!browseAll}}" class="fb-mode-toggle__link f-toni" bindtap="toggleBrowseAll">
          {{ lang === 'cn' ? '浏览全部商品 →' : 'Browse all products →' }}
        </view>
        <view wx:elif="{{substituteOptions.length}}" class="fb-mode-toggle__link f-toni" bindtap="toggleBrowseAll">
          {{ lang === 'cn' ? '← 返回推荐替代品' : '← Back to recommended' }}
        </view>
      </view>

      <!-- Search input — only relevant in browse mode. -->
      <view wx:if="{{browseAll}}" class="fb-search">
        <view class="fb-search__icon">🔍</view>
        <input class="fb-search__input"
               placeholder="{{lang === 'cn' ? '搜索商品名 / SKU' : 'Search name or SKU'}}"
               value="{{browseQuery}}"
               bindinput="onBrowseQueryInput"
               confirm-type="search"/>
        <view wx:if="{{browseQuery}}" class="fb-search__clear" bindtap="clearBrowseQuery">×</view>
      </view>

      <scroll-view scroll-y="true" class="fb-subs__scroll">
        <!-- Curated mode -->
        <block wx:if="{{!browseAll}}">
          <view wx:if="{{!substituteOptions.length}}" class="fb-subs__empty muted">
            {{ lang === 'cn' ? '暂无推荐替代品 — 试试上方"浏览全部商品"' : 'No recommended substitutes — try Browse all products above' }}
          </view>
          <view wx:for="{{substituteOptions}}" wx:key="product_id" class="fb-sub" data-id="{{item.product_id}}" bindtap="onPickSubstitute">
            <view class="fb-sub__img">
              <image wx:if="{{item.image_data}}" src="{{item.image_data}}" mode="aspectFill"/>
            </view>
            <view class="fb-sub__body">
              <view class="fb-sub__name f-bear">
                {{ lang === 'cn' ? (item.name_cn || item.name_en) : (item.name_en || item.name_cn) }}
                <text wx:if="{{item.curated}}" class="fb-sub__curated">⭐</text>
              </view>
              <view class="fb-sub__sub muted">{{ lang === 'cn' ? (item.name_en || '') : (item.name_cn || '') }}{{ item.sku ? ' · ' + item.sku : '' }}</view>
            </view>
            <view class="fb-sub__price f-bear">¥{{item.sell_price}}</view>
          </view>
        </block>

        <!-- Browse-all mode -->
        <block wx:else>
          <view wx:if="{{browseLoading && !browseResults.length}}" class="fb-subs__empty muted">
            {{ lang === 'cn' ? '加载中...' : 'Loading…' }}
          </view>
          <view wx:elif="{{!browseResults.length}}" class="fb-subs__empty muted">
            {{ browseQuery
                ? (lang === 'cn' ? ('未找到 「' + browseQuery + '」') : ('No matches for “' + browseQuery + '”'))
                : (lang === 'cn' ? '暂无商品' : 'No products') }}
          </view>
          <view wx:for="{{browseResults}}" wx:key="product_id" class="fb-sub" data-id="{{item.product_id}}" bindtap="onPickSubstitute">
            <view class="fb-sub__img">
              <image wx:if="{{item.image_data}}" src="{{item.image_data}}" mode="aspectFill"/>
            </view>
            <view class="fb-sub__body">
              <view class="fb-sub__name f-bear">{{ lang === 'cn' ? (item.name_cn || item.name_en) : (item.name_en || item.name_cn) }}</view>
              <view class="fb-sub__sub muted">{{ lang === 'cn' ? (item.name_en || '') : (item.name_cn || '') }}{{ item.sku ? ' · ' + item.sku : '' }}</view>
            </view>
            <view class="fb-sub__price f-bear">¥{{item.sell_price}}</view>
          </view>
        </block>
      </scroll-view>

      <view class="fb-subs__footer">
        <view class="fb-opt fb-opt--ghost"
              hover-class="fb-opt--pressed"
              hover-stay-time="80"
              bindtap="onReplacePickerBack">
          {{ lang === 'cn' ? '← 返回' : '← Back' }}
        </view>
      </view>
    </view>
  </view>

  <popup-manager page="checkout"></popup-manager>

  <!-- Custom in-page fallback-confirmation modal (legacy simple yes/no).
       Replaces wx.showModal so typography (Bear / Toni) and palette match
       the rest of the checkout. Backdrop tap dismisses ↔ Cancel; the
       inner card swallows the tap.
       Gated on fallbackGate === 'simple_confirm' so it never overlays the
       richer 5-option modal above when the server picks options_5. Without
       this guard both modals rendered simultaneously and this one always
       covered the options modal because it sits later in the DOM. -->
  <view wx:if="{{showFallbackModal && fallbackGate === 'simple_confirm'}}" class="fb-modal-backdrop" bindtap="resolveFallbackCancel">
    <view class="fb-modal-card" catchtap="noop">
      <view class="fb-modal-icon">🚚</view>
      <view class="fb-modal-kicker f-toni">{{ lang === 'cn' ? '02 · 库存提示' : '02 · STOCK NOTICE' }}</view>
      <view class="fb-modal-title f-bear">
        {{ lang === 'cn' ? '配送时间会更长' : 'Longer delivery' }}
      </view>
      <view class="fb-modal-body">
        <text>{{ lang === 'cn'
          ? (nearestStoreName + '暂时缺货，订单将由 ')
          : (nearestStoreName + ' is out of stock. We can ship from ') }}</text>
        <text class="fb-modal-body-em">{{fallbackStoreName}}</text>
        <text>{{ lang === 'cn'
          ? ' 发货，配送时间会比往常更久。'
          : ' instead — delivery will take longer than usual.' }}</text>
      </view>

      <!-- Spell out exactly which items the nearest store is short of, so
           the customer knows whether they care enough about that SKU to
           accept the longer delivery (vs. tapping Cancel and removing it). -->
      <view wx:if="{{missingItems.length}}" class="fb-modal-missing">
        <view class="fb-modal-missing__kicker f-toni">
          {{ lang === 'cn' ? '缺货商品' : 'Out of stock' }}
        </view>
        <view wx:for="{{missingItems}}" wx:key="product_id" class="fb-modal-missing__row">
          <view wx:if="{{item.image_data}}" class="fb-modal-missing__img">
            <image src="{{item.image_data}}" mode="aspectFill"/>
          </view>
          <view class="fb-modal-missing__name">
            {{ lang === 'cn' ? (item.name_cn || item.name_en) : (item.name_en || item.name_cn) }}
            <text class="fb-modal-missing__qty"> × {{item.qty}}</text>
          </view>
        </view>
      </view>
      <!-- Numeric delta — server-computed distance + time. Only renders when
           the server actually returned a value; falls back to the prose-only
           message above if extra_km / extra_min_estimate were null. -->
      <view wx:if="{{fallbackExtraKm !== null || fallbackExtraMin}}" class="fb-modal-delta">
        <view wx:if="{{fallbackExtraKm !== null}}" class="fb-modal-delta__chip">
          <text class="fb-modal-delta__icon">📍</text>
          <text class="fb-modal-delta__val">+{{fallbackExtraKm}} km</text>
          <text class="fb-modal-delta__lbl">{{ lang === 'cn' ? '更远' : 'farther' }}</text>
        </view>
        <view wx:if="{{fallbackExtraMin}}" class="fb-modal-delta__chip">
          <text class="fb-modal-delta__icon">⏱</text>
          <text class="fb-modal-delta__val">~{{fallbackExtraMin}} min</text>
          <text class="fb-modal-delta__lbl">{{ lang === 'cn' ? '更慢' : 'slower' }}</text>
        </view>
      </view>
      <view class="fb-modal-actions">
        <view class="fb-modal-btn fb-modal-btn--secondary f-toni" bindtap="resolveFallbackCancel">
          {{ lang === 'cn' ? '取消' : 'Cancel' }}
        </view>
        <view class="fb-modal-btn fb-modal-btn--primary f-toni" bindtap="resolveFallbackContinue">
          {{ lang === 'cn' ? '继续下单 →' : 'Continue →' }}
        </view>
      </view>
    </view>
  </view>

  <!-- Wait-for-restock slot-conflict warning. Brand-styled (reuses
       fb-modal-card so the palette + typography match the simple_confirm
       modal above). Opens when the customer taps "Wait for restock" in
       the 5-option modal AND their picked slot is time-bound
       (right_away or today HH:MM). Backdrop tap = Cancel. -->
  <view wx:if="{{showWaitConfirmModal}}" class="fb-modal-backdrop" bindtap="resolveWaitConfirmCancel">
    <view class="fb-modal-card" catchtap="noop">
      <view class="fb-modal-icon">⏳</view>
      <view class="fb-modal-kicker f-toni">
        {{ lang === 'cn' ? '04 · 时段提示' : '04 · TIMING NOTICE' }}
      </view>
      <view class="fb-modal-title f-bear">
        {{ lang === 'cn' ? '时段可能无法保证' : 'Time slot may not be honored' }}
      </view>
      <view class="fb-modal-body">
        <text>{{ lang === 'cn'
          ? '等补货后发货意味着我们会在补货当天或次日发货 — 您选择的 '
          : 'Waiting for restock means we ship as soon as the item arrives — your picked window ' }}</text>
        <text class="fb-modal-body-em">{{ waitConfirmSlotLabel }}</text>
        <text>{{ lang === 'cn'
          ? ' 时段可能无法准时送达。'
          : ' may not be met.' }}</text>
      </view>
      <!-- When the shortage is a fresh meal, the kitchen schedule gives us the
           day — so say it instead of leaving them with "whenever it arrives". -->
      <view wx:if="{{waitConfirmMakeDate}}" class="fb-modal-body" style="margin-top: 8rpx;">
        <text>{{ lang === 'cn' ? '我们将于 ' : 'We make the next fresh batch on ' }}</text>
        <text class="fb-modal-body-em">{{waitConfirmMakeDate}}</text>
        <text>{{ lang === 'cn' ? ' 制作下一批新鲜商品，并于当天送达。' : ' and deliver it the same day.' }}</text>
      </view>
      <view class="fb-modal-body" style="margin-top: 8rpx;">
        <text class="muted">{{ lang === 'cn'
          ? '若选择继续，您所选时段的加急费用将被退还，订单会在到货后第一时间发出。'
          : 'If you continue, any same-day surcharge is refunded and we ship as soon as stock arrives.' }}</text>
      </view>
      <view class="fb-modal-actions">
        <view class="fb-modal-btn fb-modal-btn--secondary f-toni" bindtap="resolveWaitConfirmCancel">
          {{ lang === 'cn' ? '取消' : 'Cancel' }}
        </view>
        <view class="fb-modal-btn fb-modal-btn--primary f-toni" bindtap="resolveWaitConfirmContinue">
          {{ lang === 'cn' ? '继续 →' : 'Continue →' }}
        </view>
      </view>
    </view>
  </view>

  <!-- "Made fresh for you" popup. Auto-opens once per checkout visit when the
       cart holds a batch-made item shipping to an outside-GZ / Panyu-style
       zone, and re-opens from the inline banner. Copy (kicker/title/body) is
       operator-editable; the item list is matched to the cart for thumbnails. -->
  <view wx:if="{{batchNoticePopup && batchNotice}}" class="bn-backdrop" bindtap="closeBatchNotice" catchtouchmove="noop">
    <view class="bn-card" catchtap="noop">
      <view class="bn-hero">
        <view class="bn-badge">🥗</view>
      </view>
      <view class="bn-kicker f-toni">{{ lang === 'cn' ? batchNotice.kicker_cn : batchNotice.kicker_en }}</view>
      <view class="bn-title f-bear">{{ lang === 'cn' ? batchNotice.title_cn : batchNotice.title_en }}</view>

      <!-- The specific fresh items this refers to -->
      <view wx:if="{{batchNoticeItems.length}}" class="bn-items">
        <view wx:for="{{batchNoticeItems}}" wx:key="id" class="bn-item">
          <image wx:if="{{item.image}}" class="bn-item-img" src="{{item.image}}" mode="aspectFill"/>
          <view wx:else class="bn-item-img bn-item-img--ph">🥗</view>
          <view class="bn-item-name">{{item.name}}</view>
        </view>
      </view>

      <view class="bn-body">{{ lang === 'cn' ? batchNotice.message_cn : batchNotice.message_en }}</view>

      <!-- Ship → arrive timeline -->
      <view class="bn-timeline">
        <view class="bn-tl-step">
          <view class="bn-tl-dot bn-tl-dot--make"></view>
          <view class="bn-tl-lbl f-toni">{{ lang === 'cn' ? '现做发货' : 'MADE & SHIPPED' }}</view>
          <view class="bn-tl-date f-bear">{{batchNotice.ship_date}}</view>
        </view>
        <view class="bn-tl-line"></view>
        <view class="bn-tl-step">
          <view class="bn-tl-dot bn-tl-dot--arrive"></view>
          <view class="bn-tl-lbl f-toni">{{ lang === 'cn' ? '新鲜送达' : 'ARRIVES FRESH' }}</view>
          <view class="bn-tl-date f-bear">{{batchNotice.delivery_date}}</view>
        </view>
      </view>

      <!-- Freshness recommendation: consume within 48h of arrival -->
      <view class="bn-tip">
        <view class="bn-tip-icon">
          <view class="bn-tip-dot"></view>
        </view>
        <view class="bn-tip-text">{{ lang === 'cn' ? (batchNotice.tip_cn || '我们建议在收到后 48 小时内享用这些新鲜现做的商品，以获得最佳口感与新鲜度。') : (batchNotice.tip_en || 'We recommend enjoying these freshly-made items within 48 hours of arrival for the best taste and freshness.') }}</view>
      </view>

      <view class="bn-cta f-toni" bindtap="closeBatchNotice">{{ lang === 'cn' ? '知道了' : 'Got it' }}</view>
    </view>
  </view>

  <!-- "Ships soon" pre-order popup — auto-opens once when the cart holds a
       sold-out backorder item, re-opens from its banner. Reuses the batch
       modal styling minus the dated timeline (a restock has no fixed date). -->
  <view wx:if="{{preorderNoticePopup && preorderNotice}}" class="bn-backdrop" bindtap="closePreorderNotice" catchtouchmove="noop">
    <view class="bn-card" catchtap="noop">
      <view class="bn-hero">
        <view class="bn-badge">📦</view>
      </view>
      <view class="bn-kicker f-toni">{{ lang === 'cn' ? preorderNotice.kicker_cn : preorderNotice.kicker_en }}</view>
      <view class="bn-title f-bear">{{ lang === 'cn' ? preorderNotice.title_cn : preorderNotice.title_en }}</view>

      <!-- The specific sold-out items this pre-order refers to -->
      <view wx:if="{{preorderNoticeItems.length}}" class="bn-items">
        <view wx:for="{{preorderNoticeItems}}" wx:key="id" class="bn-item">
          <image wx:if="{{item.image}}" class="bn-item-img" src="{{item.image}}" mode="aspectFill"/>
          <view wx:else class="bn-item-img bn-item-img--ph">📦</view>
          <view class="bn-item-name">{{item.name}}</view>
        </view>
      </view>

      <view class="bn-body">{{ lang === 'cn' ? preorderNotice.message_cn : preorderNotice.message_en }}</view>

      <view class="bn-cta f-toni" bindtap="closePreorderNotice">{{ lang === 'cn' ? '知道了' : 'Got it' }}</view>
    </view>
  </view>

  <!-- "Next fresh batch" popup — the Guangzhou dated variant. Same shell as the
       two above. It shows ONE dated step, not the batch modal's make → arrive
       pair: on the local run there is no courier day to add, and the schedule
       stores an order cutoff rather than a kitchen-ready hour, so the arrival
       day isn't ours to promise. See computeLocalFreshNotice in routes/retail.js. -->
  <view wx:if="{{localFreshNoticePopup && localFreshNotice}}" class="bn-backdrop" bindtap="closeLocalFreshNotice" catchtouchmove="noop">
    <view class="bn-card" catchtap="noop">
      <view class="bn-hero">
        <view class="bn-badge">🥬</view>
      </view>
      <view class="bn-kicker f-toni">{{ lang === 'cn' ? localFreshNotice.kicker_cn : localFreshNotice.kicker_en }}</view>
      <view class="bn-title f-bear">{{ lang === 'cn' ? localFreshNotice.title_cn : localFreshNotice.title_en }}</view>

      <!-- The sold-out fresh items this batch date refers to -->
      <view wx:if="{{localFreshNoticeItems.length}}" class="bn-items">
        <view wx:for="{{localFreshNoticeItems}}" wx:key="id" class="bn-item">
          <image wx:if="{{item.image}}" class="bn-item-img" src="{{item.image}}" mode="aspectFill"/>
          <view wx:else class="bn-item-img bn-item-img--ph">🥬</view>
          <view class="bn-item-name">{{item.name}}</view>
        </view>
      </view>

      <view class="bn-body">{{ lang === 'cn' ? localFreshNotice.message_cn : localFreshNotice.message_en }}</view>

      <!-- ONE dated step, not the courier modal's two: on the local run the batch
           is made and delivered on the same day, so make_date and delivery_date
           are the same date. Printing it twice either side of a dashed line
           would read as a wait that isn't there. The arrival dot, because the
           day means "you get it" to the customer, not "we cook it". -->
      <view class="bn-timeline">
        <view class="bn-tl-step">
          <view class="bn-tl-dot bn-tl-dot--arrive"></view>
          <view class="bn-tl-lbl f-toni">{{ lang === 'cn' ? '现做当天送达' : 'MADE & DELIVERED' }}</view>
          <view class="bn-tl-date f-bear">{{localFreshNotice.delivery_date}}</view>
        </view>
      </view>

      <view class="bn-tip">
        <view class="bn-tip-icon">
          <view class="bn-tip-dot"></view>
        </view>
        <view class="bn-tip-text">{{ lang === 'cn' ? localFreshNotice.tip_cn : localFreshNotice.tip_en }}</view>
      </view>

      <view class="bn-cta f-toni" bindtap="closeLocalFreshNotice">{{ lang === 'cn' ? '知道了' : 'Got it' }}</view>
    </view>
  </view>

  <!-- "Sent from another shop" popup — auto-opens once per address when the shop
       that would normally serve it is closed, re-opens from its banner. Same
       shell as the pre-order modal, minus the item list (this is about where the
       order ships FROM, not which items are affected). Closing it is purely a
       dismissal — the order is placed exactly as it would have been. -->
  <view wx:if="{{storeMoveNoticePopup && storeMoveNotice}}" class="bn-backdrop" bindtap="closeStoreMoveNotice" catchtouchmove="noop">
    <view class="bn-card" catchtap="noop">
      <view class="bn-hero">
        <view class="bn-badge">🚚</view>
      </view>
      <view class="bn-kicker f-toni">{{ lang === 'cn' ? storeMoveNotice.kicker_cn : storeMoveNotice.kicker_en }}</view>
      <view class="bn-title f-bear">{{ lang === 'cn' ? storeMoveNotice.title_cn : storeMoveNotice.title_en }}</view>

      <view class="bn-body">{{ lang === 'cn' ? storeMoveNotice.message_cn : storeMoveNotice.message_en }}</view>

      <view class="bn-cta f-toni" bindtap="closeStoreMoveNotice">{{ lang === 'cn' ? '知道了' : 'Got it' }}</view>
    </view>
  </view>

  <!-- "Guangzhou delivery only" explainer popup. Custom-styled to match the
       fresh-batch modal; driven by the single `localOnlyPopup` flag so repeat
       triggers (re-quote + submit backstop) can't stack a second copy. -->
  <view wx:if="{{localOnlyPopup}}" class="bn-backdrop" bindtap="closeLocalOnly" catchtouchmove="noop">
    <view class="bn-card" catchtap="noop">
      <view class="bn-hero bn-hero--warn">
        <view class="bn-badge bn-badge--warn">📍</view>
      </view>
      <view class="bn-kicker bn-kicker--warn f-toni">{{ lang === 'cn' ? '配送范围' : 'DELIVERY AREA' }}</view>
      <view class="bn-title f-bear">{{localOnlyTitle}}</view>

      <!-- The specific Guangzhou-only items this refers to — product photo when
           we have one (matched from the cart), pin icon only as a fallback. -->
      <view wx:if="{{localOnlyItems.length}}" class="bn-items bn-items--warn">
        <view wx:for="{{localOnlyItems}}" wx:key="name" class="bn-item">
          <image wx:if="{{item.image}}" class="bn-item-img" src="{{item.image}}" mode="aspectFill"/>
          <view wx:else class="bn-item-img bn-item-img--ph bn-item-img--warn">📍</view>
          <view class="bn-item-name">{{item.name}}</view>
        </view>
      </view>

      <view class="bn-body">{{localOnlyBody}}</view>

      <view class="bn-cta f-toni" bindtap="closeLocalOnly">{{localOnlyCta}}</view>
    </view>
  </view>

  <!-- Last-chance upsell — shown once right before payment. Single `showOffers`
       flag so it can't stack. Tapping the backdrop or "Continue to pay"
       proceeds to payment; each "Add" drops the item in and re-quotes. -->
  <view wx:if="{{showOffers}}" class="bn-backdrop" bindtap="onOffersContinue" catchtouchmove="noop">
    <view class="bn-card" catchtap="noop">
      <view class="bn-hero">
        <view class="bn-badge">🛒</view>
      </view>
      <view class="bn-kicker">{{ lang === 'cn' ? '结账前 · 别错过' : 'BEFORE YOU PAY' }}</view>
      <view class="bn-title f-bear">{{ lang === 'cn' ? '再加一件？' : 'Add one more?' }}</view>

      <view class="of-list">
        <view wx:for="{{offers}}" wx:key="id" class="of-card">
          <image wx:if="{{item.image}}" class="of-img" src="{{item.image}}" mode="aspectFill"/>
          <view wx:else class="of-img of-img--ph">🥗</view>
          <view class="of-main">
            <view class="of-tag {{item.flash ? 'of-tag--flash' : ''}}">{{item.tag}}</view>
            <view class="of-name">{{item.name}}</view>
            <view wx:if="{{item.countdown}}" class="of-count">⏳ {{item.countdown}}</view>
            <view class="of-price-row">
              <text class="of-price">{{item.price}}</text>
              <text wx:if="{{item.was}}" class="of-was">{{item.was}}</text>
              <text wx:if="{{item.off}}" class="of-off">{{item.off}}</text>
            </view>
          </view>
          <view class="of-add f-toni" data-id="{{item.id}}" catchtap="onOfferAdd">{{item.cta}}</view>
        </view>
      </view>

      <view wx:if="{{!offers.length}}" class="of-empty">{{ lang === 'cn' ? '都加好啦 🎉' : 'All set 🎉' }}</view>

      <view class="bn-cta f-toni" catchtap="onOffersContinue">{{offerTotalLabel}}</view>
    </view>
  </view>
</view>

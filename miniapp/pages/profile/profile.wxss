.page { background: var(--oat); min-height: 100vh; padding-bottom: 80rpx; }

/* ── Hero band (editorial) ── */
.hero {
  position: relative;
  background: var(--corn);
  padding: 80rpx 44rpx 140rpx;
  overflow: hidden;
  min-height: 380rpx;
}
.hero-ip {
  position: absolute;
  right: -20rpx;
  bottom: -10rpx;
  width: 260rpx;
  height: 320rpx;
  pointer-events: none;
  mix-blend-mode: multiply;
  opacity: 0.9;
}
.hero-inner { position: relative; z-index: 1; max-width: 64%; }
.kicker {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.2em;
  color: var(--forest);
}
.title {
  font-size: calc(84rpx * var(--font-scale));
  font-weight: 500;
  line-height: 0.92;
  margin-top: 14rpx;
  color: var(--ink);
  word-break: break-word;
  white-space: pre-line;
}
.sub {
  margin-top: 18rpx;
  font-size: calc(22rpx * var(--font-scale));
  line-height: 1.45;
  color: var(--forest);
  max-width: 95%;
}

/* ── Avatar disc overlapping the seam ── */
.avatar-wrap {
  margin: -100rpx 44rpx 0;
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.avatar-disc {
  width: 200rpx;
  height: 200rpx;
  border: 3rpx solid var(--ink);
  border-radius: 999rpx;
  background: #FFFCF7;
  overflow: hidden;
  position: relative;
}
.avatar-btn {
  width: 100% !important;
  height: 100% !important;
  min-width: 0 !important;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.avatar-btn::after { border: none; }
.avatar-img { width: 100%; height: 100%; display: block; }
.avatar-placeholder {
  font-size: calc(22rpx * var(--font-scale));
  color: var(--olive);
  letter-spacing: 0.08em;
  text-align: center;
  padding: 0 16rpx;
}
.avatar-hint {
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.12em;
  color: var(--olive);
  margin-top: 16rpx;
  text-align: center;
}

/* Small text-link WeChat-avatar shortcut — strip the default button chrome. */
.avatar-wx-btn {
  display: inline-block;
  margin: 12rpx auto 0;
  padding: 0;
  background: transparent;
  line-height: 1.4;
  font-size: calc(18rpx * var(--font-scale));
  letter-spacing: 0.12em;
  color: var(--olive);
  text-decoration: underline;
}
.avatar-wx-btn::after {
  border: none;
}

/* ── Form ── */
.form { margin-top: 48rpx; }
.field-block { padding: 0 44rpx 28rpx; }
.field-label {
  font-size: calc(20rpx * var(--font-scale));
  letter-spacing: 0.14em;
  color: var(--olive);
  margin-bottom: 12rpx;
}
.input {
  background: #FFFCF7;
  border: 3rpx solid var(--ink);
  padding: 0 24rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: calc(28rpx * var(--font-scale));
  color: var(--ink);
  border-radius: 0;
  width: 100%;
  box-sizing: border-box;
}
.input-placeholder {
  color: rgba(26, 26, 23, 0.42);
  font-size: calc(28rpx * var(--font-scale));
  font-family: var(--f-aleo);
  line-height: 84rpx;
}
.field-hint {
  font-size: calc(20rpx * var(--font-scale));
  margin-top: 10rpx;
  line-height: 1.4;
  color: var(--olive);
}

/* ── WeChat address button — brand-styled (ink shell, small green dot to signal WeChat) ── */
.wx-addr-btn {
  background: #FFFCF7;
  color: var(--ink);
  border: 3rpx solid var(--ink);
  border-radius: 0;
  padding: 0 24rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: calc(22rpx * var(--font-scale));
  letter-spacing: 0.1em;
  text-align: center;
  width: 100% !important;
  min-width: 0 !important;
  margin: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.wx-addr-btn::after { border: none; }
.wx-addr-btn[disabled] { opacity: 0.5; }
.wx-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 999rpx;
  background: #07c160;
  display: inline-block;
}
.addr-preview {
  background: var(--ink);
  color: #fff;
  padding: 20rpx 24rpx;
  margin-top: -3rpx;
  border: 3rpx solid var(--ink);
}
.addr-line {
  font-size: calc(26rpx * var(--font-scale));
  line-height: 1.35;
  color: #fff;
}
.addr-line.addr-sub {
  font-family: var(--f-aleo);
  font-size: calc(22rpx * var(--font-scale));
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.7);
}

/* ── Phone (conditional) ── */
.phone-btn {
  background: #FFFCF7;
  border: 3rpx solid var(--ink);
  border-radius: 0;
  padding: 0 24rpx;
  height: 84rpx;
  line-height: 84rpx;
  font-size: calc(26rpx * var(--font-scale));
  letter-spacing: 0.04em;
  color: var(--ink);
  text-align: left;
  width: 100% !important;
  min-width: 0 !important;
  margin: 0;
}
.phone-btn::after { border: none; }

/* ── Actions ── */
.actions {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 44rpx 0;
}
.btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  font-size: calc(24rpx * var(--font-scale));
  letter-spacing: 0.14em;
  text-align: center;
  border-radius: 0;
  padding: 0;
  margin: 0;
  min-width: 0;
}
.btn.primary { background: var(--ink); color: var(--lime); }
.btn.secondary {
  background: transparent;
  color: var(--ink);
  border: 3rpx solid var(--ink);
}
.btn[disabled] { opacity: 0.5; }

/* ── Footer note ── */
.note {
  font-size: calc(20rpx * var(--font-scale));
  line-height: 1.5;
  padding: 36rpx 44rpx 0;
  text-align: center;
  color: var(--olive);
}

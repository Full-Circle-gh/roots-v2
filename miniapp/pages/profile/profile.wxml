<view class="page">
  <!-- Editorial hero band -->
  <view class="hero">
    <image class="hero-ip" src="/assets/brand/ip-onion.png" mode="aspectFit"></image>
    <view class="hero-inner">
      <view class="kicker f-toni">{{copy.kicker}}</view>
      <view class="title f-bear">{{copy.title}}</view>
      <view class="sub">{{copy.sub}}</view>
    </view>
  </view>

  <!-- Avatar disc overlaps the hero/oat seam -->
  <view class="avatar-wrap">
    <view class="avatar-disc">
      <button
        class="avatar-btn"
        bindtap="pickAvatar">
        <image wx:if="{{avatarPreview}}" class="avatar-img" src="{{avatarPreview}}" mode="aspectFill"></image>
        <view wx:else class="avatar-placeholder f-toni">{{copy.pickAvatar}}</view>
      </button>
    </view>
    <view class="avatar-hint f-toni">{{copy.avatarHint}}</view>
    <!-- WeChat-avatar shortcut. This is the ONLY way to pull the user's real
         WeChat avatar; it opens WeChat's own native sheet (its language follows
         the user's WeChat setting, not ours — unavoidable). -->
    <button
      class="avatar-wx-btn f-toni"
      open-type="chooseAvatar"
      bindchooseavatar="onChooseAvatar">{{copy.useWxAvatar}}</button>
  </view>

  <view class="form">
    <view class="field-block">
      <view class="field-label f-toni">{{copy.nicknameLabel}}</view>
      <input
        class="input f-aleo"
        type="nickname"
        placeholder-class="input-placeholder"
        placeholder="{{copy.nicknamePh}}"
        value="{{nickname}}"
        maxlength="40"
        bindinput="onNicknameInput"
        bindblur="onNicknameInput"
      />
    </view>

    <view class="field-block">
      <view class="field-label f-toni">{{copy.phoneLabel}}</view>
      <button
        class="phone-btn f-aleo"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhone"
        disabled="{{binding}}">
        {{binding ? '...' : (phone ? phone : copy.phoneBtn)}}
      </button>
      <view class="field-hint">{{copy.phoneHint}}</view>
    </view>
  </view>

  <view class="actions">
    <button class="btn secondary f-toni" bindtap="cancel" disabled="{{saving}}">{{copy.cancel}}</button>
    <button class="btn primary f-toni" bindtap="save" disabled="{{saving}}">{{saving ? copy.saving : copy.save}}</button>
  </view>

  <view class="note">{{copy.note}}</view>
</view>

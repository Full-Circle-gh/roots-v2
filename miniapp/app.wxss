/* Roots design tokens — matches /cms preview and customer-facing brand */

/* Bear Serif's digits are thin/geometric and don't match its chunky letters.
   The first @font-face below maps digits + currency to Lilita One; the second
   covers the remaining glyphs from BearSerif.otf. Both files are also loaded
   globally via wx.loadFontFace (utils/fonts.js) for cross-page availability. */
@font-face {
  font-family: 'Bear Serif';
  src: url('https://rootskitchenchina.com/assets/fonts/LilitaOne.ttf') format('truetype');
  unicode-range: U+0024, U+0025, U+0030-0039, U+00A5;
  font-display: swap;
}
@font-face {
  font-family: 'Bear Serif';
  src: url('https://rootskitchenchina.com/assets/fonts/BearSerif.otf') format('opentype');
  font-display: swap;
}

page {
  /* Height of the custom tab bar (custom-tab-bar/index.wxss). Two flavours
     because WeChat's CSS engine does NOT resolve env(safe-area-inset-bottom)
     when it sits inside calc() inside a chained var() — the env() expands
     to 0 and you lose the iPhone home-indicator inset (~68rpx). So:

       --tabbar-h        : 98rpx + safe-area, intended for INLINE use at
                           the consuming site (e.g. `bottom: var(--tabbar-h)`).
                           Safe when the consumer is a non-calc property.
       --tabbar-clear    : a generous fixed reservation (170rpx ≈ 98 + 68
                           safe-area + a 4rpx kiss of buffer). Use this in
                           any padding-bottom/calc context, because the
                           env() form silently breaks there.

     Stick to --tabbar-clear for padding-bottom; use --tabbar-h when you
     literally want `bottom: <value>` and nothing else. */
  --tabbar-h:     calc(98rpx + env(safe-area-inset-bottom));
  --tabbar-clear: 170rpx;

  /* Brand palette */
  --lime: #CCD900;
  --forest: #365329;
  --olive: #6A6E2D;
  --almond: #C37F4E;
  --corn: #F2CA6C;
  --oat: #F2E7DF;
  --ink: #1a1a17;
  --pink: #F4B8CB;
  --berry: #E96174;
  --carrot: #FF6B0C;
  --papaya: #FFAF60;
  --sky: #B2CFED;
  --lotus: #EEB8E4;
  --citrus: #E7E74C;
  --lemon: #F4F087;
  --pea: #7BBD3B;
  --cucumber: #A8D185;
  --avocado: #73BF83;

  /* Brand fonts — loaded at runtime via wx.loadFontFace (see utils/fonts.js).
     Falls back to system fonts on first paint (font-display: swap behaviour). */
  /* CN fallback order is identical across families so a kicker (f-toni) and
     headline (f-bear) — which never share a Latin face — still share the
     SAME Chinese face when DF Yuan doesn't cover a glyph. Without this,
     the kicker dropped to -apple-system's CJK pick while the headline
     dropped to PingFang SC, and their first characters didn't line up. */
  --f-bear:   'Bear Serif',   'DF Yuan', 'PingFang SC', 'Hiragino Sans GB', -apple-system, serif;
  --f-toni:   'Toni Grotesk', 'DF Yuan', 'PingFang SC', 'Hiragino Sans GB', -apple-system, sans-serif;
  --f-gothic: 'League Gothic','DF Yuan', 'PingFang SC', 'Hiragino Sans GB', 'Bebas Neue', sans-serif;
  --f-aleo:   'Aleo',         'DF Yuan', 'PingFang SC', 'Hiragino Sans GB', -apple-system, serif;
  --f-yuan:   'DF Yuan', 'PingFang SC', 'Hiragino Sans GB', sans-serif;

  /* Global text scaler — every `font-size: Nrpx` declaration in the app
     is rewritten as `font-size: calc(Nrpx * var(--font-scale))`. Tweak
     this single value to dial overall readability up or down. */
  --font-scale: 1.15;

  background: var(--oat);
  color: var(--ink);
  font-family: var(--f-aleo);
  font-size: calc(28rpx * var(--font-scale));
}

/* Reset */
view, text, image, scroll-view, button, input, navigator { box-sizing: border-box; }
button {
  border: none;
  background: transparent;
  padding: 0;
  line-height: 1.4;
}
button::after { border: none; }

/* Reusable utility classes */
.f-bear   { font-family: var(--f-bear); }
.f-toni   { font-family: var(--f-toni); letter-spacing: 0.04em; text-transform: uppercase; }
.f-gothic { font-family: var(--f-gothic); letter-spacing: 0.04em; }
.f-aleo   { font-family: var(--f-aleo); }
.f-yuan   { font-family: var(--f-yuan); }

.muted   { color: var(--olive); }
.full    { width: 100%; }
.tap     { -webkit-tap-highlight-color: transparent; }

/* Loading skeleton — same shimmer pattern as /storefront */
.skeleton {
  background: linear-gradient(90deg, rgba(0,0,0,.06) 0%, rgba(0,0,0,.03) 50%, rgba(0,0,0,.06) 100%);
  background-size: 200% 100%;
  animation: shimmer 1.6s ease-in-out infinite;
}
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

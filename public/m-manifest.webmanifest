{
  "name": "Tacet · store",
  "short_name": "Tacet",
  "id": "/m",
  "description": "The store backend on your phone — what needs you, and today's numbers.",
  "start_url": "/m?from=app",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#FBF9F4",
  "theme_color": "#FBF9F4",
  "lang": "en",
  "dir": "ltr",
  "categories": ["business", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/tacet-icon-192.png",          "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/tacet-icon-512.png",          "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/tacet-icon-192-maskable.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/tacet-icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/tacet-icon.svg",              "sizes": "any",     "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Orders",
      "short_name": "Orders",
      "url": "/m?from=app&to=orders",
      "icons": [{ "src": "/tacet-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Products",
      "short_name": "Products",
      "url": "/m?from=app&to=products",
      "icons": [{ "src": "/tacet-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Inbox",
      "short_name": "Inbox",
      "url": "/m?from=app&to=inbox",
      "icons": [{ "src": "/tacet-icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}

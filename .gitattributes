* text=auto

# Shell scripts and git hooks must keep LF endings — bash chokes on CRLF
# (the deploy hook + deploy scripts run under Git Bash / on the Linux server).
*.sh text eol=lf
*.hook text eol=lf

# The gzgrocery price list was converted from a Windows spreadsheet and is
# stored on the server with CRLF endings. Keep its bytes verbatim so tracking
# it never rewrites the file that is already on disk there.
/scripts/_guanyi_pricing.json -text

# The Postgres rehearsal scripts and the proposed schema are the verbatim
# record of a run that already happened on the Linux box, and they checksum
# against the copies still sitting there. They are stored LF, but a Windows
# checkout was handing back CRLF — which inflates every file and, worse, turns
# the shebang into "#!/usr/bin/env python3\r", an interpreter that does not
# exist. Pin them so the working copy always matches the committed bytes.
/scripts/postgres-migration/*.py text eol=lf
/docs/tacet-postgres-schema-proposed.sql text eol=lf

# The full-copy scripts are the verbatim record of the 2026-08-04 copy and
# checksum against the copies still on the box. Unlike the rehearsal set they
# are NOT uniformly LF — checks.py, gen.py, verify.py, plan.json and
# copy_order.json were written with CRLF, the other sixteen files with LF.
# A blanket eol=lf would rewrite five of them. Convert nothing in either
# direction; keep the bytes exactly as they ran.
/scripts/postgres-full-copy/*.py -text
/scripts/postgres-full-copy/*.json -text
/scripts/postgres-full-copy/*.sh -text
/scripts/postgres-full-copy/survey_pg.sql -text

# The as-built schema dump is pg_dump output and is LF on the box. Pin it so a
# Windows checkout cannot hand back a CRLF copy that no longer matches.
/docs/tacet-postgres-schema-as-built-2026-08-04.sql text eol=lf

# The decimal schema is derived from that dump line-for-line and will be RUN on
# the Linux box to create the tables. It has to diff cleanly against the
# as-built file, so it gets the same LF pin — a CRLF checkout would make every
# line differ and hide the 92 that actually changed.
/docs/tacet-postgres-schema-decimal.sql text eol=lf

# The money-scale census is new work, written LF, and runs on the Linux box.
# Same shebang hazard as the migration scripts above: a Windows checkout handing
# back CRLF turns "#!/usr/bin/env python3" into an interpreter that does not
# exist. Pin it.
/scripts/postgres-money-scale/*.py text eol=lf
